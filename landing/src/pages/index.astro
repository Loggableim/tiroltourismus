---
// tiroltourismus.com — Landing/Hub
// Design: Warhol × Jobs × Tourismus
// Jede Sprach-Karte nennt ihr Künstlerpaar + Link zur Sprachseite.
// 7 soon-Sprachen mit Vote (KV-backed, anti-collusion).
import fs from 'node:fs';
import path from 'node:path';

// ── Echte Daten aus dem Repo lesen (Build-Zeit) ──
const DATA = path.resolve(process.cwd(), '..', 'src', 'data');
function count(coll) {
  try {
    return fs.readdirSync(path.join(DATA, coll), { withFileTypes: true })
      .filter(d => d.isDirectory() && fs.existsSync(path.join(DATA, coll, d.name, 'index.json')))
      .length;
  } catch { return 0; }
}
function regions() {
  try {
    return fs.readdirSync(path.join(DATA, 'regionen'), { withFileTypes: true })
      .filter(d => d.isDirectory())
      .map(d => {
        try {
          const j = JSON.parse(fs.readFileSync(path.join(DATA, 'regionen', d.name, 'index.json'), 'utf-8'));
          return { slug: d.name, name: j.titel || j.name || d.name };
        } catch { return { slug: d.name, name: d.name }; }
      })
      .sort((a, b) => a.name.localeCompare(b.name, 'de'));
  } catch { return []; }
}

const REGIONS = regions();
const COUNTS = {
  gastro: count('gastro'),
  unterkuenfte: count('unterkuenfte'),
  orte: count('orte'),
  sehenswuerdigkeiten: count('sehenswuerdigkeiten'),
  camping: count('camping'),
  magazin: count('magazin'),
};
const TOTAL = Object.values(COUNTS).reduce((a, b) => a + b, 0);

// ── Sprachen mit Künstlerpaar + Design-Info ──
const LANGS = [
  { code: 'de', flag: '🇩🇪', native: 'Deutsch',    url: 'https://de.tiroltourismus.com', color: '#FF1493',
    artists: 'Otto Grünmandl & Paul Flora', style: 'Minimalistische Linienzeichnung trifft satirischen Humor' },
  { code: 'en', flag: '🇬🇧', native: 'English',    url: 'https://en.tiroltourismus.com', color: '#FFD700',
    artists: 'Albin Egger-Lienz & Alfons Walde', style: 'Monumentale Bergsilhouetten, erdig & winterlich' },
  { code: 'fr', flag: '🇫🇷', native: 'Français',   url: 'https://fr.tiroltourismus.com', color: '#00E5FF',
    artists: 'Max Weiler & Paul Flora', style: 'Poetische organische Formen, Serif-Eleganz' },
  { code: 'cs', flag: '🇨🇿', native: 'Čeština',    url: 'https://cs.tiroltourismus.com', color: '#FF6B35',
    artists: 'Franz von Defregger & Albin Egger-Lienz', style: 'Historische Figurenmalerei, Rauten-Ornament' },
  { code: 'nl', flag: '🇳🇱', native: 'Nederlands', url: 'https://nl.tiroltourismus.com', color: '#8B5CF6',
    artists: 'Paul Flora & Salvador Dalí', style: 'Surreale schwebende Objekte, Outline-Typo' },
  { code: 'it', flag: '🇮🇹', native: 'Italiano',   url: 'https://it.tiroltourismus.com', color: '#00C853',
    artists: 'Alfons Walde & Gustav Klimt', style: 'Luxuriöse Goldornamentik, Schneeweiß & Navy' },
  { code: 'es', flag: '🇪🇸', native: 'Español',    url: 'https://es.tiroltourismus.com', color: '#FF1493',
    artists: 'Max Weiler & Wassily Kandinsky', style: 'Abstrakte Natur trifft Geometrie' },
  { code: 'zh', flag: '🇨🇳', native: '中文',        url: 'https://cn.tiroltourismus.com', color: '#FFD700',
    artists: 'Michael Pacher & Albin Egger-Lienz', style: 'Sakral, symmetrisch, dramatisches Licht' },
];

// ── Soon-Sprachen (7 für Vote) ──
const SOON = [
  { code: 'pl', flag: '🇵🇱', native: 'Polski',     color: '#00E5FF' },
  { code: 'hu', flag: '🇭🇺', native: 'Magyar',     color: '#FF6B35' },
  { code: 'sk', flag: '🇸🇰', native: 'Slovenčina', color: '#8B5CF6' },
  { code: 'ru', flag: '🇷🇺', native: 'Русский',    color: '#FF1493' },
  { code: 'ja', flag: '🇯🇵', native: '日本語',      color: '#FFD700' },
  { code: 'sl', flag: '🇸🇮', native: 'Slovenščina', color: '#00C853' },
  { code: 'hr', flag: '🇭🇷', native: 'Hrvatski',   color: '#FF6B35' },
];

const CATS = [
  { icon: '🍽️', label: 'Gastronomie', count: COUNTS.gastro, color: '#FF1493' },
  { icon: '🏡', label: 'Unterkünfte', count: COUNTS.unterkuenfte, color: '#FFD700' },
  { icon: '🏘️', label: 'Orte', count: COUNTS.orte, color: '#00E5FF' },
  { icon: '🏛️', label: 'Sehenswürdigkeiten', count: COUNTS.sehenswuerdigkeiten, color: '#FF6B35' },
  { icon: '🏕️', label: 'Camping', count: COUNTS.camping, color: '#8B5CF6' },
  { icon: '📰', label: 'Magazin', count: COUNTS.magazin, color: '#00C853' },
];

const fmt = (n) => n.toLocaleString('de-AT');
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tirol Tourismus — Ein Land. Acht Sprachen. Alles drin.</title>
  <meta name="description" content="Tirol Tourismus: Der smarte Guide für Reiseplanung, Unterkünfte, Gastronomie und Erlebnisse in Tirol — in 8 Sprachen. 14 Regionen, über 5.200 Orte, Gastro-Adressen und Unterkünfte.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://tiroltourismus.com/">
  <link rel="alternate" href="https://de.tiroltourismus.com/" hreflang="de-AT">
  <link rel="alternate" href="https://en.tiroltourismus.com/" hreflang="en-US">
  <link rel="alternate" href="https://fr.tiroltourismus.com/" hreflang="fr-FR">
  <link rel="alternate" href="https://cs.tiroltourismus.com/" hreflang="cs-CZ">
  <link rel="alternate" href="https://nl.tiroltourismus.com/" hreflang="nl-NL">
  <link rel="alternate" href="https://it.tiroltourismus.com/" hreflang="it-IT">
  <link rel="alternate" href="https://es.tiroltourismus.com/" hreflang="es-ES">
  <link rel="alternate" href="https://cn.tiroltourismus.com/" hreflang="zh-CN">
  <link rel="alternate" href="https://tiroltourismus.com/" hreflang="x-default">
  <meta property="og:title" content="Tirol Tourismus — Ein Land. Acht Sprachen. Alles drin.">
  <meta property="og:description" content="14 Regionen, über 5.200 Orte, Gastro-Adressen und Unterkünfte — in 8 Sprachen.">
  <meta property="og:url" content="https://tiroltourismus.com/">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://tiroltourismus.com/images/og-default.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Tirol Tourismus">
  <meta property="og:locale" content="de_AT">
  <meta name="theme-color" content="#000000">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Tirol Tourismus — Ein Land. Acht Sprachen. Alles drin.">
  <meta name="twitter:description" content="14 Regionen, über 5.200 Orte, Gastro-Adressen und Unterkünfte — in 8 Sprachen.">
  <meta name="twitter:image" content="https://tiroltourismus.com/images/og-default.jpg">
  <link rel="icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Tirol Tourismus",
    "url": "https://tiroltourismus.com",
    "description": "Der smarte Tirol-Guide für Reiseplanung, Unterkünfte und Erlebnisse — in 8 Sprachen.",
    "inLanguage": "de",
    "hasPart": [
      {"@type": "WebSite", "name": "Tirol Tourismus Deutsch", "url": "https://de.tiroltourismus.com", "inLanguage": "de"},
      {"@type": "WebSite", "name": "Tirol Tourismus English", "url": "https://en.tiroltourismus.com", "inLanguage": "en"},
      {"@type": "WebSite", "name": "Tirol Tourismus Français", "url": "https://fr.tiroltourismus.com", "inLanguage": "fr"},
      {"@type": "WebSite", "name": "Tirol Tourismus Čeština", "url": "https://cs.tiroltourismus.com", "inLanguage": "cs"},
      {"@type": "WebSite", "name": "Tirol Tourismus Nederlands", "url": "https://nl.tiroltourismus.com", "inLanguage": "nl"},
      {"@type": "WebSite", "name": "Tirol Tourismus Italiano", "url": "https://it.tiroltourismus.com", "inLanguage": "it"},
      {"@type": "WebSite", "name": "Tirol Tourismus Español", "url": "https://es.tiroltourismus.com", "inLanguage": "es"},
      {"@type": "WebSite", "name": "Tirol Tourismus 中文", "url": "https://cn.tiroltourismus.com", "inLanguage": "zh"}
    ]
  }
  </script>
  <style>
    :root {
      --black: #000;
      --white: #fff;
      --pink: #FF1493;
      --gold: #FFD700;
      --cyan: #00E5FF;
      --orange: #FF6B35;
      --purple: #8B5CF6;
      --green: #00C853;
      --grey: #111;
      --grey2: #1a1a1a;
      --font-display: 'Bebas Neue', Impact, sans-serif;
      --font-body: 'Montserrat', system-ui, sans-serif;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:var(--font-body);background:var(--black);color:var(--white);line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    a{color:inherit;text-decoration:none}
    .wrap{max-width:1280px;margin:0 auto;padding:0 24px}

    /* ═══ HERO ═══ */
    .hero{padding:clamp(72px,12vh,140px) 0 clamp(40px,6vh,72px);position:relative}
    .hero-kicker{font-size:11px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:24px}
    .hero-title{font-family:var(--font-display);font-size:clamp(88px,19vw,260px);line-height:.82;letter-spacing:.02em;text-transform:uppercase}
    .hero-title .row{display:block}
    .hero-title .c{display:inline-block;transition:transform .3s cubic-bezier(.16,1,.3,1)}
    .hero-title .c:hover{transform:translateY(-8px)}
    .c-pink{color:var(--pink)}.c-gold{color:var(--gold)}.c-cyan{color:var(--cyan)}
    .c-orange{color:var(--orange)}.c-purple{color:var(--purple)}.c-green{color:var(--green)}
    .hero-sub{margin-top:28px;max-width:560px;font-size:clamp(15px,1.6vw,19px);color:rgba(255,255,255,.55);line-height:1.7}
    .hero-sub strong{color:var(--white);font-weight:600}
    .strip{display:grid;grid-template-columns:repeat(6,1fr);height:14px;margin-top:clamp(40px,7vh,80px)}
    .strip span{display:block}

    /* ═══ SECTIONS ═══ */
    .section{padding:clamp(64px,10vh,120px) 0}
    .sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:24px;margin-bottom:clamp(32px,5vh,56px);flex-wrap:wrap}
    .sec-title{font-family:var(--font-display);font-size:clamp(40px,6vw,84px);line-height:.9;letter-spacing:.02em;text-transform:uppercase}
    .sec-note{font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.35)}

    /* ═══ SPRACH-KARTEN (mit Künstler) ═══ */
    .lang-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:3px}
    .lang-tile{position:relative;display:flex;flex-direction:column;gap:14px;padding:28px 26px;background:var(--grey);transition:transform .25s cubic-bezier(.16,1,.3,1),background .25s;overflow:hidden;min-height:200px}
    .lang-tile:hover{transform:scale(1.01);z-index:2;background:var(--grey2)}
    .lang-tile .bar{position:absolute;left:0;top:0;bottom:0;width:5px;transition:width .3s cubic-bezier(.16,1,.3,1),opacity .3s}
    .lang-tile:hover .bar{width:100%;opacity:.1}
    .lang-top{display:flex;align-items:center;gap:14px}
    .lang-flag{font-size:clamp(32px,4vw,48px);line-height:1}
    .lang-native{font-family:var(--font-display);font-size:clamp(24px,3vw,38px);letter-spacing:.04em;text-transform:uppercase;line-height:1}
    .lang-artists{font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase}
    .lang-style{font-size:12.5px;color:rgba(255,255,255,.45);line-height:1.5}
    .lang-go{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;opacity:0;transform:translateY(6px);transition:all .25s;margin-top:auto}
    .lang-tile:hover .lang-go{opacity:1;transform:translateY(0)}

    /* ═══ ZAHLEN ═══ */
    .numbers{display:grid;grid-template-columns:repeat(4,1fr);gap:3px}
    .num-block{padding:clamp(28px,4vw,48px) 24px;background:var(--grey)}
    .num-val{font-family:var(--font-display);font-size:clamp(48px,7vw,96px);line-height:.9;letter-spacing:.01em}
    .num-label{font-size:11px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:rgba(255,255,255,.4);margin-top:10px}

    /* ═══ KATEGORIEN ═══ */
    .cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}
    .cat-tile{display:flex;align-items:center;gap:18px;padding:24px;background:var(--grey);transition:background .25s}
    .cat-tile:hover{background:var(--grey2)}
    .cat-icon{font-size:32px;line-height:1}
    .cat-info{flex:1;min-width:0}
    .cat-label{font-family:var(--font-display);font-size:clamp(20px,2.2vw,28px);letter-spacing:.04em;text-transform:uppercase;line-height:1.1}
    .cat-count{font-size:12px;font-weight:700;letter-spacing:1.5px;color:rgba(255,255,255,.4);margin-top:4px}
    .cat-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}

    /* ═══ REGIONEN ═══ */
    .region-row{display:flex;flex-wrap:wrap;gap:3px}
    .region-chip{font-family:var(--font-display);font-size:clamp(18px,2vw,26px);letter-spacing:.05em;text-transform:uppercase;padding:14px 22px;background:var(--grey);transition:all .25s cubic-bezier(.16,1,.3,1)}
    .region-chip:hover{background:var(--white);color:var(--black);transform:translateY(-3px)}

    /* ═══ SOON + VOTE ═══ */
    .soon-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:3px}
    .soon-tile{padding:28px 24px;background:var(--grey);display:flex;flex-direction:column;gap:16px;border:1px dashed rgba(255,255,255,.14)}
    .soon-top{display:flex;align-items:center;gap:14px}
    .soon-flag{font-size:32px}
    .soon-name{font-family:var(--font-display);font-size:clamp(22px,2.4vw,30px);letter-spacing:.04em;text-transform:uppercase;line-height:1}
    .soon-badge{font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:3px 10px;border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.5);width:fit-content}
    .vote-btn{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 18px;background:transparent;border:1px solid rgba(255,255,255,.2);color:var(--white);font-family:var(--font-body);font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;cursor:pointer;transition:all .25s}
    .vote-btn:hover{background:var(--white);color:var(--black);border-color:var(--white)}
    .vote-btn.voted{background:var(--green);border-color:var(--green);color:var(--black);cursor:default}
    .vote-btn:disabled{opacity:.5;cursor:wait}
    .vote-count{font-family:var(--font-display);font-size:22px;letter-spacing:.05em}

    /* ═══ FOOTER ═══ */
    .footer{padding:56px 0 40px;border-top:1px solid rgba(255,255,255,.08)}
    .footer-inner{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap}
    .footer-brand{font-family:var(--font-display);font-size:clamp(28px,4vw,48px);letter-spacing:.03em;text-transform:uppercase;line-height:1}
    .footer-links{display:flex;gap:20px;font-size:12px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,.4)}
    .footer-links a:hover{color:var(--white)}

    @media(max-width:900px){
      .lang-grid{grid-template-columns:1fr}
      .numbers{grid-template-columns:repeat(2,1fr)}
      .cat-grid{grid-template-columns:1fr}
      .soon-grid{grid-template-columns:repeat(auto-fill,minmax(240px,1fr))}
    }
    @media(max-width:520px){
      .numbers{grid-template-columns:1fr}
    }
  </style>
</head>
<body>

  <!-- ═══ HERO ═══ -->
  <header class="hero">
    <div class="wrap">
      <div class="hero-kicker">Ein Land · Acht Sprachen · Alles drin</div>
      <h1 class="hero-title">
        <span class="row"><span class="c c-pink">T</span><span class="c c-gold">I</span><span class="c c-cyan">R</span><span class="c c-orange">O</span><span class="c c-purple">L</span></span>
      </h1>
      <p class="hero-sub">
        <strong>{fmt(TOTAL)} Einträge.</strong> {REGIONS.length} Regionen. {LANGS.length} Sprachen.
        Der smarte Guide für Reiseplanung, Unterkünfte, Gastronomie und Erlebnisse —
        von der urbanen Alpenstadt Innsbruck bis zu den Gletscherwelten des Kaunertals.
      </p>
    </div>
    <div class="strip" aria-hidden="true">
      <span style="background:var(--pink)"></span>
      <span style="background:var(--gold)"></span>
      <span style="background:var(--cyan)"></span>
      <span style="background:var(--orange)"></span>
      <span style="background:var(--purple)"></span>
      <span style="background:var(--green)"></span>
    </div>
  </header>

  <!-- ═══ SPRACHEN (mit Künstler-Erwähnung) ═══ -->
  <section class="section" aria-labelledby="langs-title" id="sprachen">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="sec-title" id="langs-title">Sprache wählen</h2>
        <span class="sec-note">{LANGS.length} vollständige Versionen · jede mit eigener künstlerischer Handschrift</span>
      </div>
      <div class="lang-grid">
        {LANGS.map(l => (
          <a href={l.url} class="lang-tile" hreflang={l.code} aria-label={`Tirol Tourismus auf ${l.native}`}>
            <span class="bar" style={`background:${l.color}`}></span>
            <span class="lang-top">
              <span class="lang-flag">{l.flag}</span>
              <span class="lang-native">{l.native}</span>
            </span>
            <span class="lang-artists" style={`color:${l.color}`}>🎨 {l.artists}</span>
            <span class="lang-style">{l.style}</span>
            <span class="lang-go" style={`color:${l.color}`}>Öffnen →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ZAHLEN ═══ -->
  <section class="section" aria-labelledby="numbers-title" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="sec-title" id="numbers-title">Was drin ist</h2>
        <span class="sec-note">Stand: {new Date().toLocaleDateString('de-AT', { month: 'long', year: 'numeric' })}</span>
      </div>
      <div class="numbers">
        <div class="num-block">
          <div class="num-val c-pink">{fmt(COUNTS.gastro)}</div>
          <div class="num-label">Gastro-Adressen</div>
        </div>
        <div class="num-block">
          <div class="num-val c-gold">{fmt(COUNTS.unterkuenfte)}</div>
          <div class="num-label">Unterkünfte</div>
        </div>
        <div class="num-block">
          <div class="num-val c-cyan">{fmt(COUNTS.orte)}</div>
          <div class="num-label">Orte</div>
        </div>
        <div class="num-block">
          <div class="num-val c-orange">{fmt(COUNTS.sehenswuerdigkeiten + COUNTS.camping)}</div>
          <div class="num-label">Sights & Camping</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ KATEGORIEN ═══ -->
  <section class="section" aria-labelledby="cats-title" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="sec-title" id="cats-title">Sechs Welten</h2>
        <span class="sec-note">Alles kuratiert & gepflegt</span>
      </div>
      <div class="cat-grid">
        {CATS.map(c => (
          <div class="cat-tile">
            <span class="cat-icon">{c.icon}</span>
            <span class="cat-info">
              <span class="cat-label">{c.label}</span>
              <span class="cat-count" style="display:block">{fmt(c.count)} Einträge</span>
            </span>
            <span class="cat-dot" style={`background:${c.color}`}></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ REGIONEN ═══ -->
  <section class="section" aria-labelledby="regions-title" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="sec-title" id="regions-title">Vierzehn Gesichter</h2>
        <span class="sec-note">Von Arlberg bis Zillertal</span>
      </div>
      <div class="region-row">
        {REGIONS.map(r => (
          <a href={`https://de.tiroltourismus.com/regionen/${r.slug}/`} class="region-chip">{r.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SOON + VOTE (7 Sprachen) ═══ -->
  <section class="section" aria-labelledby="soon-title" style="padding-top:0" id="voting">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="sec-title" id="soon-title">Als Nächstes</h2>
        <span class="sec-note">{SOON.length} Sprachen in Vorbereitung — stimme ab</span>
      </div>
      <div class="soon-grid">
        {SOON.map(l => (
          <div class="soon-tile" id={`vote-${l.code}`}>
            <div class="soon-top">
              <span class="soon-flag">{l.flag}</span>
              <span class="soon-name">{l.native}</span>
            </div>
            <span class="soon-badge">In Vorbereitung</span>
            <button class="vote-btn" data-lang={l.code} type="button" aria-label={`Für ${l.native} stimmen`}>
              <span>+1 Stimme</span>
              <span class="vote-count" data-count-for={l.code}>–</span>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FOOTER ═══ -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">Tirol<span class="c-pink">.</span>Tourismus</div>
      <div class="footer-links">
        <a href="https://de.tiroltourismus.com/impressum/">Impressum</a>
        <a href="https://de.tiroltourismus.com/datenschutz/">Datenschutz</a>
        <a href="https://de.tiroltourismus.com/transparenz/">Transparenz</a>
      </div>
    </div>
  </footer>

  <script>
    // ── Vote-System (KV-backed via /api/vote, anti-collusion: IP-Hash serverseitig) ──
    (function () {
      'use strict';
      var VOTED_KEY = 'tt_lang_votes';
      var voted = {};
      try { voted = JSON.parse(localStorage.getItem(VOTED_KEY) || '{}'); } catch (e) { voted = {}; }

      function setVoted(code) {
        voted[code] = Date.now();
        try { localStorage.setItem(VOTED_KEY, JSON.stringify(voted)); } catch (e) {}
      }

      fetch('/api/votes', { credentials: 'omit' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data || !data.counts) return;
          Object.keys(data.counts).forEach(function (code) {
            var el = document.querySelector('[data-count-for="' + code + '"]');
            if (el) el.textContent = data.counts[code];
          });
        })
        .catch(function () {});

      document.querySelectorAll('.vote-btn').forEach(function (btn) {
        var code = btn.dataset.lang;
        if (voted[code]) {
          btn.classList.add('voted');
          btn.querySelector('span').textContent = 'Danke!';
        }
        btn.addEventListener('click', function () {
          if (btn.classList.contains('voted') || btn.disabled) return;
          btn.disabled = true;
          fetch('/api/vote', {
            method: 'POST',
            credentials: 'omit',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lang: code })
          })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
              if (res.ok && res.data && res.data.success) {
                setVoted(code);
                btn.classList.add('voted');
                btn.querySelector('span').textContent = 'Danke!';
                var el = document.querySelector('[data-count-for="' + code + '"]');
                if (el && typeof res.data.count === 'number') el.textContent = res.data.count;
              } else if (res.data && res.data.error === 'already_voted') {
                setVoted(code);
                btn.classList.add('voted');
                btn.querySelector('span').textContent = 'Danke!';
              } else {
                btn.disabled = false;
              }
            })
            .catch(function () { btn.disabled = false; });
        });
      });
    })();
  </script>
</body>
</html>