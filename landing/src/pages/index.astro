---
// tiroltourismus.com — Landing/Hub-Page
// Reduziert, SEO-optimiert. Leitet Besucher zu den Sprach-Subdomains.
// it/es/zh: "soon" mit +1-Vote (KV-backed, anti-collusion via IP-Hash).
const PUBLISHED = [
  { code: 'de', flag: '🇩🇪', name: 'Deutsch',    native: 'Deutsch',    url: 'https://de.tiroltourismus.com', desc: 'Der smarte Tirol-Guide — Regionen, Unterkünfte, Gastro & mehr.' },
  { code: 'en', flag: '🇬🇧', name: 'English',    native: 'English',    url: 'https://en.tiroltourismus.com', desc: 'The smart Tyrol guide — regions, stays, food & more.' },
  { code: 'fr', flag: '🇫🇷', name: 'Français',   native: 'Français',   url: 'https://fr.tiroltourismus.com', desc: 'Le guide intelligent du Tyrol — régions, hébergements, gastronomie.' },
  { code: 'cs', flag: '🇨🇿', name: 'Čeština',    native: 'Čeština',    url: 'https://cs.tiroltourismus.com', desc: 'Chytrý průvodce Tyrolskem — regiony, ubytování, gastronomie.' },
  { code: 'nl', flag: '🇳🇱', name: 'Nederlands', native: 'Nederlands', url: 'https://nl.tiroltourismus.com', desc: 'De slimme Tirol-gids — regio\'s, accommodaties, eten & drinken.' },
];
const SOON = [
  { code: 'it', flag: '🇮🇹', name: 'Italiano', native: 'Italiano' },
  { code: 'es', flag: '🇪🇸', name: 'Español',  native: 'Español' },
  { code: 'zh', flag: '🇨🇳', name: '中文',      native: '中文' },
];
const STATS = [
  { num: '5.400+', label: 'Seiten pro Sprache' },
  { num: '5', label: 'Sprachen live' },
  { num: '5.200+', label: 'Orte, Gastro & Unterkünfte' },
  { num: '3', label: 'Sprachen in Abstimmung' },
];
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tirol Tourismus — Der smarte Tirol-Guide in 5 Sprachen</title>
  <meta name="description" content="Tirol Tourismus: Der smarte Guide für Reiseplanung, Unterkünfte, Gastronomie und Erlebnisse in Tirol — verfügbar in Deutsch, English, Français, Čeština und Nederlands.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://tiroltourismus.com/">
  <link rel="alternate" href="https://de.tiroltourismus.com/" hreflang="de-AT">
  <link rel="alternate" href="https://en.tiroltourismus.com/" hreflang="en-US">
  <link rel="alternate" href="https://fr.tiroltourismus.com/" hreflang="fr-FR">
  <link rel="alternate" href="https://cs.tiroltourismus.com/" hreflang="cs-CZ">
  <link rel="alternate" href="https://nl.tiroltourismus.com/" hreflang="nl-NL">
  <link rel="alternate" href="https://tiroltourismus.com/" hreflang="x-default">
  <meta property="og:title" content="Tirol Tourismus — Der smarte Tirol-Guide in 5 Sprachen">
  <meta property="og:description" content="Regionen, Unterkünfte, Gastronomie und Erlebnisse in Tirol — in 5 Sprachen.">
  <meta property="og:url" content="https://tiroltourismus.com/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Tirol Tourismus">
  <meta property="og:locale" content="de_AT">
  <meta name="theme-color" content="#FF1493">
  <link rel="icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Tirol Tourismus",
    "url": "https://tiroltourismus.com",
    "description": "Der smarte Tirol-Guide für Reiseplanung, Unterkünfte und Erlebnisse — in 5 Sprachen.",
    "inLanguage": "de",
    "hasPart": [
      {"@type": "WebSite", "name": "Tirol Tourismus Deutsch", "url": "https://de.tiroltourismus.com", "inLanguage": "de"},
      {"@type": "WebSite", "name": "Tirol Tourismus English", "url": "https://en.tiroltourismus.com", "inLanguage": "en"},
      {"@type": "WebSite", "name": "Tirol Tourismus Français", "url": "https://fr.tiroltourismus.com", "inLanguage": "fr"},
      {"@type": "WebSite", "name": "Tirol Tourismus Čeština", "url": "https://cs.tiroltourismus.com", "inLanguage": "cs"},
      {"@type": "WebSite", "name": "Tirol Tourismus Nederlands", "url": "https://nl.tiroltourismus.com", "inLanguage": "nl"}
    ]
  }
  </script>
  <style>
    :root {
      --bg: #0A0A12; --bg2: #10101E;
      --surface: rgba(255,255,255,.04); --surface-hover: rgba(255,255,255,.08);
      --text: #F0EDEE; --text2: rgba(255,255,255,.65); --text3: rgba(255,255,255,.30);
      --pink: #FF1493; --pink-dark: #C0006E; --gold: #D4A800;
      --glass-border: rgba(255,255,255,.08);
      --font-display: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
      --font-body: 'Montserrat', system-ui, sans-serif;
      --ease: cubic-bezier(.16,1,.3,1);
      --radius: 16px; --radius-lg: 24px;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:var(--font-body);color:var(--text);background:var(--bg);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden;min-height:100vh}
    a{color:inherit;text-decoration:none}
    img{max-width:100%;height:auto;display:block}
    .container{max-width:1100px;margin:0 auto;padding:0 24px}

    /* ── Hero ── */
    .hero{position:relative;text-align:center;padding:clamp(80px,12vw,140px) 24px clamp(48px,7vw,80px);overflow:hidden}
    .hero::before{content:'';position:absolute;inset:0;background:
      radial-gradient(ellipse 140% 70% at 60% 0%,rgba(180,40,120,.18) 0%,transparent 50%),
      radial-gradient(ellipse 120% 60% at 30% 20%,rgba(120,30,180,.10) 0%,transparent 45%),
      radial-gradient(ellipse 100% 80% at 70% 30%,rgba(212,168,0,.06) 0%,transparent 40%),
      linear-gradient(180deg,var(--bg) 0%,#140c1e 54%,#05070c 100%);pointer-events:none}
    .hero-content{position:relative;z-index:1;max-width:820px;margin:0 auto}
    .hero-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 20px;border-radius:100px;font-size:12px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;background:rgba(255,255,255,.06);border:1px solid var(--glass-border);margin-bottom:20px;color:rgba(255,255,255,.92)}
    .hero h1{font-family:var(--font-display);font-size:clamp(52px,9vw,110px);line-height:.92;letter-spacing:2px;text-transform:uppercase;margin-bottom:18px;text-shadow:0 10px 40px rgba(0,0,0,.3)}
    .hero h1 .accent{color:var(--pink)}
    .hero p{font-size:clamp(15px,1.4vw,18px);color:var(--text2);max-width:640px;margin:0 auto 32px;line-height:1.75}

    /* ── Stats ── */
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:820px;margin:0 auto 64px;padding:0 24px}
    .stat{text-align:center;padding:20px 12px;background:var(--surface);border:1px solid var(--glass-border);border-radius:var(--radius)}
    .stat-num{font-family:var(--font-display);font-size:clamp(28px,3.5vw,42px);letter-spacing:1px;background:linear-gradient(135deg,var(--pink),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1.1}
    .stat-label{font-size:12px;color:var(--text3);font-weight:600;margin-top:4px}

    /* ── Language Cards ── */
    .section-title{text-align:center;font-family:var(--font-display);font-size:clamp(32px,4.5vw,52px);letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}
    .section-sub{text-align:center;color:var(--text2);font-size:15px;max-width:560px;margin:0 auto 36px}
    .lang-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;max-width:1100px;margin:0 auto;padding:0 24px}
    .lang-card{display:flex;align-items:center;gap:16px;padding:22px 24px;background:var(--surface);border:1px solid var(--glass-border);border-radius:var(--radius-lg);transition:transform .35s var(--ease),border-color .35s var(--ease),box-shadow .35s var(--ease);position:relative;overflow:hidden}
    .lang-card:hover{transform:translateY(-4px);border-color:var(--pink);box-shadow:0 16px 40px rgba(0,0,0,.3)}
    .lang-flag{font-size:38px;line-height:1;flex-shrink:0}
    .lang-info{flex:1;min-width:0}
    .lang-name{font-family:var(--font-display);font-size:24px;letter-spacing:1px;text-transform:uppercase;line-height:1.1}
    .lang-desc{font-size:12.5px;color:var(--text2);line-height:1.5;margin-top:2px}
    .lang-arrow{font-size:20px;color:var(--pink);flex-shrink:0;transition:transform .3s var(--ease)}
    .lang-card:hover .lang-arrow{transform:translateX(4px)}

    /* ── Soon + Vote ── */
    .soon-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;max-width:1100px;margin:0 auto;padding:0 24px}
    .soon-card{display:flex;align-items:center;gap:16px;padding:22px 24px;background:linear-gradient(135deg,rgba(255,255,255,.03),rgba(255,255,255,.01));border:1px dashed var(--glass-border);border-radius:var(--radius-lg);position:relative}
    .soon-card .lang-name{color:var(--text2)}
    .soon-badge{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1px;padding:3px 10px;border-radius:100px;background:rgba(255,255,255,.08);color:var(--text3);margin-left:8px;vertical-align:middle}
    .vote-btn{display:inline-flex;align-items:center;gap:6px;padding:10px 18px;border-radius:100px;border:1px solid var(--glass-border);background:rgba(255,255,255,.05);color:var(--text);font-family:inherit;font-size:13px;font-weight:700;cursor:pointer;transition:all .3s var(--ease);white-space:nowrap;flex-shrink:0}
    .vote-btn:hover{background:var(--pink);border-color:var(--pink);color:#fff;transform:translateY(-2px)}
    .vote-btn.voted{background:rgba(0,200,83,.15);border-color:rgba(0,200,83,.4);color:#4ade80;cursor:default;transform:none}
    .vote-btn:disabled{opacity:.6;cursor:wait}
    .vote-count{font-size:11px;color:var(--text3);font-weight:600;min-width:20px;text-align:center}

    /* ── Footer ── */
    .footer{margin-top:80px;padding:40px 24px;border-top:1px solid var(--glass-border);text-align:center}
    .footer p{font-size:12.5px;color:var(--text3);line-height:1.8}
    .footer a{color:var(--text2);border-bottom:1px solid transparent;transition:border-color .2s}
    .footer a:hover{border-color:var(--pink);color:var(--text)}

    @media(max-width:768px){
      .stats{grid-template-columns:repeat(2,1fr)}
      .lang-card,.soon-card{padding:18px 20px}
      .lang-flag{font-size:32px}
      .lang-name{font-size:21px}
    }
    @media(max-width:480px){
      .soon-card{flex-wrap:wrap}
      .vote-btn{width:100%;justify-content:center}
    }
  </style>
</head>
<body>
  <header class="hero">
    <div class="hero-content">
      <div class="hero-badge">🏔️ Tirol entdecken, planen und erleben</div>
      <h1>TIROL <span class="accent">TOURISMUS</span></h1>
      <p>Der smarte Guide für Reiseplanung, Unterkünfte, Gastronomie und Erlebnisse in Tirol — jetzt in fünf Sprachen verfügbar. Wähle Deine Sprache und tauche ein.</p>
    </div>
  </header>

  <section class="stats" aria-label="Statistiken">
    {STATS.map(s => (
      <div class="stat">
        <div class="stat-num">{s.num}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </section>

  <section aria-labelledby="lang-title" style="margin-bottom:72px">
    <div class="container">
      <h2 class="section-title" id="lang-title">Sprache wählen</h2>
      <p class="section-sub">Fünf vollständige Sprachversionen mit allen Regionen, Unterkünften und Erlebnissen.</p>
    </div>
    <div class="lang-grid">
      {PUBLISHED.map(l => (
        <a href={l.url} class="lang-card" hreflang={l.code}>
          <span class="lang-flag">{l.flag}</span>
          <span class="lang-info">
            <span class="lang-name">{l.native}</span>
            <span class="lang-desc">{l.desc}</span>
          </span>
          <span class="lang-arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="soon-title">
    <div class="container">
      <h2 class="section-title" id="soon-title">Bald verfügbar</h2>
      <p class="section-sub">Diese Sprachen sind in Vorbereitung. Stimme ab — jede Stimme hilft uns, die nächste Sprache zu priorisieren.</p>
    </div>
    <div class="soon-grid">
      {SOON.map(l => (
        <div class="soon-card" id={`vote-${l.code}`}>
          <span class="lang-flag">{l.flag}</span>
          <span class="lang-info">
            <span class="lang-name">{l.native}<span class="soon-badge">soon</span></span>
          </span>
          <button class="vote-btn" data-lang={l.code} type="button" aria-label={`Für ${l.native} stimmen`}>
            <span class="vote-icon">👍</span>
            <span class="vote-label">+1</span>
            <span class="vote-count" data-count-for={l.code}>–</span>
          </button>
        </div>
      ))}
    </div>
  </section>

  <footer class="footer">
    <p>© 2026 tiroltourismus.com — Der smarte Tirol-Guide<br>
    <a href="https://de.tiroltourismus.com/impressum/">Impressum</a> · <a href="https://de.tiroltourismus.com/datenschutz/">Datenschutz</a></p>
  </footer>

  <script>
    // ── Vote-System (KV-backed via /api/vote, anti-collusion: IP-Hash serverseitig) ──
    (function () {
      'use strict';
      var VOTED_KEY = 'tt_lang_votes';
      var voted = {};
      try { voted = JSON.parse(localStorage.getItem(VOTED_KEY) || '{}'); } catch (e) { voted = {}; }

      function getVoted() { return voted; }
      function setVoted(code) {
        voted[code] = Date.now();
        try { localStorage.setItem(VOTED_KEY, JSON.stringify(voted)); } catch (e) {}
      }

      // Load counts
      fetch('/api/votes', { credentials: 'omit' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data || !data.counts) return;
          Object.keys(data.counts).forEach(function (code) {
            var el = document.querySelector('[data-count-for="' + code + '"]');
            if (el) el.textContent = data.counts[code];
          });
        })
        .catch(function () {});

      // Wire buttons
      document.querySelectorAll('.vote-btn').forEach(function (btn) {
        var code = btn.dataset.lang;
        if (voted[code]) {
          btn.classList.add('voted');
          btn.querySelector('.vote-label').textContent = 'Danke!';
        }
        btn.addEventListener('click', function () {
          if (btn.classList.contains('voted') || btn.disabled) return;
          btn.disabled = true;
          fetch('/api/vote', {
            method: 'POST',
            credentials: 'omit',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lang: code })
          })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
              if (res.ok && res.data && res.data.success) {
                setVoted(code);
                btn.classList.add('voted');
                btn.querySelector('.vote-label').textContent = 'Danke!';
                var el = document.querySelector('[data-count-for="' + code + '"]');
                if (el && typeof res.data.count === 'number') el.textContent = res.data.count;
              } else if (res.data && res.data.error === 'already_voted') {
                setVoted(code);
                btn.classList.add('voted');
                btn.querySelector('.vote-label').textContent = 'Danke!';
              } else {
                btn.disabled = false;
              }
            })
            .catch(function () { btn.disabled = false; });
        });
      });
    })();
  </script>
</body>
</html>
