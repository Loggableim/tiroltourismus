---
// tiroltourismus.com — Apex Sprach-Hub
// Self-contained one-screen (#sprache) language picker. 8 tiles (4x2 desktop /
// 2x4 mobile), "Recommended" badge from navigator.languages, localStorage
// "Continue in" banner. A small legal footer sits at the bottom edge.
const TILES = [
  { code: 'de', htmlLang: 'de', name: 'Deutsch',    tagline: 'Tirol entdecken',    accent: 'var(--tirol-red)',       href: 'https://de.tiroltourismus.com/' },
  { code: 'en', htmlLang: 'en', name: 'English',    tagline: 'Discover Tirol',     accent: 'var(--ikea-blue)',       href: 'https://en.tiroltourismus.com/' },
  { code: 'fr', htmlLang: 'fr', name: 'Français',   tagline: 'Découvrir le Tyrol', accent: 'var(--pop-purple)',      href: 'https://fr.tiroltourismus.com/' },
  { code: 'cs', htmlLang: 'cs', name: 'Čeština',    tagline: 'Objevte Tyrolsko',   accent: 'var(--pop-green)',       href: 'https://cs.tiroltourismus.com/' },
  { code: 'nl', htmlLang: 'nl', name: 'Nederlands', tagline: 'Ontdek Tirol',       accent: 'var(--pop-orange)',      href: 'https://nl.tiroltourismus.com/' },
  { code: 'it', htmlLang: 'it', name: 'Italiano',   tagline: 'Scopri il Tirolo',   accent: 'var(--tirol-pink-dark)', href: 'https://it.tiroltourismus.com/' },
  { code: 'es', htmlLang: 'es', name: 'Español',    tagline: 'Descubre el Tirol',  accent: 'var(--gold)',            href: 'https://es.tiroltourismus.com/' },
  { code: 'zh', htmlLang: 'zh', name: '中文',        tagline: '探索蒂罗尔',         accent: 'var(--tirol-pink)',      href: 'https://cn.tiroltourismus.com/' },
];
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tirol Tourismus — Ein Land. Acht Sprachen. Alles drin.</title>
  <meta name="description" content="Tirol Tourismus: Der smarte Guide für Reiseplanung, Unterkünfte, Gastronomie und Erlebnisse in Tirol — in 8 Sprachen. 14 Regionen, über 5.200 Orte, Gastro-Adressen und Unterkünfte.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://tiroltourismus.com/">
  <link rel="alternate" href="https://de.tiroltourismus.com/" hreflang="de-AT">
  <link rel="alternate" href="https://en.tiroltourismus.com/" hreflang="en-US">
  <link rel="alternate" href="https://fr.tiroltourismus.com/" hreflang="fr-FR">
  <link rel="alternate" href="https://cs.tiroltourismus.com/" hreflang="cs-CZ">
  <link rel="alternate" href="https://nl.tiroltourismus.com/" hreflang="nl-NL">
  <link rel="alternate" href="https://it.tiroltourismus.com/" hreflang="it-IT">
  <link rel="alternate" href="https://es.tiroltourismus.com/" hreflang="es-ES">
  <link rel="alternate" href="https://cn.tiroltourismus.com/" hreflang="zh-CN">
  <link rel="alternate" href="https://tiroltourismus.com/" hreflang="x-default">
  <meta property="og:title" content="Tirol Tourismus — Ein Land. Acht Sprachen. Alles drin.">
  <meta property="og:description" content="14 Regionen, über 5.200 Orte, Gastro-Adressen und Unterkünfte — in 8 Sprachen.">
  <meta property="og:url" content="https://tiroltourismus.com/">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://tiroltourismus.com/images/og-default.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Tirol Tourismus">
  <meta property="og:locale" content="de_AT">
  <meta name="theme-color" content="#000000">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Tirol Tourismus — Ein Land. Acht Sprachen. Alles drin.">
  <meta name="twitter:description" content="14 Regionen, über 5.200 Orte, Gastro-Adressen und Unterkünfte — in 8 Sprachen.">
  <meta name="twitter:image" content="https://tiroltourismus.com/images/og-default.jpg">
  <link rel="icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Tirol Tourismus",
    "url": "https://tiroltourismus.com",
    "description": "Der smarte Tirol-Guide für Reiseplanung, Unterkünfte und Erlebnisse — in 8 Sprachen.",
    "inLanguage": "de",
    "hasPart": [
      {"@type": "WebSite", "name": "Tirol Tourismus Deutsch", "url": "https://de.tiroltourismus.com", "inLanguage": "de"},
      {"@type": "WebSite", "name": "Tirol Tourismus English", "url": "https://en.tiroltourismus.com", "inLanguage": "en"},
      {"@type": "WebSite", "name": "Tirol Tourismus Français", "url": "https://fr.tiroltourismus.com", "inLanguage": "fr"},
      {"@type": "WebSite", "name": "Tirol Tourismus Čeština", "url": "https://cs.tiroltourismus.com", "inLanguage": "cs"},
      {"@type": "WebSite", "name": "Tirol Tourismus Nederlands", "url": "https://nl.tiroltourismus.com", "inLanguage": "nl"},
      {"@type": "WebSite", "name": "Tirol Tourismus Italiano", "url": "https://it.tiroltourismus.com", "inLanguage": "it"},
      {"@type": "WebSite", "name": "Tirol Tourismus Español", "url": "https://es.tiroltourismus.com", "inLanguage": "es"},
      {"@type": "WebSite", "name": "Tirol Tourismus 中文", "url": "https://cn.tiroltourismus.com", "inLanguage": "zh"}
    ]
  }
  </script>
  <style is:global>
    :root {
      --bg: #0B0F14; --bg2: #131A22;
      --surface: rgba(255,255,255,.06); --surface-hover: rgba(255,255,255,.12);
      --text: #F5F3F0; --text2: rgba(255,255,255,.78); --text3: rgba(255,255,255,.5);
      --tirol-red: #C8102E;
      --tirol-pink: #FF1493; --tirol-pink-dark: #C0006E; --tirol-pink-glow: rgba(255,20,147,.35);
      --ikea-blue: #4A90E2;
      --pop-green: #00C853; --pop-orange: #FF6B35; --pop-purple: #8B5CF6;
      --gold: #E0B72C; --gold-soft: rgba(224,183,44,.16);
      --glass-border: rgba(255,255,255,.16);
      --font-display: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
      --font-body: 'Montserrat', system-ui, sans-serif;
      --ease: cubic-bezier(.16,1,.3,1);
      --radius: 14px;
    }
    *,*::before,*::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow: hidden;
    }
    a { color: inherit; text-decoration: none; }
    a:focus-visible, button:focus-visible { outline: 3px solid var(--tirol-pink); outline-offset: 3px; }

    /* ─── Full-viewport hero ─── */
    .df-picker {
      position: relative;
      height: 100dvh;
      min-height: 100dvh;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg);
      isolation: isolate;
    }
    .df-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 42%;
      z-index: 0;
    }
    .df-scrim {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(180deg, rgba(7,10,15,.74) 0%, rgba(7,10,15,.46) 40%, rgba(7,10,15,.86) 100%),
        radial-gradient(90% 70% at 50% 8%, rgba(7,10,15,.15), rgba(7,10,15,.72) 100%);
    }
    .df-content {
      position: relative;
      z-index: 2;
      width: min(1140px, 100%);
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(12px, 2.2vh, 30px);
      padding: clamp(16px, 3.6vh, 40px) clamp(16px, 5vw, 56px) clamp(32px, 5.2vh, 50px);
    }

    /* ─── "Continue in" banner ─── */
    .df-banner {
      position: absolute;
      top: clamp(12px, 2.6vh, 26px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 5;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: clamp(5px, 1vh, 9px) clamp(12px, 2vw, 20px);
      border-radius: 100px;
      background: var(--tirol-pink-dark);
      color: #fff;
      font-size: clamp(11px, 1.5vh, 13px);
      font-weight: 700;
      letter-spacing: .3px;
      box-shadow: 0 10px 30px rgba(0,0,0,.45);
    }
    .df-banner[hidden] { display: none; }
    .df-banner:hover { filter: brightness(1.08); }

    /* ─── Header ─── */
    .df-head {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(4px, 1vh, 12px);
      text-align: center;
    }
    .df-brand { display: inline-flex; line-height: 0; }
    .df-brand svg { width: clamp(118px, 15vw, 168px); height: auto; filter: drop-shadow(0 4px 18px rgba(0,0,0,.55)); }
    .df-brand svg text, .df-brand svg circle { fill: #fff; }
    .df-claim {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(50px, 10.4vh, 118px);
      line-height: .9;
      letter-spacing: .02em;
      text-transform: uppercase;
      text-shadow: 0 8px 44px rgba(0,0,0,.55);
    }
    .df-claim em { font-style: normal; color: var(--gold); }
    .df-sub {
      font-size: clamp(11px, 1.7vh, 15px);
      color: var(--text2);
      max-width: 56ch;
      text-wrap: balance;
    }

    /* ─── Language tiles: slim, compact ─── */
    .df-langs {
      flex: 0 1 auto;
      min-height: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: clamp(8px, 1.1vw, 14px);
      margin: 0;
    }
    .df-tile {
      position: relative;
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1px;
      padding: clamp(9px, 1.6vh, 15px) clamp(30px, 3vw, 40px) clamp(9px, 1.6vh, 15px) clamp(15px, 1.7vw, 20px);
      border: 1px solid var(--glass-border);
      border-left: 3px solid var(--accent);
      border-radius: var(--radius);
      background: rgba(12,16,22,.42);
      backdrop-filter: blur(9px);
      -webkit-backdrop-filter: blur(9px);
      color: #fff;
      overflow: hidden;
      transition: transform .25s var(--ease), box-shadow .25s var(--ease), border-color .25s var(--ease), background .25s var(--ease);
    }
    .df-tile::after {
      content: '→';
      position: absolute;
      right: clamp(11px, 1.4vw, 16px);
      top: 50%;
      transform: translateY(-50%);
      font-size: clamp(12px, 1.6vh, 16px);
      color: rgba(255,255,255,.5);
      transition: transform .25s var(--ease), color .25s var(--ease);
    }
    .df-tile:hover {
      transform: translateY(-3px);
      border-color: var(--accent);
      background: rgba(18,24,32,.6);
      box-shadow: 0 16px 40px rgba(0,0,0,.42);
    }
    .df-tile:hover::after { transform: translate(3px, -50%); color: #fff; }
    .df-name {
      font-family: var(--font-display);
      font-size: clamp(18px, 2.5vh, 27px);
      line-height: 1.02;
      letter-spacing: .6px;
    }
    .df-tile[lang="zh"] .df-name { letter-spacing: 4px; }
    .df-tagline {
      font-size: clamp(9.5px, 1.35vh, 12px);
      line-height: 1.2;
      color: rgba(255,255,255,.72);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .df-tile.recommended {
      border-color: var(--gold);
      box-shadow: 0 0 0 1px var(--gold), 0 12px 34px rgba(0,0,0,.4);
    }
    .df-rec {
      position: absolute;
      top: 0;
      right: 0;
      display: none;
      align-items: center;
      padding: 2px 8px 3px;
      border-bottom-left-radius: 8px;
      background: var(--gold);
      color: #1A1A1A;
      font-size: clamp(7.5px, 1vh, 9.5px);
      font-weight: 700;
      letter-spacing: .5px;
      text-transform: uppercase;
    }
    .df-tile.recommended .df-rec { display: inline-flex; }

    /* ─── Legal footer: small, muted, pinned to the bottom edge ─── */
    .df-foot {
      position: absolute;
      left: 50%;
      bottom: clamp(7px, 1.4vh, 14px);
      transform: translateX(-50%);
      z-index: 3;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: max-content;
      max-width: calc(100% - 24px);
      font-size: 12px;
      line-height: 1.2;
      color: rgba(255,255,255,.64);
      text-align: center;
    }
    .df-foot a { color: rgba(255,255,255,.64); transition: color .2s var(--ease); }
    .df-foot a:hover { color: #fff; }
    .df-sep { color: rgba(255,255,255,.34); }

    @media (max-width: 760px) {
      .df-langs {
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(8px, 2.2vw, 12px);
      }
      .df-claim { font-size: clamp(46px, 9.4vh, 88px); }
    }
    /* Guarantee the one-screen fit on short / small devices. */
    @media (max-height: 620px) { .df-sub { display: none; } }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .df-tile, .df-tile::after, .df-foot a { transition: none; }
    }
  </style>
</head>
<body>
  <section id="sprache" class="df-picker" aria-label="Sprachauswahl">
    <img class="df-bg" src="/hero-tirol.jpg" alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
    <div class="df-scrim" aria-hidden="true"></div>

    <a class="df-banner" id="dfContinueBanner" href="https://de.tiroltourismus.com/" hidden>
      <span>Weiter auf</span> <span id="dfContinueLang"></span> <span aria-hidden="true">→</span>
    </a>

    <div class="df-content">
      <header class="df-head">
        <a class="df-brand" href="https://tiroltourismus.com/" aria-label="Tirol Tourismus">
          <svg viewBox="0 2 375 46" role="img" aria-label="Tirol Tourismus">
            <text x="14" y="38" font-family="'Bebas Neue','Impact',sans-serif" font-size="36" font-weight="bold">T</text>
            <text x="46" y="38" font-family="'Bebas Neue','Impact',sans-serif" font-size="36" font-weight="bold">I</text>
            <text x="72" y="38" font-family="'Bebas Neue','Impact',sans-serif" font-size="36" font-weight="bold">R</text>
            <text x="104" y="38" font-family="'Bebas Neue','Impact',sans-serif" font-size="36" font-weight="bold">O</text>
            <text x="138" y="38" font-family="'Bebas Neue','Impact',sans-serif" font-size="36" font-weight="bold">L</text>
            <circle cx="178" cy="30" r="2.5" style="fill:rgba(255,255,255,.35)"/>
            <text x="192" y="38" font-family="'Montserrat',sans-serif" font-size="28" font-weight="300" letter-spacing="0.8">tourismus</text>
          </svg>
        </a>
        <h1 class="df-claim">Tirol<em>.</em></h1>
        <p class="df-sub">Ein Land. Acht Sprachen. Alles drin — wähle deine Sprache und entdecke Tirol auf einer Seite.</p>
      </header>

      <main class="df-langs" aria-label="Sprachauswahl">
        {TILES.map((t) => (
          <a class="df-tile" href={t.href} lang={t.htmlLang} data-lang={t.code} style={`--accent:${t.accent}`}>
            <span class="df-rec" aria-hidden="true">Empfohlen</span>
            <span class="df-name">{t.name}</span>
            <span class="df-tagline">{t.tagline}</span>
          </a>
        ))}
      </main>
    </div>

    <footer class="df-foot" aria-label="Rechtliches">
      <a id="dfImprint" href="https://de.tiroltourismus.com/impressum/">Impressum</a>
      <span class="df-sep" aria-hidden="true">·</span>
      <a id="dfPrivacy" href="https://de.tiroltourismus.com/datenschutz/">Datenschutz</a>
      <span class="df-sep" aria-hidden="true">·</span>
      <span>© tiroltourismus</span>
    </footer>
  </section>

  <script is:inline>
    (function () {
      'use strict';
      var STORE = 'tirol-demo-lang';
      var tiles = {};
      var NAMES = {};
      document.querySelectorAll('.df-tile[data-lang]').forEach(function (a) {
        var code = a.getAttribute('data-lang');
        tiles[code] = a;
        var nameEl = a.querySelector('.df-name');
        NAMES[code] = nameEl ? nameEl.textContent.trim() : code;
      });

      var FOOTER = {
        de: ['Impressum', 'Datenschutz'],
        en: ['Legal notice', 'Privacy'],
        fr: ['Mentions légales', 'Confidentialité'],
        cs: ['Tiráž', 'Ochrana soukromí'],
        nl: ['Colofon', 'Privacy'],
        it: ['Note legali', 'Privacy'],
        es: ['Aviso legal', 'Privacidad'],
        zh: ['法律声明', '隐私']
      };

      function normalize(tag) {
        tag = String(tag || '').toLowerCase();
        if (!tag) return null;
        var base = tag.split('-')[0];
        return tiles[base] ? base : null;
      }

      // 1) Recommend the browser language (no auto redirect)
      var langs = [];
      try { langs = navigator.languages || [navigator.language]; } catch (e) {}
      var match = null;
      for (var i = 0; i < langs.length && !match; i++) match = normalize(langs[i]);
      if (match) {
        tiles[match].classList.add('recommended');
        tiles[match].setAttribute('aria-current', 'true');
        var labels = FOOTER[match];
        var imp = document.getElementById('dfImprint');
        var priv = document.getElementById('dfPrivacy');
        if (labels) {
          if (imp) imp.textContent = labels[0];
          if (priv) priv.textContent = labels[1];
        }
      }

      // 2) Return visit → "Continue in <language> →"
      var saved = null;
      try { saved = localStorage.getItem(STORE); } catch (e) {}
      if (saved && tiles[saved]) {
        var banner = document.getElementById('dfContinueBanner');
        var label = document.getElementById('dfContinueLang');
        if (banner && label) {
          label.textContent = NAMES[saved] || saved;
          banner.setAttribute('href', tiles[saved].getAttribute('href'));
          banner.hidden = false;
        }
      }

      // 3) Save the chosen language on click
      Object.keys(tiles).forEach(function (code) {
        tiles[code].addEventListener('click', function () {
          try { localStorage.setItem(STORE, code); } catch (e) {}
        });
      });
    })();
  </script>
</body>
</html>
