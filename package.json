{
  "name": "tiroltourismus",
  "version": "2.0.0",
  "description": "Tirol Tourismus Portal \u2014 JSON-driven, Astro 5",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build:search-index": "node scripts/build-search-index.mjs",
    "build:image-variants": "node scripts/generate-hero-variants.mjs",
    "build:astro": "astro build",
    "build": "npm run build:search-index && npm run build:astro",
    "build:ci": "npm run build",
    "preview": "astro preview",
    "test:content": "node --test src/lib/content.test.js",
    "check:chrono-contrast": "node scripts/check-chronochrom-contrast.mjs",
    "check:chrono-live": "node scripts/check-chronochrom-live.mjs",
    "check:content": "node scripts/check-content-gate.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.18.1",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.32.0",
    "marked": "^18.0.3",
    "minisearch": "^7.1.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "sharp": "^0.34.5"
  }
}
