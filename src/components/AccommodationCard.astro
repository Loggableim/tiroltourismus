---
import FavHeart from './FavHeart.astro';
import PremiumBadge from './PremiumBadge.astro';
export interface Props {
  name: string;
  slug: string;
  typ?: string;
  ort?: string;
  sterne?: number;
  preis_ab?: number;
  tier?: string;
  'data-tier'?: string;
}
const { name, slug, typ, ort, sterne = 3, preis_ab, tier = 'basic', 'data-tier': dataTier } = Astro.props;
const isCamping = typ === 'camping';
const typLabel = { hotel: 'Hotel', ferienwohnung: 'Ferienwohnung', bauernhof: 'Bauernhof', jugendherberge: 'Jugendherberge', camping: 'Camping' };
const placeholderIcon = isCamping ? '🏕️' : '🏨';
// Badge handled by PremiumBadge component
---
<a href={`/unterkuenfte/${slug}/`} class="uk-card" data-filter-card data-filter-tier={dataTier || tier || 'basic'} data-filter-typ={typ || 'unknown'} data-collection="unterkuenfte" data-slug={slug}>
  <div class="uk-img" style="position:relative">
    <PremiumBadge tier={tier} />
    {isCamping && <span class="uk-camping-badge">⛺</span>}
    <span class="uk-placeholder">{placeholderIcon}</span>
    <FavHeart collection="unterkuenfte" slug={slug} />
  </div>
  <div class="uk-body">
    <div class="uk-type">{typLabel[typ] || typ || 'Unterkunft'}</div>
    <div class="uk-name">{name}</div>
    <div class="uk-ort">{ort || 'Tirol'}</div>
    {!isCamping && <div class="uk-stars">{'★'.repeat(sterne)}</div>}
    {isCamping && <div class="uk-camping-info">Zelt • Wohnmobil • Wohnwagen</div>}
    <div class="uk-meta">
      {preis_ab ? <span class="uk-price">ab {preis_ab}€<small>/Nacht</small></span> : <span class="uk-na">{isCamping ? 'Stellplatz' : 'Preis auf Anfrage'}</span>}
    </div>
    <span class="uk-cta">Details →</span>
  </div>
</a>

<style is:global>
  .uk-card{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.012));border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-lg);overflow:hidden;transition:transform .35s var(--ease),border-color .35s var(--ease),box-shadow .35s var(--ease),background .35s var(--ease);display:flex;flex-direction:column;box-shadow:0 12px 30px rgba(0,0,0,.06);backdrop-filter:blur(10px)}
  .uk-card:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.18);box-shadow:0 18px 44px rgba(0,0,0,.12)}
  .uk-img{position:relative;height:150px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,rgba(255,255,255,.035),rgba(255,255,255,.015))}
  .badge-gold{position:absolute;top:12px;left:12px;padding:4px 12px;border-radius:100px;font-size:10px;font-weight:700;background:linear-gradient(135deg,var(--yellow),#F59E0B);color:#1a1a1a;box-shadow:0 4px 12px rgba(255,215,0,.14)}
  .badge-silver{position:absolute;top:12px;left:12px;padding:4px 12px;border-radius:100px;font-size:10px;font-weight:700;background:linear-gradient(135deg,var(--green),#059669);color:#fff;box-shadow:0 4px 12px rgba(0,200,83,.12)}
  .uk-placeholder{font-size:48px;color:var(--text3);filter:drop-shadow(0 8px 18px rgba(0,0,0,.16))}
  .uk-camping-badge{position:absolute;top:12px;left:62px;padding:4px 8px;border-radius:100px;font-size:10px;font-weight:700;background:rgba(0,200,83,.15);color:var(--pop-green)}
  .uk-camping-info{font-size:11px;color:var(--pop-green);font-weight:600;letter-spacing:.3px;margin-bottom:8px}
  .uk-body{padding:18px 20px 22px;flex:1;display:flex;flex-direction:column}
  .uk-type{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text3);margin-bottom:4px}
  .uk-name{font-family:var(--font-display);font-size:22px;line-height:1.08;letter-spacing:.35px;margin-bottom:2px;color:var(--text)}
  .uk-ort{font-size:12px;color:var(--text2);margin-bottom:8px}
  .uk-stars{color:var(--yellow);font-size:13px;letter-spacing:2px;margin-bottom:8px}
  .uk-meta{display:flex;align-items:center;justify-content:center;margin-top:auto;padding-top:12px;border-top:1px solid rgba(255,255,255,.08)}
  .uk-price{font-size:18px;font-weight:800;color:var(--text)}
  .uk-price small{font-size:11px;font-weight:400;color:var(--text2)}
  .uk-na{font-size:12px;color:var(--text3)}
  .uk-cta{display:block;width:100%;padding:12px;margin-top:14px;border-radius:100px;background:var(--pink);color:#fff;font-size:12px;font-weight:700;text-transform:uppercase;text-align:center;transition:all .3s}
  .uk-cta:hover{background:var(--pink-dark);transform:translateY(-2px)}
  @media(max-width:600px){
    .uk-img{height:130px}
    .uk-name{font-size:19px}
    .uk-body{padding:16px 18px 18px}
    .uk-cta{padding:11px}
  }
  @media(max-width:480px){
    .uk-img{height:110px}
    .uk-name{font-size:17px}
    .uk-body{padding:12px}
    .uk-cta{padding:10px}
  }
</style>
