---
import FavHeart from './FavHeart.astro';
export interface Props {
  titel: string;
  slug: string;
  teaser?: string;
  datum?: string;
  kategorie?: string;
  emoji?: string;
  hero_bild?: string;
}
const { titel, slug, teaser, datum, kategorie, emoji = '📰', hero_bild } = Astro.props;
---
<a href={`/magazin/${slug}/`} class="article-card" data-collection="magazin" data-slug={slug}>
  <div class="article-img" style="position:relative">
    {hero_bild ? (
      <img src={hero_bild} alt={titel} class="article-thumb" loading="lazy" decoding="async" width="420" height="240" />
    ) : (
      <span style="font-size:56px;line-height:1">{emoji}</span>
    )}
    <FavHeart collection="magazin" slug={slug} />
  </div>
  <div class="article-body">
    {kategorie && <span class="article-tag">{kategorie}</span>}
    {datum && <div class="article-date">{datum}</div>}
    <h3>{titel}</h3>
    {teaser && <p>{teaser}</p>}
    <span class="article-link">Weiterlesen →</span>
  </div>
</a>

<style is:global>
  .article-card{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.012));border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-lg);overflow:hidden;transition:transform .35s var(--ease),border-color .35s var(--ease),box-shadow .35s var(--ease),background .35s var(--ease);display:flex;flex-direction:column;box-shadow:0 12px 30px rgba(0,0,0,.06);backdrop-filter:blur(10px);content-visibility:auto;contain-intrinsic-size:360px 430px}
  .article-card:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.18);box-shadow:0 18px 44px rgba(0,0,0,.12)}
  .article-img{height:170px;display:flex;align-items:center;justify-content:center;font-size:56px;background:linear-gradient(135deg,rgba(255,255,255,.03),rgba(255,255,255,.012));overflow:hidden;position:relative}
  .article-thumb{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s var(--ease)}
  .article-card:hover .article-thumb{transform:scale(1.06)}
  .article-card .fav-heart{position:absolute;top:10px;right:10px;font-size:20px;z-index:2;background:rgba(0,0,0,.35);width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);transition:background .3s}
  .article-card .fav-heart:hover{background:rgba(0,0,0,.6)}
  .article-body{padding:22px;flex:1;display:flex;flex-direction:column}
  .article-tag{display:inline-block;padding:3px 12px;border-radius:100px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.55px;background:rgba(255,255,255,.08);color:var(--text2);margin-bottom:6px;width:fit-content}
  .article-date{font-size:11px;color:var(--text3);margin-bottom:6px}
  .article-body h3{font-family:var(--font-display);font-size:22px;line-height:1.12;letter-spacing:.25px;margin-bottom:8px;color:var(--text)}
  .article-body p{font-size:14px;color:var(--text2);line-height:1.72;flex:1;margin-bottom:12px}
  .article-link{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--pink);margin-top:auto;display:inline-flex;align-items:center;gap:4px;transition:all .3s}
  .article-link:hover{gap:8px}
  @media(max-width:600px){
    .article-img{height:150px}
    .article-body h3{font-size:19px}
    .article-body{padding:18px 18px 16px}
  }
  @media(max-width:480px){
    .article-img{height:130px}
    .article-body h3{font-size:17px}
    .article-body{padding:14px}
  }
</style>
