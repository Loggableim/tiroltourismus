---
import FavHeart from './FavHeart.astro';
export interface Props {
  titel: string;
  slug: string;
  teaser?: string;
  datum?: string;
  kategorie?: string;
  emoji?: string;
}
const { titel, slug, teaser, datum, kategorie, emoji = '📰' } = Astro.props;
---
<a href={`/magazin/${slug}/`} class="article-card" data-collection="magazin" data-slug={slug}>
  <div class="article-img" style="position:relative">{emoji}<FavHeart collection="magazin" slug={slug} /></div>
  <div class="article-body">
    {kategorie && <span class="article-tag">{kategorie}</span>}
    {datum && <div class="article-date">{datum}</div>}
    <h3>{titel}</h3>
    {teaser && <p>{teaser}</p>}
    <span class="article-link">Weiterlesen →</span>
  </div>
</a>

<style is:global>
  .article-card{background:var(--bg2);border:1px solid var(--glass-border);border-radius:var(--radius-lg);overflow:hidden;transition:all .4s var(--ease);display:flex;flex-direction:column}
  .article-card:hover{transform:translateY(-5px);border-color:var(--pink);box-shadow:0 16px 48px rgba(0,0,0,.08)}
  .article-img{height:160px;display:flex;align-items:center;justify-content:center;font-size:56px;background:linear-gradient(135deg,var(--surface),var(--surface-hover))}
  .article-body{padding:20px;flex:1;display:flex;flex-direction:column}
  .article-tag{display:inline-block;padding:3px 12px;border-radius:100px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;background:rgba(255,20,147,.12);color:var(--pink);margin-bottom:6px;width:fit-content}
  .article-date{font-size:11px;color:var(--text3);margin-bottom:6px}
  .article-body h3{font-family:var(--font-display);font-size:22px;line-height:1.15;letter-spacing:.3px;margin-bottom:8px;color:var(--text)}
  .article-body p{font-size:13px;color:var(--text2);line-height:1.6;flex:1;margin-bottom:12px}
  .article-link{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--pink);margin-top:auto;display:inline-flex;align-items:center;gap:4px;transition:all .3s}
  .article-link:hover{gap:8px}
  @media(max-width:600px){
    .article-img{height:140px}
    .article-body h3{font-size:20px}
    .article-body{padding:16px 18px}
  }
  @media(max-width:480px){
    .article-img{height:120px}
    .article-body h3{font-size:18px}
    .article-body{padding:14px}
  }
</style>
