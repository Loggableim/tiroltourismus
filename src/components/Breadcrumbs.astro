---
import { plainText } from '../lib/richtext.js';
import { localePrefix as localePrefixFn } from '../lib/languages.js';
export interface Props {
  items: Array<{ label: string; href?: string }>;
  /** Optional locale for localized "Home" label and link prefix. */
  locale?: string;
}
const { items, locale = undefined } = Astro.props;
const itemList = Array.isArray(items) ? items : [];
// Lokalisierte "Startseite"-Labels
const HOME_LABEL = { de: 'Startseite', en: 'Home', fr: 'Accueil', cs: 'Domů', nl: 'Home', it: 'Home', es: 'Inicio', zh: '首页' };
const homeLabel = HOME_LABEL[locale] || HOME_LABEL.de;
const all = [{ label: homeLabel, href: localePrefixFn(locale) || '/' }, ...itemList.map(i => ({ ...i, label: plainText(i?.label ?? '') }))];
---
<div class="breadcrumbs container">
  {all.map((item, i) => (
    <>
      {i > 0 && <span class="sep">›</span>}
      {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
    </>
  ))}
</div>
