---
export interface Props {
  items: Array<{ label: string; href?: string }>;
}
const { items } = Astro.props;
const all = [{ label: 'Startseite', href: '/' }, ...items];
---
<div class="breadcrumbs container">
  {all.map((item, i) => (
    <>
      {i > 0 && <span class="sep">›</span>}
      {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
    </>
  ))}
</div>

<style is:global>
  .breadcrumbs{display:flex;align-items:center;gap:8px;padding:12px 0;font-size:12px;color:var(--text3);flex-wrap:wrap}
  .breadcrumbs a{color:var(--text2);transition:color .2s}
  .breadcrumbs a:hover{color:var(--pink)}
  .breadcrumbs .sep{color:var(--text3);font-size:10px}
</style>
