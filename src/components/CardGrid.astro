---
export interface Props {
  items: Array<{ slug?: string; entry: Record<string, any> }>;
  columns?: 2 | 3 | 4;
  component: string;
}

const { items, columns = 3 } = Astro.props;
const gridClass = `grid-${columns}`;
---
{items && items.length > 0 && (
  <div class={gridClass}>
    <slot name="before" />
    {items.map((item) => (
      <slot name="card" slot={item} />
    ))}
  </div>
)}

<style is:global>
  .grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  @media(max-width:968px){.grid-4{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:768px){.grid-3,.grid-4{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:550px){.grid-2,.grid-3,.grid-4{grid-template-columns:1fr}}
</style>
