---
export interface Props {
  icon?: string;
  title: string;
  description: string;
}

const { icon = '✨', title, description } = Astro.props as Props;
---

<section class="empty-state">
  <div class="container empty-state__inner">
    <div class="empty-state__icon">{icon}</div>
    <h2 class="empty-state__title">{title}</h2>
    <p class="empty-state__text" set:html={description}></p>
    <div class="empty-state__actions">
      <slot name="actions" />
    </div>
  </div>
</section>

<style>
  .empty-state {
    padding: 30px 0 0;
  }

  .empty-state__inner {
    text-align: center;
    padding: 60px 0;
  }

  .empty-state__icon {
    font-size: 64px;
    margin-bottom: 16px;
    line-height: 1;
  }

  .empty-state__title {
    font-family: var(--font-display);
    font-size: 32px;
    margin-bottom: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .empty-state__text {
    color: var(--text2);
    max-width: 420px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .empty-state__actions {
    margin-top: 20px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
