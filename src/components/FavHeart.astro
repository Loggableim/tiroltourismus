---
import type { Props as FavProps } from './FavHeart.astro';
export interface Props {
  collection: string;
  slug: string;
}
const { collection, slug } = Astro.props;
---
<span class="fav-heart" data-collection={collection} data-slug={slug}
      onclick="event.preventDefault();event.stopPropagation();window.toggleFav(this)">
  ♡
</span>
