---
export interface FilterOption {
  value: string;
  label: string;
}

export interface Props {
  keyName: string;
  options: FilterOption[];
  allLabel?: string;
  allValue?: string;
  ariaLabel?: string;
  compact?: boolean;
  class?: string;
  /** Optional locale for localized default labels. */
  locale?: string;
}

// Lokalisierte "Alle"-Labels
const ALL_LABEL = { de: 'Alle', en: 'All', fr: 'Tous', cs: 'Vše', nl: 'Alle', it: 'Tutti', es: 'Todos', zh: '全部' };
const FILTER_LABEL = { de: 'filtern', en: 'filter', fr: 'filtrer', cs: 'filtrovat', nl: 'filteren', it: 'filtrare', es: 'filtrar', zh: '筛选' };

const {
  keyName,
  options,
  allLabel,
  allValue = 'all',
  ariaLabel,
  compact = false,
  class: className,
  locale = undefined,
} = Astro.props;
const resolvedAllLabel = allLabel || ALL_LABEL[locale] || ALL_LABEL.de;
const resolvedAriaLabel = ariaLabel || `${keyName} ${FILTER_LABEL[locale] || FILTER_LABEL.de}`;
---
<div
  class:list={['filter-bar', compact && 'filter-bar--compact', className]}
  data-filter-bar
  data-filter-key={keyName}
  data-filter-all={allValue}
  aria-label={resolvedAriaLabel}
>
  <button type="button" class="filter-pill active" data-filter-value={allValue}>{resolvedAllLabel}</button>
  {options.map((option) => (
    <button type="button" class="filter-pill" data-filter-value={option.value}>
      {option.label}
    </button>
  ))}
</div>

<style is:global>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 28px;
  }
  .filter-pill {
    appearance: none;
    -webkit-appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 14px;
    border: 1px solid rgba(0, 0, 0, .3);
    border-radius: 999px;
    background: var(--surface, rgba(0, 0, 0, .04));
    color: var(--text, #1a1a1a);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background .2s var(--ease, ease), color .2s var(--ease, ease), border-color .2s var(--ease, ease), box-shadow .2s var(--ease, ease);
  }
  @supports (border-color: color-mix(in srgb, red 30%, transparent)) {
    .filter-pill {
      border-color: color-mix(in srgb, currentColor 30%, transparent);
    }
  }
  .filter-bar--compact .filter-pill {
    padding: 6px 12px;
    font-size: 13px;
  }
  .filter-pill:hover {
    background: var(--surface-hover, rgba(0, 0, 0, .06));
    color: var(--text, #1a1a1a);
    border-color: color-mix(in srgb, currentColor 55%, transparent);
  }
  .filter-pill:focus-visible {
    outline: 2px solid var(--tirol-pink-dark, #c0006e);
    outline-offset: 2px;
  }
  .filter-pill.active {
    background: var(--tirol-pink-dark, #c0006e);
    border-color: var(--tirol-pink-dark, #c0006e);
    color: #fff;
    font-weight: 700;
  }
  .filter-pill.active:hover {
    background: var(--tirol-pink-dark, #c0006e);
    border-color: var(--tirol-pink-dark, #c0006e);
    color: #fff;
  }
  @media (max-width: 600px) {
    .filter-bar { gap: 8px; }
    .filter-pill { padding: 8px 12px; font-size: 13px; }
  }
</style>

<script>
  {
    function applyFilters() {
      var selected = {};
      document.querySelectorAll('[data-filter-bar]').forEach(function (bar) {
        var key = bar.getAttribute('data-filter-key');
        if (!key) return;
        var all = bar.getAttribute('data-filter-all') || 'all';
        var active = bar.querySelector('.filter-pill.active');
        selected[key] = {
          value: (active && active.getAttribute('data-filter-value')) || all,
          all: all,
        };
      });
      document.querySelectorAll('[data-filter-card]').forEach(function (card) {
        var visible = true;
        Object.keys(selected).forEach(function (key) {
          if (!visible) return;
          var state = selected[key];
          if (!state.value || state.value === state.all) return;
          if ((card.getAttribute('data-filter-' + key) || '') !== state.value) visible = false;
        });
        card.style.display = visible ? '' : 'none';
      });
    }

    document.addEventListener('click', function (event) {
      var target = event.target;
      var pill = target && target.closest ? target.closest('.filter-pill') : null;
      if (!pill) return;
      var bar = pill.closest('[data-filter-bar]');
      if (!bar) return;
      bar.querySelectorAll('.filter-pill').forEach(function (p) {
        p.classList.toggle('active', p === pill);
      });
      applyFilters();
    });
  }
</script>
