---
export interface Props {
  name: string;
  slug: string;
  beschreibung?: string;
  kategorie?: string;
  preis?: string;
  emoji?: string;
  farbe?: string;
  ort?: string;
}
const { name, slug, beschreibung, kategorie, preis, emoji = '🍽️', farbe = '#FF6B35', ort } = Astro.props;
---
<a href={`/gastro/${slug}/`} class="gastro-card">
  <div class="gastro-card-img" style={`background:${farbe}20`}>
    <span class="gastro-emoji">{emoji}</span>
  </div>
  <div class="gastro-body">
    <div class="gastro-type">{kategorie || 'Kulinarik'}</div>
    <h3>{name}</h3>
    {ort && <div class="gastro-ort">{ort}</div>}
    {beschreibung && <p>{beschreibung}</p>}
    <div class="gastro-meta">
      {preis && <span class="gastro-preis">{preis}</span>}
      <span class="gastro-link">Details →</span>
    </div>
  </div>
</a>

<style is:global>
  .gastro-card{background:var(--bg2);border:1px solid var(--glass-border);border-radius:var(--radius-lg);overflow:hidden;transition:all .4s var(--ease);display:flex;flex-direction:column}
  .gastro-card:hover{transform:translateY(-4px);border-color:var(--pink)}
  .gastro-card-img{height:100px;display:flex;align-items:center;justify-content:center;font-size:40px}
  .gastro-emoji{font-size:40px}
  .gastro-body{padding:16px 20px 20px;flex:1;display:flex;flex-direction:column}
  .gastro-type{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text3);margin-bottom:2px}
  .gastro-body h3{font-family:var(--font-display);font-size:22px;letter-spacing:1px;text-transform:uppercase;margin-bottom:2px;color:var(--text)}
  .gastro-ort{font-size:12px;color:var(--text2);margin-bottom:6px}
  .gastro-body p{font-size:13px;color:var(--text2);line-height:1.5;flex:1;margin-bottom:10px}
  .gastro-meta{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:10px;border-top:1px solid var(--glass-border)}
  .gastro-preis{font-size:14px;font-weight:700;color:var(--orange)}
  .gastro-link{font-size:11px;font-weight:700;text-transform:uppercase;color:var(--pink)}
</style>
