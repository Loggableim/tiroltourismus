---
import FavHeart from './FavHeart.astro';
export interface Props {
  name: string;
  slug: string;
  beschreibung?: string;
  kategorie?: string;
  preis?: string;
  emoji?: string;
  farbe?: string;
  ort?: string;
  linkPrefix?: string;
}
const { name, slug, beschreibung, kategorie, preis, emoji = '🍽️', farbe = '#FF6B35', ort, linkPrefix = '/gastro/' } = Astro.props;
---
<a href={`${linkPrefix}${slug}/`} class="gastro-card" data-collection="gastro" data-slug={slug} data-filter-card data-filter-cat={kategorie || ''}>
  <div class="gastro-card-img" style={`position:relative;background:${farbe}20`}>
    <span class="gastro-emoji">{emoji}</span>
    <FavHeart collection="gastro" slug={slug} />
  </div>
  <div class="gastro-body">
    <div class="gastro-type">{kategorie || 'Kulinarik'}</div>
    <h3>{name}</h3>
    {ort && <div class="gastro-ort">{ort}</div>}
    {beschreibung && <p>{beschreibung}</p>}
    <div class="gastro-meta">
      {preis && <span class="gastro-preis">{preis}</span>}
      <span class="gastro-link">Details →</span>
    </div>
  </div>
</a>

<style is:global>
  .gastro-card{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.012));border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-lg);overflow:hidden;transition:transform .35s var(--ease),border-color .35s var(--ease),box-shadow .35s var(--ease),background .35s var(--ease);display:flex;flex-direction:column;box-shadow:0 12px 30px rgba(0,0,0,.06);backdrop-filter:blur(10px);content-visibility:auto;contain-intrinsic-size:330px 360px}
  .gastro-card:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.18);box-shadow:0 18px 44px rgba(0,0,0,.12)}
  .gastro-card-img{height:110px;display:flex;align-items:center;justify-content:center;font-size:40px;background:linear-gradient(135deg,rgba(255,255,255,.035),rgba(255,255,255,.015))}
  .gastro-emoji{font-size:40px;filter:drop-shadow(0 8px 18px rgba(0,0,0,.16))}
  .gastro-body{padding:18px 20px 22px;flex:1;display:flex;flex-direction:column}
  .gastro-type{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text3);margin-bottom:2px}
  .gastro-body h3{font-family:var(--font-display);font-size:22px;letter-spacing:.6px;text-transform:uppercase;margin-bottom:2px;color:var(--text)}
  .gastro-ort{font-size:12px;color:var(--text2);margin-bottom:6px}
  .gastro-body p{font-size:14px;color:var(--text2);line-height:1.68;flex:1;margin-bottom:10px}
  .gastro-meta{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:10px;border-top:1px solid rgba(255,255,255,.08)}
  .gastro-preis{font-size:14px;font-weight:700;color:var(--orange)}
  .gastro-link{font-size:11px;font-weight:700;text-transform:uppercase;color:var(--pink)}
  @media(max-width:600px){
    .gastro-card-img{height:95px}
    .gastro-body h3{font-size:19px}
    .gastro-body{padding:16px 18px 18px}
  }
  @media(max-width:480px){
    .gastro-card-img{height:80px}
    .gastro-body h3{font-size:17px}
    .gastro-body{padding:12px}
  }
</style>
