  magazin: any[];
  counts: { gastro: number; unterkuenfte: number; orte: number; sights: number; camping: number; magazin: number; erlebnisse?: number; events?: number };
  regionNames: { slug: string; name: string }[];
  /** Optional: Erlebnisse für die Onepage */
  erlebnisse?: any[];
  /** Optional: Events für die Onepage */
  events?: any[];
  /** Optional: Camping für die Onepage */
  camping?: any[];
  /** Optional: Bezirke für die Onepage */
