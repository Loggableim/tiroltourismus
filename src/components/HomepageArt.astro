<style is:global>
  /* ═══════════════════════════════════════════════════════════
     BASIS
     ═══════════════════════════════════════════════════════════ */
  .art-root{min-height:100vh;background:var(--art-bg);color:var(--art-text);font-family:var(--font-body);
    --text:var(--art-text);--text2:var(--art-text2);--text3:var(--art-text3);
    --surface:var(--art-surface);--surface-hover:var(--art-surface-hover);
    --glass-border:var(--art-border);--tirol-pink:var(--art-accent);
    --tirol-pink-dark:var(--art-accent-dark);--bg:var(--art-bg);--bg2:var(--art-bg2);
    --yellow:var(--art-gold);--gold:var(--art-gold);
  }
  .art-wrap{max-width:1240px;margin:0 auto;padding:0 24px}
  .art-hero{position:relative;overflow:hidden}
  .art-kicker{font-size:11px;font-weight:700;letter-spacing:4px;text-transform:uppercase;margin-bottom:24px;position:relative;z-index:2}
  .art-title{text-transform:uppercase;margin:0;position:relative;z-index:2}
  .art-title-line{display:block}
  .art-sub{margin-top:28px;max-width:560px;font-size:clamp(15px,1.6vw,19px);color:var(--art-text2);line-height:1.7;position:relative;z-index:2}
  .art-sub strong{color:var(--art-text);font-weight:600}
  .art-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px;position:relative;z-index:2}
  .art-btn{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border:1.5px solid var(--art-border);color:var(--art-text);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;transition:all .25s cubic-bezier(.16,1,.3,1);position:relative;z-index:2}
  .art-btn:hover{background:var(--art-text);color:var(--art-bg);transform:translateY(-2px)}
  .art-btn-primary{background:var(--art-accent);border-color:var(--art-accent);color:#fff}
  .art-btn-primary:hover{background:var(--art-accent-dark);border-color:var(--art-accent-dark);color:#fff}

  .art-deco{position:absolute;pointer-events:none;z-index:1}

  .art-divider{display:flex;justify-content:center;padding:8px 24px;color:var(--art-accent)}
  .art-divider svg{width:200px;height:14px}

  .art-section{padding:clamp(56px,9vh,110px) 0}
  .art-head{display:flex;align-items:baseline;justify-content:space-between;gap:24px;margin-bottom:clamp(28px,4vh,48px);flex-wrap:wrap}
  .art-h2{font-size:clamp(36px,5.5vw,76px);line-height:.9;letter-spacing:.02em;text-transform:uppercase;margin:0}
  .art-note{font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--art-text3)}
  .art-more{font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--art-accent);white-space:nowrap}
  .art-more:hover{text-decoration:underline}

  .art-numbers{display:grid;grid-template-columns:repeat(4,1fr);gap:3px}
  .art-num-block{padding:clamp(28px,4vw,48px) 24px;background:var(--art-surface);border:1px solid var(--art-border)}
  .art-num-val{font-size:clamp(44px,6.5vw,92px);line-height:.9;letter-spacing:.01em;color:var(--art-accent)}
  .art-num-label{font-size:11px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--art-text3);margin-top:10px}

  .art-cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}
  .art-cat-tile{display:flex;align-items:center;gap:18px;padding:24px;background:var(--art-surface);border:1px solid var(--art-border);transition:background .25s,transform .25s cubic-bezier(.16,1,.3,1)}
  .art-cat-tile:hover{background:var(--art-surface-hover);transform:translateY(-3px)}
  .art-cat-icon{font-size:32px;line-height:1}

  /* ═══ WARUM TIROL ═══ */
  .art-why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}
  .art-why-card{padding:clamp(28px,4vw,44px) 24px;background:var(--art-surface);border:1px solid var(--art-border);display:flex;flex-direction:column;gap:12px;position:relative}
  .art-why-icon{font-size:40px;line-height:1}
  .art-why-title{font-size:clamp(20px,2.2vw,28px);letter-spacing:.03em;text-transform:uppercase;margin:0;line-height:1.1}
  .art-why-desc{font-size:14px;line-height:1.7;color:var(--art-text2);margin:0;flex:1}
  .art-why-stat{font-size:clamp(28px,3.5vw,44px);font-weight:800;color:var(--art-accent);line-height:1}

  /* ═══ ERLEBNISSE ═══ */
  .art-exp-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:3px}
  .art-exp-card{display:flex;gap:18px;padding:24px;background:var(--art-surface);border:1px solid var(--art-border);transition:background .25s,transform .25s cubic-bezier(.16,1,.3,1);align-items:flex-start}
  .art-exp-card:hover{background:var(--art-surface-hover);transform:translateY(-3px)}
  .art-exp-emoji{font-size:36px;line-height:1;flex-shrink:0}
  .art-exp-body{display:flex;flex-direction:column;gap:4px;min-width:0}
  .art-exp-name{font-size:clamp(18px,2vw,24px);letter-spacing:.03em;text-transform:uppercase;line-height:1.15}
  .art-exp-ort{font-size:12px;color:var(--art-text3)}
  .art-exp-desc{font-size:13px;line-height:1.6;color:var(--art-text2)}

  /* ═══ EVENTS ═══ */
  .art-events-list{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}

  /* ═══ DESIGN-INSPIRATION ═══ */
  .art-design-section{background:var(--art-surface);border-top:1px solid var(--art-border);border-bottom:1px solid var(--art-border)}
  .art-design-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(28px,4vw,56px);align-items:start}
  .art-design-artists{display:flex;flex-direction:column;gap:10px}
  .art-design-label{font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--art-text3)}
  .art-design-names{font-size:clamp(22px,2.6vw,34px);letter-spacing:.02em;line-height:1.2;color:var(--art-accent)}
  .art-design-desc{font-size:15px;line-height:1.75;color:var(--art-text2);margin:0}
  .art-design-elements{display:flex;flex-wrap:wrap;gap:8px;align-content:flex-start}
  .art-design-chip{font-size:12px;font-weight:600;letter-spacing:.5px;padding:10px 18px;border:1px solid var(--art-border);color:var(--art-text2);transition:all .25s}
  .art-design-chip:hover{border-color:var(--art-accent);color:var(--art-accent)}
  .art-cat-info{flex:1;min-width:0}
  .art-cat-label{font-size:clamp(19px,2.1vw,27px);letter-spacing:.04em;text-transform:uppercase;line-height:1.1;display:block}
  .art-cat-count{font-size:12px;font-weight:700;letter-spacing:1.5px;color:var(--art-text3);margin-top:4px;display:block}

  .art-region-row{display:flex;flex-wrap:wrap;gap:3px}
  .art-region-chip{font-size:clamp(17px,1.9vw,25px);letter-spacing:.05em;text-transform:uppercase;padding:14px 22px;background:var(--art-surface);border:1px solid var(--art-border);transition:all .25s cubic-bezier(.16,1,.3,1)}
  .art-region-chip:hover{background:var(--art-accent);border-color:var(--art-accent);color:#fff;transform:translateY(-3px)}

  .art-card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .art-card-grid-4{grid-template-columns:repeat(4,1fr)}

  .art-footer{padding:48px 0 56px;border-top:1px solid var(--art-border);margin-top:24px}
  .art-footer-inner{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}
  .art-credit{display:flex;flex-direction:column;gap:4px}
  .art-credit-label{font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--art-text3)}
  .art-credit-text{font-size:13px;font-weight:600;color:var(--art-text2)}
  .art-landing-link{font-size:13px;font-weight:700;letter-spacing:.5px;color:var(--art-accent);border:1.5px solid var(--art-accent);padding:10px 20px;transition:all .25s}
  .art-landing-link:hover{background:var(--art-accent);color:#fff}

  /* ═══════════════════════════════════════════════════════════
     DE — Otto Grünmandl + Paul Flora
     Minimalistisch, humorvoll, dünne Linien, viel Weißraum
     ═══════════════════════════════════════════════════════════ */
  .art-de{--art-bg:#faf9f6;--art-bg2:#f2f0ea;--art-text:#1c1c1a;--art-text2:rgba(28,28,26,.62);--art-text3:rgba(28,28,26,.38);
    --art-accent:#c44536;--art-accent-dark:#9e3529;--art-gold:#8a6d1f;--art-surface:rgba(28,28,26,.028);--art-surface-hover:rgba(28,28,26,.06);--art-border:rgba(28,28,26,.14)}
  .art-de .art-hero{padding:clamp(88px,14vh,160px) 0 clamp(40px,6vh,72px)}
  .art-de .art-title{font-family:var(--font-display);font-size:clamp(60px,12vw,180px);line-height:.9;letter-spacing:.01em;font-weight:400}
  .art-de .art-title-line:last-child{transform:rotate(-1.8deg);display:inline-block;color:var(--art-accent);margin-left:.06em}
  .art-de .art-kicker{color:var(--art-accent)}
  .art-de .art-h2{font-family:var(--font-display);font-weight:400}
  .art-de .art-num-val{font-family:var(--font-display);font-weight:400}
  .art-de .art-cat-label,.art-de .art-region-chip{font-family:var(--font-display);font-weight:400}
  .art-de .art-deco-flora{right:40px;bottom:20px;width:min(36vw,420px);height:auto;color:#1c1c1a;opacity:.55}
  .art-de .art-btn{border-radius:0}
  .art-de .art-cat-tile,.art-de .art-num-block,.art-de .art-region-chip{background:transparent}
  .art-de .art-cat-tile:hover{background:rgba(28,28,26,.04)}

  /* ═══════════════════════════════════════════════════════════
     EN — Albin Egger-Lienz + Alfons Walde
     Monumental, erdig, Winterhimmel, schwere Typo
     ═══════════════════════════════════════════════════════════ */
  .art-en{--art-bg:#2b211a;--art-bg2:#33281f;--art-text:#f5f0e8;--art-text2:rgba(245,240,232,.66);--art-text3:rgba(245,240,232,.42);
    --art-accent:#a63d40;--art-accent-dark:#7f2e31;--art-gold:#c9a227;--art-surface:rgba(245,240,232,.05);--art-surface-hover:rgba(245,240,232,.1);--art-border:rgba(245,240,232,.16)}
  .art-en .art-hero{padding:clamp(96px,15vh,180px) 0 clamp(140px,22vh,260px)}
  .art-en .art-title{font-family:'Anton','Bebas Neue',sans-serif;font-size:clamp(72px,15vw,230px);line-height:.92;letter-spacing:.01em;font-weight:400;text-shadow:0 12px 60px rgba(0,0,0,.5)}
  .art-en .art-title-line:last-child{color:var(--art-gold)}
  .art-en .art-kicker{color:var(--art-gold);letter-spacing:6px}
  .art-en .art-h2{font-family:'Anton','Bebas Neue',sans-serif;font-weight:400;letter-spacing:.02em}
  .art-en .art-num-val{font-family:'Anton','Bebas Neue',sans-serif;font-weight:400;color:var(--art-gold)}
  .art-en .art-cat-label,.art-en .art-region-chip{font-family:'Anton','Bebas Neue',sans-serif;font-weight:400;letter-spacing:.03em}
  .art-en .art-deco-winter-sky{inset:0;background:linear-gradient(180deg,#1a1230 0%,#3d1f2a 30%,#5c2a24 55%,#2b211a 100%);opacity:.75}
  .art-en .art-deco-mountains{left:0;right:0;bottom:-2px;width:100%;height:min(46vh,420px)}
  .art-en .art-deco-sun{right:8%;top:12%;width:min(24vw,220px);height:auto}
  .art-en .art-btn{border-radius:0;border-width:2px}
  .art-en .art-num-block{border-width:2px}
  .art-en .art-cat-tile{border-width:2px}
  .art-en .art-cat-tile:hover{background:rgba(201,162,39,.08);border-color:var(--art-gold)}

  /* ═══════════════════════════════════════════════════════════
     FR — Max Weiler + Paul Flora
     Poetisch, organisch, Serif-Eleganz, luftig
     ═══════════════════════════════════════════════════════════ */
  .art-fr{--art-bg:#f4f1ea;--art-bg2:#ece8de;--art-text:#3a3a35;--art-text2:rgba(58,58,53,.6);--art-text3:rgba(58,58,53,.36);
    --art-accent:#7a8b6f;--art-accent-dark:#5f6e56;--art-gold:#c2a05a;--art-surface:rgba(58,58,53,.025);--art-surface-hover:rgba(58,58,53,.055);--art-border:rgba(58,58,53,.12)}
  .art-fr .art-hero{padding:clamp(96px,15vh,180px) 0 clamp(56px,8vh,100px);text-align:center}
  .art-fr .art-title{font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(48px,9vw,140px);line-height:1;letter-spacing:.14em;text-transform:uppercase}
  .art-fr .art-title-line:last-child{color:var(--art-accent);font-style:italic;text-transform:none;letter-spacing:.06em;font-size:1.05em}
  .art-fr .art-kicker{color:#d97d54;letter-spacing:5px}
  .art-fr .art-sub{margin-left:auto;margin-right:auto}
  .art-fr .art-actions{justify-content:center}
  .art-fr .art-h2{font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;letter-spacing:.1em}
  .art-fr .art-num-val{font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;font-style:italic}
  .art-fr .art-cat-label,.art-fr .art-region-chip{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;letter-spacing:.08em}
  .art-fr .art-deco-weiler{inset:0}
  .art-fr .weiler-blob{position:absolute;border-radius:62% 38% 34% 66% / 58% 32% 68% 42%;filter:blur(1px)}
  .art-fr .wb-1{width:min(32vw,360px);height:min(32vw,360px);right:-70px;top:30px;background:#7a8b6f;opacity:.32}
  .art-fr .wb-2{width:min(22vw,240px);height:min(22vw,240px);left:-50px;bottom:-30px;background:#d97d54;opacity:.24}
  .art-fr .wb-3{width:min(15vw,160px);height:min(15vw,160px);left:16%;top:50px;background:#c2a05a;opacity:.22}
  .art-fr .weiler-leaf{position:absolute;color:#7a8b6f;opacity:.5}
  .art-fr .wl-1{width:56px;left:10%;bottom:14%;animation:artFloat 8s ease-in-out infinite}
  .art-fr .wl-2{width:44px;right:14%;bottom:22%;animation:artFloat 10s ease-in-out infinite reverse}
  .art-fr .art-btn{border-radius:100px;border-width:1px}
  .art-fr .art-num-block,.art-fr .art-cat-tile,.art-fr .art-region-chip{border-radius:14px;border-width:1px}
  .art-fr .art-card-grid{gap:28px}

  /* ═══════════════════════════════════════════════════════════
     CS — Franz von Defregger + Albin Egger-Lienz
     Historisch, ländlich, Rauten-Ornament, Holzstich
     ═══════════════════════════════════════════════════════════ */
  .art-cs{--art-bg:#ede4d3;--art-bg2:#e3d8c2;--art-text:#2e1f14;--art-text2:rgba(46,31,20,.64);--art-text3:rgba(46,31,20,.42);
    --art-accent:#7a2e2e;--art-accent-dark:#5c2121;--art-gold:#b8860b;--art-surface:rgba(46,31,20,.04);--art-surface-hover:rgba(46,31,20,.08);--art-border:rgba(46,31,20,.2)}
  .art-cs .art-hero{padding:clamp(96px,15vh,180px) 0 clamp(56px,8vh,100px);text-align:center}
  .art-cs .art-title{font-family:'Playfair Display',Georgia,serif;font-weight:900;font-size:clamp(56px,11vw,170px);line-height:.9;letter-spacing:.04em}
  .art-cs .art-title-line:last-child{color:var(--art-accent)}
  .art-cs .art-kicker{color:var(--art-gold);letter-spacing:5px}
  .art-cs .art-sub{margin-left:auto;margin-right:auto}
  .art-cs .art-actions{justify-content:center}
  .art-cs .art-h2{font-family:'Playfair Display',Georgia,serif;font-weight:700;letter-spacing:.03em}
  .art-cs .art-num-val{font-family:'Playfair Display',Georgia,serif;font-weight:900}
  .art-cs .art-cat-label,.art-cs .art-region-chip{font-family:'Playfair Display',Georgia,serif;font-weight:700;letter-spacing:.04em}
  .art-cs .art-deco-cs-band{left:0;right:0;bottom:0;width:100%;height:70px;color:var(--art-accent)}
  .art-cs .art-deco-cs-frame{left:50%;top:50%;transform:translate(-50%,-50%);width:min(64vw,560px);height:auto;color:var(--art-accent);opacity:.28}
  .art-cs .art-btn{border-radius:0;border-width:2px}
  .art-cs .art-num-block{border-width:2px;border-color:rgba(46,31,20,.3)}
  .art-cs .art-cat-tile{border-width:2px;border-color:rgba(46,31,20,.3)}
  .art-cs .art-region-chip{border-width:2px;border-color:rgba(46,31,20,.3)}
  .art-cs .art-region-chip:hover{background:var(--art-accent);border-color:var(--art-accent)}

  /* ═══════════════════════════════════════════════════════════
     IT — Alfons Walde + Gustav Klimt
     Luxuriös, Goldornamentik, Cinzel-Kapitale, Schneeberge
     ═══════════════════════════════════════════════════════════ */
  .art-it{--art-bg:#faf8f5;--art-bg2:#f1ede6;--art-text:#1a2a4a;--art-text2:rgba(26,42,74,.62);--art-text3:rgba(26,42,74,.4);
    --art-accent:#b8912e;--art-accent-dark:#96741f;--art-gold:#d4af37;--art-surface:rgba(26,42,74,.03);--art-surface-hover:rgba(26,42,74,.06);--art-border:rgba(184,145,46,.35)}
  .art-it .art-hero{padding:clamp(96px,15vh,180px) 0 clamp(56px,8vh,100px);text-align:center}
  .art-it .art-title{font-family:'Cinzel','Times New Roman',serif;font-weight:600;font-size:clamp(56px,11vw,170px);line-height:.92;letter-spacing:.06em}
  .art-it .art-title-line:last-child{background:linear-gradient(135deg,#d4af37,#b8912e,#e8c96a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .art-it .art-kicker{color:var(--art-accent);letter-spacing:6px}
  .art-it .art-sub{margin-left:auto;margin-right:auto}
  .art-it .art-actions{justify-content:center}
  .art-it .art-h2{font-family:'Cinzel','Times New Roman',serif;font-weight:600;letter-spacing:.05em}
  .art-it .art-num-val{font-family:'Cinzel','Times New Roman',serif;font-weight:600;background:linear-gradient(135deg,#d4af37,#b8912e);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .art-it .art-cat-label,.art-it .art-region-chip{font-family:'Cinzel','Times New Roman',serif;font-weight:600;letter-spacing:.05em}
  .art-it .art-deco-klimt{right:-50px;top:20px;width:min(40vw,460px);height:auto;color:#b8912e}
  .art-it .art-deco-it-mountains{left:0;right:0;bottom:0;width:100%;height:min(30vh,260px);color:#1a2a4a}
  .art-it .art-deco-gold-frame{left:50%;top:50%;transform:translate(-50%,-50%);width:min(66vw,600px);height:auto;color:#b8912e;opacity:.5}
  .art-it .art-btn{border-radius:0;border-width:1.5px;border-color:#b8912e;color:#1a2a4a}
  .art-it .art-btn-primary{background:linear-gradient(135deg,#d4af37,#b8912e);border-color:#b8912e;color:#fff}
  .art-it .art-btn-primary:hover{background:linear-gradient(135deg,#b8912e,#96741f)}
  .art-it .art-num-block{border-width:1.5px;border-color:rgba(184,145,46,.4);background:linear-gradient(180deg,rgba(212,175,55,.05),transparent)}
  .art-it .art-cat-tile{border-width:1.5px;border-color:rgba(184,145,46,.35)}
  .art-it .art-cat-tile:hover{border-color:#b8912e;background:rgba(212,175,55,.07)}
  .art-it .art-region-chip{border-width:1.5px;border-color:rgba(184,145,46,.35)}
  .art-it .art-region-chip:hover{background:linear-gradient(135deg,#d4af37,#b8912e);border-color:#b8912e}

  /* ═══════════════════════════════════════════════════════════
     NL — Paul Flora + Salvador Dalí
     Surreal, schwebend, Outline-Typo, dünne schwarze Linien
     ═══════════════════════════════════════════════════════════ */
  .art-nl{--art-bg:#f7f7f5;--art-bg2:#efefec;--art-text:#111;--art-text2:rgba(17,17,17,.6);--art-text3:rgba(17,17,17,.38);
    --art-accent:#4a4aff;--art-accent-dark:#3232d6;--art-gold:#c98a2e;--art-surface:rgba(17,17,17,.025);--art-surface-hover:rgba(17,17,17,.055);--art-border:rgba(17,17,17,.18)}
  .art-nl .art-hero{padding:clamp(96px,15vh,180px) 0 clamp(72px,10vh,120px)}
  .art-nl .art-title{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(64px,13vw,190px);line-height:.9;letter-spacing:.01em;color:transparent;-webkit-text-stroke:2px #111}
  .art-nl .art-title-line:last-child{-webkit-text-stroke:0;color:var(--art-accent);transform:translateX(.4em)}
  .art-nl .art-kicker{color:var(--art-accent);letter-spacing:5px}
  .art-nl .art-h2{font-family:'Space Grotesk',sans-serif;font-weight:700}
  .art-nl .art-num-val{font-family:'Space Grotesk',sans-serif;font-weight:700;color:transparent;-webkit-text-stroke:1.5px #111}
  .art-nl .art-cat-label,.art-nl .art-region-chip{font-family:'Space Grotesk',sans-serif;font-weight:700}
  .art-nl .art-deco-surreal{inset:0;color:#111}
  .art-nl .sur-obj{position:absolute}
  .art-nl .sur-moon{width:66px;right:10%;top:40px;animation:artFloat 7s ease-in-out infinite}
  .art-nl .sur-clock{width:96px;right:26%;top:170px;animation:artFloat 9s ease-in-out infinite reverse}
  .art-nl .sur-key{width:88px;right:5%;top:290px;animation:artFloat 8s ease-in-out infinite}
  .art-nl .sur-eye{width:82px;right:32%;top:60px;animation:artFloat 11s ease-in-out infinite}
  .art-nl .sur-stair{width:100px;right:16%;bottom:40px;animation:artFloat 10s ease-in-out infinite reverse}
  .art-nl .art-btn{border-radius:0;border-width:1.5px;border-color:#111}
  .art-nl .art-btn-primary{background:var(--art-accent);border-color:var(--art-accent)}
  .art-nl .art-num-block{border-width:1.5px;border-color:#111;background:transparent}
  .art-nl .art-cat-tile{border-width:1.5px;border-color:#111;background:transparent}
  .art-nl .art-cat-tile:hover{background:rgba(74,74,255,.06);border-color:var(--art-accent)}
  .art-nl .art-region-chip{border-width:1.5px;border-color:#111;background:transparent}
  .art-nl .art-region-chip:hover{background:var(--art-accent);border-color:var(--art-accent)}

  /* ═══════════════════════════════════════════════════════════
     ES — Max Weiler + Wassily Kandinsky
