---
<div class={`art-root art-${locale}`}>

  <!-- ═══════════════════════════════════════════════════════════
       HERO — Layout & Dekoration pro Künstlerpaar
       ═══════════════════════════════════════════════════════════ -->
  <header class="art-hero">

    <!-- DE: Grünmandl + Flora — dünne Linienzeichnung, Vögel auf Linie -->
    {locale === 'de' && (
      <svg class="art-deco art-deco-flora" viewBox="0 0 420 200" aria-hidden="true">
        <line x1="20" y1="170" x2="400" y2="170" stroke="currentColor" stroke-width="1.2"/>
        <path d="M150,170 Q158,120 178,116 Q198,112 204,128 Q210,144 192,148 Q174,152 172,138" fill="none" stroke="currentColor" stroke-width="1.4"/>
        <circle cx="176" cy="124" r="2.2" fill="currentColor"/>
        <path d="M204,128 L232,120 M204,133 L234,136" stroke="currentColor" stroke-width="1.1"/>
        <path d="M290,170 Q296,150 310,148 Q324,146 328,156 Q332,166 320,168 Q308,170 308,162" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="312" cy="152" r="1.8" fill="currentColor"/>
        <circle cx="60" cy="170" r="3" fill="currentColor" opacity=".5"/>
        <circle cx="90" cy="170" r="2" fill="currentColor" opacity=".35"/>
      </svg>
    )}

    <!-- EN: Egger-Lienz + Walde — monumentale Bergsilhouetten + Winterhimmel -->
    {locale === 'en' && (
      <>
        <div class="art-deco art-deco-winter-sky" aria-hidden="true"></div>
        <svg class="art-deco art-deco-mountains" viewBox="0 0 1440 420" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0,420 L200,140 L360,280 L560,60 L760,300 L950,120 L1140,320 L1300,180 L1440,360 L1440,420 Z" fill="#1a130e" opacity=".85"/>
          <path d="M0,420 L260,220 L440,320 L640,170 L840,340 L1040,220 L1240,360 L1440,270 L1440,420 Z" fill="#241a12" opacity=".9"/>
          <path d="M560,60 L600,110 L520,110 Z M950,120 L990,165 L910,165 Z" fill="#f5f0e8" opacity=".5"/>
        </svg>
        <svg class="art-deco art-deco-sun" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="70" fill="none" stroke="#c9a227" stroke-width="1.5" opacity=".4"/>
          <circle cx="100" cy="100" r="48" fill="#c9a227" opacity=".18"/>
          <circle cx="100" cy="100" r="26" fill="#c9a227" opacity=".3"/>
        </svg>
      </>
    )}

    <!-- FR: Weiler + Flora — organische Formen, schwebende Blätter -->
    {locale === 'fr' && (
      <div class="art-deco art-deco-weiler" aria-hidden="true">
        <span class="weiler-blob wb-1"></span>
        <span class="weiler-blob wb-2"></span>
        <span class="weiler-blob wb-3"></span>
        <svg class="weiler-leaf wl-1" viewBox="0 0 60 80"><path d="M30,5 Q55,30 30,75 Q5,30 30,5 Z" fill="none" stroke="currentColor" stroke-width="1.3"/><line x1="30" y1="15" x2="30" y2="70" stroke="currentColor" stroke-width="1"/></svg>
        <svg class="weiler-leaf wl-2" viewBox="0 0 60 80"><path d="M30,5 Q55,30 30,75 Q5,30 30,5 Z" fill="none" stroke="currentColor" stroke-width="1.3"/><line x1="30" y1="15" x2="30" y2="70" stroke="currentColor" stroke-width="1"/></svg>
