---
import FavHeart from './FavHeart.astro';
export interface Props {
  name: string;
  slug: string;
  beschreibung?: string;
  emoji?: string;
  farbe?: string;
  region?: string;
}
const { name, slug, beschreibung, emoji = '🏘️', farbe = 'var(--pink)', region } = Astro.props;
---
<a href={`/orte/${slug}/`} class="ort-card" data-collection="orte" data-slug={slug} data-filter-card data-filter-cat={region || ''}>
  <div class="ort-card-img" style={`position:relative;background:${farbe}20`}>
    <span class="ort-emoji">{emoji}</span>
    <FavHeart collection="orte" slug={slug} />
  </div>
  <div class="ort-card-body">
    <h3>{name}</h3>
    {beschreibung && <p>{beschreibung}</p>}
    <span class="ort-link">Entdecken →</span>
  </div>
</a>

<style is:global>
  .ort-card{background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.015));border:1px solid rgba(255,255,255,.09);border-radius:var(--radius-lg);overflow:hidden;transition:transform .35s var(--ease),border-color .35s var(--ease),box-shadow .35s var(--ease),background .35s var(--ease);display:flex;flex-direction:column;box-shadow:0 14px 36px rgba(0,0,0,.08);backdrop-filter:blur(12px)}
  .ort-card:hover{transform:translateY(-8px);border-color:rgba(255,20,147,.42);box-shadow:0 22px 56px rgba(0,0,0,.14)}
  .ort-card-img{height:130px;display:flex;align-items:center;justify-content:center;font-size:48px;background:linear-gradient(135deg,rgba(255,20,147,.08),rgba(255,255,255,.02))}
  .ort-emoji{font-size:48px;filter:drop-shadow(0 8px 20px rgba(0,0,0,.18))}
  .ort-card-body{padding:22px 20px 20px;flex:1;display:flex;flex-direction:column}
  .ort-card-body h3{font-family:var(--font-display);font-size:22px;letter-spacing:.6px;text-transform:uppercase;margin-bottom:6px;color:var(--text)}
  .ort-card-body p{font-size:14px;color:var(--text2);line-height:1.72;flex:1;margin-bottom:12px}
  .ort-link{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--pink)}
  @media(max-width:600px){
    .ort-card-img{height:110px}
    .ort-card-body h3{font-size:20px}
    .ort-card-body{padding:18px 18px}
  }
  @media(max-width:480px){
    .ort-card-img{height:90px}
    .ort-card-body h3{font-size:17px}
    .ort-card-body{padding:12px}
  }
</style>
