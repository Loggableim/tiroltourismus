---
export interface Props {
  titel: string;
  slug: string;
  beschreibung?: string;
  emoji?: string;
  bewertung?: number;
  farbe?: string;
  featured?: boolean;
}
const { titel, slug, beschreibung, emoji = '🏔️', bewertung = 0, farbe = 'var(--pink)', featured } = Astro.props;
const filledStars = Array.from({length:5}, (_, i) => i < bewertung);
---
<a href={`/regionen/${slug}/`} class="region-card">
  <div class="region-card-img" style={`background:linear-gradient(135deg,${farbe}15,${farbe}25)`}>
    <div class="region-blob" style={`background:${farbe}`}></div>
    <span class="region-emoji">{emoji}</span>
  </div>
  <div class="region-card-body">
    <h3>{titel}</h3>
    {beschreibung && <p>{beschreibung}</p>}
    {featured && <span class="featured-badge">🔥 Empfohlen</span>}
    <div class="region-stars">
      {filledStars.map(f => <span class={`star${f ? '' : ' empty'}`}>★</span>)}
    </div>
    <span class="region-link">Entdecken →</span>
  </div>
</a>

<style is:global>
  .region-card{background:var(--bg2);border:1px solid var(--glass-border);border-radius:var(--radius-lg);overflow:hidden;transition:all .4s var(--ease);display:flex;flex-direction:column}
  .region-card:hover{transform:translateY(-5px);border-color:var(--pink);box-shadow:0 16px 48px rgba(0,0,0,.08)}
  .region-card-img{height:180px;display:flex;align-items:center;justify-content:center;font-size:48px;position:relative;overflow:hidden}
  .region-card-img .region-emoji{position:relative;z-index:1;font-size:56px}
  .region-card-img .region-blob{position:absolute;width:200px;height:200px;border-radius:50%;opacity:.15;filter:blur(40px);top:50%;left:50%;transform:translate(-50%,-50%)}
  .region-card-body{padding:24px;flex:1;display:flex;flex-direction:column}
  .region-card-body h3{font-family:var(--font-display);font-size:28px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;line-height:1.1;color:var(--text)}
  .region-card-body p{font-size:13px;color:var(--text2);line-height:1.6;margin-bottom:12px;flex:1}
  .region-stars{display:flex;gap:3px;margin-bottom:14px;font-size:14px}
  .region-stars .star{color:var(--yellow)}
  .region-stars .star.empty{color:var(--text3)}
  .region-link{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--pink);transition:all .3s}
  .region-link:hover{gap:10px}
  .featured-badge{display:inline-block;padding:3px 12px;border-radius:100px;font-size:10px;font-weight:700;background:var(--yellow);color:#1a1a1a;margin-bottom:8px;width:fit-content}
  @media(max-width:600px){
    .region-card-img{height:155px}
    .region-card-body h3{font-size:25px}
    .region-card-body{padding:20px}
  }
  @media(max-width:480px){
    .region-card-img{height:130px}
    .region-card-body h3{font-size:22px}
    .region-card-body{padding:16px}
  }
</style>
