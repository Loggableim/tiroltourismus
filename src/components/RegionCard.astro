---
import FavHeart from './FavHeart.astro';
export interface Props {
  /** Optional locale prefix for multilang links (e.g. "fr"). */
  locale?: string;
  titel: string;
  slug: string;
  beschreibung?: string;
  emoji?: string;
  wappenSrc?: string;
  /** Optional hero image. When provided, used as background cover. Falls back to gradient. */
  heroSrc?: string;
  bewertung?: number;
  farbe?: string;
  featured?: boolean;
}
const { titel, slug, beschreibung, emoji = '🏔️', wappenSrc, heroSrc, bewertung = 0, farbe = 'var(--tirol-pink)', featured , locale = undefined } = Astro.props;
const filledStars = Array.from({length:5}, (_, i) => i < bewertung);
---
<a href={`${locale ? '/' + locale : ''}/regionen/${slug}/`} class="region-card" data-collection="regionen" data-slug={slug} data-filter-card data-filter-cat={featured ? 'featured' : 'other'}>
  <div class="region-card-img" style={`position:relative;background:linear-gradient(135deg,${farbe}15,${farbe}25)`}>
    {heroSrc ? (
      <img
        src={heroSrc}
        alt={`${titel} Panorama`}
        class="region-card-photo"
        loading="lazy"
        decoding="async"
        width="420" height="315"
      />
    ) : wappenSrc ? (
      <img src={wappenSrc} alt={`${titel} Wappen`} class="region-badge-img" loading="lazy" decoding="async" />
    ) : (
      <>
        <div class="region-blob" style={`background:${farbe}`}></div>
        <span class="region-emoji">{emoji}</span>
      </>
    )}
    <FavHeart collection="regionen" slug={slug} />
  </div>
  <div class="region-card-body">
    <h3>{titel}</h3>
    {beschreibung && <p>{beschreibung}</p>}
    {featured && <span class="featured-badge">🔥 Empfohlen</span>}
    <div class="region-stars">
      {filledStars.map(f => <span class={`star${f ? '' : ' empty'}`}>★</span>)}
    </div>
    <span class="region-link">Entdecken →</span>
  </div>
</a>

<style is:global>
  .region-card{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.012));border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-lg);overflow:hidden;transition:transform .35s var(--ease),border-color .35s var(--ease),box-shadow .35s var(--ease),background .35s var(--ease);display:flex;flex-direction:column;box-shadow:0 12px 30px rgba(0,0,0,.06);backdrop-filter:blur(10px)}
  .region-card:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.18);box-shadow:0 18px 44px rgba(0,0,0,.12)}
  .region-card-img{height:190px;display:flex;align-items:center;justify-content:center;font-size:48px;position:relative;overflow:hidden;background:linear-gradient(135deg,rgba(255,255,255,.035),rgba(255,255,255,.015))}
  .region-card-img::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at center,rgba(255,255,255,.08),transparent 60%);pointer-events:none}
  .region-card-img .region-badge-img{position:relative;z-index:1;width:86%;height:auto;max-height:88%;object-fit:contain;filter:drop-shadow(0 8px 20px rgba(0,0,0,0.24))}
  .region-card-img .region-card-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
  .region-card-img .region-card-photo::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 0%,transparent 50%,rgba(0,0,0,0.4) 100%);pointer-events:none}
  .region-card-img .region-emoji{position:relative;z-index:1;font-size:56px;filter:drop-shadow(0 8px 18px rgba(0,0,0,.16))}
  .region-card-img .region-blob{position:absolute;width:220px;height:220px;border-radius:50%;opacity:.1;filter:blur(52px);top:50%;left:50%;transform:translate(-50%,-50%)}
  .region-card-body{padding:26px 24px 24px;flex:1;display:flex;flex-direction:column}
  .region-card-body h3{font-family:var(--font-display);font-size:26px;letter-spacing:.7px;text-transform:uppercase;margin-bottom:8px;line-height:1.05;color:var(--text)}
  .region-card-body p{font-size:14px;color:var(--text2);line-height:1.72;margin-bottom:14px;flex:1}
  .region-stars{display:flex;gap:3px;margin-bottom:14px;font-size:14px}
  .region-stars .star{color:var(--yellow)}
  .region-stars .star.empty{color:var(--text3)}
  .region-link{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--tirol-pink);transition:all .3s}
  .region-link:hover{gap:10px}
  .featured-badge{display:inline-block;padding:3px 12px;border-radius:100px;font-size:10px;font-weight:700;background:rgba(255,215,0,.9);color:#1a1a1a;margin-bottom:10px;width:fit-content;box-shadow:0 4px 12px rgba(255,215,0,.14)}
  @media(max-width:600px){
    .region-card-img{height:160px}
    .region-card-body h3{font-size:24px}
    .region-card-body{padding:22px 20px 20px}
  }
  @media(max-width:480px){
    .region-card-img{height:140px}
    .region-card-body h3{font-size:21px}
    .region-card-body{padding:16px}
  }
</style>
