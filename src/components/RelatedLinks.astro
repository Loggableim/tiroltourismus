---
import { plainText } from '../lib/richtext.js';
import { getRelatedForEntry } from '../lib/related.js';
import CategoryPlaceholder from './CategoryPlaceholder.astro';

export interface Props {
  collection: string;
  slug: string;
  locale?: string;
}

const { collection, slug, locale = 'de' } = Astro.props;
const { sameCategory, crossCategory, headings } = getRelatedForEntry(collection, slug, locale);

const hasAny = sameCategory.length > 0 || crossCategory.length > 0;

const CATEGORY_LABELS = {
  de: { unterkuenfte: 'Unterkunft', camping: 'Camping', gastro: 'Gastro', sehenswuerdigkeiten: 'Sehenswertes', erlebnisse: 'Erlebnis', events: 'Event', orte: 'Ort', regionen: 'Region', magazin: 'Magazin' },
  en: { unterkuenfte: 'Accommodation', camping: 'Camping', gastro: 'Dining', sehenswuerdigkeiten: 'Sight', erlebnisse: 'Experience', events: 'Event', orte: 'Place', regionen: 'Region', magazin: 'Magazine' },
  fr: { unterkuenfte: 'Hébergement', camping: 'Camping', gastro: 'Gastronomie', sehenswuerdigkeiten: 'Sites touristiques', erlebnisse: 'Expérience', events: 'Événement', orte: 'Village', regionen: 'Région', magazin: 'Magazine' },
  it: { unterkuenfte: 'Alloggio', camping: 'Campeggio', gastro: 'Gastronomia', sehenswuerdigkeiten: 'Attrazione', erlebnisse: 'Esperienza', events: 'Evento', orte: 'Paese', regionen: 'Regione', magazin: 'Magazine' },
  es: { unterkuenfte: 'Alojamiento', camping: 'Camping', gastro: 'Gastronomía', sehenswuerdigkeiten: 'Atracción', erlebnisse: 'Experiencia', events: 'Evento', orte: 'Pueblo', regionen: 'Región', magazin: 'Revista' },
  zh: { unterkuenfte: '住宿', camping: '露营', gastro: '美食', sehenswuerdigkeiten: '景点', erlebnisse: '体验', events: '活动', orte: '村镇', regionen: '地区', magazin: '杂志' },
  nl: { unterkuenfte: 'Accommodatie', camping: 'Camping', gastro: 'Eten & Drinken', sehenswuerdigkeiten: 'Bezienswaardigheid', erlebnisse: 'Belevenis', events: 'Evenement', orte: 'Plaats', regionen: 'Regio', magazin: 'Magazine' },
  cs: { unterkuenfte: 'Ubytování', camping: 'Kemp', gastro: 'Gastronomie', sehenswuerdigkeiten: 'Pamětihodnost', erlebnisse: 'Zážitek', events: 'Akce', orte: 'Místo', regionen: 'Region', magazin: 'Časopis' },
};
const catMap = CATEGORY_LABELS[locale] || CATEGORY_LABELS.de;
---

{hasAny && (
  <section class={`related-links section related-links-${locale}`} aria-label={headings.same}>
    <div class="container" style="max-width:860px">
      {sameCategory.length > 0 && (
        <div class="related-links-group">
          <div class="related-links-header">
            <span class="related-links-badge">{catMap[collection] || collection}</span>
            <h2 class="related-links-subtitle">{headings.same}</h2>
          </div>
          <div class="related-links-grid">
            {sameCategory.map((item) => (
              <a href={item.href} class="related-card">
                <div class="related-card-media">
                  <CategoryPlaceholder collection={item.collection} locale={locale} />
                  <span class="related-card-icon" aria-hidden="true">{item.emoji}</span>
                </div>
                <div class="related-card-content">
                  <div class="related-card-meta">
                    <span class="related-card-cat">{catMap[item.collection] || item.collection}</span>
                    {item.ort && <span class="related-card-loc">📍 {plainText(item.ort)}</span>}
                  </div>
                  <h3 class="related-card-name">{plainText(item.name)}</h3>
                  {item.kurzbeschreibung && (
                    <p class="related-card-desc">{plainText(item.kurzbeschreibung)}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {crossCategory.length > 0 && (
        <div class="related-links-group">
          <div class="related-links-header">
            <span class="related-links-badge">Tirol</span>
            <h2 class="related-links-subtitle">{headings.cross}</h2>
          </div>
          <div class="related-links-grid">
            {crossCategory.map((item) => (
              <a href={item.href} class="related-card">
                <div class="related-card-media">
                  <CategoryPlaceholder collection={item.collection} locale={locale} />
                  <span class="related-card-icon" aria-hidden="true">{item.emoji}</span>
                </div>
                <div class="related-card-content">
                  <div class="related-card-meta">
                    <span class="related-card-cat">{catMap[item.collection] || item.collection}</span>
                    {item.ort && <span class="related-card-loc">📍 {plainText(item.ort)}</span>}
                  </div>
                  <h3 class="related-card-name">{plainText(item.name)}</h3>
                  {item.kurzbeschreibung && (
                    <p class="related-card-desc">{plainText(item.kurzbeschreibung)}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .related-links {
    padding: 44px 0 24px;
    border-top: 1px solid var(--glass-border);
  }
  .related-links-header {
    margin-bottom: 20px;
  }
  .related-links-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    background: var(--surface-hover);
    color: var(--text2);
    margin-bottom: 6px;
  }
  .related-links-subtitle {
    font-family: var(--font-display);
    font-size: clamp(22px, 3.5vw, 30px);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0;
    color: var(--text);
  }
  .related-links-group + .related-links-group {
    margin-top: 40px;
  }
  .related-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 16px;
  }
  .related-card {
    display: flex;
    gap: 16px;
    padding: 14px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    align-items: center;
  }
  .related-card:hover {
    border-color: var(--tirol-pink);
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.09);
  }
  .related-card-media {
    position: relative;
    width: 80px;
    height: 80px;
    border-radius: var(--radius);
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
  }
  .related-card-icon {
    position: relative;
    z-index: 1;
    font-size: 26px;
    filter: drop-shadow(0 2px 6px rgba(0,0,0,.2));
  }
  .related-card-content {
    flex: 1;
    min-width: 0;
  }
  .related-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .related-card-cat {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--tirol-pink);
  }
  .related-card-loc {
    font-size: 11px;
    color: var(--text2);
    text-transform: capitalize;
  }
  .related-card-name {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text);
    margin: 0 0 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .related-card-desc {
    font-size: 12px;
    color: var(--text2);
    line-height: 1.45;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 600px) {
    .related-links-grid {
      grid-template-columns: 1fr;
    }
    .related-card {
      padding: 12px;
      gap: 12px;
    }
    .related-card-media {
      width: 70px;
      height: 70px;
    }
  }
</style>
