---
export interface NavItem {
  label: string;
  href: string;
  icon?: string;
  count?: number | string;
  active?: boolean;
}

export interface Props {
  items: NavItem[];
  ariaLabel?: string;
  compact?: boolean;
  class?: string;
}

const {
  items,
  ariaLabel = 'Navigation',
  compact = false,
  class: className,
} = Astro.props;
---
<nav class:list={['segmented-nav', compact && 'segmented-nav--compact', className]} aria-label={ariaLabel}>
  {items.map((item) => (
    <a href={item.href} class:list={['segmented-nav-link', item.active && 'active']}>
      {item.icon && <span class="segmented-nav-icon">{item.icon}</span>}
      <span class="segmented-nav-label">{item.label}</span>
      {item.count !== undefined && <span class="segmented-nav-count">{item.count}</span>}
    </a>
  ))}
</nav>

<style is:global>
  .segmented-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 0 0 40px;
  }
  .segmented-nav--compact {
    gap: 6px;
    padding-bottom: 24px;
  }
  .segmented-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    transition: all .3s var(--ease);
    white-space: nowrap;
  }
  .segmented-nav-link:hover {
    border-color: var(--tirol-pink);
    background: var(--surface-hover);
    box-shadow: 0 4px 16px var(--tirol-pink-glow);
    transform: translateY(-2px);
  }
  .segmented-nav-link.active {
    background: var(--tirol-pink);
    color: #fff;
    border-color: var(--tirol-pink);
    box-shadow: 0 4px 16px var(--tirol-pink-glow);
  }
  .segmented-nav-icon { font-size: 18px; line-height: 1; }
  .segmented-nav-count {
    font-size: 11px;
    font-weight: 600;
    color: var(--text3);
    background: var(--surface);
    padding: 2px 8px;
    border-radius: 100px;
    min-width: 20px;
    text-align: center;
  }
  .segmented-nav-link.active .segmented-nav-count {
    color: rgba(255,255,255,.9);
    background: rgba(255,255,255,.16);
  }
  @media (max-width: 700px) {
    .segmented-nav {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      flex-wrap: nowrap;
      justify-content: flex-start;
      scrollbar-width: none;
      padding-bottom: 24px;
    }
    .segmented-nav::-webkit-scrollbar { display: none; }
    .segmented-nav-link {
      padding: 8px 14px;
      font-size: 12px;
      flex-shrink: 0;
    }
    .segmented-nav-icon { font-size: 16px; }
  }
</style>
