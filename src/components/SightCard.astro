---
export interface Props {
  name: string;
  slug: string;
  kurzbeschreibung?: string;
  kategorie?: string;
  emoji?: string;
  farbe?: string;
  ort?: string;
  preis?: string;
}
const { name, slug, kurzbeschreibung, kategorie, emoji = '🏛️', farbe = '#8B5CF6', ort, preis } = Astro.props;
const catLabel = { natur: 'Natur', kultur: 'Kultur', aussicht: 'Aussicht', sport: 'Sport', museum: 'Museum', kirche: 'Kirche', burg: 'Burg', wanderung: 'Wanderung' };
---
<a href={`/sehenswuerdigkeiten/${slug}/`} class="sight-card">
  <div class="sight-card-img" style={`background:${farbe}18`}>
    <span class="sight-emoji">{emoji}</span>
  </div>
  <div class="sight-body">
    <div class="sight-kategorie">{catLabel[kategorie] || kategorie || 'Sehenswürdigkeit'}</div>
    <h3>{name}</h3>
    {ort && <div class="sight-ort">{ort}</div>}
    {kurzbeschreibung && <p>{kurzbeschreibung}</p>}
    <div class="sight-meta">
      {preis && <span class="sight-preis">{preis}</span>}
      <span class="sight-link">Entdecken →</span>
    </div>
  </div>
</a>

<style is:global>
  .sight-card{background:var(--bg2);border:1px solid var(--glass-border);border-radius:var(--radius-lg);overflow:hidden;transition:all .4s var(--ease);display:flex;flex-direction:column}
  .sight-card:hover{transform:translateY(-5px);border-color:var(--pink);box-shadow:0 16px 48px rgba(0,0,0,.08)}
  .sight-card-img{height:130px;display:flex;align-items:center;justify-content:center;font-size:48px}
  .sight-emoji{font-size:48px;line-height:1}
  .sight-body{padding:16px 20px 20px;flex:1;display:flex;flex-direction:column}
  .sight-kategorie{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--purple);margin-bottom:2px}
  .sight-body h3{font-family:var(--font-display);font-size:24px;letter-spacing:1px;text-transform:uppercase;margin-bottom:2px;color:var(--text);line-height:1.1}
  .sight-ort{font-size:12px;color:var(--text2);margin-bottom:6px}
  .sight-body p{font-size:13px;color:var(--text2);line-height:1.6;flex:1;margin-bottom:10px}
  .sight-meta{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:10px;border-top:1px solid var(--glass-border)}
  .sight-preis{font-size:13px;font-weight:700;color:var(--purple)}
  .sight-link{font-size:11px;font-weight:700;text-transform:uppercase;color:var(--pink);transition:all .3s}
  .sight-link:hover{gap:6px}
</style>
