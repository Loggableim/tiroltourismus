---
export interface Props {
  items: Array<{ zahl: string; label: string }>;
  columns?: number;
}
const { items, columns = items.length } = Astro.props;
---
<section class="stats-section">
  <div class="container">
    <div class="stats-grid" style={`grid-template-columns:repeat(${Math.min(columns, 4)},1fr)`}>
      {items.map((s) => (
        <div class="stat-item">
          <div class="stat-number">{s.zahl}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .stats-section{background:var(--bg2);padding:60px 0;border-top:1px solid var(--glass-border);border-bottom:1px solid var(--glass-border)}
  .stats-grid{display:grid;gap:40px;text-align:center}
  .stat-number{font-family:var(--font-display);font-size:clamp(48px,6vw,80px);line-height:1;color:var(--tirol-pink);letter-spacing:2px}
  .stat-label{font-size:14px;color:var(--text2);margin-top:6px;font-weight:500}
  @media(max-width:600px){.stats-grid{grid-template-columns:repeat(2,1fr)!important;gap:30px}}
</style>
