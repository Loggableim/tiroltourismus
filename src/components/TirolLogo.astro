---
/**
 * TirolLogo.astro — Offizielles Tirol-Logo in Landesfarben (Rot→Weiß→Rot).
 *
 * Tirol-Markenidentität: Die offiziellen Landesfarben sind Rot (#C8102E)
 * und Weiß (Wappen, Tiroler Fahne mit rotem Adler). Die Buchstaben
 * T·I·R·O·L werden alle im selben Rot→Weiß-Verlauf gerendert — kein
 * Regenbogen-Look mehr (war vorher: T=Rot, I=Pink, R=Gold, O=Pink, L=Blau).
 *
 * Suffix "tourismus" wird in derselben Familie gerendert:
 * - Light-Theme: Tirol-Rot (#C8102E)
 * - Dark-Theme:  helleres Rot (#FF2D55) für besseren Kontrast auf dunklem BG
 *
 * Replaces 3 hand-duplicated inline SVGs in BaseLayout (nav, footer)
 * and index.astro (hero). Width prop is the only knob.
 */
export interface Props {
  /** Render width in pixels. The viewBox is fixed at 0 2 375 46. */
  width?: number | string;
  /** Optional override for suffix color. Default: Tirol-Rot via theme-aware CSS. */
  suffixColor?: string;
  /** Optional id suffix to keep SVG gradient defs unique per instance. */
  idSuffix?: string;
  /** When true, prefix letters render in white instead of red (for use on red backgrounds). */
  inverted?: boolean;
}
const {
  width = 240,
  suffixColor,
  idSuffix = 'tl',
  inverted = false,
} = Astro.props;

// Theme-aware color: red on light, lighter red on dark theme.
// Inverted mode: white prefix on red bg.
const prefixStart = inverted ? '#FFFFFF' : '#A00D24';
const prefixEnd   = inverted ? '#F5E6E8' : '#C8102E';
const suffixColorFinal = suffixColor ?? (inverted ? '#FFFFFF' : 'var(--tirol-red)');
---
<svg viewBox="0 2 375 46" width={width} aria-label="Tirol Tourismus" role="img">
  <defs>
    <linearGradient id={`${idSuffix}-g1`}><stop offset="0%" stop-color={prefixStart}/><stop offset="100%" stop-color={prefixEnd}/></linearGradient>
    <linearGradient id={`${idSuffix}-g2`}><stop offset="0%" stop-color={prefixStart}/><stop offset="100%" stop-color={prefixEnd}/></linearGradient>
    <linearGradient id={`${idSuffix}-g3`}><stop offset="0%" stop-color={prefixStart}/><stop offset="100%" stop-color={prefixEnd}/></linearGradient>
    <linearGradient id={`${idSuffix}-g4`}><stop offset="0%" stop-color={prefixStart}/><stop offset="100%" stop-color={prefixEnd}/></linearGradient>
    <linearGradient id={`${idSuffix}-g5`}><stop offset="0%" stop-color={prefixStart}/><stop offset="100%" stop-color={prefixEnd}/></linearGradient>
  </defs>
  <text x="14" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill={`url(#${idSuffix}-g1)`}>T</text>
  <polygon points="14,36 14,10 36,36" fill={`url(#${idSuffix}-g1)`} opacity="0.08"/>
  <text x="46" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill={`url(#${idSuffix}-g2)`}>I</text>
  <polygon points="46,36 46,14 60,36" fill={`url(#${idSuffix}-g2)`} opacity="0.08"/>
  <text x="72" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill={`url(#${idSuffix}-g3)`}>R</text>
  <polygon points="72,36 72,8 96,36" fill={`url(#${idSuffix}-g3)`} opacity="0.08"/>
  <text x="104" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill={`url(#${idSuffix}-g4)`}>O</text>
  <polygon points="104,36 104,10 130,36" fill={`url(#${idSuffix}-g4)`} opacity="0.08"/>
  <text x="138" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill={`url(#${idSuffix}-g5)`}>L</text>
  <polygon points="138,36 138,12 158,36" fill={`url(#${idSuffix}-g5)`} opacity="0.08"/>
  <circle cx="178" cy="30" r="2.5" fill={inverted ? 'rgba(255,255,255,0.3)' : 'rgba(0,0,0,0.12)'} opacity="0.3"/>
  <text x="192" y="38" font-family="'Montserrat',sans-serif" font-size="28" font-weight="300" letter-spacing="0.8" fill={suffixColorFinal}>tourismus</text>
</svg>

<style is:global>
  /* Dark-Theme: brighter red for legibility on dark background */
  [data-theme="alpenpeak"] .tirol-logo-suffix {
    fill: #FF2D55;
  }
</style>
