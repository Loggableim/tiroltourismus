---
// DemoPage.astro — Complete one-page demo front for /demofrontneu and /demofrontneu/<lang>.
//
// Structure:
//   Section 1  #sprache  — language picker (100dvh, tiles, recommended, continue banner)
//   Sticky nav           — anchors, scroll-spy, burger menu, language switch
//   Content              — ALL sections of the real front page (DemoContent,
//                          a copy of HomepageArt adapted with on-page anchors)
//
// Reuses the real data loaders (readCollection/isPublished) and the real card
// components. Nothing is invented — counts and entries come from src/data.
import { readCollection, isPublished } from '../../lib/content.js';
import { localePrefix as localePrefixFn } from '../../lib/languages.js';
import LanguagePicker from './LanguagePicker.astro';
import DemoNav from './DemoNav.astro';
import DemoContent from './DemoContent.astro';

import dePage from '../../data/homepage.json';
import enPage from '../../data/en/homepage.json';
import frPage from '../../data/fr/homepage.json';
import itPage from '../../data/it/homepage.json';
import esPage from '../../data/es/homepage.json';
import zhPage from '../../data/zh/homepage.json';
import nlPage from '../../data/nl/homepage.json';
import csPage from '../../data/cs/homepage.json';

export interface Props {
  locale: string;
}

const { locale } = Astro.props;

const PAGE_MAP: Record<string, any> = {
  de: dePage, en: enPage, fr: frPage, it: itPage,
  es: esPage, zh: zhPage, nl: nlPage, cs: csPage,
};
const page = PAGE_MAP[locale] || dePage;
const localePrefix = localePrefixFn(locale);

// ── Real data (same loaders as the real front page) ──
const allRegions = readCollection('regionen', locale).filter((r) => isPublished(r.entry));
const allOrte = readCollection('orte', locale).filter((o) => isPublished(o.entry));
const allSights = readCollection('sehenswuerdigkeiten', locale).filter((s) => isPublished(s.entry));
const allStays = readCollection('unterkuenfte', locale).filter((u) => isPublished(u.entry));
const allCamping = readCollection('camping', locale).filter((c) => isPublished(c.entry));
const allGastro = readCollection('gastro', locale).filter((g) => isPublished(g.entry));
const allMagazin = readCollection('magazin', locale).filter((a) => isPublished(a.entry));
const allErlebnisse = readCollection('erlebnisse', locale).filter((e) => isPublished(e.entry));
const allEvents = readCollection('events', locale).filter((e) => isPublished(e.entry));

const counts = {
  gastro: allGastro.length,
  unterkuenfte: allStays.length,
  orte: allOrte.length,
  sights: allSights.length,
  camping: allCamping.length,
  magazin: allMagazin.length,
  erlebnisse: allErlebnisse.length,
  events: allEvents.length,
  regionen: allRegions.length,
};

const regions = allRegions.slice(0, 6);
const stays = allStays.slice(0, 3);
const sights = allSights.slice(0, 4);
const gastro = allGastro.slice(0, 3);
const magazin = allMagazin.slice(0, 3);
const erlebnisse = allErlebnisse.slice(0, 4);
const events = allEvents.slice(0, 4);
const camping = allCamping.slice(0, 3);
const orte = allOrte.slice(0, 4);
const regionNames = allRegions
  .map((r) => ({ slug: r.slug, name: r.entry.titel || r.entry.name || r.slug }))
  .sort((a, b) => a.name.localeCompare(b.name, locale === 'cs' ? 'cs' : 'de'));

// ── Static route helpers (/demofrontneu is de, others get a prefix) ──
const demoHref = (code: string) => (code === 'de' ? '/demofrontneu' : `/demofrontneu/${code}`);

const TILES = [
  { code: 'de', htmlLang: 'de', name: 'Deutsch',    tagline: 'Tirol entdecken',   accent: 'var(--tirol-red)' },
  { code: 'en', htmlLang: 'en', name: 'English',    tagline: 'Discover Tirol',    accent: 'var(--ikea-blue)' },
  { code: 'fr', htmlLang: 'fr', name: 'Français',   tagline: 'Découvrir le Tyrol', accent: 'var(--pop-purple)' },
  { code: 'cs', htmlLang: 'cs', name: 'Čeština',    tagline: 'Objevte Tyrolsko',  accent: 'var(--pop-green)' },
  { code: 'nl', htmlLang: 'nl', name: 'Nederlands', tagline: 'Ontdek Tirol',      accent: 'var(--pop-orange)' },
  { code: 'it', htmlLang: 'it', name: 'Italiano',   tagline: 'Scopri il Tirolo',  accent: 'var(--tirol-pink-dark)' },
  { code: 'es', htmlLang: 'es', name: 'Español',    tagline: 'Descubre el Tirol', accent: 'var(--gold)' },
  { code: 'zh', htmlLang: 'zh', name: '中文',        tagline: '探索蒂罗尔',         accent: 'var(--tirol-pink)' },
];
const FLAGS: Record<string, string> = {
  de: '🇩🇪', en: '🇬🇧', fr: '🇫🇷', cs: '🇨🇿', nl: '🇳🇱', it: '🇮🇹', es: '🇪🇸', zh: '🇨🇳',
};

const tiles = TILES.map((t) => ({ ...t, href: `${demoHref(t.code)}#entdecken` }));
const langLinks = TILES.map((t) => ({
  code: t.code,
  name: t.name,
  flag: FLAGS[t.code] || '🌐',
  href: demoHref(t.code),
  active: t.code === locale,
}));

// ── Localized UI strings (all 8 languages) ──
type SectionKey = 'entdecken' | 'orte' | 'unterkuenfte' | 'sehenswuerdigkeiten' | 'aktivitaeten' | 'gastro' | 'camping' | 'regionen' | 'magazin';

const UI: Record<string, {
  title: string;
  picker: { title: string; subtitle: string; recommended: string; continueIn: string; aria: string; categoriesAria: string };
  nav: { aria: string; menu: string; language: string; languageAria: string; sectionsAria: string };
  sections: Record<SectionKey, string>;
}> = {
  de: {
    title: 'Der smarte Tirol-Guide',
    picker: { title: 'Wähle deine Sprache', subtitle: 'Wähle deine Sprache und entdecke Tirol auf einer Seite.', recommended: 'Empfohlen', continueIn: 'Weiter auf', aria: 'Sprachauswahl', categoriesAria: 'Kategorien' },
    nav: { aria: 'Ein-Seiten-Navigation', menu: 'Menü öffnen', language: 'Sprache', languageAria: 'Sprache wechseln', sectionsAria: 'Abschnitte' },
    sections: { entdecken: 'Entdecken', orte: 'Orte', unterkuenfte: 'Unterkünfte', sehenswuerdigkeiten: 'Sehenswürdigkeiten', aktivitaeten: 'Aktivitäten', gastro: 'Gastronomie', camping: 'Camping', regionen: 'Regionen', magazin: 'Magazin' },
  },
  en: {
    title: 'The Smart Tyrol Guide',
    picker: { title: 'Choose your language', subtitle: 'Choose your language and discover Tyrol on one page.', recommended: 'Recommended', continueIn: 'Continue in', aria: 'Language selection', categoriesAria: 'Categories' },
    nav: { aria: 'One-page navigation', menu: 'Open menu', language: 'Language', languageAria: 'Change language', sectionsAria: 'Sections' },
    sections: { entdecken: 'Discover', orte: 'Places', unterkuenfte: 'Accommodations', sehenswuerdigkeiten: 'Sights', aktivitaeten: 'Activities', gastro: 'Food & Drink', camping: 'Camping', regionen: 'Regions', magazin: 'Magazine' },
  },
  fr: {
    title: 'Le Guide Intelligent du Tyrol',
    picker: { title: 'Choisissez votre langue', subtitle: 'Choisissez votre langue et découvrez le Tyrol sur une seule page.', recommended: 'Recommandé', continueIn: 'Continuer en', aria: 'Sélection de la langue', categoriesAria: 'Catégories' },
    nav: { aria: 'Navigation sur une page', menu: 'Ouvrir le menu', language: 'Langue', languageAria: 'Changer de langue', sectionsAria: 'Sections' },
    sections: { entdecken: 'Découvrir', orte: 'Villages', unterkuenfte: 'Hébergements', sehenswuerdigkeiten: 'Sites touristiques', aktivitaeten: 'Activités', gastro: 'Gastronomie', camping: 'Camping', regionen: 'Régions', magazin: 'Magazine' },
  },
  cs: {
    title: 'Chytrý průvodce Tyrolskem',
    picker: { title: 'Zvolte jazyk', subtitle: 'Zvolte jazyk a objevte Tyrolsko na jedné stránce.', recommended: 'Doporučeno', continueIn: 'Pokračovat v', aria: 'Výběr jazyka', categoriesAria: 'Kategorie' },
    nav: { aria: 'Navigace na jedné stránce', menu: 'Otevřít menu', language: 'Jazyk', languageAria: 'Změnit jazyk', sectionsAria: 'Sekce' },
    sections: { entdecken: 'Objevit', orte: 'Místa', unterkuenfte: 'Ubytování', sehenswuerdigkeiten: 'Pamětihodnosti', aktivitaeten: 'Aktivity', gastro: 'Gastronomie', camping: 'Kempy', regionen: 'Regiony', magazin: 'Časopis' },
  },
  nl: {
    title: 'De Slimme Tirol-Gids',
    picker: { title: 'Kies je taal', subtitle: 'Kies je taal en ontdek Tirol op één pagina.', recommended: 'Aanbevolen', continueIn: 'Doorgaan in', aria: 'Taalkeuze', categoriesAria: 'Categorieën' },
    nav: { aria: 'Navigatie op één pagina', menu: 'Menu openen', language: 'Taal', languageAria: 'Taal wijzigen', sectionsAria: 'Secties' },
    sections: { entdecken: 'Ontdekken', orte: 'Plaatsen', unterkuenfte: 'Accommodaties', sehenswuerdigkeiten: 'Bezienswaardigheden', aktivitaeten: 'Activiteiten', gastro: 'Eten & Drinken', camping: 'Campings', regionen: "Regio's", magazin: 'Tijdschrift' },
  },
  it: {
    title: 'La Guida Intelligente del Tirolo',
    picker: { title: 'Scegli la tua lingua', subtitle: 'Scegli la lingua e scopri il Tirolo su una sola pagina.', recommended: 'Consigliato', continueIn: 'Continua in', aria: 'Selezione della lingua', categoriesAria: 'Categorie' },
    nav: { aria: 'Navigazione a pagina singola', menu: 'Apri il menu', language: 'Lingua', languageAria: 'Cambia lingua', sectionsAria: 'Sezioni' },
    sections: { entdecken: 'Scoprire', orte: 'Paesi', unterkuenfte: 'Alloggi', sehenswuerdigkeiten: 'Attrazioni', aktivitaeten: 'Attività', gastro: 'Gastronomia', camping: 'Campeggio', regionen: 'Regioni', magazin: 'Magazine' },
  },
  es: {
    title: 'La Guía Inteligente de Tirol',
    picker: { title: 'Elige tu idioma', subtitle: 'Elige tu idioma y descubre el Tirol en una sola página.', recommended: 'Recomendado', continueIn: 'Continuar en', aria: 'Selección de idioma', categoriesAria: 'Categorías' },
    nav: { aria: 'Navegación de una página', menu: 'Abrir menú', language: 'Idioma', languageAria: 'Cambiar idioma', sectionsAria: 'Secciones' },
    sections: { entdecken: 'Descubrir', orte: 'Pueblos', unterkuenfte: 'Alojamientos', sehenswuerdigkeiten: 'Atracciones', aktivitaeten: 'Actividades', gastro: 'Gastronomía', camping: 'Camping', regionen: 'Regiones', magazin: 'Revista' },
  },
  zh: {
    title: '智能蒂罗尔指南',
    picker: { title: '选择您的语言', subtitle: '选择您的语言，在一页中探索蒂罗尔。', recommended: '推荐', continueIn: '继续使用', aria: '语言选择', categoriesAria: '分类' },
    nav: { aria: '单页导航', menu: '打开菜单', language: '语言', languageAria: '切换语言', sectionsAria: '章节' },
    sections: { entdecken: '探索', orte: '村镇', unterkuenfte: '住宿', sehenswuerdigkeiten: '景点', aktivitaeten: '活动', gastro: '美食', camping: '露营', regionen: '地区', magazin: '杂志' },
  },
};
const ui = UI[locale] || UI.de;
const t = ui.sections;

const navItems = (['entdecken', 'orte', 'unterkuenfte', 'sehenswuerdigkeiten', 'aktivitaeten', 'gastro', 'camping', 'regionen', 'magazin'] as SectionKey[])
  .map((id) => ({ id, label: t[id] }));

// Chips on the picker → jump to the matching on-page section (real counts).
const chips = [
  { label: t.orte, count: counts.orte, href: '#orte' },
  { label: t.unterkuenfte, count: counts.unterkuenfte, href: '#unterkuenfte' },
  { label: t.sehenswuerdigkeiten, count: counts.sights, href: '#sehenswuerdigkeiten' },
  { label: t.aktivitaeten, count: counts.erlebnisse, href: '#aktivitaeten' },
  { label: t.gastro, count: counts.gastro, href: '#gastro' },
  { label: t.camping, count: counts.camping, href: '#camping' },
  { label: t.regionen, count: counts.regionen, href: '#regionen' },
];

const ART_FONTS: Record<string, string> = {
  en: 'https://fonts.googleapis.com/css2?family=Anton&display=swap',
  fr: 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap',
  cs: 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&display=swap',
  it: 'https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;800&display=swap',
  es: 'https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&display=swap',
  zh: 'https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;900&display=swap',
  nl: 'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap',
};
const artFont = ART_FONTS[locale];

const META_DESC: Record<string, string> = {
  de: 'Tirol entdecken: Regionen, Orte, Unterkünfte, Sehenswürdigkeiten, Aktivitäten, Gastro und Camping – auf einer Seite.',
  en: 'Discover Tyrol: regions, places, accommodations, sights, activities, food & drink and camping – on one page.',
  fr: 'Découvrez le Tyrol : régions, villages, hébergements, sites, activités, gastronomie et camping – sur une seule page.',
  cs: 'Objevte Tyrolsko: regiony, místa, ubytování, pamětihodnosti, aktivity, gastronomie a kempy – na jedné stránce.',
  nl: 'Ontdek Tirol: regio’s, plaatsen, accommodaties, bezienswaardigheden, activiteiten, eten & drinken en campings – op één pagina.',
  it: 'Scopri il Tirolo: regioni, paesi, alloggi, attrazioni, attività, gastronomia e campeggio – su una sola pagina.',
  es: 'Descubre el Tirol: regiones, pueblos, alojamientos, atracciones, actividades, gastronomía y camping – en una sola página.',
  zh: '探索蒂罗尔：地区、村镇、住宿、景点、活动、美食与露营——尽在一页。',
};
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{ui.title} — Tirol Tourismus</title>
  <meta name="description" content={META_DESC[locale] || META_DESC.en}>
  <meta name="theme-color" content="#FF1493">
  <meta name="robots" content="noindex">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
  {artFont && <link rel="stylesheet" href={artFont}>}
  <link rel="stylesheet" href="/assets/css/tirol.css">
</head>
<body class="demo-body">
  <LanguagePicker
    locale={locale}
    tiles={tiles}
    chips={chips}
    labels={{ ...ui.picker }}
  />

  <DemoNav
    locale={locale}
    brandHref="#sprache"
    items={navItems}
    langLinks={langLinks}
    labels={{ ...ui.nav }}
  />

  <main id="demo-content">
    <DemoContent
      locale={locale}
      localePrefix={localePrefix}
      page={page}
      regions={regions}
      stays={stays}
      sights={sights}
      gastro={gastro}
      magazin={magazin}
      counts={counts}
      regionNames={regionNames}
      erlebnisse={erlebnisse}
      events={events}
      camping={camping}
      orte={orte}
    />
  </main>

  <script is:inline>
    // Smooth scrolling for in-page anchors (progressive enhancement).
    (function () {
      'use strict';
      document.addEventListener('click', function (e) {
        var a = e.target.closest ? e.target.closest('a[href^="#"]') : null;
        if (!a) return;
        var id = a.getAttribute('href').slice(1);
        if (!id) return;
        var el = document.getElementById(id);
        if (!el) return;
        e.preventDefault();
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        if (history.replaceState) history.replaceState(null, '', '#' + id);
        else location.hash = id;
      });
    })();
  </script>
</body>
</html>

<style is:global>
  :root { --demo-nav-h: 64px; }
  @media (max-width: 640px) { :root { --demo-nav-h: 56px; } }

  html { scroll-behavior: smooth; }

  body.demo-body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  #sprache { scroll-margin-top: 0; }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--tirol-pink);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
