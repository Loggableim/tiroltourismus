---
// LanguagePicker.astro — Section 1 of the demo one-page (id="sprache", 100dvh).
// 8 language tiles, "Recommended" badge from navigator.languages, localStorage
// "Continue in" banner. Choosing a tile navigates to the static demo route
// /demofrontneu/<lang>#entdecken (de lives at /demofrontneu#entdecken).
import TirolLogo from '../TirolLogo.astro';

export interface PickerTile {
  code: string;
  htmlLang: string;
  name: string;
  tagline: string;
  accent: string;
  href: string;
}
export interface PickerChip {
  label: string;
  count: number;
  href: string;
}
export interface PickerLabels {
  title: string;
  subtitle: string;
  recommended: string;
  continueIn: string;
  aria: string;
  categoriesAria: string;
}

export interface Props {
  locale: string;
  tiles: PickerTile[];
  chips: PickerChip[];
  labels: PickerLabels;
}

const { locale, tiles, chips, labels } = Astro.props;
const nf = new Intl.NumberFormat('en-US');
---

<section id="sprache" class="df-picker" aria-label={labels.aria}>
  <a class="df-banner" id="dfContinueBanner" href="/demofrontneu" hidden>
    <span data-continue-text>{labels.continueIn}</span> <span id="dfContinueLang"></span> <span aria-hidden="true">→</span>
  </a>

  <header class="df-head">
    <a class="df-brand" href={tiles.find((t) => t.code === locale)?.href || '/demofrontneu'} aria-label="Tirol Tourismus">
      <TirolLogo width={168} idSuffix={`df-${locale}`} locale={locale} />
    </a>
    <h1 class="df-claim">{labels.title}</h1>
    <p class="df-sub">{labels.subtitle}</p>
  </header>

  <main class="df-langs" aria-label={labels.aria}>
    {tiles.map((t) => (
      <a
        class="df-tile"
        href={t.href}
        lang={t.htmlLang}
        data-lang={t.code}
        style={`--accent:${t.accent}`}
      >
        <span class="df-rec" lang={locale}>{labels.recommended}</span>
        <span class="df-name">{t.name}</span>
        <span class="df-tagline">{t.tagline}</span>
      </a>
    ))}
  </main>

  <nav class="df-cats" aria-label={labels.categoriesAria}>
    {chips.map((c) => (
      <a class="df-chip" href={c.href}>
        {c.label} <b>{nf.format(c.count)}</b>
      </a>
    ))}
  </nav>
</section>

<script is:inline>
  (function () {
    'use strict';
    var STORE = 'tirol-demo-lang';
    var tiles = {};
    var NAMES = {};
    document.querySelectorAll('.df-tile[data-lang]').forEach(function (a) {
      var code = a.getAttribute('data-lang');
      tiles[code] = a;
      var nameEl = a.querySelector('.df-name');
      NAMES[code] = nameEl ? nameEl.textContent.trim() : code;
    });

    function normalize(tag) {
      tag = String(tag || '').toLowerCase();
      if (!tag) return null;
      var base = tag.split('-')[0];
      return tiles[base] ? base : null;
    }

    // 1) Recommend the browser language (no auto redirect)
    var langs = [];
    try { langs = navigator.languages || [navigator.language]; } catch (e) {}
    var match = null;
    for (var i = 0; i < langs.length && !match; i++) match = normalize(langs[i]);
    if (match) {
      tiles[match].classList.add('recommended');
      tiles[match].setAttribute('aria-current', 'true');
    }

    // 2) Return visit → "Continue in <language> →"
    var saved = null;
    try { saved = localStorage.getItem(STORE); } catch (e) {}
    if (saved && tiles[saved]) {
      var banner = document.getElementById('dfContinueBanner');
      var label = document.getElementById('dfContinueLang');
      if (banner && label) {
        label.textContent = NAMES[saved] || saved;
        banner.setAttribute('href', tiles[saved].getAttribute('href'));
        banner.hidden = false;
      }
    }

    // 3) Save the chosen language on click
    Object.keys(tiles).forEach(function (code) {
      tiles[code].addEventListener('click', function () {
        try { localStorage.setItem(STORE, code); } catch (e) {}
      });
    });
  })();
</script>

<style is:global>
  .df-picker {
    position: relative;
    height: 100dvh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 1.2vh, 14px);
    padding: calc(var(--demo-nav-h, 64px) + clamp(8px, 1.6vh, 20px)) clamp(10px, 3vw, 40px) clamp(10px, 1.8vh, 22px);
    overflow: hidden;
    background:
      radial-gradient(60% 45% at 15% 0%, rgba(255, 20, 147, .08), transparent 70%),
      radial-gradient(55% 45% at 90% 100%, rgba(212, 168, 0, .10), transparent 70%),
      var(--bg);
  }

  .df-banner {
    align-self: center;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: clamp(5px, 1vh, 9px) clamp(12px, 2vw, 20px);
    border-radius: 100px;
    background: var(--tirol-pink-dark);
    color: #fff;
    font-size: clamp(11px, 1.5vh, 13px);
    font-weight: 700;
    letter-spacing: .3px;
    text-decoration: none;
    box-shadow: 0 8px 24px var(--tirol-pink-glow);
  }
  .df-banner[hidden] { display: none; }
  .df-banner:hover { filter: brightness(1.08); }

  .df-head {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(4px, .8vh, 10px);
    text-align: center;
  }
  .df-brand { display: inline-flex; line-height: 0; }
  .df-claim {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.6vh, 40px);
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text);
    line-height: 1;
  }
  .df-sub {
    font-size: clamp(10px, 1.5vh, 13px);
    color: var(--text2);
    max-width: 60ch;
  }

  .df-langs {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: clamp(6px, 1.1vh, 14px);
  }

  .df-tile {
    position: relative;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2px, .6vh, 6px);
    text-align: center;
    padding: clamp(6px, 1.4vh, 18px) clamp(8px, 1.4vw, 16px);
    border: 1px solid var(--glass-border);
    border-top: 4px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg2);
    color: var(--text);
    text-decoration: none;
    transition: transform .25s var(--ease), box-shadow .25s var(--ease), border-color .25s var(--ease);
  }
  .df-tile:hover {
    transform: translateY(-3px);
    border-color: var(--tirol-pink);
    box-shadow: 0 12px 32px rgba(0, 0, 0, .12);
  }
  .df-name {
    font-family: var(--font-display);
    font-size: clamp(20px, 3.6vh, 34px);
    line-height: 1;
    letter-spacing: 1px;
  }
  .df-tile[lang="zh"] .df-name { letter-spacing: 4px; }
  .df-tagline {
    font-size: clamp(9px, 1.5vh, 13px);
    line-height: 1.25;
    color: var(--text2);
  }

  .df-tile.recommended {
    border-color: var(--tirol-pink);
    box-shadow: 0 0 0 2px var(--tirol-pink), 0 12px 34px var(--tirol-pink-glow);
  }
  .df-rec {
    position: absolute;
    top: clamp(4px, .8vh, 8px);
    right: clamp(4px, .8vh, 8px);
    display: none;
    align-items: center;
    padding: 1px 7px;
    border-radius: 100px;
    background: var(--gold);
    color: #1A1A1A;
    font-size: clamp(8px, 1.1vh, 10px);
    font-weight: 700;
    letter-spacing: .5px;
    text-transform: uppercase;
  }
  .df-tile.recommended .df-rec { display: inline-flex; }

  .df-cats {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(4px, .9vh, 10px);
  }
  .df-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: clamp(4px, .9vh, 9px) clamp(8px, 1.4vw, 15px);
    border-radius: 100px;
    background: var(--surface);
    border: 1px solid var(--glass-border);
    color: var(--text);
    font-size: clamp(10px, 1.5vh, 13px);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: border-color .2s, color .2s, background .2s;
  }
  .df-chip b {
    font-family: var(--font-display);
    font-size: 1.2em;
    line-height: 1;
    color: var(--tirol-pink);
  }
  .df-chip:hover {
    border-color: var(--tirol-pink);
    color: var(--tirol-pink);
    background: rgba(255, 20, 147, .06);
  }

  @media (max-width: 640px) {
    .df-langs {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(4, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .df-tile, .df-chip { transition: none; }
  }
</style>
