---
// BaseLayout.astro — Hauptlayout mit Nav, Footer, Theme (Hell/Dunkel)
// Locale-aware SEO: canonical + hreflang alternates for all ready languages.
import { ViewTransitions } from 'astro:transitions';
import { readSingleton } from '../lib/content.js';
import { LANGUAGES, switchLangPath, DEFAULT_LOCALE, LANG_DOMAINS } from '../lib/languages.js';
import TirolLogo from '../components/TirolLogo.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Optional critical image to preload on pages with an actual above-the-fold LCP image. */
  preloadImage?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  locale?: string;
  publishedTime?: string;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  preloadImage,
  canonicalURL,
  type = 'website',
  locale = 'de',
  publishedTime,
  jsonld,
  noindex,
} = Astro.props;

// Locale helpers — dynamisch für alle Sprachen
const langCode = locale || 'de';
const LOCALE_MAP = { de:'de_AT', en:'en_US', fr:'fr_FR', it:'it_IT', es:'es_ES', zh:'zh_CN', nl:'nl_NL', cs:'cs_CZ' };
const HREFLANG_MAP = { de:'de-AT', en:'en-US', fr:'fr-FR', it:'it-IT', es:'es-ES', zh:'zh-CN', nl:'nl-NL', cs:'cs-CZ' };
const fullLocale = LOCALE_MAP[locale] || 'de_AT';
const localePrefix = locale === 'de' ? '' : `/${locale}`;
const siteDesc = description || ({ de:'Der smarte Tirol-Guide für Reiseplanung, Unterkünfte und Erlebnisse.', en:'The smart Tyrol guide for trip planning, accommodations and experiences.', fr:'Le guide intelligent du Tyrol pour planifier vos voyages, hébergements et expériences.', it:'La guida intelligente del Tirolo per pianificare viaggi, alloggi ed esperienze.', es:'La guía inteligente de Tirol para planificar viajes, alojamientos y experiencias.', zh:'智能蒂罗尔指南，用于旅行计划、住宿和体验。', nl:'De slimme Tirol-gids voor reisplanning, accommodaties en ervaringen.', cs:'Chytrý průvodce Tyrolskem pro plánování cest, ubytování a zážitky.' }[locale] || 'Der smarte Tirol-Guide für Reiseplanung, Unterkünfte und Erlebnisse.');
const settings = readSingleton('einstellungen', locale);

// Language switcher helper (imported from lib)
const currentPath = Astro.url.pathname;

const siteName = 'Tirol Tourismus';
const siteURL = LANG_DOMAINS[locale] || 'https://tiroltourismus.com';
const normalizePath = (path) => {
  const [pathname, suffix = ''] = String(path || '/').split(/(?=[?#])/);
  const cleanPath = pathname.replace(/\/+/g, '/') || '/';
  return cleanPath === '/' || cleanPath.endsWith('/') ? `${cleanPath}${suffix}` : `${cleanPath}/${suffix}`;
};
const absoluteURL = (path) => path.startsWith('http') ? path : `${siteURL}${normalizePath(path)}`;
const pageURL = canonicalURL ? absoluteURL(canonicalURL) : absoluteURL(Astro.url.pathname);
// hreflang: ALLE 8 Sprachen (auch die auf anderen Subdomains)
// switchLangPath liefert absolute URLs für Cross-Domain-Sprachen
const alternateLinks = LANGUAGES
  .map((l) => ({
    code: l.code,
    hreflang: HREFLANG_MAP[l.code] || l.code,
    href: switchLangPath(currentPath, locale, l.code), // already absolute for cross-domain
    ogLocale: LOCALE_MAP[l.code] || l.code,
  }));
const xDefaultURL = switchLangPath(currentPath, locale, DEFAULT_LOCALE);
const FALLBACK_OG = `${siteURL}/images/og-default.jpg`;
const ogImageAbs = ogImage ? (ogImage.startsWith('http') ? ogImage : `${siteURL}${ogImage}`) : FALLBACK_OG;
const preloadImageAbs = preloadImage ? (preloadImage.startsWith('http') ? preloadImage : preloadImage) : undefined;
const twitterCard = 'summary_large_image';

// Nav labels — Multi-Sprachen-Map
const NAV_LABELS = {
  de: { entdecken:'Entdecken', uebernachten:'Übernachten', aktivitaeten:'Aktivitäten', magazin:'Magazin', preise:'Preise', fuerBetriebe:'Für Betriebe', bezirke:'Bezirke', merkliste:'♥ Merkliste', anmelden:'Anmelden', konto:'Mein Konto', kontakt:'Kontakt', regionen:'Regionen', camping:'Campingplätze', unterkuenfte:'Unterkünfte', orte:'Orte', sehenswertes:'Sehenswertes', gastro:'Gastro', erlebnisse:'Erlebnisse', events:'Events', suche:'Suche', footer_p:'Der smarte Tirol-Guide für Reiseplanung, Unterkünfte und Erlebnisse.', footer_regionen:'Regionen', footer_alle_regionen:'Alle Regionen', footer_erlebnisse:'Erlebnisse', footer_alle_erlebnisse:'Alle Erlebnisse', footer_service:'Service', footer_ueber_uns:'Über uns', footer_fuer_betriebe:'Für Betriebe', footer_kontakt:'Kontakt', footer_impressum:'Impressum', footer_datenschutz:'Datenschutz', footer_agb:'AGB', footer_transparenz:'Transparenz', footer_oben:'↑ Zum Seitenanfang' },
  en: { entdecken:'Discover', uebernachten:'Stay', aktivitaeten:'Activities', magazin:'Magazine', preise:'Pricing', fuerBetriebe:'For Businesses', bezirke:'Districts', merkliste:'♥ Wishlist', anmelden:'Login', konto:'My Account', kontakt:'Contact', regionen:'Regions', camping:'Camping', unterkuenfte:'Accommodations', orte:'Places', sehenswertes:'Sights', gastro:'Food & Drink', erlebnisse:'Experiences', events:'Events', suche:'Search', footer_p:'The smart Tyrol guide for trip planning, accommodations and experiences.', footer_regionen:'Regions', footer_alle_regionen:'All Regions', footer_erlebnisse:'Experiences', footer_alle_erlebnisse:'All Experiences', footer_service:'Service', footer_ueber_uns:'About Us', footer_fuer_betriebe:'For Businesses', footer_kontakt:'Contact', footer_impressum:'Imprint', footer_datenschutz:'Privacy', footer_agb:'Terms', footer_transparenz:'Transparency', footer_oben:'↑ Back to top' },
  fr: { entdecken:'Découvrir', uebernachten:'Dormir', aktivitaeten:'Activités', magazin:'Magazine', preise:'Tarifs', fuerBetriebe:'Pour les Pros', bezirke:'Districts', merkliste:'♥ Favoris', anmelden:'Connexion', konto:'Mon Compte', kontakt:'Contact', regionen:'Régions', camping:'Camping', unterkuenfte:'Hébergements', orte:'Villages', sehenswertes:'Sites', gastro:'Gastronomie', erlebnisse:'Expériences', events:'Événements', suche:'Recherche', footer_p:'Le guide intelligent du Tyrol pour planifier vos voyages, hébergements et expériences.', footer_regionen:'Régions', footer_alle_regionen:'Toutes les Régions', footer_erlebnisse:'Expériences', footer_alle_erlebnisse:'Toutes les Expériences', footer_service:'Service', footer_ueber_uns:'À Propos', footer_fuer_betriebe:'Pour les Pros', footer_kontakt:'Contact', footer_impressum:'Mentions Légales', footer_datenschutz:'Confidentialité', footer_agb:'CGV', footer_transparenz:'Transparence', footer_oben:'↑ Haut de page' },
  it: { entdecken:'Scopri', uebernachten:'Dormire', aktivitaeten:'Attività', magazin:'Magazine', preise:'Prezzi', fuerBetriebe:'Per Aziende', bezirke:'Distretti', merkliste:'♥ Preferiti', anmelden:'Accedi', konto:'Mio Account', kontakt:'Contatti', regionen:'Regioni', camping:'Campeggio', unterkuenfte:'Alloggi', orte:'Paesi', sehenswertes:'Attrazioni', gastro:'Gastronomia', erlebnisse:'Esperienze', events:'Eventi', suche:'Cerca', footer_p:'La guida intelligente del Tirolo per pianificare viaggi, alloggi ed esperienze.', footer_regionen:'Regioni', footer_alle_regionen:'Tutte le Regioni', footer_erlebnisse:'Esperienze', footer_alle_erlebnisse:'Tutte le Esperienze', footer_service:'Servizio', footer_ueber_uns:'Chi Siamo', footer_fuer_betriebe:'Per Aziende', footer_kontakt:'Contatti', footer_impressum:'Impressum', footer_datenschutz:'Privacy', footer_agb:'Termini', footer_transparenz:'Trasparenza', footer_oben:'↑ Torna su' },
  es: { magazin:'Revista', preise:'Precios', fuerBetriebe:'Para Empresas', bezirke:'Distritos', merkliste:'♥ Favoritos', anmelden:'Iniciar Sesión', konto:'Mi Cuenta', kontakt:'Contacto', regionen:'Regiones', camping:'Camping', unterkuenfte:'Alojamientos', orte:'Pueblos', sehenswertes:'Atracciones', gastro:'Gastronomía', erlebnisse:'Experiencias', events:'Eventos', suche:'Buscar', footer_p:'La guía inteligente de Tirol para planificar viajes, alojamientos y experiencias.', footer_regionen:'Regiones', footer_alle_regionen:'Todas las Regiones', footer_erlebnisse:'Experiencias', footer_alle_erlebnisse:'Todas las Experiencias', footer_service:'Servicio', footer_ueber_uns:'Sobre Nosotros', footer_fuer_betriebe:'Para Empresas', footer_kontakt:'Contacto', footer_impressum:'Aviso Legal', footer_datenschutz:'Privacidad', footer_agb:'Términos', footer_transparenz:'Transparencia', footer_oben:'↑ Volver arriba' },
  zh: { magazin:'杂志', preise:'价格', fuerBetriebe:'企业服务', bezirke:'行政区', merkliste:'♥ 收藏夹', anmelden:'登录', konto:'我的账户', kontakt:'联系我们', regionen:'地区', camping:'露营', unterkuenfte:'住宿', orte:'村镇', sehenswertes:'景点', gastro:'美食', erlebnisse:'体验', events:'活动', suche:'搜索', footer_p:'智能蒂罗尔指南，用于旅行计划、住宿和体验。', footer_regionen:'地区', footer_alle_regionen:'所有地区', footer_erlebnisse:'体验', footer_alle_erlebnisse:'所有体验', footer_service:'服务', footer_ueber_uns:'关于我们', footer_fuer_betriebe:'企业服务', footer_kontakt:'联系我们', footer_impressum:'法律声明', footer_datenschutz:'隐私政策', footer_agb:'使用条款', footer_transparenz:'透明度', footer_oben:'↑ 返回顶部' },
  nl: { magazin:'Magazine', preise:'Prijzen', fuerBetriebe:'Voor bedrijven', bezirke:'Districten', merkliste:'♥ Verlanglijst', anmelden:'Inloggen', konto:'Mijn account', kontakt:'Contact', regionen:'Regio’s', camping:'Campings', unterkuenfte:'Accommodaties', orte:'Plaatsen', sehenswertes:'Bezienswaardigheden', gastro:'Eten & drinken', erlebnisse:'Belevenissen', events:'Evenementen', suche:'Zoeken', footer_p:'De slimme Tirol-gids voor reisplanning, accommodaties en ervaringen.', footer_regionen:'Regio’s', footer_alle_regionen:'Alle regio’s', footer_erlebnisse:'Belevenissen', footer_alle_erlebnisse:'Alle belevenissen', footer_service:'Service', footer_ueber_uns:'Over ons', footer_fuer_betriebe:'Voor bedrijven', footer_kontakt:'Contact', footer_impressum:'Impressum', footer_datenschutz:'Privacy', footer_agb:'Voorwaarden', footer_transparenz:'Transparantie', footer_oben:'↑ Naar boven' },
};
const nav = NAV_LABELS[locale] || NAV_LABELS.de;

// JSON-LD: WebSite with SearchAction
const websiteLD = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteURL,
  description: ({ de:'Der smarte Tirol-Guide für Reiseplanung, Unterkünfte und Erlebnisse.', en:'The smart Tyrol guide for trip planning, accommodations and experiences.', fr:'Le guide intelligent du Tyrol pour planifier vos voyages, hébergements et expériences.', it:'La guida intelligente del Tirolo per pianificare viaggi, alloggi ed esperienze.', es:'La guía inteligente de Tirol para planificar viajes, alojamientos y experiencias.', zh:'智能蒂罗尔指南，用于旅行计划、住宿和体验。', nl:'De slimme Tirol-gids voor reisplanning, accommodaties en ervaringen.', cs:'Chytrý průvodce Tyrolskem pro plánování cest, ubytování a zážitky.' }[locale] || 'Der smarte Tirol-Guide für Reiseplanung, Unterkünfte und Erlebnisse.'),
  inLanguage: langCode,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteURL}${localePrefix}/suche?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// JSON-LD: Organization with Tirol address
const organizationLD = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: siteURL,
  logo: `${siteURL}/favicon.svg`,
  description: ({ de:'Der smarte Tirol-Guide für Reiseplanung, Unterkünfte und Erlebnisse.', en:'The smart Tyrol guide for trip planning, accommodations and experiences.', fr:'Le guide intelligent du Tyrol pour planifier vos voyages, hébergements et expériences.', it:'La guida intelligente del Tirolo per pianificare viaggi, alloggi ed esperienze.', es:'La guía inteligente de Tirol para planificar viajes, alojamientos y experiencias.', zh:'智能蒂罗尔指南，用于旅行计划、住宿和体验。', nl:'De slimme Tirol-gids voor reisplanning, accommodaties en ervaringen.' }[locale] || 'Der smarte Tirol-Guide für Reiseplanung, Unterkünfte und Erlebnisse.'),
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'AT',
    addressRegion: 'Tirol',
  },
};

// Allow pages to supply additional LD fragments (e.g. TouristDestination, Event, FAQPage, LocalBusiness)
// Added as separate block — never merged into websiteLD
const extraLD = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const ldBlocks = [websiteLD, organizationLD, ...extraLD];
---

<!DOCTYPE html>
<html lang={langCode}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={siteDesc}>
  <meta name="theme-color" content="#FF1493">
  <ViewTransitions />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {alternateLinks.map((link) => (
    <link rel="alternate" href={link.href} hreflang={link.hreflang} />
  ))}
  <link rel="alternate" href={xDefaultURL} hreflang="x-default" />
  <!-- Fonts: display=swap + preconnect for optimal loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700&display=swap" crossorigin fetchpriority="high">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all';this.onload=null;this.removeAttribute('media');">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700&display=swap"></noscript>

  <!-- Canonical URL -->
  <link rel="canonical" href={pageURL} />

  <!-- OpenGraph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={siteDesc} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={pageURL} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={fullLocale} />
  {alternateLinks.filter((link) => link.code !== locale).map((link) => (
    <meta property="og:locale:alternate" content={link.ogLocale} />
  ))}
  {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content={twitterCard} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={siteDesc} />
  {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}
  {preloadImageAbs && (
    <link rel="preload" as="image" href={preloadImageAbs} fetchpriority="high" imagesizes="100vw" />
  )}
  <link rel="preload" href="/assets/css/tirol.css" as="style" fetchpriority="high">
  <link rel="stylesheet" href="/assets/css/tirol.css" media="print" onload="this.media='all';this.onload=null;">
  <noscript><link rel="stylesheet" href="/assets/css/tirol.css"></noscript>
  <style is:inline>
    /* ─── Critical: Design Tokens, Reset, Nav, Hero ─── */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    /* ── Design Tokens ─────────────────────────────────────
       Naming convention: --tirol-* for brand colors,
       --pop-* for accent/pop colors, --ikea-* for blue.
       No aliases — use the primary name in new code.
    ─────────────────────────────────────────────────────── */
    :root{
      --bg:#F5F3F0;--bg2:#EDE8E2;
      --surface:rgba(0,0,0,.03);--surface-hover:rgba(0,0,0,.06);
      --text:#1A1A1A;--text2:rgba(0,0,0,.60);--text3:rgba(0,0,0,.38);
      /* Brand colors */
      --tirol-red:#C8102E;
      --tirol-pink:#FF1493;--tirol-pink-dark:#C0006E;--tirol-pink-glow:rgba(255,20,147,.12);
      --ikea-blue:#0051BA;
      --pop-yellow:#FFD700;
      --pop-green:#00C853;--pop-orange:#FF6B35;--pop-purple:#8B5CF6;
      --gold:#D4A800;--gold-light:#FFD700;--gold-glow:rgba(212,168,0,.18);--gold-soft:rgba(212,168,0,.08);
      /* Short aliases for readability (use primary name in new code) */
      --pink:var(--tirol-pink);--pink-dark:var(--tirol-pink-dark);--pink-glow:var(--tirol-pink-glow);
      --blue:var(--ikea-blue);--yellow:var(--pop-yellow);
      --orange:var(--pop-orange);--purple:var(--pop-purple);--green:var(--pop-green);
      --glass:rgba(255,255,255,.7);--glass-border:rgba(0,0,0,.06);--glass-shadow:0 12px 48px rgba(0,0,0,.06);
      --font-display:'Bebas Neue',Impact,'Arial Narrow',sans-serif;
      --font-body:'Montserrat',-apple-system,sans-serif;
      --ease:cubic-bezier(.16,1,.3,1);
      --radius:12px;--radius-sm:8px;--radius-lg:20px;
    }
    [data-theme="alpenpeak"]{
      --bg:#0A0A12;--bg2:#10101E;
      --surface:rgba(255,255,255,.04);--surface-hover:rgba(255,255,255,.08);
      --text:#F0EDEE;--text2:rgba(255,255,255,.65);--text3:rgba(255,255,255,.30);
      --glass:rgba(255,255,255,.06);--glass-border:rgba(255,255,255,.08);--glass-shadow:0 12px 48px rgba(0,0,0,.5);
      --tirol-pink-glow:rgba(255,20,147,.18);--gold-glow:rgba(255,215,0,.15);--gold-soft:rgba(255,215,0,.06);
    }
    html{scroll-behavior:smooth}
    body{font-family:var(--font-body);color:var(--text);background:var(--bg);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden;transition:background .6s,color .6s}
    a{color:inherit;text-decoration:none}::selection{background:var(--tirol-pink);color:var(--bg)}img{max-width:100%;height:auto;display:block}

    .topbar{background:rgba(0,0,0,.3);backdrop-filter:blur(12px);padding:8px 0;font-size:12px;color:rgba(255,255,255,.7);position:fixed;top:0;left:0;right:0;z-index:1002;transition:transform .4s var(--ease)}
    [data-theme="alpenpeak"] .topbar{background:rgba(10,10,18,.6);backdrop-filter:blur(20px);border-bottom:1px solid var(--glass-border)}
    .topbar .container{display:flex;justify-content:space-between;align-items:center;width:100%}
    .topbar-l,.topbar-r{display:flex;align-items:center;gap:16px}
    /* ═══ TOPBAR LANGUAGE SELECTOR ═══ */
    .topbar-lang-selector{position:relative;display:flex;align-items:center}
    .lang-current{display:flex;align-items:center;gap:5px;padding:3px 10px;border-radius:6px;cursor:pointer;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);color:rgba(255,255,255,.8);font-size:11px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;transition:all .2s;border:none;font-family:inherit}
    .lang-current:hover{background:rgba(255,255,255,.12)}
    .lang-flag{font-size:14px;line-height:1}
    .lang-chevron{transition:transform .2s;opacity:.6}
    .topbar-lang-selector.open .lang-chevron{transform:rotate(180deg)}
    .lang-dropdown{position:absolute;top:100%;left:0;margin-top:4px;min-width:150px;background:rgba(10,10,18,.95);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:4px;display:none;flex-direction:column;box-shadow:0 12px 40px rgba(0,0,0,.5);z-index:2000}
    .topbar-lang-selector.open .lang-dropdown{display:flex}
    .lang-dropdown a{display:flex;align-items:center;gap:8px;padding:7px 12px;border-radius:6px;font-size:12px;color:rgba(255,255,255,.6);text-decoration:none;transition:all .15s}
    .lang-dropdown a:hover{background:rgba(255,255,255,.06);color:#fff}
    .lang-dropdown a.active{color:var(--tirol-pink);font-weight:600;background:rgba(255,20,147,.1)}
    .lang-dropdown a.disabled{opacity:.4;pointer-events:none}
    .lang-badge{font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:1px 5px;border-radius:4px;background:rgba(255,255,255,.08);color:rgba(255,255,255,.4)}
    .fav-link{display:inline-flex;align-items:center;gap:4px;position:relative}
    .fav-badge{position:absolute;top:-5px;right:-8px;min-width:18px;height:18px;border-radius:50%;background:var(--tirol-pink);color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 4px}
    .main-nav{height:64px;position:fixed;top:6px;left:20px;right:20px;z-index:1000;border-radius:100px;background:#fff;box-shadow:0 2px 20px rgba(0,0,0,.06);border:1px solid rgba(0,0,0,.04);padding:0 8px 0 24px;max-width:1160px;margin:0 auto;transition:all .5s var(--ease)}
    [data-theme="alpenpeak"] .main-nav{background:rgba(10,10,18,.5);backdrop-filter:blur(24px);border:1px solid var(--glass-border);box-shadow:none}
    .main-nav .container{display:flex;align-items:center;justify-content:space-between;height:100%;max-width:none;padding:0}
    .nav-logo{display:flex;align-items:center;font-family:var(--font-display);font-size:26px;letter-spacing:2px;text-transform:uppercase;color:var(--text)}
    .nav-links{display:flex;gap:0;align-items:center}
    .nav-login,.nav-dash{display:flex;align-items:center;gap:3px;padding:5px 10px;font-size:11px;font-weight:600;border-radius:100px;background:var(--tirol-pink);color:#fff!important;transition:all .3s;white-space:nowrap;letter-spacing:.2px;text-decoration:none}
    .nav-login:hover,.nav-dash:hover{opacity:.85;transform:translateY(-1px)}
    .nav-links a{padding:6px 6px;font-size:11px;font-weight:600;letter-spacing:.3px;color:#111;transition:all .3s;border-radius:100px;white-space:nowrap}
    .mega-group{position:relative}
    .mega-trigger{display:flex;align-items:center;gap:4px;padding:6px 10px;font-size:11px;font-weight:600;letter-spacing:.3px;color:#111;border:none;background:none;cursor:pointer;border-radius:100px;font-family:inherit;transition:all .3s}
    [data-theme="alpenpeak"] .mega-trigger{color:var(--text)}
    .mega-trigger:hover{background:rgba(0,0,0,.04)}
    .mega-chev{transition:transform .2s;opacity:.6}
    .mega-group.open .mega-chev{transform:rotate(180deg)}
    .mega-drop{position:absolute;top:100%;left:0;margin-top:6px;min-width:200px;background:rgba(255,255,255,.98);backdrop-filter:blur(24px);border:1px solid rgba(0,0,0,.06);border-radius:16px;padding:6px;display:none;flex-direction:column;box-shadow:0 16px 48px rgba(0,0,0,.1);z-index:2000}
    [data-theme="alpenpeak"] .mega-drop{background:rgba(10,10,18,.95);border:1px solid var(--glass-border);box-shadow:0 16px 48px rgba(0,0,0,.5)}
    .mega-drop a{padding:10px 14px!important;font-size:13px!important;border-radius:10px;color:#111!important}
    [data-theme="alpenpeak"] .mega-drop a{color:var(--text)!important}
    .mega-drop a:hover{background:rgba(255,20,147,.08)!important;color:var(--tirol-pink)!important}
    .mega-group.open .mega-drop{display:flex}
    .nav-r{display:flex;align-items:center;gap:6px}
    .nav-search{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--text2);cursor:pointer}
    .hamburger{display:none;flex-direction:column;gap:4px;padding:8px;cursor:pointer}
    .hamburger span{width:20px;height:2px;background:var(--text);border-radius:2px}
    .fav-heart{position:absolute;top:8px;right:8px;z-index:5;width:32px;height:32px;border-radius:50%;background:rgba(0,0,0,.35);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;font-size:16px;cursor:pointer;transition:all .25s;color:#fff;user-select:none;border:none;font-family:inherit}
    .fav-heart:hover{transform:scale(1.15);background:rgba(220,38,38,.7)}
    .fav-heart.active{color:#FF1493;background:rgba(255,20,147,.15)}
    .fav-heart.active:hover{background:rgba(220,38,38,.2)}
    @media(max-width:600px){.stat-btn,.collection-filter button,.filter-chip{min-width:44px;min-height:36px;padding:6px 12px!important;font-size:12px!important}}
    @media(max-width:1100px){.main-nav{left:12px;right:12px;border-radius:16px;padding:0 4px 0 16px}.nav-links,.nav-login{display:none}.hamburger{display:flex}}
    @media(min-width:1101px){.main-nav{left:50%;transform:translateX(-50%);width:calc(100% - 40px)}}
    .mobile-menu{position:fixed;top:0;left:0;width:100%;height:100vh;background:rgba(10,10,18,.97);backdrop-filter:blur(40px);z-index:999;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:24px;opacity:0;pointer-events:none;transition:all .5s var(--ease)}
    .mobile-menu.open{opacity:1;pointer-events:all}
    .mobile-menu a{font-family:var(--font-display);font-size:52px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.5)}
    .mobile-close{position:absolute;top:20px;right:24px;font-size:36px;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff}
    .page-header{position:relative;padding:60px 0 40px;text-align:center;background:var(--bg2);border-bottom:1px solid var(--glass-border);overflow:hidden}
    .page-header h1{font-family:var(--font-display);font-size:clamp(42px,6vw,80px);line-height:1;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}
    .section-header{text-align:center;margin-bottom:48px;position:relative}
    .section-header::after{content:'';display:block;width:80px;height:3px;margin:14px auto 0;border-radius:2px;background:linear-gradient(90deg,var(--tirol-pink),var(--gold))}
    .daily .section-header::after{background:linear-gradient(90deg,var(--tirol-pink),var(--gold),var(--tirol-pink))}
    .section-title{font-family:var(--font-display);font-size:clamp(48px,7vw,96px);line-height:1;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}
    .section-label{font-family:var(--font-display);font-size:20px;letter-spacing:2px;margin-bottom:4px}
    .section-desc{font-size:15px;color:var(--text2);max-width:560px;margin:0 auto;line-height:1.7}
    .breadcrumbs{display:flex;align-items:center;gap:8px;padding:12px 0;font-size:12px;color:var(--text3)}
    .theme-toggle{position:fixed;top:64px;right:28px;z-index:1001;width:40px;height:40px;border-radius:50%;background:var(--glass);backdrop-filter:blur(20px);border:1px solid var(--glass-border);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .4s var(--ease);color:var(--text);box-shadow:0 4px 16px rgba(0,0,0,.08)}
    /* ═══ FLOATING LANGUAGE GLOBE ═══ */
    .floating-lang{position:fixed;right:24px;top:50%;transform:translateY(-50%);z-index:999}
    .floating-lang-btn{width:46px;height:46px;border-radius:50%;background:rgba(10,10,18,.5);backdrop-filter:blur(20px);border:1px solid var(--glass-border);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:20px;transition:all .3s var(--ease);color:var(--text);box-shadow:0 6px 24px rgba(0,0,0,.25);border:none;font-family:inherit}
    .floating-lang-btn:hover{transform:scale(1.1);border-color:var(--tirol-pink)}
    .floating-lang-panel{position:absolute;right:56px;top:50%;transform:translateY(-50%);background:rgba(10,10,18,.95);backdrop-filter:blur(24px);border:1px solid var(--glass-border);border-radius:var(--radius-lg);padding:6px;display:none;flex-direction:column;gap:2px;min-width:180px;box-shadow:0 16px 48px rgba(0,0,0,.5)}
    .floating-lang.open .floating-lang-panel{display:flex}
    .floating-lang-panel a{display:flex;align-items:center;gap:10px;padding:9px 14px;border-radius:8px;font-size:12px;color:var(--text2);text-decoration:none;transition:all .15s}
    .floating-lang-panel a:hover{background:var(--glass);color:var(--text)}
    .floating-lang-panel a.active{color:var(--tirol-pink);font-weight:600;background:rgba(255,20,147,.08)}
    .floating-lang-panel a.disabled{opacity:.4;pointer-events:none}
    .fl-flag{font-size:18px;width:22px;text-align:center}
    .fl-name{flex:1}
    .fl-check{color:var(--tirol-pink);font-size:12px}
    @media(max-width:768px){.floating-lang{display:none}}
    @media(min-width:769px){main>section:not(:first-child),.footer{content-visibility:auto;contain-intrinsic-size:1px 700px}}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
    /* ═══ FOOTER LANGUAGE FLAGS ═══ */
    .footer-lang{display:flex;align-items:center;gap:6px;margin-top:16px;flex-wrap:wrap}
    .footer-lang a{display:flex;align-items:center;gap:5px;padding:4px 10px;border-radius:100px;font-size:11px;font-weight:500;color:var(--text3);text-decoration:none;transition:all .2s;background:var(--surface);border:1px solid var(--glass-border)}
    .footer-lang a:hover{color:var(--text);border-color:var(--tirol-pink)}
    .footer-lang a.active{color:var(--tirol-pink);background:rgba(255,20,147,.08);border-color:rgba(255,20,147,.25)}
    .footer-lang a.disabled{opacity:.35;pointer-events:none}

    /* ═══ Above-the-Fold: Container, Hero, Stats, Buttons ─── */
    .container{width:100%;max-width:1160px;margin:0 auto;padding:0 24px}
    @media(max-width:600px){.container{padding:0 16px}}

    /* Hero */
    .hero{position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#0A0A12;padding-top:80px}
    .hero-bg{position:absolute;inset:0;z-index:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
    .hero-bg img{width:100%;height:100%;object-fit:cover;opacity:0.45;filter:saturate(1.4) contrast(1.1) brightness(0.9);animation:none}
    .hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#0A0A12 0%,transparent 50%),linear-gradient(180deg,rgba(10,10,18,.5) 0%,transparent 30%),linear-gradient(90deg,rgba(255,20,147,0.15) 0%,transparent 50%,rgba(212,168,0,0.08) 100%);pointer-events:none}
    .hero-glow{position:absolute;bottom:-30%;left:50%;transform:translateX(-50%);width:800px;height:800px;border-radius:50%;background:radial-gradient(circle,rgba(255,20,147,0.3) 0%,rgba(212,168,0,0.1) 30%,transparent 60%);filter:blur(80px);z-index:1;pointer-events:none;animation:glowPulse 6s ease-in-out infinite alternate}
    .hero-content{position:relative;z-index:3;text-align:center;padding:40px 24px 80px;max-width:1100px}
    .hero-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 24px;border-radius:100px;background:rgba(255,255,255,.08);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.12);font-size:13px;font-weight:600;color:rgba(255,255,255,.85);margin-bottom:20px}
    .hero-headline{font-family:var(--font-display);font-size:clamp(48px,10vw,120px);line-height:.88;letter-spacing:3px;text-transform:uppercase;margin-bottom:20px;color:#fff}
    .hero-headline .line{display:block}
    .hero-headline h1{font-size:inherit;line-height:inherit;margin:0}
    .hero p{font-size:clamp(15px,2vw,18px);color:rgba(255,255,255,.7);max-width:600px;margin:0 auto 28px;line-height:1.7}
    .hero-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
    .btn-primary,.btn-secondary{display:inline-flex;align-items:center;gap:8px;padding:14px 32px;border-radius:100px;font-weight:600;font-size:14px;letter-spacing:.5px;cursor:pointer;transition:all .4s var(--ease);text-decoration:none;font-family:inherit}
    .btn-primary{background:linear-gradient(135deg,var(--tirol-pink),var(--tirol-pink-dark));color:#fff;box-shadow:0 8px 24px var(--tirol-pink-glow, rgba(255,20,147,.35));border:none}
    .btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 32px var(--tirol-pink-glow, rgba(255,20,147,.5))}
    .btn-secondary{background:rgba(255,255,255,.08);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.15);color:#fff}
    .btn-secondary:hover{background:rgba(255,255,255,.16);transform:translateY(-2px)}
    .btn-outline{display:inline-flex;align-items:center;gap:6px;padding:10px 24px;border-radius:100px;font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--text2);border:1px solid var(--glass-border);cursor:pointer;text-decoration:none;transition:all .3s var(--ease);font-family:inherit;background:transparent}
    .btn-outline:hover{color:var(--text);border-color:var(--tirol-pink);background:rgba(255,20,147,.06)}

    /* Stats */
    .stats{padding:60px 0;background:var(--bg2);border-top:1px solid var(--glass-border);border-bottom:1px solid var(--glass-border)}
    .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px}
    .stat-card{padding:24px 16px;text-align:center;background:var(--surface);border-radius:var(--radius);border:1px solid var(--glass-border);transition:all .3s var(--ease)}
    .stat-icon{font-size:36px;display:block;margin-bottom:8px}
    .stat-num{font-family:var(--font-display);font-size:48px;line-height:1;letter-spacing:1px;margin-bottom:4px;background:linear-gradient(135deg,var(--tirol-pink),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .stat-label{font-size:12px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:var(--text2)}
    @media(max-width:600px){.stats{padding:40px 0}.stats-grid{grid-template-columns:repeat(2,1fr);gap:12px}.stat-num{font-size:36px}}

    /* Footer */
    .footer{padding:48px 0 64px;background:var(--bg2);border-top:1px solid var(--glass-border)}
    .footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px}
    .footer-col{display:flex;flex-direction:column;gap:10px}
    .footer-logo{font-family:var(--font-display);font-size:24px;letter-spacing:2px;text-transform:uppercase;font-weight:700}
    .footer h4{font-size:12px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--text3)}
    .footer a{font-size:13px;color:var(--text2);text-decoration:none}
    .footer a:hover{color:var(--tirol-pink)}
    .footer-social{display:flex;gap:12px;margin-top:8px}
    .footer-small{font-size:11px;color:var(--text3);margin-top:24px;border-top:1px solid var(--glass-border);padding-top:16px}
    @media(max-width:768px){.footer-grid{grid-template-columns:1fr 1fr;gap:24px}}
    @media(max-width:480px){.footer-grid{grid-template-columns:1fr}.footer{padding:32px 0 48px}.footer-small{font-size:10px}}
  </style>

  <!-- JSON-LD Structured Data -->
  {ldBlocks.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}
</head>
<body>
<div id="scrollProgress" transition:persist></div>
<button class="btt" id="backToTop" aria-label="Nach oben" transition:persist>↑</button>
  <button class="theme-toggle" id="themeToggle" aria-label="Tag/Nacht umschalten" transition:persist>
    <svg class="theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
    </svg>
    <svg class="theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </button>

  <!-- NAV -->
  <nav class="main-nav" id="mainNav" transition:persist>
    <div class="container">
<a href={localePrefix || '/'} class="nav-logo" style="flex-shrink:0">
  <TirolLogo width={340} idSuffix="nav" />
</a>
      <div class="nav-links">
        <div class="mega-group" data-group="entdecken">
          <button class="mega-trigger" onclick="toggleMega('entdecken')">
            {nav.entdecken} <svg class="mega-chev" viewBox="0 0 10 6" width="10" height="6"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="mega-drop" id="mega-entdecken">
            <a href={`${localePrefix}/regionen/`}>{nav.regionen}</a>
            <a href={`${localePrefix}/orte/`}>{nav.orte}</a>
            <a href={`${localePrefix}/bezirke/`}>{nav.bezirke || 'Bezirke'}</a>
            <a href={`${localePrefix}/sehenswuerdigkeiten/`}>{nav.sehenswertes}</a>
          </div>
        </div>
        <div class="mega-group" data-group="uebernachten">
          <button class="mega-trigger" onclick="toggleMega('uebernachten')">
            {nav.uebernachten} <svg class="mega-chev" viewBox="0 0 10 6" width="10" height="6"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="mega-drop" id="mega-uebernachten">
            <a href={`${localePrefix}/unterkuenfte/`}>{nav.unterkuenfte}</a>
            <a href={`${localePrefix}/camping/`}>{nav.camping}</a>
          </div>
        </div>
        <div class="mega-group" data-group="aktivitaeten">
          <button class="mega-trigger" onclick="toggleMega('aktivitaeten')">
            {nav.aktivitaeten} <svg class="mega-chev" viewBox="0 0 10 6" width="10" height="6"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="mega-drop" id="mega-aktivitaeten">
            <a href={`${localePrefix}/gastro/`}>{nav.gastro}</a>
            <a href={`${localePrefix}/erlebnisse/`}>{nav.erlebnisse}</a>
            <a href={`${localePrefix}/events/`}>{nav.events}</a>
          </div>
        </div>
        <a href={`${localePrefix}/magazin/`} class={Astro.url.pathname.includes('magazin') ? 'active' : ''}>{nav.magazin}</a>
      </div>
      <div class="nav-r">
        <button class="nav-search" onclick={`window.location.href='${localePrefix}/suche/'`} aria-label={nav.suche}>🔍</button>
        <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
      </div>
    </div>
  </nav>

  <div class="mobile-menu" id="mobileMenu" onclick="this.classList.remove('open')" transition:persist>
    <button class="mobile-close" id="mobileClose">&times;</button>
    <a href={`${localePrefix}/regionen/`}>{nav.regionen}</a>
    <a href={`${localePrefix}/unterkuenfte/`}>{nav.unterkuenfte}</a>
    <a href={`${localePrefix}/camping/`}>{nav.camping}</a>
    <a href={`${localePrefix}/orte/`}>{nav.orte}</a>
    <a href={`${localePrefix}/bezirke/`}>{nav.bezirke || 'Bezirke'}</a>
    <a href={`${localePrefix}/sehenswuerdigkeiten/`}>{nav.sehenswertes}</a>
    <a href={`${localePrefix}/gastro/`}>{nav.gastro}</a>
    <a href={`${localePrefix}/erlebnisse/`}>{nav.erlebnisse}</a>
    <a href={`${localePrefix}/events/`}>{nav.events}</a>
    <a href={`${localePrefix}/magazin/`}>{nav.magazin}</a>
    <a href={`${localePrefix}/suche/`}>🔍 {nav.suche}</a>
    <a href={`${localePrefix}/merkliste/`}>{nav.merkliste}</a>
    <a href={`${localePrefix}/kontakt/`}>{nav.kontakt}</a>
  </div>

  <slot />

  <!-- ═══ FLOATING LANGUAGE GLOBE ═══ -->
  <div class="floating-lang" id="floatingLang">
    <button class="floating-lang-btn" onclick="document.getElementById('floatingLang').classList.toggle('open')" aria-label="Sprache ändern">
      🌐
    </button>
    <div class="floating-lang-panel">
      {LANGUAGES.map(l => (
        <a href={switchLangPath(currentPath, locale, l.code)} class:list={{ active: l.code === locale, disabled: !l.ready }}>
          <span class="fl-flag">{l.flag}</span>
          <span class="fl-name">{l.name}</span>
          {l.code === locale && <span class="fl-check">✓</span>}
        </a>
      ))}
    </div>
  </div>

  <!-- Weather Widget: planned for Phase 2 — currently removed to avoid empty container. -->


  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col footer-brand">
          <a href={localePrefix || '/'} class="nav-logo">
            <TirolLogo width={240} idSuffix="ft" />
          </a>
          <p>{nav.footer_p}</p>
          <div class="footer-social">
            <a href={settings?.social?.instagram || '#'} aria-label="Instagram">📷</a>
            <a href={settings?.social?.tiktok || '#'} aria-label="TikTok">🎵</a>
            <a href={settings?.social?.facebook || '#'} aria-label="Facebook">👍</a>
            <a href={settings?.social?.youtube || '#'} aria-label="YouTube">▶️</a>
          </div>
          <!-- ═══ FOOTER LANGUAGE FLAGS ═══ -->
          <div class="footer-lang">
            {LANGUAGES.map(l => (
              <a href={switchLangPath(currentPath, locale, l.code)} class:list={{ active: l.code === locale, disabled: !l.ready }}>
                {l.flag} {l.name}
              </a>
            ))}
          </div>
        </div>
        <div class="footer-col"><h4>{nav.footer_regionen}</h4><a href={`${localePrefix}/regionen/`}>{nav.footer_alle_regionen}</a><a href={`${localePrefix}/regionen/oetztal/`}>Ötztal</a></div>
        <div class="footer-col"><h4>{nav.footer_erlebnisse}</h4><a href={`${localePrefix}/erlebnisse/`}>{nav.footer_alle_erlebnisse}</a></div>
        <div class="footer-col"><h4>{nav.footer_service}</h4><a href={`${localePrefix}/magazin/`}>{nav.magazin}</a><a href={`${localePrefix}/merkliste/`}>{nav.merkliste}</a><a href={`${localePrefix}/ueber-uns/`}>{nav.footer_ueber_uns}</a><a href={`${localePrefix}/kontakt/`}>{nav.kontakt}</a><a href={`${localePrefix}/transparenz/`}>{nav.footer_transparenz}</a><a href={`${localePrefix}/impressum/`}>{nav.footer_impressum}</a><a href={`${localePrefix}/datenschutz/`}>{nav.footer_datenschutz}</a><a href={`${localePrefix}/agb/`}>{nav.footer_agb}</a></div>
    </div>

    <div class="footer-small">
      <div class="footer-bottom">
        <span>© 2026 tiroltourismus.com</span>
        <div><a href={`${localePrefix}/impressum/`}>{nav.footer_impressum}</a><a href={`${localePrefix}/datenschutz/`}>{nav.footer_datenschutz}</a><a href="#" class="footer-btt" id="footerBackToTop">{nav.footer_oben}</a></div>
      </div>
    </div>
  </footer>
  <script is:inline>
  (function(){'use strict';
    document.addEventListener('click',function(e){
      var fl=document.getElementById('floatingLang');
      if(fl&&!fl.contains(e.target))fl.classList.remove('open');
    });
    // Mega Menu Toggle
    window.toggleMega = function(group) {
      var el = document.getElementById('mega-' + group);
      if (!el) return;
      var parent = el.closest('.mega-group');
      // Close other open mega menus
      document.querySelectorAll('.mega-group.open').forEach(function(g) {
        if (g !== parent) g.classList.remove('open');
      });
      parent.classList.toggle('open');
    };
    // Close mega menu on outside click
    document.addEventListener('click', function(e) {
      document.querySelectorAll('.mega-group.open').forEach(function(g) {
        if (!g.contains(e.target)) g.classList.remove('open');
      });
    });
    // Session-Check: Anmelden vs. Mein Konto
    (function(){
      var hasSession = document.cookie.indexOf('session=') >= 0;
      var loginBtn = document.getElementById('navLoginBtn');
      var dashBtn = document.getElementById('navDashBtn');
      var mobLogin = document.getElementById('mobLoginBtn');
      var mobDash = document.getElementById('mobDashBtn');
      if (hasSession) {
        if (loginBtn) loginBtn.style.display = 'none';
        if (dashBtn) dashBtn.style.display = 'flex';
        if (mobLogin) mobLogin.style.display = 'none';
        if (mobDash) mobDash.style.display = 'block';
      }
    })();
    // Favoriten-Toggle (global, aufgerufen von FavHeart)
    window.toggleFav = function(el) {
      var col = el.getAttribute('data-collection');
      var slug = el.getAttribute('data-slug');
      if (!col || !slug) return;
      var wasActive = el.classList.contains('active');
      // Optimistisches Toggle
      el.classList.toggle('active');
      el.textContent = wasActive ? '♡' : '♥';
      fetch('/api/user/favorites', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({collection: col, slug: slug})
      }).then(function(r){return r.json()}).then(function(data){
        // API-Bestätigung
        el.classList.toggle('active', data.favorited);
        el.textContent = data.favorited ? '♥' : '♡';
        // Topbar-Badge updaten
        var badge = document.getElementById('favBadge');
        if (badge) {
          var count = parseInt(badge.textContent) || 0;
          count = data.favorited ? count + 1 : Math.max(0, count - 1);
          badge.textContent = count;
          badge.style.display = count > 0 ? 'flex' : 'none';
        }
      }).catch(function(){
        // Rollback bei Fehler
        el.classList.toggle('active', wasActive);
        el.textContent = wasActive ? '♥' : '♡';
      });
    };
  })();
  </script>
  <script data-astro-rerun defer src="/assets/js/tirol.js"></script>
</body>
</html>
