---
// BaseLayout.astro — Hauptlayout mit Nav, Footer, Theme (Hell/Dunkel)
// Locale-aware: supports 'de' (default) and 'en' with /en/ URL prefix
import { readSingleton } from '../lib/content.js';
import { LANGUAGES, switchLangPath } from '../lib/languages.js';
import NewsletterForm from '../components/NewsletterForm.tsx';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  locale?: string;
  publishedTime?: string;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  canonicalURL,
  type = 'website',
  locale = 'de',
  publishedTime,
  jsonld,
  noindex,
} = Astro.props;

// Locale helpers — dynamisch für alle Sprachen
const langCode = locale || 'de';
const LOCALE_MAP = { de:'de_AT', en:'en_US', fr:'fr_FR', it:'it_IT', es:'es_ES', zh:'zh_CN' };
const fullLocale = LOCALE_MAP[locale] || 'de_AT';
const localePrefix = locale === 'de' ? '' : `/${locale}`;
const siteDesc = description || ({ de:'Das offizielle Tourismusportal für Tirol – Berge, Seen, Wanderwege, Skigebiete und Unterkünfte.', en:'The official tourism portal for Tyrol – Mountains, lakes, hiking trails, ski resorts, and accommodations.', fr:'Le portail touristique officiel du Tyrol – Montagnes, lacs, sentiers de randonnée, stations de ski et hébergements.', it:'Il portale turistico ufficiale del Tirolo – Montagne, laghi, sentieri escursionistici, stazioni sciistiche e alloggi.', es:'El portal turístico oficial de Tirol – Montañas, lagos, rutas de senderismo, estaciones de esquí y alojamientos.', zh:'蒂罗尔州官方旅游门户 – 山脉、湖泊、徒步小径、滑雪场和住宿。' }[locale] || 'Das offizielle Tourismusportal für Tirol – Berge, Seen, Wanderwege, Skigebiete und Unterkünfte.');
const settings = readSingleton('einstellungen', locale);

// Language switcher helper (imported from lib)
const currentPath = Astro.url.pathname;

const siteName = 'Tirol Tourismus';
const siteURL = 'https://www.tirol-tourismus.at';
const pageURL = canonicalURL ?? Astro.url.href;
const ogImageAbs = ogImage ? (ogImage.startsWith('http') ? ogImage : `${siteURL}${ogImage}`) : undefined;
const twitterCard = 'summary_large_image';

// Nav labels — Multi-Sprachen-Map
const NAV_LABELS = {
  de: { magazin:'Magazin', preise:'Preise', fuerBetriebe:'Für Betriebe', bezirke:'Bezirke', merkliste:'♥ Merkliste', anmelden:'Anmelden', konto:'Mein Konto', kontakt:'Kontakt', regionen:'Regionen', camping:'Campingplätze', unterkuenfte:'Unterkünfte', orte:'Orte', sehenswertes:'Sehenswertes', gastro:'Gastro', erlebnisse:'Erlebnisse', events:'Events', suche:'Suche', footer_p:'Das offizielle Tourismusportal für Tirol – entdecke Berge, Seen und alpine Kultur.', footer_regionen:'Regionen', footer_alle_regionen:'Alle Regionen', footer_erlebnisse:'Erlebnisse', footer_alle_erlebnisse:'Alle Erlebnisse', footer_service:'Service', footer_ueber_uns:'Über uns', footer_fuer_betriebe:'Für Betriebe', footer_kontakt:'Kontakt', footer_impressum:'Impressum', footer_datenschutz:'Datenschutz', footer_agb:'AGB', footer_oben:'↑ Zum Seitenanfang' },
  en: { magazin:'Magazine', preise:'Pricing', fuerBetriebe:'For Businesses', bezirke:'Districts', merkliste:'♥ Wishlist', anmelden:'Login', konto:'My Account', kontakt:'Contact', regionen:'Regions', camping:'Camping', unterkuenfte:'Accommodations', orte:'Places', sehenswertes:'Sights', gastro:'Food & Drink', erlebnisse:'Experiences', events:'Events', suche:'Search', footer_p:'The official tourism portal for Tyrol – discover mountains, lakes, and alpine culture.', footer_regionen:'Regions', footer_alle_regionen:'All Regions', footer_erlebnisse:'Experiences', footer_alle_erlebnisse:'All Experiences', footer_service:'Service', footer_ueber_uns:'About Us', footer_fuer_betriebe:'For Businesses', footer_kontakt:'Contact', footer_impressum:'Imprint', footer_datenschutz:'Privacy', footer_agb:'Terms', footer_oben:'↑ Back to top' },
  fr: { magazin:'Magazine', preise:'Tarifs', fuerBetriebe:'Pour les Pros', bezirke:'Districts', merkliste:'♥ Favoris', anmelden:'Connexion', konto:'Mon Compte', kontakt:'Contact', regionen:'Régions', camping:'Camping', unterkuenfte:'Hébergements', orte:'Villages', sehenswertes:'Sites', gastro:'Gastronomie', erlebnisse:'Expériences', events:'Événements', suche:'Recherche', footer_p:'Le portail touristique officiel du Tyrol – découvrez montagnes, lacs et culture alpine.', footer_regionen:'Régions', footer_alle_regionen:'Toutes les Régions', footer_erlebnisse:'Expériences', footer_alle_erlebnisse:'Toutes les Expériences', footer_service:'Service', footer_ueber_uns:'À Propos', footer_fuer_betriebe:'Pour les Pros', footer_kontakt:'Contact', footer_impressum:'Mentions Légales', footer_datenschutz:'Confidentialité', footer_agb:'CGV', footer_oben:'↑ Haut de page' },
  it: { magazin:'Magazine', preise:'Prezzi', fuerBetriebe:'Per Aziende', bezirke:'Distretti', merkliste:'♥ Preferiti', anmelden:'Accedi', konto:'Mio Account', kontakt:'Contatti', regionen:'Regioni', camping:'Campeggio', unterkuenfte:'Alloggi', orte:'Paesi', sehenswertes:'Attrazioni', gastro:'Gastronomia', erlebnisse:'Esperienze', events:'Eventi', suche:'Cerca', footer_p:'Il portale turistico ufficiale del Tirolo – scopri montagne, laghi e cultura alpina.', footer_regionen:'Regioni', footer_alle_regionen:'Tutte le Regioni', footer_erlebnisse:'Esperienze', footer_alle_erlebnisse:'Tutte le Esperienze', footer_service:'Servizio', footer_ueber_uns:'Chi Siamo', footer_fuer_betriebe:'Per Aziende', footer_kontakt:'Contatti', footer_impressum:'Impressum', footer_datenschutz:'Privacy', footer_agb:'Termini', footer_oben:'↑ Torna su' },
  es: { magazin:'Revista', preise:'Precios', fuerBetriebe:'Para Empresas', bezirke:'Distritos', merkliste:'♥ Favoritos', anmelden:'Iniciar Sesión', konto:'Mi Cuenta', kontakt:'Contacto', regionen:'Regiones', camping:'Camping', unterkuenfte:'Alojamientos', orte:'Pueblos', sehenswertes:'Atracciones', gastro:'Gastronomía', erlebnisse:'Experiencias', events:'Eventos', suche:'Buscar', footer_p:'El portal turístico oficial del Tirol – descubre montañas, lagos y cultura alpina.', footer_regionen:'Regiones', footer_alle_regionen:'Todas las Regiones', footer_erlebnisse:'Experiencias', footer_alle_erlebnisse:'Todas las Experiencias', footer_service:'Servicio', footer_ueber_uns:'Sobre Nosotros', footer_fuer_betriebe:'Para Empresas', footer_kontakt:'Contacto', footer_impressum:'Aviso Legal', footer_datenschutz:'Privacidad', footer_agb:'Términos', footer_oben:'↑ Volver arriba' },
  zh: { magazin:'杂志', preise:'价格', fuerBetriebe:'企业服务', bezirke:'行政区', merkliste:'♥ 收藏夹', anmelden:'登录', konto:'我的账户', kontakt:'联系我们', regionen:'地区', camping:'露营', unterkuenfte:'住宿', orte:'村镇', sehenswertes:'景点', gastro:'美食', erlebnisse:'体验', events:'活动', suche:'搜索', footer_p:'蒂罗尔州官方旅游门户 – 探索山脉、湖泊和阿尔卑斯文化。', footer_regionen:'地区', footer_alle_regionen:'所有地区', footer_erlebnisse:'体验', footer_alle_erlebnisse:'所有体验', footer_service:'服务', footer_ueber_uns:'关于我们', footer_fuer_betriebe:'企业服务', footer_kontakt:'联系我们', footer_impressum:'法律声明', footer_datenschutz:'隐私政策', footer_agb:'使用条款', footer_oben:'↑ 返回顶部' },
};
const nav = NAV_LABELS[locale] || NAV_LABELS.de;

// JSON-LD: WebSite with SearchAction
const websiteLD = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteURL,
  description: ({ de:'Offizielle Tourismus-Information für Tirol, Österreich. Berge, Seen, Wanderwege, Skigebiete und Unterkünfte.', en:'Official tourism information for Tyrol, Austria. Mountains, lakes, hiking trails, ski resorts, and accommodations.', fr:'Informations touristiques officielles pour le Tyrol, Autriche. Montagnes, lacs, sentiers de randonnée, stations de ski et hébergements.', it:'Informazioni turistiche ufficiali per il Tirolo, Austria. Montagne, laghi, sentieri escursionistici, stazioni sciistiche e alloggi.', es:'Información turística oficial de Tirol, Austria. Montañas, lagos, rutas de senderismo, estaciones de esquí y alojamientos.', zh:'奥地利蒂罗尔州官方旅游信息。山脉、湖泊、徒步小径、滑雪场和住宿。' }[locale] || 'Offizielle Tourismus-Information für Tirol, Österreich. Berge, Seen, Wanderwege, Skigebiete und Unterkünfte.'),
  inLanguage: langCode,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteURL}/suche?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// JSON-LD: Organization with Tirol address
const organizationLD = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: siteURL,
  logo: `${siteURL}/favicon.svg`,
  description: ({ de:'Offizielle Tourismus-Information für Tirol, Österreich.', en:'Official tourism information for Tyrol, Austria.', fr:'Informations touristiques officielles pour le Tyrol, Autriche.', it:'Informazioni turistiche ufficiali per il Tirolo, Austria.', es:'Información turística oficial de Tirol, Austria.', zh:'奥地利蒂罗尔州官方旅游信息。' }[locale] || 'Offizielle Tourismus-Information für Tirol, Österreich.'),
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'AT',
    addressRegion: 'Tirol',
  },
};

// Allow pages to supply additional LD fragments (e.g. TouristDestination, Event)
const extraLD = jsonld ? { ...websiteLD, ...jsonld } : null;
const ldBlocks = [websiteLD, organizationLD];
if (extraLD) ldBlocks.push(extraLD);
---

<!DOCTYPE html>
<html lang={langCode}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} – tiroltourismus.com</title>
  <meta name="description" content={siteDesc}>
  <meta name="theme-color" content="#FF1493">
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {LANGUAGES.map(l => (
    <link rel="alternate" href={`${siteURL}${switchLangPath(currentPath, locale, l.code)}`} hreflang={l.code} />
  ))}
  <!-- Fonts: display=swap + preconnect for optimal loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@300;400;500;600;700;800;900&family=Prata&display=swap" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@300;400;500;600;700;800;900&family=Prata&display=swap" rel="stylesheet" media="print" onload="this.media='all';this.onload=null;this.removeAttribute('media');">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@300;400;500;600;700;800;900&family=Prata&display=swap"></noscript>

  <!-- Canonical URL -->
  <link rel="canonical" href={pageURL} />

  <!-- OpenGraph -->
  <meta property="og:title" content={`${title} – ${siteName}`} />
  <meta property="og:description" content={siteDesc} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={pageURL} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={fullLocale} />
  {ogImage && <meta property="og:image" content={ogImageAbs} />}
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content={twitterCard} />
  <meta name="twitter:title" content={`${title} – ${siteName}`} />
  <meta name="twitter:description" content={siteDesc} />
  {ogImage && <meta name="twitter:image" content={ogImageAbs} />}
  <!-- LCP: hero image with explicit dimensions -->
  <link rel="preload" as="image" href="/brand/hero-logos/konzept1_gipfellinie_20260517_083224.webp" fetchpriority="high" imagesrcset="/brand/hero-logos/konzept1_gipfellinie_20260517_083224.webp" imagesizes="100vw">
  <link rel="stylesheet" href="/assets/css/tirol.css" media="print" onload="this.media='all';this.onload=null;this.removeAttribute('media');">
  <noscript><link rel="stylesheet" href="/assets/css/tirol.css"></noscript>
  <style is:inline>
    /* ─── Critical: Design Tokens, Reset, Nav, Hero ─── */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#F5F3F0;--bg2:#EDE8E2;
      --surface:rgba(0,0,0,.03);--surface-hover:rgba(0,0,0,.06);
      --text:#1A1A1A;--text2:rgba(0,0,0,.60);--text3:rgba(0,0,0,.38);
      --tirol-red:#C8102E;--ikea-blue:#0051BA;
      --tirol-pink:#FF1493;--tirol-pink-dark:#C0006E;--tirol-pink-glow:rgba(255,20,147,.12);
      --pop-yellow:#FFD700;--pop-green:#00C853;--pop-orange:#FF6B35;--pop-purple:#8B5CF6;
      --glass:rgba(255,255,255,.7);--glass-border:rgba(0,0,0,.06);--glass-shadow:0 12px 48px rgba(0,0,0,.06);
      --font-display:'Bebas Neue',Impact,'Arial Narrow',sans-serif;
      --font-body:'Montserrat',-apple-system,sans-serif;
      --ease:cubic-bezier(.16,1,.3,1);
      --radius:12px;--radius-sm:8px;--radius-lg:20px;
      --pink:var(--tirol-pink);--pink-dark:var(--tirol-pink-dark);--pink-glow:var(--tirol-pink-glow);
      --blue:var(--ikea-blue);--yellow:var(--pop-yellow);
      --gold:#D4A800;--gold-light:#FFD700;--gold-glow:rgba(212,168,0,.18);--gold-soft:rgba(212,168,0,.08);
    }
    [data-theme="alpenpeak"]{
      --bg:#0A0A12;--bg2:#10101E;
      --surface:rgba(255,255,255,.04);--surface-hover:rgba(255,255,255,.08);
      --text:#F0EDEE;--text2:rgba(255,255,255,.65);--text3:rgba(255,255,255,.30);
      --glass:rgba(255,255,255,.06);--glass-border:rgba(255,255,255,.08);--glass-shadow:0 12px 48px rgba(0,0,0,.5);
      --tirol-pink-glow:rgba(255,20,147,.18);--gold-glow:rgba(255,215,0,.15);--gold-soft:rgba(255,215,0,.06);
    }
    html{scroll-behavior:smooth}
    body{font-family:var(--font-body);color:var(--text);background:var(--bg);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden;transition:background .6s,color .6s;font-display:swap}
    a{color:inherit;text-decoration:none}::selection{background:var(--pink);color:var(--bg)}img{max-width:100%;height:auto;display:block}
    .container{max-width:1200px;margin:0 auto;padding:0 24px}
    .topbar{background:rgba(0,0,0,.3);backdrop-filter:blur(12px);padding:8px 0;font-size:12px;color:rgba(255,255,255,.7);position:fixed;top:0;left:0;right:0;z-index:1002;transition:transform .4s var(--ease)}
    [data-theme="alpenpeak"] .topbar{background:rgba(10,10,18,.6);backdrop-filter:blur(20px);border-bottom:1px solid var(--glass-border)}
    .topbar .container{display:flex;justify-content:space-between;align-items:center;width:100%}
    .topbar-l,.topbar-r{display:flex;align-items:center;gap:16px}
    /* ═══ TOPBAR LANGUAGE SELECTOR ═══ */
    .topbar-lang-selector{position:relative;display:flex;align-items:center}
    .lang-current{display:flex;align-items:center;gap:5px;padding:3px 10px;border-radius:6px;cursor:pointer;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);color:rgba(255,255,255,.8);font-size:11px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;transition:all .2s;border:none;font-family:inherit}
    .lang-current:hover{background:rgba(255,255,255,.12)}
    .lang-flag{font-size:14px;line-height:1}
    .lang-chevron{transition:transform .2s;opacity:.6}
    .topbar-lang-selector.open .lang-chevron{transform:rotate(180deg)}
    .lang-dropdown{position:absolute;top:100%;left:0;margin-top:4px;min-width:150px;background:rgba(10,10,18,.95);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:4px;display:none;flex-direction:column;box-shadow:0 12px 40px rgba(0,0,0,.5);z-index:2000}
    .topbar-lang-selector.open .lang-dropdown{display:flex}
    .lang-dropdown a{display:flex;align-items:center;gap:8px;padding:7px 12px;border-radius:6px;font-size:12px;color:rgba(255,255,255,.6);text-decoration:none;transition:all .15s}
    .lang-dropdown a:hover{background:rgba(255,255,255,.06);color:#fff}
    .lang-dropdown a.active{color:var(--pink);font-weight:600;background:rgba(255,20,147,.1)}
    .lang-dropdown a.disabled{opacity:.4;pointer-events:none}
    .lang-badge{font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:1px 5px;border-radius:4px;background:rgba(255,255,255,.08);color:rgba(255,255,255,.4)}
    .fav-link{display:inline-flex;align-items:center;gap:4px;position:relative}
    .fav-badge{position:absolute;top:-5px;right:-8px;min-width:18px;height:18px;border-radius:50%;background:var(--pink);color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 4px}
    .main-nav{height:64px;position:fixed;top:46px;left:20px;right:20px;z-index:1000;border-radius:100px;background:#fff;box-shadow:0 2px 20px rgba(0,0,0,.06);border:1px solid rgba(0,0,0,.04);padding:0 8px 0 24px;max-width:1160px;margin:0 auto;transition:all .5s var(--ease)}
    [data-theme="alpenpeak"] .main-nav{background:rgba(10,10,18,.5);backdrop-filter:blur(24px);border:1px solid var(--glass-border);box-shadow:none}
    .main-nav .container{display:flex;align-items:center;justify-content:space-between;height:100%;max-width:none;padding:0}
    .nav-logo{display:flex;align-items:center;font-family:var(--font-display);font-size:26px;letter-spacing:2px;text-transform:uppercase;color:var(--text)}
    .nav-links{display:flex;gap:0;align-items:center}
    .nav-login,.nav-dash{display:flex;align-items:center;gap:3px;padding:5px 10px;font-size:11px;font-weight:600;border-radius:100px;background:var(--pink);color:#fff!important;transition:all .3s;white-space:nowrap;letter-spacing:.2px;text-decoration:none}
    .nav-login:hover,.nav-dash:hover{opacity:.85;transform:translateY(-1px)}
    .nav-links a{padding:6px 6px;font-size:11px;font-weight:500;letter-spacing:.1px;color:var(--text2);transition:all .3s;border-radius:100px;white-space:nowrap}
    .nav-r{display:flex;align-items:center;gap:6px}
    .nav-search{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--text2);cursor:pointer}
    .hamburger{display:none;flex-direction:column;gap:4px;padding:8px;cursor:pointer}
    .hamburger span{width:20px;height:2px;background:var(--text);border-radius:2px}
    .fav-heart{position:absolute;top:8px;right:8px;z-index:5;width:32px;height:32px;border-radius:50%;background:rgba(0,0,0,.35);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;font-size:16px;cursor:pointer;transition:all .25s;color:#fff;user-select:none;border:none;font-family:inherit}
    .fav-heart:hover{transform:scale(1.15);background:rgba(220,38,38,.7)}
    .fav-heart.active{color:#FF1493;background:rgba(255,20,147,.15)}
    .fav-heart.active:hover{background:rgba(220,38,38,.2)}
    @media(max-width:600px){.stat-btn,.collection-filter button,.filter-chip{min-width:44px;min-height:36px;padding:6px 12px!important;font-size:12px!important}}
    @media(max-width:1100px){.main-nav{left:12px;right:12px;border-radius:16px;padding:0 4px 0 16px}.nav-links,.nav-login{display:none}.hamburger{display:flex}}
    @media(min-width:1101px){.main-nav{left:50%;transform:translateX(-50%);width:calc(100% - 40px)}}
    .mobile-menu{position:fixed;top:0;left:0;width:100%;height:100vh;background:rgba(10,10,18,.97);backdrop-filter:blur(40px);z-index:999;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:24px;opacity:0;pointer-events:none;transition:all .5s var(--ease)}
    .mobile-menu.open{opacity:1;pointer-events:all}
    .mobile-menu a{font-family:var(--font-display);font-size:52px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.5)}
    .mobile-close{position:absolute;top:20px;right:24px;font-size:36px;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff}
    .page-header{position:relative;padding:60px 0 40px;text-align:center;background:var(--bg2);border-bottom:1px solid var(--glass-border);overflow:hidden}
    .page-header h1{font-family:var(--font-display);font-size:clamp(42px,6vw,80px);line-height:1;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}
    .section-header{text-align:center;margin-bottom:48px}
    .section-title{font-family:var(--font-display);font-size:clamp(48px,7vw,96px);line-height:1;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}
    .section-label{font-family:var(--font-display);font-size:20px;letter-spacing:2px;margin-bottom:4px}
    .section-desc{font-size:15px;color:var(--text2);max-width:560px;margin:0 auto;line-height:1.7}
    .breadcrumbs{display:flex;align-items:center;gap:8px;padding:12px 0;font-size:12px;color:var(--text3)}
    .theme-toggle{position:fixed;top:84px;right:28px;z-index:1001;width:40px;height:40px;border-radius:50%;background:var(--glass);backdrop-filter:blur(20px);border:1px solid var(--glass-border);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .4s var(--ease);color:var(--text);box-shadow:0 4px 16px rgba(0,0,0,.08)}
    /* ═══ FLOATING LANGUAGE GLOBE ═══ */
    .floating-lang{position:fixed;right:24px;top:50%;transform:translateY(-50%);z-index:999}
    .floating-lang-btn{width:46px;height:46px;border-radius:50%;background:rgba(10,10,18,.5);backdrop-filter:blur(20px);border:1px solid var(--glass-border);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:20px;transition:all .3s var(--ease);color:var(--text);box-shadow:0 6px 24px rgba(0,0,0,.25);border:none;font-family:inherit}
    .floating-lang-btn:hover{transform:scale(1.1);border-color:var(--pink)}
    .floating-lang-panel{position:absolute;right:56px;top:50%;transform:translateY(-50%);background:rgba(10,10,18,.95);backdrop-filter:blur(24px);border:1px solid var(--glass-border);border-radius:var(--radius-lg);padding:6px;display:none;flex-direction:column;gap:2px;min-width:180px;box-shadow:0 16px 48px rgba(0,0,0,.5)}
    .floating-lang.open .floating-lang-panel{display:flex}
    .floating-lang-panel a{display:flex;align-items:center;gap:10px;padding:9px 14px;border-radius:8px;font-size:12px;color:var(--text2);text-decoration:none;transition:all .15s}
    .floating-lang-panel a:hover{background:var(--glass);color:var(--text)}
    .floating-lang-panel a.active{color:var(--pink);font-weight:600;background:rgba(255,20,147,.08)}
    .floating-lang-panel a.disabled{opacity:.4;pointer-events:none}
    .fl-flag{font-size:18px;width:22px;text-align:center}
    .fl-name{flex:1}
    .fl-check{color:var(--pink);font-size:12px}
    @media(max-width:768px){.floating-lang{display:none}}
    /* ═══ FOOTER LANGUAGE FLAGS ═══ */
    .footer-lang{display:flex;align-items:center;gap:6px;margin-top:16px;flex-wrap:wrap}
    .footer-lang a{display:flex;align-items:center;gap:5px;padding:4px 10px;border-radius:100px;font-size:11px;font-weight:500;color:var(--text3);text-decoration:none;transition:all .2s;background:var(--surface);border:1px solid var(--glass-border)}
    .footer-lang a:hover{color:var(--text);border-color:var(--pink)}
    .footer-lang a.active{color:var(--pink);background:rgba(255,20,147,.08);border-color:rgba(255,20,147,.25)}
    .footer-lang a.disabled{opacity:.35;pointer-events:none}
  </style>

  <!-- JSON-LD Structured Data -->
  {ldBlocks.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}
</head>
<body>
<div id="scrollProgress"></div>
<button class="btt" id="backToTop" aria-label="Nach oben">↑</button>
  <button class="theme-toggle" id="themeToggle" aria-label="Tag/Nacht umschalten">
    <svg class="theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
    </svg>
    <svg class="theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </button>

  <!-- TOP BAR -->
  <div class="topbar">
    <div class="container">
      <div class="topbar-l">
        <div class="topbar-lang-selector" id="langSelector">
          <button class="lang-current" onclick="this.closest('.topbar-lang-selector').classList.toggle('open')" aria-label="Sprache ändern">
            <span class="lang-flag">{LANGUAGES.find(l => l.code === locale).flag}</span>
            <span class="lang-code">{locale.toUpperCase()}</span>
            <svg class="lang-chevron" viewBox="0 0 10 6" width="10" height="6"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="lang-dropdown">
            {LANGUAGES.map(l => (
              <a href={switchLangPath(currentPath, locale, l.code)} class:list={{ active: l.code === locale, disabled: !l.ready }}>
                <span class="lang-flag">{l.flag}</span>
                <span class="lang-name">{l.nameNative}</span>
                {!l.ready && <span class="lang-badge">soon</span>}
              </a>
            ))}
          </div>
        </div>
        <a href={`${localePrefix}/magazin/`}>{nav.magazin}</a>
      </div>
      <div class="topbar-r">
        <a href={`${localePrefix}/fuer-betriebe/`}>{nav.fuerBetriebe}</a>
        <a href={`${localePrefix}/merkliste/`} class="fav-link" id="topFavLink">{nav.merkliste} <span class="fav-badge" id="favBadge" style="display:none">0</span></a>
        <a href={`${localePrefix}/kontakt/`}>{nav.kontakt}</a>
      </div>
    </div>
  </div>

  <!-- NAV -->
  <nav class="main-nav" id="mainNav">
    <div class="container">
<a href={localePrefix || '/'} class="nav-logo">
        <svg viewBox="4 4 404 46" width="280" height="36"><defs>
          <linearGradient id="nt1"><stop offset="0%" stop-color="#A00D24"/><stop offset="100%" stop-color="#C8102E"/></linearGradient>
          <linearGradient id="nt2"><stop offset="0%" stop-color="#C0006E"/><stop offset="100%" stop-color="#FF1493"/></linearGradient>
          <linearGradient id="nt3"><stop offset="0%" stop-color="#D4A800"/><stop offset="100%" stop-color="#FFD700"/></linearGradient>
          <linearGradient id="nt4"><stop offset="0%" stop-color="#C0006E"/><stop offset="100%" stop-color="#FF1493"/></linearGradient>
          <linearGradient id="nt5"><stop offset="0%" stop-color="#003A8A"/><stop offset="100%" stop-color="#0066FF"/></linearGradient>
        </defs>
        <text x="10" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#nt1)">T</text>
        <polygon points="10,36 10,10 34,36" fill="url(#nt1)" opacity="0.08"/>
        <text x="42" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#nt2)">I</text>
        <polygon points="42,36 42,14 56,36" fill="url(#nt2)" opacity="0.08"/>
        <text x="68" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#nt3)">R</text>
        <polygon points="68,36 68,8 92,36" fill="url(#nt3)" opacity="0.08"/>
        <text x="100" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#nt4)">O</text>
        <polygon points="100,36 100,10 126,36" fill="url(#nt4)" opacity="0.08"/>
        <text x="134" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#nt5)">L</text>
        <circle cx="172" cy="30" r="2.5" fill="rgba(0,0,0,0.12)" opacity="0.3"/>
        <text x="186" y="38" font-family="'Montserrat',sans-serif" font-size="28" font-weight="300" letter-spacing="0.8" fill="#FF1493">tourismus</text>
      </svg></a>
      <div class="nav-links">
        <a href={`${localePrefix}/regionen/`} class={Astro.url.pathname.includes('regionen') ? 'active' : ''}>{nav.regionen}</a>
        <a href={`${localePrefix}/unterkuenfte/`} class={Astro.url.pathname.includes('unterkuenfte') ? 'active' : ''}>{nav.unterkuenfte}</a>
        <a href={`${localePrefix}/camping/`} class={Astro.url.pathname.includes('camping') ? 'active' : ''}>{nav.camping}</a>
        <a href={`${localePrefix}/orte/`} class={Astro.url.pathname.includes('orte') ? 'active' : ''}>{nav.orte}</a>
        <a href={`${localePrefix}/bezirke/`} class={Astro.url.pathname.includes('bezirke') ? 'active' : ''}>{nav.bezirke || 'Bezirke'}</a>
        <a href={`${localePrefix}/sehenswuerdigkeiten/`} class={Astro.url.pathname.includes('sehenswuerdigkeiten') ? 'active' : ''}>{nav.sehenswertes}</a>
        <a href={`${localePrefix}/gastro/`} class={Astro.url.pathname.includes('gastro') ? 'active' : ''}>{nav.gastro}</a>
        <a href={`${localePrefix}/erlebnisse/`} class={Astro.url.pathname.includes('erlebnisse') ? 'active' : ''}>{nav.erlebnisse}</a>
        <a href={`${localePrefix}/events/`} class={Astro.url.pathname.includes('events') ? 'active' : ''}>{nav.events}</a>
        <a href={`${localePrefix}/magazin/`} class={Astro.url.pathname.includes('magazin') ? 'active' : ''}>{nav.magazin}</a>
        <a href={`${localePrefix}/preise/`} class={Astro.url.pathname.includes('preise') ? 'active' : ''} style="color:var(--gold-light);font-weight:600">{nav.preise}</a>
      </div>
      <div class="nav-r">
        <a href={`${localePrefix}/login/`} class="nav-login" id="navLoginBtn">{nav.anmelden}</a>
        <a href={`${localePrefix}/dashboard/`} class="nav-dash" id="navDashBtn" style="display:none">{nav.konto}</a>
        <button class="nav-search" onclick={`window.location.href='${localePrefix}/suche/'`} aria-label={nav.suche}>🔍</button>
        <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
      </div>
    </div>
  </nav>

  <div class="mobile-menu" id="mobileMenu" onclick="this.classList.remove('open')">
    <button class="mobile-close" id="mobileClose">&times;</button>
    <a href={`${localePrefix}/regionen/`}>{nav.regionen}</a>
    <a href={`${localePrefix}/unterkuenfte/`}>{nav.unterkuenfte}</a>
    <a href={`${localePrefix}/camping/`}>{nav.camping}</a>
    <a href={`${localePrefix}/orte/`}>{nav.orte}</a>
    <a href={`${localePrefix}/bezirke/`}>{nav.bezirke || 'Bezirke'}</a>
    <a href={`${localePrefix}/sehenswuerdigkeiten/`}>{nav.sehenswertes}</a>
    <a href={`${localePrefix}/gastro/`}>{nav.gastro}</a>
    <a href={`${localePrefix}/erlebnisse/`}>{nav.erlebnisse}</a>
    <a href={`${localePrefix}/events/`}>{nav.events}</a>
    <a href={`${localePrefix}/magazin/`}>{nav.magazin}</a>
    <a href={`${localePrefix}/preise/`} style="color:var(--gold-light)">{nav.preise}</a>
    <a href={`${localePrefix}/suche/`}>🔍 {nav.suche}</a>
    <a href={`${localePrefix}/login/`} class="mob-login" id="mobLoginBtn" style="color:var(--pink);font-weight:600">{nav.anmelden}</a>
    <a href={`${localePrefix}/dashboard/`} class="mob-dash" id="mobDashBtn" style="display:none;color:var(--pink);font-weight:600">{nav.konto}</a>
    <a href={`${localePrefix}/merkliste/`}>{nav.merkliste}</a>
    <a href={`${localePrefix}/kontakt/`}>{nav.kontakt}</a>
  </div>

  <slot />

  <!-- ═══ FLOATING LANGUAGE GLOBE ═══ -->
  <div class="floating-lang" id="floatingLang">
    <button class="floating-lang-btn" onclick="document.getElementById('floatingLang').classList.toggle('open')" aria-label="Sprache ändern">
      🌐
    </button>
    <div class="floating-lang-panel">
      {LANGUAGES.map(l => (
        <a href={switchLangPath(currentPath, locale, l.code)} class:list={{ active: l.code === locale, disabled: !l.ready }}>
          <span class="fl-flag">{l.flag}</span>
          <span class="fl-name">{l.name}</span>
          {l.code === locale && <span class="fl-check">✓</span>}
        </a>
      ))}
    </div>
  </div>

  <!-- Weather Widget (populated by JS) -->
  <div id="weatherWidget" class="weather-widget"></div>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col footer-brand">
          <a href={localePrefix || '/'} class="nav-logo">
            <svg viewBox="4 4 404 46" width="340" height="46"><defs>
              <linearGradient id="ft1"><stop offset="0%" stop-color="#A00D24"/><stop offset="100%" stop-color="#C8102E"/></linearGradient>
              <linearGradient id="ft2"><stop offset="0%" stop-color="#C0006E"/><stop offset="100%" stop-color="#FF1493"/></linearGradient>
              <linearGradient id="ft3"><stop offset="0%" stop-color="#D4A800"/><stop offset="100%" stop-color="#FFD700"/></linearGradient>
              <linearGradient id="ft4"><stop offset="0%" stop-color="#C0006E"/><stop offset="100%" stop-color="#FF1493"/></linearGradient>
              <linearGradient id="ft5"><stop offset="0%" stop-color="#003A8A"/><stop offset="100%" stop-color="#0066FF"/></linearGradient>
            </defs>
            <text x="10" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#ft1)">T</text>
            <polygon points="10,36 10,10 34,36" fill="url(#ft1)" opacity="0.08"/>
            <text x="42" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#ft2)">I</text>
            <polygon points="42,36 42,14 56,36" fill="url(#ft2)" opacity="0.08"/>
            <text x="68" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#ft3)">R</text>
            <polygon points="68,36 68,8 92,36" fill="url(#ft3)" opacity="0.08"/>
            <text x="100" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#ft4)">O</text>
            <polygon points="100,36 100,10 126,36" fill="url(#ft4)" opacity="0.08"/>
            <text x="134" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#ft5)">L</text>
            <circle cx="172" cy="30" r="2.5" fill="rgba(255,255,255,0.12)" opacity="0.3"/>
            <text x="186" y="38" font-family="'Montserrat',sans-serif" font-size="28" font-weight="300" letter-spacing="0.8" fill="var(--pink)">tourismus</text>
          </svg></a>
          <p>{nav.footer_p}</p>
          <div class="footer-social">
            <a href={settings?.social?.instagram || '#'} aria-label="Instagram">📷</a>
            <a href={settings?.social?.tiktok || '#'} aria-label="TikTok">🎵</a>
            <a href={settings?.social?.facebook || '#'} aria-label="Facebook">👍</a>
            <a href={settings?.social?.youtube || '#'} aria-label="YouTube">▶️</a>
          </div>
          <!-- ═══ FOOTER LANGUAGE FLAGS ═══ -->
          <div class="footer-lang">
            {LANGUAGES.map(l => (
              <a href={switchLangPath(currentPath, locale, l.code)} class:list={{ active: l.code === locale, disabled: !l.ready }}>
                {l.flag} {l.name}
              </a>
            ))}
          </div>
        </div>
        <div class="footer-col"><h4>{nav.footer_regionen}</h4><a href={`${localePrefix}/regionen/`}>{nav.footer_alle_regionen}</a><a href={`${localePrefix}/regionen/oetztal/`}>Ötztal</a></div>
        <div class="footer-col"><h4>{nav.footer_erlebnisse}</h4><a href={`${localePrefix}/erlebnisse/`}>{nav.footer_alle_erlebnisse}</a></div>
        <div class="footer-col"><h4>{nav.footer_service}</h4><a href={`${localePrefix}/preise/`} style="color:var(--gold-light);font-weight:600">{nav.preise}</a><a href={`${localePrefix}/ueber-uns/`}>{nav.footer_ueber_uns}</a><a href={`${localePrefix}/fuer-betriebe/`}>{nav.footer_fuer_betriebe}</a><a href={`${localePrefix}/kontakt/`}>{nav.footer_kontakt}</a><a href={`${localePrefix}/impressum/`}>{nav.footer_impressum}</a><a href={`${localePrefix}/datenschutz/`}>{nav.footer_datenschutz}</a><a href={`${localePrefix}/agb/`}>{nav.footer_agb}</a></div>
      </div>

      <!-- NEWSLETTER SIGNUP -->
      <div class="footer-newsletter">
        <h3 class="footer-newsletter-title">📬 Newsletter</h3>
        <p class="footer-newsletter-desc">
          Einmal im Monat die schönsten Seiten Tirols – Berggeschichten,
          Events und exklusive Angebote. Kein Spam, jederzeit kündbar.
        </p>
        <NewsletterForm client:load compact />
      </div>

      <div class="footer-bottom">
        <span>© 2026 tiroltourismus.com</span>
        <div><a href={`${localePrefix}/impressum/`}>{nav.footer_impressum}</a><a href={`${localePrefix}/datenschutz/`}>{nav.footer_datenschutz}</a><a href="#" class="footer-btt" id="footerBackToTop">{nav.footer_oben}</a></div>
      </div>
    </div>
  </footer>
  <script is:inline>
  (function(){'use strict';
    document.addEventListener('click',function(e){
      var sel=document.getElementById('langSelector');
      if(sel&&!sel.contains(e.target))sel.classList.remove('open');
      var fl=document.getElementById('floatingLang');
      if(fl&&!fl.contains(e.target))fl.classList.remove('open');
    });
    // Session-Check: Anmelden vs. Mein Konto
    (function(){
      var hasSession = document.cookie.indexOf('session=') >= 0;
      var loginBtn = document.getElementById('navLoginBtn');
      var dashBtn = document.getElementById('navDashBtn');
      var mobLogin = document.getElementById('mobLoginBtn');
      var mobDash = document.getElementById('mobDashBtn');
      if (hasSession) {
        if (loginBtn) loginBtn.style.display = 'none';
        if (dashBtn) dashBtn.style.display = 'flex';
        if (mobLogin) mobLogin.style.display = 'none';
        if (mobDash) mobDash.style.display = 'block';
      }
    })();
    // Favoriten-Toggle (global, aufgerufen von FavHeart)
    window.toggleFav = function(el) {
      var col = el.getAttribute('data-collection');
      var slug = el.getAttribute('data-slug');
      if (!col || !slug) return;
      var wasActive = el.classList.contains('active');
      // Optimistisches Toggle
      el.classList.toggle('active');
      el.textContent = wasActive ? '♡' : '♥';
      fetch('/api/user/favorites', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({collection: col, slug: slug})
      }).then(function(r){return r.json()}).then(function(data){
        // API-Bestätigung
        el.classList.toggle('active', data.favorited);
        el.textContent = data.favorited ? '♥' : '♡';
        // Topbar-Badge updaten
        var badge = document.getElementById('favBadge');
        if (badge) {
          var count = parseInt(badge.textContent) || 0;
          badge.textContent = data.favorited ? count + 1 : Math.max(0, count - 1);
          badge.style.display = count > 0 || data.favorited ? 'flex' : 'none';
        }
      }).catch(function(){
        // Rollback bei Fehler
        el.classList.toggle('active', wasActive);
        el.textContent = wasActive ? '♥' : '♡';
      });
    };
  })();
  </script>
  <script is:inline defer src="/assets/js/tirol.js"></script>
</body>
</html>
