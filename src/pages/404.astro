    }
  },
  {
    key: 'magazin',
    path: 'magazin/',
    icon: '📰',
    labels: { de: 'Magazin', en: 'Magazine', fr: 'Magazine', cs: 'Časopis', nl: 'Tijdschrift', it: 'Magazine', es: 'Revista', zh: '杂志' },
    descs: {
      de: 'Reisetipps, Touren & Insider-Wissen',
      en: 'Travel tips, tours & insider guides',
      fr: 'Guides, récits de voyage & conseils',
      cs: 'Tipy na cesty a průvodce',
      nl: 'Reistips, tochten & insidertips',
      it: 'Consigli di viaggio e itinerari',
      es: 'Consejos de viaje y rutas',
      zh: '旅行指南、深度路线与当地贴士',
    }
  },
  {
    key: 'suche',
    path: 'suche/',
    icon: '🔍',
    labels: { de: 'Suche & Filter', en: 'Search & Filters', fr: 'Recherche', cs: 'Hledání', nl: 'Zoeken', it: 'Ricerca', es: 'Búsqueda', zh: '搜索与筛选' },
    descs: {
      de: 'Portal gezielt durchsuchen',
      en: 'Search the entire portal',
      fr: 'Rechercher dans tout le portail',
      cs: 'Vyhledávat na celém portálu',
      nl: 'Doorzoek het hele portaal',
      it: 'Cerca in tutto il portale',
      es: 'Buscar en todo el portal',
