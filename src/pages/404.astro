---
// 404 — Seite nicht gefunden / Page not found / Page introuvable
// Dynamic error page with localized designs and top categories across all 8 subdomains
import { DEFAULT_LOCALE } from '../lib/languages.js';

const initialLocale = DEFAULT_LOCALE || 'de';

const TOP_CATEGORIES = [
  {
    key: 'regionen',
