    descs: {
      de: 'Kultur, Schlösser & Naturwunder',
      en: 'Culture, castles & natural wonders',
      fr: 'Culture, châteaux & merveilles',
      cs: 'Kultura, hrady a přírodní krásy',
      nl: 'Cultuur, kastelen & natuurwonderen',
      it: 'Cultura, castelli e meraviglie',
      es: 'Cultura, castillos y maravillas',
      zh: '文化名胜、古堡与自然奇观',
    }
  },
  {
    key: 'gastro',
    path: 'gastro/',
    icon: '🍽️',
    labels: { de: 'Gastronomie', en: 'Food & Drink', fr: 'Gastronomie', cs: 'Gastronomie', nl: 'Eten & Drinken', it: 'Gastronomia', es: 'Gastronomía', zh: '美食' },
    descs: {
      de: 'Tiroler Küche, Hütten & Genuss',
      en: 'Tyrolean cuisine, alpine huts & dining',
      fr: 'Cuisine tyrolienne, auberges & refuges',
      cs: 'Tyrolská kuchyně a horské chaty',
      nl: 'Tiroolse keuken, berghutten & restaurants',
      it: 'Cucina tipica tirolese e rifugi',
      es: 'Gastronomía tirolesa y refugios',
      zh: '地道提洛风味美食与高山木屋',
    }
  },
  {
    key: 'camping',
    path: 'camping/',
    icon: '🏕️',
    labels: { de: 'Camping', en: 'Camping', fr: 'Camping', cs: 'Kempy', nl: 'Campings', it: 'Campeggio', es: 'Camping', zh: '露营' },
    descs: {
      de: 'Natur-Campingplätze mit Bergblick',
      en: 'Scenic campsites with mountain views',
      fr: 'Campings en pleine nature alpine',
      cs: 'Přírodní kempy s výhledem na hory',
      nl: 'Natuurcampings met bergzicht',
      it: 'Campeggi nella natura panoramici',
      es: 'Campings en plena naturaleza alpina',
