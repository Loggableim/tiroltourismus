      de: '14 alpine Urlaubsregionen',
      en: '14 alpine holiday regions',
      fr: '14 régions alpines de vacances',
      cs: '14 alpských prázdninových regionů',
      nl: '14 alpiene vakantieregio’s',
      it: '14 splendide regioni alpine',
