---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import SectionMap from '../../../sections/SectionMap.astro';
import FilterBar from '../../../components/FilterBar.astro';
import CategoryPlaceholder from '../../../components/CategoryPlaceholder.astro';
import { readCollection, isPublished } from '../../../lib/content.js';
import { LANGUAGES_READY, DEFAULT_LOCALE, localePrefix, localeParams } from '../../../lib/languages.js';

export async function getStaticPaths() {
  return localeParams().map(locale => ({ params: { locale } }));
}

const locale = Astro.params.locale || DEFAULT_LOCALE;
const t = (map) => map[locale] || map[DEFAULT_LOCALE] || '';
const pref = localePrefix(locale);

const labels = {
  title: { de: 'Erlebnisse in Tirol', en: 'Experiences in Tyrol', fr: 'Expériences au Tyrol', it: 'Esperienze in Tirolo', es: 'Experiencias en Tirol', zh: '蒂罗尔体验', nl: 'Ervaringen in Tirol', cs: 'Zážitky v Tyrolsku' },
  desc: { de: 'Erlebnisse in Tirol: Wandern, Ski, Bike, Wellness, Familie, Kulinarik, Kultur & Abenteuer.', en: 'Experiences in Tyrol: Hiking, Ski, Bike, Wellness, Family, Culinary, Culture & Adventure.', fr: 'Expériences au Tyrol: Randonnée, Ski, Bike, Bien-être, Famille, Gastronomie, Culture & Aventure.', it: 'Esperienze in Tirolo: Escursionismo, Sci, Bike, Benessere, Famiglia, Enogastronomia, Cultura & Avventura.', es: 'Experiencias en Tirol: Senderismo, Esquí, Bicicleta, Bienestar, Familia, Gastronomía, Cultura y Aventura.', zh: '蒂罗尔体验：徒步、滑雪、骑行、养生、家庭、美食、文化与冒险。', nl: 'Ervaringen in Tirol: Wandelen, Ski, Bike, Wellness, Familie, Culinaire, Cultuur & Avontuur.', cs: 'Zážitky v Tyrolsku: Turistika, Lyžování, Kolo, Wellness, Rodina, Gastronomie, Kultura & Dobrodružství.' },
  heroSub: { de: 'Wandern, Ski, Bike, Wellness, Kulinarik, Kultur & Abenteuer – Tirol hat für jeden das passende Erlebnis.', en: 'Hiking, Ski, Bike, Wellness, Culinary, Culture & Adventure – Tyrol has the right experience for everyone.', fr: 'Randonnée, Ski, Bike, Bien-être, Gastronomie, Culture & Aventure – le Tyrol a l\'expérience qu\'il vous faut.', it: 'Escursionismo, Sci, Bike, Benessere, Enogastronomia, Cultura & Avventura – il Tirolo ha l\'esperienza giusta per tutti.', es: 'Senderismo, Esquí, Bicicleta, Bienestar, Gastronomía, Cultura y Aventura – Tirol tiene la experiencia adecuada para todos.', zh: '徒步、滑雪、骑行、养生、美食、文化与冒险——蒂罗尔为每个人提供合适的体验。', nl: 'Wandelen, Ski, Bike, Wellness, Culinaire, Cultuur & Avontuur – Tirol heeft voor ieder de juiste ervaring.', cs: 'Turistika, Lyžování, Kolo, Wellness, Gastronomie, Kultura & Dobrodružství – Tyrolsko má pro každého ten správný zážitek.' },
  sectionLabel: { de: 'Entdecken', en: 'Discover', fr: 'Découvrir', it: 'Scoprire', es: 'Descubrir', zh: '探索', nl: 'Ontdekken', cs: 'Objevovat' },
  sectionTitle: { de: 'Dein nächstes Abenteuer', en: 'Your Next Adventure', fr: 'Votre Prochaine Aventure', it: 'La Tua Prossima Avventura', es: 'Tu Próxima Aventura', zh: '你的下一次冒险', nl: 'Jouw Volgende Avontuur', cs: 'Váš příští dobroženstvo' },
  sectionSub: { de: 'Ob hoch über den Wolken oder tief in den Tälern – Tirols Erlebnisse warten auf dich.', en: 'Whether high above the clouds or deep in the valleys – Tyrol\'s experiences await you.', fr: 'Que ce soit haut au-dessus des nuages ou profondément dans les vallées – les expériences du Tyrol vous attendent.', it: 'Che si tratti di sopra le nuvole o in profondità nelle valli – le esperienze del Tirolo ti aspettano.', es: 'Ya sea alto sobre las nubes o profundo en los valles – las experiencias de Tirol te esperan.', zh: '无论是在云端之上还是山谷深处——蒂罗尔的体验都在等着你。', nl: 'Of het nu hoog boven de wolken of diep in de valleien is – Tirols ervaringen wachten op je.', cs: 'Ať už vysoko nad oblaky nebo hluboko v údolích – tyrolské zážitky na vás čekají.' },
  filterAria: { de: 'Erlebnisse nach Kategorie filtern', en: 'Filter experiences by category', fr: 'Filtrer les expériences par catégorie', it: 'Filtra esperienze per categoria', es: 'Filtrar experiencias por categoría', zh: '按类别筛选体验', nl: 'Filter ervaringen op categorie', cs: 'Filtrovat zážitky podle kategorie' },
  emptyTitle: { de: 'Bald verfügbar', en: 'Coming Soon', fr: 'Bientôt disponible', it: 'Presto disponibile', es: 'Próximamente', zh: '即将上线', nl: 'Binnenkort beschikbaar', cs: 'Brzy k dispozici' },
  emptyText: { de: 'Erlebnisse werden aktuell eingepflegt. Schau bald wieder vorbei!', en: 'Experiences are being added. Check back soon!', fr: 'Les expériences sont en cours d\'ajout. Revenez bientôt!', it: 'Le esperienze sono in fase di inserimento. Torna presto!', es: 'Las experiencias se están añadiendo. ¡Vuelve pronto!', zh: '体验正在添加中。请稍后再来查看！', nl: 'Ervaringen worden momenteel toegevoegd. Kom snel terug!', cs: 'Zážitky se právě přidávají. Podívejte se brzy znovu!' },
  mapTitle: { de: 'Auf einen Blick', en: 'At a Glance', fr: 'En un Coup d\'Œil', it: 'A Colpo d\'Occhio', es: 'De un Vistazo', zh: '一览', nl: 'In één oogopslag', cs: 'Na první pohled' },
  countLabel: { de: 'Abenteuer', en: 'adventures', fr: 'aventures', it: 'avventure', es: 'aventuras', zh: '冒险', nl: 'avonturen', cs: 'dobrodružství' },
};

const kategorieMeta = {
  wandern: { emoji: '🥾', color: 'var(--green)' }, ski: { emoji: '⛷️', color: 'var(--ikea-blue)' },
  bike: { emoji: '🚵', color: 'var(--orange)' }, wellness: { emoji: '♨️', color: 'var(--tirol-pink)' },
  familie: { emoji: '👨‍👩‍👧‍👦', color: 'var(--yellow)' }, kulinarik: { emoji: '🍷', color: 'var(--purple)' },
  kultur: { emoji: '🎭', color: 'var(--orange)' }, abenteuer: { emoji: '🧗', color: 'var(--tirol-red)' },
  natur: { emoji: '🌲', color: 'var(--green)' }, tradition: { emoji: '🐂', color: 'var(--orange)' },
  winter: { emoji: '❄️', color: 'var(--ikea-blue)' },
};

const kategorieLabel = {
  wandern: { de: 'Wandern', en: 'Hiking', fr: 'Randonnée', it: 'Escursionismo', es: 'Senderismo', zh: '徒步', nl: 'Wandelen', cs: 'Turistika' },
  ski: { de: 'Ski & Snowboard', en: 'Ski & Snowboard', fr: 'Ski & Snowboard', it: 'Sci & Snowboard', es: 'Esquí & Snowboard', zh: '滑雪', nl: 'Skiën & Snowboarden', cs: 'Lyžování & Snowboard' },
  bike: { de: 'Bike & Mountainbike', en: 'Bike & Mountain Bike', fr: 'Vélo & VTT', it: 'Bici & Mountain Bike', es: 'Bici & Mountain Bike', zh: '骑行', nl: 'Fietsen & Mountainbike', cs: 'Kolo & Horské kolo' },
  wellness: { de: 'Wellness & Erholung', en: 'Wellness & Relaxation', fr: 'Bien-être & Détente', it: 'Benessere & Relax', es: 'Bienestar & Relajación', zh: '养生', nl: 'Wellness & Ontspanning', cs: 'Wellness & Odpočinek' },
  familie: { de: 'Familie & Kinder', en: 'Family & Kids', fr: 'Famille & Enfants', it: 'Famiglia & Bambini', es: 'Familia & Niños', zh: '家庭', nl: 'Gezin & Kinderen', cs: 'Rodina & Děti' },
  kulinarik: { de: 'Kulinarik', en: 'Culinary', fr: 'Gastronomie', it: 'Enogastronomia', es: 'Gastronomía', zh: '美食', nl: 'Culinaire', cs: 'Gastronomie' },
  kultur: { de: 'Kultur', en: 'Culture', fr: 'Culture', it: 'Cultura', es: 'Cultura', zh: '文化', nl: 'Cultuur', cs: 'Kultura' },
  abenteuer: { de: 'Abenteuer', en: 'Adventure', fr: 'Aventure', it: 'Avventura', es: 'Aventura', zh: '冒险', nl: 'Avontuur', cs: 'Dobrodružství' },
  natur: { de: 'Natur', en: 'Nature', fr: 'Nature', it: 'Natura', es: 'Naturaleza', zh: '自然', nl: 'Natuur', cs: 'Příroda' },
  tradition: { de: 'Tradition', en: 'Tradition', fr: 'Tradition', it: 'Tradizione', es: 'Tradición', zh: '传统', nl: 'Traditie', cs: 'Tradice' },
  winter: { de: 'Winter', en: 'Winter', fr: 'Hiver', it: 'Inverno', es: 'Invierno', zh: '冬季', nl: 'Winter', cs: 'Zima' },
};

const FROM_WORD = { de: 'ab', en: 'from', fr: 'dès', it: 'da', es: 'desde', zh: '', nl: 'vanaf', cs: 'od' };

const cleanText = (value) => String(value || '')
  .replace(/<[^>]+>/g, ' ')
  .replace(/^#{1,6}\s.*$/gm, ' ')
  .replace(/\s+/g, ' ')
  .trim();

const excerpt = (entry, max = 130) => {
  const text = cleanText(entry.kurzbeschreibung || entry.beschreibung || '');
  if (text.length <= max) return text;
  return text.slice(0, max).replace(/\s+\S*$/, '') + '…';
};

const priceText = (entry) => {
  const value = entry.preis;
  if (typeof value === 'number') {
    if (!(value > 0)) return '';
    const number = Number.isInteger(value) ? String(value) : value.toFixed(2).replace('.', ',');
    const from = FROM_WORD[locale] !== undefined ? FROM_WORD[locale] : 'ab';
    return `${from ? `${from} ` : ''}€${number}`;
  }
  if (typeof value === 'string' && value.trim()) return value.trim();
  return '';
};

const heroSrc = (entry) => entry.hero_bild || entry.bilder?.[0]?.url || '';
const kategorieText = (entry) => t(kategorieLabel[entry.kategorie]) || entry.kategorie || '';

const erlebnisse = readCollection('erlebnisse', locale).filter(e => isPublished(e.entry));
const erlebnisseFilterKeys = Object.keys(kategorieLabel).sort((a, b) => t(kategorieLabel[a]).localeCompare(t(kategorieLabel[b])));
const erlebnisseMitKarte = erlebnisse.filter(e => e.entry.koordinaten?.lat && e.entry.koordinaten?.lng);
const erlebnisseMarkers = erlebnisseMitKarte.map((e) => {
  const meta = kategorieMeta[e.entry.kategorie] || {};
  return {
    lat: e.entry.koordinaten.lat, lng: e.entry.koordinaten.lng,
    label: e.entry.name || e.entry.titel,
    href: `${pref}/erlebnisse/${e.slug}/`,
    emoji: e.entry.emoji || meta.emoji || '🏔️',
  };
});

const siteURL = 'https://www.tirol-tourismus.at';
const erlebnisItemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: t(labels.title), description: t(labels.desc),
  url: `${siteURL}${pref}/erlebnisse/`,
  numberOfItems: erlebnisse.length,
  itemListElement: erlebnisse.slice(0, 30).map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.entry.name || e.entry.titel, url: `${siteURL}${pref}/erlebnisse/${e.slug}/` })),
};
---

<BaseLayout title={t(labels.title)} description={t(labels.desc)} locale={locale} jsonld={erlebnisItemList}>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: t(labels.title) }]} locale={locale} />
    </div>

    <Hero title={t(labels.title)} subtitle={t(labels.heroSub)} emoji="🏔️" size="md">
      <div slot="actions" class="hero-actions">
        <a href="#erlebnis-grid" class="btn btn-pink">{t(labels.sectionLabel)} →</a>
        <span class="hero-urgency">{erlebnisse.length} {t(labels.countLabel)}</span>
      </div>
    </Hero>

    <SectionMap markers={erlebnisseMarkers} label={`${erlebnisseMarkers.length} ${t(labels.countLabel)}`} title={t(labels.mapTitle)} height="380px" scrollWheelZoom={true} filterable={true} />

    {erlebnisse.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHeader label={t(labels.sectionLabel)} title={t(labels.sectionTitle)} sub={t(labels.sectionSub)} />
          <FilterBar keyName="cat" ariaLabel={t(labels.filterAria)} options={erlebnisseFilterKeys.map((k) => ({ value: k, label: t(kategorieLabel[k]) }))} />
          <div class="erlebnisse-grid" id="erlebnis-grid">
            {erlebnisse.map((e) => {
              const entry = e.entry;
              const meta = kategorieMeta[entry.kategorie] || { color: 'var(--tirol-pink)' };
              const image = heroSrc(entry);
              const price = priceText(entry);
              const description = excerpt(entry);
              const category = kategorieText(entry);
              return (
                <a
                  href={`${pref}/erlebnisse/${e.slug}/`}
                  class="erlebnis-card"
                  data-filter-card
                  data-filter-cat={entry.kategorie}
                  style={`--accent:${meta.color || 'var(--tirol-pink)'}`}
                >
                  <div class="erlebnis-media">
                    {image ? (
                      <img src={image} alt={entry.name || ''} loading="lazy" decoding="async" />
                    ) : (
                      <CategoryPlaceholder collection="erlebnisse" locale={locale} />
                    )}
                  </div>
                  <div class="erlebnis-body">
                    {category && <span class="erlebnis-kat">{category}</span>}
                    <h3 class="erlebnis-title">{entry.name}</h3>
                    {description && <p class="erlebnis-desc">{description}</p>}
                    <div class="erlebnis-foot">
                      <div class="erlebnis-meta">
                        {entry.dauer && (
                          <span class="erlebnis-meta-item">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                            <span>{entry.dauer}</span>
                          </span>
                        )}
                        {entry.ort && (
                          <span class="erlebnis-meta-item">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                            <span>{entry.ort}</span>
                          </span>
                        )}
                      </div>
                      {price && <div class="erlebnis-price">{price}</div>}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <svg class="erlebnis-empty-icon" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 74 L46 32 L60 52 L68 40 L84 74 Z"></path>
              <circle cx="50" cy="22" r="4" fill="currentColor" stroke="none"></circle>
            </g>
          </svg>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase">{t(labels.emptyTitle)}</h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">{t(labels.emptyText)}</p>
        </div>
      </section>
    )}

    <section class="quote-section">
      <div class="container">
        <blockquote>„Die Berge sind nicht nur aus Stein und Schnee – sie sind aus Geschichten gemacht. Jeder Gipfel hat eine, die darauf wartet, erzählt zu werden."</blockquote>
        <cite>Tiroler Redeweisheit</cite>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .erlebnisse-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding:0 0 80px;align-items:stretch}
  @media(max-width:968px){.erlebnisse-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.erlebnisse-grid{grid-template-columns:1fr}}
  .erlebnis-card{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--glass-border);border-radius:var(--radius-lg);overflow:hidden;text-decoration:none;color:inherit;box-shadow:0 12px 30px rgba(0,0,0,.06);transition:transform .35s var(--ease),border-color .35s var(--ease),box-shadow .35s var(--ease);content-visibility:auto;contain-intrinsic-size:300px 380px}
  .erlebnis-card:hover{transform:translateY(-6px);border-color:var(--tirol-pink);box-shadow:0 18px 44px rgba(0,0,0,.12)}
  .erlebnis-card:focus-visible{outline:2px solid var(--tirol-pink);outline-offset:2px}
  .erlebnis-media{position:relative;height:140px;flex:0 0 auto;overflow:hidden;border-bottom:1px solid var(--glass-border);background:linear-gradient(135deg,var(--surface),var(--surface-hover))}
  .erlebnis-media::after{content:'';position:absolute;inset:0;background:var(--accent,transparent);opacity:.08;pointer-events:none}
  .erlebnis-media img{width:100%;height:100%;object-fit:cover;display:block}
  .erlebnis-body{padding:18px 20px 20px;display:flex;flex-direction:column;flex:1}
  .erlebnis-kat{font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--accent,var(--tirol-pink));margin-bottom:6px}
  .erlebnis-title{font-family:var(--font-display);font-size:22px;line-height:1.06;letter-spacing:.5px;text-transform:uppercase;color:var(--text);margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .erlebnis-desc{font-size:13px;color:var(--text2);line-height:1.55;margin-bottom:14px;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .erlebnis-foot{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-top:auto;padding-top:12px;border-top:1px solid var(--glass-border)}
  .erlebnis-meta{display:flex;flex-direction:column;gap:5px;min-width:0}
  .erlebnis-meta-item{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text3);min-width:0}
  .erlebnis-meta-item svg{flex:0 0 auto;color:var(--accent,var(--tirol-pink))}
  .erlebnis-meta-item>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .erlebnis-price{flex:0 0 auto;font-size:14px;font-weight:700;color:var(--tirol-pink);white-space:nowrap}
  .erlebnis-empty-icon{width:72px;height:72px;margin:0 auto 16px;display:block;color:var(--tirol-pink);opacity:.85}
  .quote-section{background:var(--bg2);border-top:1px solid var(--glass-border);border-bottom:1px solid var(--glass-border);padding:64px 0;text-align:center}
  .quote-section blockquote{font-size:clamp(18px,2.5vw,28px);font-weight:600;line-height:1.5;max-width:700px;margin:0 auto;color:var(--text);font-style:italic}
  .quote-section cite{display:block;margin-top:16px;font-size:13px;color:var(--text2);font-style:normal;font-weight:500}
  .quote-section cite::before{content:'— '}
</style>
