---
// src/pages/[...locale]/index.astro — REAL language front pages (subdomain roots).
//
// One-page layout per language: sticky DemoNav (scroll-spy, smooth scroll,
// burger, language switch) + DemoContent (all sections with on-page anchors).
// Wrapped in the existing BaseLayout (SEO head, hreflang, JSON-LD, real footer).
// The language picker lives on the apex landing (tiroltourismus.com), not here.
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoNav from '../../components/demofront/DemoNav.astro';
import DemoContent from '../../components/demofront/DemoContent.astro';
import { readCollection, isPublished } from '../../lib/content.js';
import { localeParams, DEFAULT_LOCALE, localePrefix as localePrefixFn, LANGUAGES, PUBLISHED_LANGS, switchLangPath } from '../../lib/languages.js';

import dePage from '../../data/homepage.json';
import enPage from '../../data/en/homepage.json';
import frPage from '../../data/fr/homepage.json';
import itPage from '../../data/it/homepage.json';
import esPage from '../../data/es/homepage.json';
import zhPage from '../../data/zh/homepage.json';
import nlPage from '../../data/nl/homepage.json';
import csPage from '../../data/cs/homepage.json';

const PAGE_MAP = {
  de: dePage,
  en: enPage,
  fr: frPage,
  it: itPage,
  es: esPage,
  zh: zhPage,
  nl: nlPage,
  cs: csPage,
};

// ── One-page nav labels + anchor order (all 8 languages) ──
type SectionKey = 'entdecken' | 'orte' | 'unterkuenfte' | 'sehenswuerdigkeiten' | 'aktivitaeten' | 'gastro' | 'camping' | 'regionen' | 'magazin';

const UI: Record<string, { nav: { aria: string; menu: string; language: string; languageAria: string; sectionsAria: string }; sections: Record<SectionKey, string> }> = {
  de: {
    nav: { aria: 'Ein-Seiten-Navigation', menu: 'Menü öffnen', language: 'Sprache', languageAria: 'Sprache wechseln', sectionsAria: 'Abschnitte' },
    sections: { entdecken: 'Entdecken', orte: 'Orte', unterkuenfte: 'Unterkünfte', sehenswuerdigkeiten: 'Sehenswürdigkeiten', aktivitaeten: 'Aktivitäten', gastro: 'Gastronomie', camping: 'Camping', regionen: 'Regionen', magazin: 'Magazin' },
  },
  en: {
    nav: { aria: 'One-page navigation', menu: 'Open menu', language: 'Language', languageAria: 'Change language', sectionsAria: 'Sections' },
    sections: { entdecken: 'Discover', orte: 'Places', unterkuenfte: 'Accommodations', sehenswuerdigkeiten: 'Sights', aktivitaeten: 'Activities', gastro: 'Food & Drink', camping: 'Camping', regionen: 'Regions', magazin: 'Magazine' },
  },
  fr: {
    nav: { aria: 'Navigation sur une page', menu: 'Ouvrir le menu', language: 'Langue', languageAria: 'Changer de langue', sectionsAria: 'Sections' },
    sections: { entdecken: 'Découvrir', orte: 'Villages', unterkuenfte: 'Hébergements', sehenswuerdigkeiten: 'Sites touristiques', aktivitaeten: 'Activités', gastro: 'Gastronomie', camping: 'Camping', regionen: 'Régions', magazin: 'Magazine' },
  },
  cs: {
    nav: { aria: 'Navigace na jedné stránce', menu: 'Otevřít menu', language: 'Jazyk', languageAria: 'Změnit jazyk', sectionsAria: 'Sekce' },
    sections: { entdecken: 'Objevit', orte: 'Místa', unterkuenfte: 'Ubytování', sehenswuerdigkeiten: 'Pamětihodnosti', aktivitaeten: 'Aktivity', gastro: 'Gastronomie', camping: 'Kempy', regionen: 'Regiony', magazin: 'Časopis' },
  },
  nl: {
    nav: { aria: 'Navigatie op één pagina', menu: 'Menu openen', language: 'Taal', languageAria: 'Taal wijzigen', sectionsAria: 'Secties' },
    sections: { entdecken: 'Ontdekken', orte: 'Plaatsen', unterkuenfte: 'Accommodaties', sehenswuerdigkeiten: 'Bezienswaardigheden', aktivitaeten: 'Activiteiten', gastro: 'Eten & Drinken', camping: 'Campings', regionen: "Regio's", magazin: 'Tijdschrift' },
  },
  it: {
    nav: { aria: 'Navigazione a pagina singola', menu: 'Apri il menu', language: 'Lingua', languageAria: 'Cambia lingua', sectionsAria: 'Sezioni' },
    sections: { entdecken: 'Scoprire', orte: 'Paesi', unterkuenfte: 'Alloggi', sehenswuerdigkeiten: 'Attrazioni', aktivitaeten: 'Attività', gastro: 'Gastronomia', camping: 'Campeggio', regionen: 'Regioni', magazin: 'Magazine' },
  },
  es: {
    nav: { aria: 'Navegación de una página', menu: 'Abrir menú', language: 'Idioma', languageAria: 'Cambiar idioma', sectionsAria: 'Secciones' },
    sections: { entdecken: 'Descubrir', orte: 'Pueblos', unterkuenfte: 'Alojamientos', sehenswuerdigkeiten: 'Atracciones', aktivitaeten: 'Actividades', gastro: 'Gastronomía', camping: 'Camping', regionen: 'Regiones', magazin: 'Revista' },
  },
  zh: {
    nav: { aria: '单页导航', menu: '打开菜单', language: '语言', languageAria: '切换语言', sectionsAria: '章节' },
    sections: { entdecken: '探索', orte: '村镇', unterkuenfte: '住宿', sehenswuerdigkeiten: '景点', aktivitaeten: '活动', gastro: '美食', camping: '露营', regionen: '地区', magazin: '杂志' },
  },
};

const NAV_ORDER: SectionKey[] = ['entdecken', 'orte', 'unterkuenfte', 'sehenswuerdigkeiten', 'aktivitaeten', 'gastro', 'camping', 'regionen', 'magazin'];

export async function getStaticPaths() {
  return localeParams().map(locale => ({ params: { locale } }));
}

const locale = Astro.params.locale || DEFAULT_LOCALE;
const ui = UI[locale] || UI.de;
const page = PAGE_MAP[locale] || dePage;
const localePrefix = localePrefixFn(locale);

const navItems = NAV_ORDER.map((id) => ({ id, label: ui.sections[id] }));

// ── Language switch → REAL language front pages (subdomain roots) ──
const langLinks = LANGUAGES
  .filter(l => PUBLISHED_LANGS.includes(l.code))
  .map(l => ({
    code: l.code,
    name: l.name,
    flag: l.flag,
    href: switchLangPath(Astro.url.pathname, locale, l.code),
    active: l.code === locale,
  }));

// ── Real data (same loaders as the previous front page) ──
const allRegionen = readCollection('regionen', locale).filter(r => isPublished(r.entry));
const allOrte = readCollection('orte', locale).filter(o => isPublished(o.entry));
const allSights = readCollection('sehenswuerdigkeiten', locale).filter(s => isPublished(s.entry));
const allUnterkuenfte = readCollection('unterkuenfte', locale).filter(u => isPublished(u.entry));
const allCamping = readCollection('camping', locale).filter(c => isPublished(c.entry));
const allGastro = readCollection('gastro', locale).filter(g => isPublished(g.entry));
const allMagazin = readCollection('magazin', locale).filter(a => isPublished(a.entry));
const allErlebnisse = readCollection('erlebnisse', locale).filter(e => isPublished(e.entry));
const allEvents = readCollection('events', locale).filter(e => isPublished(e.entry));

const counts = {
  gastro: allGastro.length,
  unterkuenfte: allUnterkuenfte.length,
  orte: allOrte.length,
  sights: allSights.length,
  camping: allCamping.length,
  magazin: allMagazin.length,
  erlebnisse: allErlebnisse.length,
  events: allEvents.length,
  regionen: allRegionen.length,
};

const regions = allRegionen.slice(0, 6);
const stays = allUnterkuenfte.slice(0, 3);
const sights = allSights.slice(0, 4);
const gastro = allGastro.slice(0, 3);
const magazin = allMagazin.slice(0, 3);
const erlebnisse = allErlebnisse.slice(0, 4);
const events = allEvents.slice(0, 4);
const camping = allCamping.slice(0, 3);
const orte = allOrte.slice(0, 4);
const regionNames = allRegionen
  .map(r => ({ slug: r.slug, name: r.entry.titel || r.entry.name || r.slug }))
  .sort((a, b) => a.name.localeCompare(b.name, locale === 'cs' ? 'cs' : 'de'));
---

<BaseLayout
  title={locale === 'de' ? 'Der smarte Tirol-Guide' : locale === 'en' ? 'The Smart Tyrol Guide' : locale === 'fr' ? 'Le Guide Intelligent du Tyrol' : locale === 'it' ? 'La Guida Intelligente del Tirolo' : locale === 'es' ? 'La Guía Inteligente de Tirol' : locale === 'zh' ? '智能蒂罗尔指南' : locale === 'nl' ? 'De Slimme Tirol-Gids' : locale === 'cs' ? 'Chytrý průvodce Tyrolskem' : 'Der smarte Tirol-Guide'}
  description={page.hero?.subtitle}
  locale={locale}
  preloadImage={page.hero?.bgImage}
  onePage
>
  <DemoNav
    locale={locale}
    brandHref="#entdecken"
    items={navItems}
    langLinks={langLinks}
    labels={{ ...ui.nav }}
  />

  <main>
    <DemoContent
      locale={locale}
      localePrefix={localePrefix}
      page={page}
      regions={regions}
      stays={stays}
      sights={sights}
      gastro={gastro}
      magazin={magazin}
      counts={counts}
      regionNames={regionNames}
      erlebnisse={erlebnisse}
      events={events}
      camping={camping}
      orte={orte}
      showFooter={false}
    />
  </main>
</BaseLayout>
