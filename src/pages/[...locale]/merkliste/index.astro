---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MerklistePage from '../../../components/MerklistePage.tsx';
import { LANGUAGES_READY, localeParams, DEFAULT_LOCALE } from '../../../lib/languages.js';

export async function getStaticPaths() {
  return localeParams().map(locale => ({ params: { locale } }));
}

const locale = Astro.params.locale || DEFAULT_LOCALE;
const t = { de:'Merkliste', en:'Wishlist', fr:'Favoris', cs:'Seznam', nl:'Verlanglijst', it:'Preferiti', es:'Favoritos', zh:'收藏夹' };
const desc = { de:'Deine Merkliste – gespeicherte Orte, Unterkünfte und Erlebnisse.', en:'Your wishlist – saved places, accommodations and experiences.', fr:'Vos favoris – lieux, hébergements et expériences enregistrés.', cs:'Váš seznam – uložená místa, ubytování a zážitky.', nl:'Je verlanglijst – opgeslagen plaatsen, accommodaties en ervaringen.', it:'I tuoi preferiti – luoghi, alloggi ed esperienze salvati.', es:'Tus favoritos – lugares, alojamientos y experiencias guardados.', zh:'您的收藏夹 – 保存的地点、住宿和体验。' };
---

<BaseLayout title="{t[locale] || t.de}" description={desc[locale] || desc.de} locale={locale}>
  <main>
    <div class="container"><h1>{t[locale] || t.de}</h1></div>
    <MerklistePage client:load locale={locale} />
  </main>
</BaseLayout>
