  },
};
const info = t[locale] || t.en;
---
<BaseLayout title={info.title} description={info.desc} locale={locale} noindex={true}>
  <main class="search-page">
    <section class="search-hero">
      <div class="container hero-container">
        <div class="hero-icon" aria-hidden="true">🔍</div>
        <h1 class="hero-title">{info.title}</h1>
        <p class="hero-sub">{info.sub}</p>
      </div>
    </section>

    <section class="section search-section">
      <div class="container search-container">
        <!-- Main Search Bar -->
        <div class="search-box">
          <span class="search-icon" aria-hidden="true">🔎</span>
          <input
            type="search"
            id="searchInput"
            placeholder={info.placeholder}
            autocomplete="off"
            spellcheck="false"
            aria-label={info.title}
          />
          <button type="button" id="clearInputBtn" class="clear-input-btn" aria-label="Clear input" style="display:none;">✕</button>
          <div class="search-status" id="searchStatus" aria-live="polite"></div>
        </div>

        <!-- Filter Controls -->
        <div class="filters-card">
          <!-- Category Chips -->
          <div class="category-filters-scroll" tabIndex="0" role="region" aria-label="Category filters">
            <div class="search-filters" id="searchFilters">
              <button class="chip active" data-type="all">⭐ {info.all}</button>
              <button class="chip" data-type="unterkunft">🏨 {info.stays}</button>
              <button class="chip" data-type="ort">🏘️ {info.places}</button>
              <button class="chip" data-type="region">🏔️ {info.regions}</button>
              <button class="chip" data-type="sight">🏛️ {info.sights}</button>
              <button class="chip" data-type="gastro">🍽️ {info.gastro}</button>
              <button class="chip" data-type="camping">🏕️ {info.camping}</button>
              <button class="chip" data-type="magazin">📰 {info.magazin}</button>
            </div>
          </div>

          <!-- Region Dropdown & Filter Actions Bar -->
          <div class="filter-actions-bar">
            <div class="region-filter-group">
              <label for="regionSelect" class="region-label">{info.filterRegionLabel}</label>
              <div class="select-wrapper">
                <select id="regionSelect" class="region-select" aria-label={info.filterRegionLabel}>
                  <option value="all">🏔️ {info.allRegions}</option>
                  {REGIONS.map((r) => (
                    <option value={r.slug}>{r.name}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="filter-meta-group">
              <span id="resultsCount" class="results-count-badge" style="display:none;"></span>
              <button type="button" id="resetFilters" class="reset-filters-btn" style="display:none;">
                {info.clearFilters}
              </button>
            </div>
          </div>
        </div>

        <!-- Popular Tags Suggestion Bar -->
        <div class="popular-tags-bar" id="popularTagsBar">
          <span class="popular-label">{info.popularSearches}</span>
          <button type="button" class="tag-pill" data-query="Innsbruck">Innsbruck</button>
          <button type="button" class="tag-pill" data-query="Zillertal">Zillertal</button>
          <button type="button" class="tag-pill" data-query="Kitzbühel">Kitzbühel</button>
          <button type="button" class="tag-pill" data-query="Hotel">Hotel</button>
          <button type="button" class="tag-pill" data-query="Wandern">Wandern</button>
          <button type="button" class="tag-pill" data-query="Wellness">Wellness</button>
          <button type="button" class="tag-pill" data-query="See">See</button>
        </div>

        <!-- Search Results List -->
        <div class="search-results" id="searchResults" aria-live="polite">
          <div class="search-initial-hint">
            <p>💡 {info.initialPrompt}</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (function() {
    'use strict';
    const LOCALE = document.documentElement.lang || 'de';
    const input = document.getElementById('searchInput');
    const clearInputBtn = document.getElementById('clearInputBtn');
    const status = document.getElementById('searchStatus');
    const results = document.getElementById('searchResults');
    const filterButtons = document.querySelectorAll('#searchFilters .chip');
    const regionSelect = document.getElementById('regionSelect');
    const resetFiltersBtn = document.getElementById('resetFilters');
    const resultsCountBadge = document.getElementById('resultsCount');
    const popularTags = document.querySelectorAll('.popular-tags-bar .tag-pill');

    if (!input || !results) return;

    let activeType = 'all';
    let activeRegion = 'all';
    let miniSearch = null;
    let allStoredDocs = [];
    let searchTimer = null;
    let isInitialized = false;

    // Translations for UI & Result Types
    const JS_T = {
      de: { loading: 'Lade Suchindex…', ready: 'Suchindex bereit ✓', failed: 'Suchindex konnte nicht geladen werden.', noResults: 'Keine passenden Einträge gefunden. Versuche einen anderen Suchbegriff oder passe die Filter an.', results: 'Ergebnisse', oneResult: 'Ergebnis', initialHint: 'Tippe einen Suchbegriff ein oder wähle oben eine Kategorie und Region.' },
      en: { loading: 'Loading search index…', ready: 'Index ready ✓', failed: 'Search index failed to load.', noResults: 'No matching entries found. Try a different search term or adjust filters.', results: 'results', oneResult: 'result', initialHint: 'Type a search term or select a category and region above.' },
      fr: { loading: "Chargement de l'index…", ready: 'Index prêt ✓', failed: "Impossible de charger l'index.", noResults: 'Aucun résultat trouvé. Essayez un autre terme ou ajustez vos filtres.', results: 'résultats', oneResult: 'résultat', initialHint: 'Tapez un mot-clé ou sélectionnez une catégorie et une région ci-dessus.' },
      cs: { loading: 'Načítání indexu…', ready: 'Index připraven ✓', failed: 'Index se nepodařilo načíst.', noResults: 'Nebyly nalezeny žádné odpovídající položky. Zkuste jiný výraz nebo upravte filtry.', results: 'výsledků', oneResult: 'výsledek', initialHint: 'Zadejte hledaný výraz nebo zvolte kategorii a region výše.' },
      nl: { loading: 'Index laden…', ready: 'Index gereed ✓', failed: 'Index kon niet worden geladen.', noResults: 'Geen passende resultaten gevonden. Probeer een andere zoekterm of pas de filters aan.', results: 'resultaten', oneResult: 'resultaat', initialHint: 'Typ een zoekterm of selecteer hierboven een categorie en regio.' },
      it: { loading: 'Caricamento indice…', ready: 'Indice pronto ✓', failed: "Impossibile caricare l'indice.", noResults: 'Nessun risultato trovato. Prova un altro termine o modifica i filtri.', results: 'risultati', oneResult: 'risultato', initialHint: 'Digita un termine di ricerca o seleziona una categoria e una regione in alto.' },
      es: { loading: 'Cargando índice…', ready: 'Índice listo ✓', failed: 'No se pudo cargar el índice.', noResults: 'No se encontraron resultados. Prueba con otro término o ajusta los filtros.', results: 'resultados', oneResult: 'resultado', initialHint: 'Escribe un término o selecciona una categoría y región arriba.' },
      zh: { loading: '加载搜索索引…', ready: '索引就绪 ✓', failed: '搜索索引加载失败。', noResults: '未找到匹配结果。请尝试其他搜索词或调整筛选条件。', results: '条结果', oneResult: '条结果', initialHint: '输入搜索词或在上方选择类别和地区。' },
    };
    const jt = JS_T[LOCALE] || JS_T.de;

    const TYPE_LABELS = {
      region: { de: 'Region', en: 'Region', fr: 'Région', cs: 'Region', nl: 'Regio', it: 'Regione', es: 'Región', zh: '地区' },
      ort: { de: 'Ort', en: 'Place', fr: 'Village', cs: 'Místo', nl: 'Plaats', it: 'Paese', es: 'Pueblo', zh: '村镇' },
      unterkunft: { de: 'Unterkunft', en: 'Accommodation', fr: 'Hébergement', cs: 'Ubytování', nl: 'Accommodatie', it: 'Alloggio', es: 'Alojamiento', zh: '住宿' },
      sight: { de: 'Sehenswürdigkeit', en: 'Sight', fr: 'Site touristique', cs: 'Pamětihodnost', nl: 'Bezienswaardigheid', it: 'Attrazione', es: 'Atracción', zh: '景点' },
      gastro: { de: 'Gastro', en: 'Food & Drink', fr: 'Gastronomie', cs: 'Gastronomie', nl: 'Eten & Drinken', it: 'Gastronomia', es: 'Gastronomía', zh: '美食' },
      camping: { de: 'Camping', en: 'Camping', fr: 'Camping', cs: 'Kemp', nl: 'Camping', it: 'Campeggio', es: 'Camping', zh: '露营' },
      magazin: { de: 'Magazin', en: 'Magazine', fr: 'Magazine', cs: 'Časopis', nl: 'Tijdschrift', it: 'Magazine', es: 'Revista', zh: '杂志' },
    };

    const REGION_MAP = {
      'achensee': 'Achensee',
      'arlberg': 'Arlberg',
      'ausserfern': 'Außerfern',
      'imst': 'Imst',
      'innsbruck': 'Innsbruck',
      'innsbruck-land': 'Innsbruck-Land',
      'kaunertal': 'Kaunertal',
      'kitzbuehel': 'Kitzbühel',
      'kufstein': 'Kufstein',
      'landeck': 'Landeck',
      'oetztal': 'Ötztal',
      'osttirol': 'Osttirol',
      'stubaital': 'Stubaital',
      'tannheimer-tal': 'Tannheimer Tal',
      'zillertal': 'Zillertal',
      'schwaz': 'Schwaz',
    };

    function formatRegion(slug) {
      if (!slug) return '';
      return REGION_MAP[slug.toLowerCase()] || slug;
    }

    function setStatus(text, kind) {
      if (!status) return;
      status.textContent = text || '';
      status.className = 'search-status' + (kind ? ' ' + kind : '');
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }

    function typeLabel(type) {
      const labels = TYPE_LABELS[type];
      if (!labels) return type || 'Eintrag';
      return labels[LOCALE] || labels.de || type;
    }

    async function loadIndex() {
      if (miniSearch) return miniSearch;
      setStatus(jt.loading, 'loading');
      try {
        const [{ default: MiniSearch }, indexRes] = await Promise.all([
          import('https://cdn.jsdelivr.net/npm/minisearch@7.1.2/+esm'),
          fetch(`/search-index.${LOCALE}.json`, { credentials: 'omit' })
        ]);
        if (!indexRes.ok) throw new Error('HTTP ' + indexRes.status);
        const payload = await indexRes.json();
        
        allStoredDocs = Object.values(payload.index.storedFields || {});

        miniSearch = MiniSearch.loadJSON(JSON.stringify(payload.index), {
          idField: 'id',
          fields: ['search', 'name', 'ort', 'region', 'kategorie', 'tags'],
          storeFields: ['name', 'type', 'emoji', 'ort', 'region', 'url', 'locale', 'kategorie', 'tier', 'sterne', 'preis_ab', 'kurzbeschreibung'],
          searchOptions: {
            boost: { name: 3, ort: 2, region: 2, tags: 1.5 },
            fuzzy: 0.2,
            prefix: true,
            combineWith: 'AND',
          },
        });

        setStatus(jt.ready, 'ready');
        setTimeout(() => setStatus(''), 1800);
        return miniSearch;
      } catch (err) {
        setStatus(jt.failed, 'error');
        console.error('Search index load failed:', err);
        throw err;
      }
    }

    function matchesRegion(doc, region) {
      if (!region || region === 'all') return true;
      const targetReg = region.toLowerCase();
      const docReg = (doc.region || '').toLowerCase();
      if (docReg === targetReg) return true;
      if (targetReg === 'innsbruck' && (docReg === 'innsbruck-land' || docReg === 'innsbruck')) return true;
      if (doc.type === 'region' && doc.url && doc.url.toLowerCase().includes('/' + targetReg + '/')) return true;
      if (doc.ort && doc.ort.toLowerCase().includes(targetReg)) return true;
      return false;
    }

    function renderResults(items) {
      if (!items || items.length === 0) {
        results.innerHTML = `<div class="search-empty"><div class="empty-icon">🔍</div><p>${escapeHtml(jt.noResults)}</p></div>`;
        return;
      }

      results.innerHTML = items.slice(0, 60).map(r => {
        const regName = formatRegion(r.region);
        const metaParts = [];
        if (r.ort) metaParts.push(r.ort);
        if (regName && regName.toLowerCase() !== (r.ort || '').toLowerCase()) metaParts.push(regName);
        const meta = metaParts.join(' · ');

        const badge = r.tier === 'gold' ? ' <span class="badge gold">★ Gold</span>' :
                      r.tier === 'silver' ? ' <span class="badge silver">✦ Silver</span>' : '';
        const stars = r.sterne ? ' <span class="sterne">' + '★'.repeat(Math.min(5, Number(r.sterne))) + '</span>' : '';

        return `<a href="${escapeHtml(r.url)}" class="result-card">
          <div class="result-emoji" aria-hidden="true">${escapeHtml(r.emoji || '✨')}</div>
          <div class="result-body">
            <div class="result-type">${escapeHtml(typeLabel(r.type))}${badge}${stars}</div>
            <div class="result-name">${escapeHtml(r.name)}</div>
            ${meta ? `<div class="result-meta">📍 ${escapeHtml(meta)}</div>` : ''}
            ${r.kurzbeschreibung ? `<div class="result-desc">${escapeHtml(r.kurzbeschreibung)}</div>` : ''}
          </div>
          <div class="result-arrow" aria-hidden="true">→</div>
        </a>`;
      }).join('');
    }

    function updateURL(q) {
      if (!window.history || !window.history.replaceState) return;
      const url = new URL(window.location.href);
      if (q) url.searchParams.set('q', q);
      else url.searchParams.delete('q');

      if (activeType && activeType !== 'all') url.searchParams.set('cat', activeType);
      else url.searchParams.delete('cat');

      if (activeRegion && activeRegion !== 'all') url.searchParams.set('region', activeRegion);
      else url.searchParams.delete('region');

      window.history.replaceState({}, '', url.toString());
    }

    async function executeSearch() {
      const q = input.value.trim();
      const hasFilter = (activeType !== 'all') || (activeRegion !== 'all');

      // Update clear input button visibility
      if (clearInputBtn) {
        clearInputBtn.style.display = q ? 'block' : 'none';
      }

      // Update reset button and count visibility
      if (resetFiltersBtn) {
        resetFiltersBtn.style.display = (q || hasFilter) ? 'inline-flex' : 'none';
      }

      updateURL(q);

      // If no query and no filters, reset to initial helpful state
      if (!q && !hasFilter) {
        results.innerHTML = `<div class="search-initial-hint"><p>💡 ${escapeHtml(jt.initialHint)}</p></div>`;
        setStatus('');
        if (resultsCountBadge) resultsCountBadge.style.display = 'none';
        return;
      }

      try {
        const ms = await loadIndex();
        let hits = [];

        if (q.length >= 2) {
          hits = ms.search(q);
          if (activeType !== 'all') {
            hits = hits.filter(h => h.type === activeType);
          }
          if (activeRegion !== 'all') {
            hits = hits.filter(h => matchesRegion(h, activeRegion));
          }
        } else if (hasFilter) {
          // No query, but filtering by category and/or region over stored docs
          hits = allStoredDocs;
          if (activeType !== 'all') {
            hits = hits.filter(h => h.type === activeType);
          }
          if (activeRegion !== 'all') {
            hits = hits.filter(h => matchesRegion(h, activeRegion));
          }
        }

        renderResults(hits);

        const countText = `${hits.length} ${hits.length === 1 ? jt.oneResult : jt.results}`;
        setStatus(countText);
        if (resultsCountBadge) {
          resultsCountBadge.textContent = countText;
          resultsCountBadge.style.display = 'inline-block';
        }
      } catch (e) {
        // Handled in loadIndex
      }
    }

    // Input debounce
    input.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(executeSearch, 150);
    });

    input.addEventListener('focus', () => {
      if (!miniSearch) loadIndex();
    }, { once: true });

    if (clearInputBtn) {
      clearInputBtn.addEventListener('click', () => {
        input.value = '';
        input.focus();
        executeSearch();
      });
    }

    // Category chips
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeType = btn.dataset.type || 'all';
        executeSearch();
      });
    });

    // Region select
    if (regionSelect) {
      regionSelect.addEventListener('change', () => {
        activeRegion = regionSelect.value || 'all';
        executeSearch();
      });
    }

    // Reset filters
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        input.value = '';
        activeType = 'all';
        activeRegion = 'all';
        if (regionSelect) regionSelect.value = 'all';
        filterButtons.forEach(b => {
          if (b.dataset.type === 'all') b.classList.add('active');
          else b.classList.remove('active');
        });
        executeSearch();
      });
    }

    // Popular query pills
    popularTags.forEach(pill => {
      pill.addEventListener('click', () => {
        const query = pill.dataset.query;
        if (!query) return;
        input.value = query;
        executeSearch();
      });
    });

    // Initialize from URL parameters on first load
    function initFromURL() {
      if (isInitialized) return;
      isInitialized = true;
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      const cat = params.get('cat') || params.get('type');
      const reg = params.get('region');

      if (q) input.value = q;
      if (cat) {
        const targetBtn = document.querySelector(`#searchFilters .chip[data-type="${cat}"]`);
        if (targetBtn) {
          filterButtons.forEach(b => b.classList.remove('active'));
          targetBtn.classList.add('active');
          activeType = cat;
        }
      }
      if (reg && regionSelect) {
        const optionExists = Array.from(regionSelect.options).some(o => o.value === reg);
        if (optionExists) {
          regionSelect.value = reg;
          activeRegion = reg;
        }
      }

      if (q || (cat && cat !== 'all') || (reg && reg !== 'all')) {
        executeSearch();
      }
    }

    initFromURL();
  })();
</script>

