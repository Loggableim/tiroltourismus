---
// [locale]/suche/index.astro — Multi-language search and filter page across all 8 subdomains
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localeParams, DEFAULT_LOCALE } from '../../../lib/languages.js';

export async function getStaticPaths() {
  return localeParams().map(locale => ({ params: { locale } }));
}

const locale = Astro.params.locale || DEFAULT_LOCALE;

const REGIONS = [
  { slug: 'achensee', name: 'Achensee' },
  { slug: 'arlberg', name: 'Arlberg' },
  { slug: 'ausserfern', name: 'Außerfern / Reutte' },
  { slug: 'imst', name: 'Imst & Gurgltal' },
