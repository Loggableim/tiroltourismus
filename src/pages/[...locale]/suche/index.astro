    initialPrompt: 'Escribe un término o selecciona una categoría y región arriba.',
    noResults: 'No se encontraron resultados. Prueba con otro término o ajusta los filtros.',
  },
  zh: {
    title: '搜索与发现',
    desc: '搜索蒂罗尔旅游门户 – 住宿、村镇、地区、景点与美食。',
    sub: '找到您想要的 – 按地区和类别筛选，或直接搜索名称和地点。',
    placeholder: '输入搜索（例如 酒店、齐勒河谷、徒步）…',
    all: '全部',
    regions: '地区',
    places: '村镇',
    stays: '住宿',
    sights: '景点',
    gastro: '美食',
    camping: '露营',
    magazin: '杂志',
    allRegions: '所有地区',
    filterRegionLabel: '按地区筛选：',
    clearFilters: '✕ 重置筛选',
    popularSearches: '热门：',
    initialPrompt: '输入搜索词或在上方选择类别和地区。',
