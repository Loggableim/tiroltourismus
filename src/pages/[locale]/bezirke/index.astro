---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { readSingleton } from '../../../lib/content.js';
import { LANGUAGES_READY, DEFAULT_LOCALE, localePrefix } from '../../../lib/languages.js';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

export async function getStaticPaths() {
  return LANGUAGES_READY.filter((locale) => locale !== 'de').map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const LABELS = {
  title: { de: 'Bezirke Tirols', en: 'Districts of Tyrol', fr: 'Districts du Tyrol', it: 'Distretti del Tirolo', es: 'Distritos de Tirol', zh: '蒂罗尔行政区', nl: 'Districten van Tirol', cs: 'Okresy Tyrolska' },
  desc: { de: 'Alle neun Bezirke Tirols im Überblick – von Innsbruck bis Osttirol.', en: 'All nine districts of Tyrol at a glance – from Innsbruck to East Tyrol.', fr: 'Les neuf districts du Tyrol en un coup d\'œil – d\'Innsbruck au Tyrol oriental.', it: 'Tutti e nove i distretti del Tirolo a colpo d\'occhio – da Innsbruck al Tirolo orientale.', es: 'Los nueve distritos de Tirol de un vistazo – de Innsbruck a Tirol del Este.', zh: '蒂罗尔所有九个行政区一览——从因斯布鲁克到东蒂罗尔。', nl: 'Alle negen districten van Tirol in één oogopslag – van Innsbruck tot Oost-Tirol.', cs: 'Všech devět okresů Tyrolska na první pohled – od Innsbrucku po Východní Tyrolsko.' },
  heroSub: { de: 'Neun Bezirke – neun Persönlichkeiten. Von der Landeshauptstadt bis zu den entlegensten Tälern.', en: 'Nine districts – nine personalities. From the state capital to the most remote valleys.', fr: 'Neuf districts – neuf personnalités. De la capitale aux vallées les plus reculées.', it: 'Nove distretti – nove personalità. Dalla capitale alle valli più remote.', es: 'Nueve distritos – nueve personalidades. Desde la capital hasta los valles más remotos.', zh: '九个行政区——九种个性。从首府到最偏远的山谷。', nl: 'Negen districten – negen persoonlijkheden. Van de hoofdstad tot de meest afgelegen valleien.', cs: 'Devět okresů – devět osobností. Od hlavního města po nejzazší údolí.' },
  wappenKicker: { de: 'Neu im Atlas', en: 'New in Atlas', fr: 'Nouveau dans l\'Atlas', it: 'Nuovo nell\'Atlante', es: 'Nuevo en el Atlas', zh: '地图册新增', nl: 'Nieuw in Atlas', cs: 'Nové v atlasy' },
  wappenTitle: { de: 'Tiroler Wappen-Übersicht', en: 'Tyrol Coat of Arms Overview', fr: 'Aperçu des Armoiries du Tyrol', it: 'Panorama dello Stemma del Tirolo', es: 'Resumen de Escudos de Tirol', zh: '蒂罗尔徽章概览', nl: 'Tirolse Wapenoverzicht', cs: 'Přehled tyrolských erbů' },
  wappenDesc: { de: 'Alle Bezirks- und Ortswappen in einer modernen, ultraminimalen Darstellung.', en: 'All district and town coats of arms in a modern, ultra-minimalist design.', fr: 'Toutes les armoiries des districts et villes dans un design moderne et ultra-minimaliste.', it: 'Tutti gli stemmi dei distretti e delle città in un design moderno e ultra-minimalista.', es: 'Todos los escudos de distritos y pueblos en un diseño moderno y ultra-minimalista.', zh: '所有城镇和行政区徽章，现代超极简设计。', nl: 'Alle district- en stadswapens in een modern, ultra-minimaal ontwerp.', cs: 'Všechny erby okresů a měst v moderním, ultra minimálním designu.' },
  gemeinden: { de: '∞ Gemeinden', en: '∞ Municipalities', fr: '∞ Communes', it: '∞ Comuni', es: '∞ Municipios', zh: '∞ 市镇', nl: '∞ Gemeenten', cs: '∞ Obce' },
};

const bezirke = readSingleton('bezirke', locale);
const items = bezirke ? Object.values(bezirke) : [];
let wappenBezirke = [];
try {
  const wappenData = JSON.parse(readFileSync(resolve(process.cwd(), 'wappen/wappen_page_data.json'), 'utf-8'));
  wappenBezirke = wappenData.bezirke.map((b) => ({
    ...b,
    publicImg: `/wappen/${b.img.replace(/^img\//, '')}`,
  }));
} catch (e) { console.warn('wappen data not found'); }

const pref = localePrefix(locale);
const siteURL = 'https://www.tirol-tourismus.at';
const bezirkItemList = items.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: LABELS.title[locale] || LABELS.title.de,
  description: LABELS.desc[locale] || LABELS.desc.de,
  url: `${siteURL}${pref}/bezirke/`,
  numberOfItems: items.length,
  itemListElement: items.filter(Boolean).map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    url: `${siteURL}${pref}/bezirke/${b.slug}/`,
  })),
} : undefined;
---

<BaseLayout title={LABELS.title[locale] || LABELS.title.de} description={LABELS.desc[locale] || LABELS.desc.de} locale={locale} jsonld={bezirkItemList}>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: LABELS.title[locale] || LABELS.title.de }]} />
    </div>

    <section class="bezirke-hero">
      <div class="container" style="text-align:center;padding:60px 0 40px">
        <div style="font-size:64px;margin-bottom:8px">🗺️</div>
        <h1 class="bezirke-title">{LABELS.title[locale] || LABELS.title.de}</h1>
        <p class="bezirke-sub">{LABELS.heroSub[locale] || LABELS.heroSub.de}</p>
      </div>
    </section>

    <section class="wappen-feature-wrap">
      <div class="container">
        <a href={`${pref}/wappen/`} class="wappen-feature-card">
          <div class="wappen-feature-copy">
            <div class="wappen-feature-kicker">{LABELS.wappenKicker[locale] || LABELS.wappenKicker.de}</div>
            <h2>{LABELS.wappenTitle[locale] || LABELS.wappenTitle.de}</h2>
            <p>{LABELS.wappenDesc[locale] || LABELS.wappenDesc.de}</p>
          </div>
          <div class="wappen-feature-preview">
            {wappenBezirke.slice(0, 4).map((b) => (
              <img src={b.publicImg} alt={b.name} loading="lazy" decoding="async" />
            ))}
          </div>
        </a>
      </div>
    </section>

    <section class="section" style="padding:0 0 80px">
      <div class="container">
        <div class="bezirke-grid">
          {items.filter(Boolean).map(b => (
            <a href={`${pref}/bezirke/${b.slug}/`} class="bezirk-card">
              <div class="bezirk-card-header">
                <h2 class="bezirk-card-name">{b.name}</h2>
              </div>
              <p class="bezirk-card-desc">{b.beschreibung}</p>
              <div class="bezirk-card-footer">
                <span class="bezirk-card-count">{LABELS.gemeinden[locale] || LABELS.gemeinden.de}</span>
                <span class="bezirk-card-arrow">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .bezirke-title{font-family:var(--font-display);font-size:clamp(42px,6vw,72px);line-height:1;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}
  .bezirke-sub{color:var(--text2);max-width:560px;margin:0 auto;line-height:1.6;font-size:15px}
  .wappen-feature-wrap{padding:0 0 18px}
  .wappen-feature-card{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.9fr);gap:16px;align-items:center;padding:20px;border-radius:var(--radius-lg);background:linear-gradient(135deg,rgba(255,20,147,.08),rgba(255,215,0,.06));border:1px solid rgba(255,20,147,.18);text-decoration:none;color:var(--text);box-shadow:0 14px 36px rgba(0,0,0,.05);transition:all .25s var(--ease)}
  .wappen-feature-card:hover{border-color:var(--pink);transform:translateY(-1px)}
  .wappen-feature-kicker{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--pink);font-weight:700;margin-bottom:6px}
  .wappen-feature-copy h2{font-family:var(--font-display);font-size:clamp(26px,3vw,44px);letter-spacing:1px;text-transform:uppercase;line-height:1;margin-bottom:8px}
  .wappen-feature-copy p{color:var(--text2);line-height:1.7;max-width:62ch}
  .wappen-feature-preview{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
  .wappen-feature-preview img{width:100%;aspect-ratio:1/1.5;object-fit:contain;background:#fff;border-radius:16px;border:1px solid var(--glass-border);padding:8px}
  .bezirke-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .bezirk-card{background:var(--bg);border:1px solid var(--glass-border);border-radius:var(--radius);padding:28px;text-decoration:none;color:var(--text);transition:all .3s var(--ease);display:flex;flex-direction:column;gap:12px}
  .bezirk-card:hover{border-color:var(--pink);box-shadow:0 8px 32px rgba(255,20,147,.1);transform:translateY(-2px)}
  .bezirk-card-name{font-family:var(--font-display);font-size:22px;letter-spacing:1px;text-transform:uppercase;line-height:1.1}
  .bezirk-card-desc{color:var(--text2);font-size:13px;line-height:1.6;flex:1}
  .bezirk-card-footer{display:flex;justify-content:space-between;align-items:center;padding-top:8px;border-top:1px solid var(--glass-border)}
  .bezirk-card-count{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--text3)}
  .bezirk-card-arrow{color:var(--pink);font-size:18px}
  @media(max-width:968px){.wappen-feature-card{grid-template-columns:1fr}.wappen-feature-preview{grid-template-columns:repeat(4,1fr)}.bezirke-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.bezirke-grid{grid-template-columns:1fr}.wappen-feature-preview{grid-template-columns:repeat(2,1fr)}}
</style>
