---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { readSingleton } from '../../../lib/content.js';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { LANGUAGES_READY, DEFAULT_LOCALE, localePrefix } from '../../../lib/languages.js';

export async function getStaticPaths() {
  return LANGUAGES_READY.filter((locale) => locale !== 'de').map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = (map) => map[locale] || map[DEFAULT_LOCALE] || '';
const pref = localePrefix(locale);

const labels = {
  title: { de: 'Bezirke Tirols', en: 'Districts of Tyrol', fr: 'Districts du Tyrol', it: 'Distretti del Tirolo', es: 'Distritos de Tirol', zh: '蒂罗尔行政区', nl: 'Districten van Tirol', cs: 'Okresy Tyrolska' },
  desc: { de: 'Alle neun Bezirke Tirols im Überblick – von Innsbruck bis Osttirol, vom Außerfern bis zum Zillertal.', en: 'All nine districts of Tyrol at a glance – from Innsbruck to East Tyrol, from Außerfern to Zillertal.', fr: 'Les neuf districts du Tyrol en un coup d\'œil – d\'Innsbruck au Tyrol oriental, de l\'Außerfern au Zillertal.', it: 'Tutti e nove i distretti del Tirolo a colpo d\'occhio – da Innsbruck all\'Est Tirolo, dall\'Außerfern allo Zillertal.', es: 'Los nueve distritos de Tirol de un vistazo – de Innsbruck a Tirol del Este, de Außerfern a Zillertal.', zh: '蒂罗尔所有九个行政区一览——从因斯布鲁克到东蒂罗尔，从奥斯特费恩到齐勒河谷。', nl: 'Alle negen districten van Tirol in een oogopslag – van Innsbruck tot Oost-Tirol, van Außerfern tot Zillertal.', cs: 'Všech devět okresů Tyrolska na první pohled – od Innsbrucku po Východní Tyrolsko, od Außerfernu po Zillertal.' },
  heroSub: { de: 'Neun Bezirke – neun Persönlichkeiten. Von der Landeshauptstadt bis zu den entlegensten Tälern.', en: 'Nine districts – nine personalities. From the state capital to the most remote valleys.', fr: 'Neuf districts – neuf personnalités. De la capitale régionale aux vallées les plus reculées.', it: 'Nove distretti – nove personalità. Dalla capitale regionale alle valli più remote.', es: 'Nueve distritos – nueve personalidades. Desde la capital del estado hasta los valles más remotos.', zh: '九个行政区——九种个性。从州首府到最偏远的山谷。', nl: 'Negen districten – negen persoonlijkheden. Van de hoofdstad tot de meest afgelegen valleien.', cs: 'Devět okresů – devět osobností. Od hlavního města po nejodlehlejší údolí.' },
  wappenKicker: { de: 'Neu im Atlas', en: 'New in Atlas', fr: 'Nouveau dans l\'Atlas', it: 'Nuovo nell\'Atlas', es: 'Nuevo en el Atlas', zh: '地图集新增', nl: 'Nieuw in Atlas', cs: 'Nové v Atlasu' },
  wappenTitle: { de: 'Tiroler Wappen-Übersicht', en: 'Tyrol Coat of Arms Overview', fr: 'Aperçu des Armoiries du Tyrol', it: 'Panorama degli Stemmi del Tirolo', es: 'Resumen de Escudos de Armas de Tirol', zh: '蒂罗尔纹章概览', nl: 'Wapenoverzicht Tirol', cs: 'Přehled erbů Tyrolska' },
  wappenDesc: { de: 'Alle Bezirks- und Ortswappen in einer modernen, ultraminimalen Darstellung – direkt aus der Bezirke-Übersicht erreichbar.', en: 'All district and town coats of arms in a modern, ultra-minimalist design – directly accessible from the district overview.', fr: 'Toutes les armoiries des districts et des villes dans un design moderne et ultra-minimaliste – directement accessibles depuis l\'aperçu des districts.', it: 'Tutti gli stemmi dei distretti e delle città in un design moderno e ultra-minimalista – direttamente accessibili dalla panoramica dei distretti.', es: 'Todos los escudos de armas de distritos y pueblos en un diseño moderno y ultra-minimalista – directamente accesibles desde el resumen de distritos.', zh: '所有城镇和地区的纹章采用现代超简约设计——可直接从地区概览访问。', nl: 'Alle wapens van districten en steden in een moderne, ultra-minimalistisch ontwerp – direct toegankelijk vanuit het districtsoverzicht.', cs: 'Všechny erby okresů a měst v moderních, ultraminimálních provedeních – přímo přístupné z přehledu okresů.' },
  gemeinden: { de: '∞ Gemeinden', en: '∞ Municipalities', fr: '∞ Municipalités', it: '∞ Comuni', es: '∞ Municipios', zh: '∞ 市镇', nl: '∞ Gemeenten', cs: '∞ Obce' },
};

const bezirke = readSingleton('bezirke', locale);
const items = bezirke ? Object.values(bezirke) : [];
const wappenData = JSON.parse(readFileSync(resolve(process.cwd(), 'wappen/wappen_page_data.json'), 'utf-8'));
const wappenBezirke = wappenData.bezirke.map((b) => ({ ...b, publicImg: `/wappen/${b.img.replace(/^img\//, '')}` }));

const siteURL = 'https://www.tirol-tourismus.at';
const bezirkItemList = items.length > 0 ? {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: t(labels.title), description: t(labels.desc),
  url: `${siteURL}${pref}/bezirke/`,
  numberOfItems: items.length,
  itemListElement: items.filter(Boolean).map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, url: `${siteURL}${pref}/bezirke/${b.slug}/` })),
} : undefined;
---

<BaseLayout title={t(labels.title)} description={t(labels.desc)} locale={locale} jsonld={bezirkItemList}>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: t(labels.title) }]} />
    </div>

    <section class="bezirke-hero">
      <div class="container" style="text-align:center;padding:60px 0 40px">
        <div style="font-size:64px;margin-bottom:8px">🗺️</div>
        <h1 class="bezirke-title">{t(labels.title)}</h1>
        <p class="bezirke-sub">{t(labels.heroSub)}</p>
      </div>
    </section>

    <section class="wappen-feature-wrap">
      <div class="container">
        <a href={`${pref}/wappen/`} class="wappen-feature-card">
          <div class="wappen-feature-copy">
            <div class="wappen-feature-kicker">{t(labels.wappenKicker)}</div>
            <h2>{t(labels.wappenTitle)}</h2>
            <p>{t(labels.wappenDesc)}</p>
          </div>
          <div class="wappen-feature-preview">
            {wappenBezirke.slice(0, 4).map((b) => (
              <img src={b.publicImg} alt={b.name} loading="lazy" decoding="async" />
            ))}
          </div>
        </a>
      </div>
    </section>

    <section class="section" style="padding:0 0 80px">
      <div class="container">
        <div class="bezirke-grid">
          {items.filter(Boolean).map(b => (
            <a href={`${pref}/bezirke/${b.slug}/`} class="bezirk-card">
              <div class="bezirk-card-header">
                <h2 class="bezirk-card-name">{b.name}</h2>
              </div>
              <p class="bezirk-card-desc">{b.beschreibung}</p>
              <div class="bezirk-card-footer">
                <span class="bezirk-card-count">{t(labels.gemeinden)}</span>
                <span class="bezirk-card-arrow">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .bezirke-title{font-family:var(--font-display);font-size:clamp(42px,6vw,72px);line-height:1;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}
  .bezirke-sub{color:var(--text2);max-width:560px;margin:0 auto;line-height:1.6;font-size:15px}
  .wappen-feature-wrap{padding:0 0 18px}
  .wappen-feature-card{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.9fr);gap:16px;align-items:center;padding:20px;border-radius:var(--radius-lg);background:linear-gradient(135deg,rgba(255,20,147,.08),rgba(255,215,0,.06));border:1px solid rgba(255,20,147,.18);text-decoration:none;color:var(--text);box-shadow:0 14px 36px rgba(0,0,0,.05);transition:all .25s var(--ease)}
  .wappen-feature-card:hover{border-color:var(--tirol-pink);transform:translateY(-1px)}
  .wappen-feature-kicker{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--tirol-pink);font-weight:700;margin-bottom:6px}
  .wappen-feature-copy h2{font-family:var(--font-display);font-size:clamp(26px,3vw,44px);letter-spacing:1px;text-transform:uppercase;line-height:1;margin-bottom:8px}
  .wappen-feature-copy p{color:var(--text2);line-height:1.7;max-width:62ch}
  .wappen-feature-preview{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
  .wappen-feature-preview img{width:100%;aspect-ratio:1/1.1;object-fit:contain;background:#fff;border-radius:16px;border:1px solid var(--glass-border);padding:8px}
  .bezirke-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .bezirk-card{background:var(--bg);border:1px solid var(--glass-border);border-radius:var(--radius);padding:28px;text-decoration:none;color:var(--text);transition:all .3s var(--ease);display:flex;flex-direction:column;gap:12px}
  .bezirk-card:hover{border-color:var(--tirol-pink);box-shadow:0 8px 32px rgba(255,20,147,.1);transform:translateY(-2px)}
  .bezirk-card-name{font-family:var(--font-display);font-size:22px;letter-spacing:1px;text-transform:uppercase;line-height:1.1}
  .bezirk-card-desc{color:var(--text2);font-size:13px;line-height:1.6;flex:1}
  .bezirk-card-footer{display:flex;justify-content:space-between;align-items:center;padding-top:8px;border-top:1px solid var(--glass-border)}
  .bezirk-card-count{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--text3)}
  .bezirk-card-arrow{color:var(--tirol-pink);font-size:18px}
  @media(max-width:968px){.wappen-feature-card{grid-template-columns:1fr}.wappen-feature-preview{grid-template-columns:repeat(4,1fr)}.bezirke-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.bezirke-grid{grid-template-columns:1fr}.wappen-feature-preview{grid-template-columns:repeat(2,1fr)}}
</style>
