export async function getStaticPaths() {
  const locales = LANGUAGES_READY.filter((l) => l !== 'de');
  const paths = [];
  for (const locale of locales) {
    const all = readCollection('gastro', locale).filter(g => isPublished(g.entry));
    for (const g of all) {
      paths.push({ params: { locale, slug: g.slug } });
    }
  }
  return paths;
}

const { locale, slug } = Astro.params;
const entry = readEntry('gastro', slug, locale);
if (!entry) return Astro.redirect(`${localePrefix(locale)}/gastro/`);

// Qualitätslogik: dünne Seiten nicht indexieren
const qualityScore = getContentQuality(entry);
const shouldIdx = shouldIndex(entry, 'gastro');

const l = LABELS[locale] || LABELS.de;
const prefix = localePrefix(locale);

const emoji = entry.emoji || '🍽️';
const subtitle = entry.ort ? `${entry.ort}${entry.kategorie ? ` · ${entry.kategorie}` : ''}` : undefined;

const tier = entry.tier || 'basic';

const CATEGORY_EMOJI = { sehenswuerdigkeiten:'🏛️', gastro:'🍽️', unterkuenfte:'🏨', camping:'🏕️', erlebnisse:'🎯', orte:'🏘️', events:'🎪', regionen:'🏔️' };
const nearbyEntries = entry.koordinaten ? findNearby(entry, 'gastro', locale, 8) : [];
const mapMarkers = [];
if (entry.koordinaten) {
  mapMarkers.push({ lat: entry.koordinaten.lat, lng: entry.koordinaten.lng, label: entry.name, emoji: emoji });
}
nearbyEntries.forEach(n => {
  if (!n.entry.koordinaten) return;
  mapMarkers.push({
    lat: n.entry.koordinaten.lat, lng: n.entry.koordinaten.lng,
    label: n.entry.name || n.entry.titel,
    emoji: CATEGORY_EMOJI[n.collection] || '📍',
    href: `${prefix}/${n.collection}/${n.slug}/`,
    category: n.collection,
  });
});
const mapSection = mapMarkers.length > 0 ? {
  type: 'map',
  label: l.standort,
  title: l.aufDerKarte,
  markers: mapMarkers, scrollWheelZoom: true,
  filterable: true,
} : null;

// Related gastro entries via first tag
const relatedByTag = entry.tags && entry.tags.length > 0
  ? findByTag(entry.tags[0], locale)
      .filter(r => r.collection === 'gastro' && r.slug !== slug)
      .slice(0, 3)
      .map(r => ({
        ...r,
        entry: { ...r.entry, _emoji: r.entry.emoji || '🍽️' }
      }))
  : [];

// JSON-LD: LocalBusiness
const siteURL = 'https://tiroltourismus.com';
const businessLD = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: entry.name,
  description: (entry.kurzbeschreibung || '').substring(0, 300),
  url: `${siteURL}${prefix}/gastro/${slug}/`,
  telephone: entry.telefon || undefined,
  email: entry.email || undefined,
  image: entry.hero_bild ? `${siteURL}${entry.hero_bild}` : undefined,
  ...(entry.adresse || entry.ort ? {
    address: {
      '@type': 'PostalAddress',
      ...(entry.adresse ? { streetAddress: entry.adresse } : {}),
      ...(entry.ort ? { addressLocality: entry.ort } : {}),
      addressCountry: 'AT',
    },
  } : {}),
  ...(entry.koordinaten ? {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: entry.koordinaten.lat,
      longitude: entry.koordinaten.lng,
    },
  } : {}),
  ...(entry.kategorie ? { servesCuisine: entry.kategorie } : {}),
};
const ogImage = entry.hero_bild ? `${siteURL}${entry.hero_bild}` : undefined;
---

<DetailPage
  title={entry.name}
  description={generateMetaDescription(entry, 'gastro', locale)}
  breadcrumbs={[{ label: l.gastro, href: `${prefix}/gastro/` }, { label: entry.name }]}
  locale={locale}
  jsonld={businessLD}
  ogImage={ogImage}
  noindex={!shouldIdx}
  sections={[
    {
      type: 'hero',
      title: entry.name,
      subtitle: subtitle,
      emoji: emoji,
      gradient: entry.farbe,
      bgImage: entry.hero_bild,
    },
    {
      type: 'details-grid',
      label: l.kontaktStandort,
      items: [
        { label: l.ort, value: entry.ort || undefined },
        { label: l.kategorie, value: entry.kategorie || undefined },
        { label: l.telefon, value: entry.telefon || undefined, type: 'link', href: entry.telefon ? `tel:${entry.telefon}` : undefined },
        { label: l.adresse, value: entry.adresse || undefined },
        { label: l.tags, tags: entry.tags || [], type: 'tags' },
      ].filter(Boolean),
    },
    !(tier === 'basic') && (entry.kurzbeschreibung || entry.beschreibung) ? {
      type: 'description',
      label: entry.name,
      title: l.ueberDiesesLokal,
      content: autoLinkContent([entry.kurzbeschreibung, entry.beschreibung].filter(Boolean).join('<br><br>'), entry, locale),
    } : null,
    !(tier === 'basic') ? {
      type: 'details-grid',
      items: [
        { label: l.preis, value: entry.preis || undefined, type: 'price' },
        entry.webseite ? { label: l.webseite, value: entry.webseite, type: 'link', href: entry.webseite } : null,
      ].filter(Boolean),
    } : null,
    !(tier === 'basic') ? mapSection : null,
    !(tier === 'basic') && relatedByTag.length > 0 ? {
      type: 'related-grid',
      label: l.weitereLokale,
      entries: relatedByTag,
      slugPrefix: `${prefix}/gastro/`,
      nameField: 'name',
      subtitleField: 'kurzbeschreibung',
      emojiField: '_emoji',
      defaultEmoji: '🍽️',
    } : null,
    !(tier === 'basic') ? {
      type: 'cta',
      label: l.lustBekommen,
      title: l.jetztReservieren,
      subtitle: l.ctaSubtitle,
      buttons: [
        entry.telefon ? { label: `📞 ${entry.telefon}`, href: `tel:${entry.telefon}`, variant: 'pink' } : null,
        entry.webseite ? { label: `🌐 ${l.webseite}`, href: entry.webseite, variant: 'glass' } : null,
      ].filter(Boolean),
    } : null,
    {
      type: 'back-link',
      href: `${prefix}/gastro/`,
      text: l.alleGastro,
    },
  ].filter(Boolean)}
/>

<!-- Basic: Premium-Inhalte hinter Paywall -->
{(tier === 'basic') && (
  <section class="section paywall-restricted">
    <div class="container" style="position:relative;max-width:800px">
      <PaywallOverlay name={entry.name} slug={slug} />
    </div>
  </section>
)}
