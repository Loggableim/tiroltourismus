---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import RegionCard from '../../components/RegionCard.astro';
import AccommodationCard from '../../components/AccommodationCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import GastroCard from '../../components/GastroCard.astro';
import SightCard from '../../components/SightCard.astro';
import NewsletterForm from '../../components/NewsletterForm.tsx';
import { readCollection, isPublished, readSingleton } from '../../lib/content.js';

export async function getStaticPaths() {
  return [
    { params: { locale: 'de' } },
    { params: { locale: 'en' } },
  ];
}

const { locale } = Astro.params;
const page = readSingleton('homepage', locale);

// ── Locale-aware hardcoded strings ──
const t = locale === 'en' ? {
  willkommen: { label: '#welcome', title: 'Welcome to', titleAccent: 'Tyrol', p1: 'Tyrol is far more than just a region – it is a feeling of freedom, adventure, and deep connection with nature. Gentle alpine meadows and rugged rock peaks alternate like the seasons, ancient tradition meets modern hospitality, and in every valley a new surprise awaits.', p2: 'Whether you stroll through the historic alleys of Innsbruck, enjoy panoramic views from the summit of a three-thousander, or sample Tyrolean delicacies in a rustic hut – this corner of the earth has a soul you can feel. Let our diversity surprise you.', features: [
    { icon: '🏔️', text: '835 Three-thousanders' },
    { icon: '🥾', text: '24,500 km of Hiking Trails' },
    { icon: '🚡', text: '580 Cable Cars & Lifts' },
    { icon: '🍽️', text: 'Tyrolean Cuisine' },
  ], highlight: { icon: '💡', title: 'Did You Know?', text: 'In Tyrol there are over <strong>60 different snack stations and alpine huts</strong> that are only accessible on foot or by cable car. Each one serves homemade Kaiserschmarrn, Kaspressknödel, and other Tyrolean specialties – with guaranteed stunning mountain scenery.', cta: 'Discover more →' } },
  heute: { label: '#today', title: 'Discover Today', sub: 'Random finds from all categories – new every day. Click your way through Tyrol\'s most colorful pages.' },
  regionen: { label: '#regionen', title: 'Our Regions', sub: 'One land, countless faces. Each Tyrolean region has its own character – from the urban Alpine city of Innsbruck to the pristine glacier worlds of the Kaunertal.', lead: 'Whether action-packed days in the Zillertal, culinary delights in the Stubaital, or luxurious escapes in Kitzbühel – find your perfect region here. Every destination on our portal has been curated, rated, and described personally.' },
  sehenswuerdigkeiten: { label: '#sights', title: 'Sights & Attractions', sub: 'From historic churches to spectacular mountain peaks and cultural highlights – Tyrol\'s most beautiful excursion destinations.' },
  unterkuenfte: { label: '#accommodation', title: 'Top Accommodations', sub: 'Hand-picked hotels, apartments, and farm stays – for every taste and budget.', lead: 'Our editorial team personally tests and rates every accommodation. Gold-tier properties offer that special something with style and first-class service. Silver stands for excellent value for money, Basic for charming and affordable.' },
  gastro: { label: '#gastro', title: 'Food & Drink', sub: 'From rustic alpine huts to fine dining – Tyrol\'s gastronomy is as diverse as its landscape.' },
  magazin: { label: '#magazine', title: 'Stories from the Mountains', sub: 'Latest stories, tips & inspiration for your next Tyrol holiday.' },
  newsletter: { title: '#tiroltourismus', desc: 'Don\'t miss any news from Tyrol. Exclusive tips, new offers, and stories delivered to your inbox – unsubscribe anytime.', placeholder: 'Your e-mail address', button: 'Subscribe', disclaimer: 'By clicking "Subscribe" you accept our privacy policy.', success: '🎉 Thank you! Welcome to the Tyrol newsletter.' },
  partner: { title: 'Become a', titleAccent: 'Partner', desc: 'Showcase your accommodation, event, or offer on the most modern tourism portal in the Alps. With AI-powered recommendations, smart search, and a growing community of over 50,000 enthusiastic Tyrol fans.', benefits: ['Visibility with 50k+ Visitors', 'Free Listings', 'Social Media Boost', 'Exclusive Events'], cta: 'Become a Partner Now' },
  dailyPickTypes: { unterkunft: 'Accommodation', gastro: 'Gastro', ort: 'Place', sight: 'Sight', magazin: 'Magazine' },
  dailyPickLinks: { unterkunft: '/en/unterkuenfte/', gastro: '/en/gastro/', ort: '/en/orte/', sight: '/en/sehenswuerdigkeiten/', magazin: '/en/magazin/' },
  discover_all: 'Discover all places & sights →',
  all_regions: 'Discover all regions →',
  all_sights: 'Show all sights →',
  all_unterkuenfte: 'Show all accommodations →',
  all_gastro: 'Discover all restaurants →',
  all_magazin: 'Read all magazine articles →',
  no_sights: 'Currently no sights have been added to the database. New entries coming soon.',
  no_unterkuenfte: 'Currently no accommodations have been added.',
  no_gastro: 'Currently no restaurant entries have been added to the database.',
  no_magazin: 'Currently no magazine articles have been published.',
  willkommen_featured: '✨ Find of the Day →',
  willkommen_discover: 'Discover →',
  unknown: 'Unknown',
} : {
  willkommen: { label: '#willkommen', title: 'Willkommen in', titleAccent: 'Tirol', p1: 'Tirol ist weit mehr als nur eine Region – es ist ein Gefühl von Freiheit, Abenteuer und tiefer Verbundenheit mit der Natur. Sanfte Almwiesen und schroffe Felsgipfel wechseln sich ab wie die Jahreszeiten, uralte Tradition trifft auf moderne Gastfreundschaft, und in jedem Tal wartet eine neue Überraschung.', p2: 'Ob Sie durch die historischen Gassen Innsbrucks schlendern, auf dem Gipfel eines Dreitausenders den Panoramablick genießen oder in einer urigen Hütte Tiroler Schmankerl kosten – dieser Flecken Erde hat eine Seele, die man spüren kann. Lassen Sie sich von unserer Vielfalt überraschen.', features: [
    { icon: '🏔️', text: '835 Dreitausender' },
    { icon: '🥾', text: '24.500 Wanderkilometer' },
    { icon: '🚡', text: '580 Liftanlagen' },
    { icon: '🍽️', text: 'Tiroler Genussküche' },
  ], highlight: { icon: '💡', title: 'Wussten Sie?', text: 'In Tirol gibt es über <strong>60 verschiedene Jausenstationen und Almhütten</strong>, die nur zu Fuß oder mit der Seilbahn erreichbar sind. Jede davon serviert hausgemachten Kaiserschmarrn, Kaspressknödel und andere Tiroler Spezialitäten – mit einmaliger Bergkulisse garantiert.', cta: 'Mehr entdecken →' } },
  heute: { label: '#heute', title: 'Heute entdecken', sub: 'Zufallsfunde aus allen Kategorien – jeden Tag neu. Klick Dich durch Tirols bunteste Seiten.' },
  regionen: { label: '#regionen', title: 'Unsere Regionen', sub: 'Ein Land, unendlich viele Gesichter. Jede Region Tirols hat ihren eigenen Charakter – von der urbanen Alpenstadt Innsbruck bis zu den unberührten Gletscherwelten des Kaunertals.', lead: 'Egal ob actionreiche Tage im Zillertal, kulinarische Genussmomente im Stubaital oder luxuriöse Auszeiten in Kitzbühel – hier finden Sie Ihre perfekte Region. Jede Destination in unserem Portal wurde kuratiert, bewertet und mit persönlichen Beschreibungen versehen.' },
  sehenswuerdigkeiten: { label: '#sehenswuerdigkeiten', title: 'Sehenswürdigkeiten', sub: 'Von historischen Kirchen über spektakuläre Berggipfel bis zu kulturellen Highlights – Tirols schönste Ausflugsziele.' },
  unterkuenfte: { label: '#unterkuenfte', title: 'Top Unterkünfte', sub: 'Handverlesene Hotels, Ferienwohnungen und Bauernhöfe – für jeden Geschmack und jedes Budget.', lead: 'Unsere Redaktion testet und bewertet jede Unterkunft persönlich. Gold-gekennzeichnete Häuser bieten das besondere Extra mit Stil und erstklassigem Service. Silber steht für exzellentes Preis-Leistungs-Verhältnis, Basic für charmant und erschwinglich.' },
  gastro: { label: '#gastro', title: 'Essen & Trinken', sub: 'Von der urigen Almhütte bis zur gehobenen Küche – Tirols Gastronomie ist so vielfältig wie seine Landschaft.' },
  magazin: { label: '#magazin', title: 'Stories aus den Bergen', sub: 'Neueste Geschichten, Tipps & Inspirationen rund um Ihren nächsten Tirol-Urlaub.' },
  newsletter: { title: '#tiroltourismus', desc: 'Verpassen Sie keine Neuigkeit aus Tirol. Exklusive Tipps, neue Angebote und Geschichten direkt in Ihr Postfach – jederzeit kündbar.', placeholder: 'Deine E-Mail-Adresse', button: 'Anmelden', disclaimer: 'Mit Klick auf "Anmelden" akzeptierst Du unsere Datenschutzbestimmungen.', success: '🎉 Danke! Willkommen im Tirol-Newsletter.' },
  partner: { title: 'Partner', titleAccent: 'werden', desc: 'Zeige Deine Unterkunft, Dein Event oder Dein Angebot auf dem modernsten Tourismusportal der Alpen. Mit KI-gestützten Empfehlungen, intelligenter Suche und einer wachsenden Community von über 50.000 begeisterten Tirol-Fans.', benefits: ['Sichtbarkeit bei 50k+ Visitors', 'Kostenlose Einträge', 'Social-Media-Boost', 'Exklusive Events'], cta: 'Jetzt Partner werden' },
  dailyPickTypes: { unterkunft: 'Unterkunft', gastro: 'Gastro', ort: 'Ort', sight: 'Sehenswürdigkeit', magazin: 'Magazin' },
  dailyPickLinks: { unterkunft: '/unterkuenfte/', gastro: '/gastro/', ort: '/orte/', sight: '/sehenswuerdigkeiten/', magazin: '/magazin/' },
  discover_all: 'Alle Orte & Sehenswürdigkeiten entdecken →',
  all_regions: 'Alle Regionen entdecken →',
  all_sights: 'Alle Sehenswürdigkeiten anzeigen →',
  all_unterkuenfte: 'Alle Unterkünfte anzeigen →',
  all_gastro: 'Alle Gastro-Adressen entdecken →',
  all_magazin: 'Alle Magazin-Beiträge lesen →',
  no_sights: 'Aktuell sind keine Sehenswürdigkeiten in der Datenbank erfasst. Neue Einträge folgen in Kürze.',
  no_unterkuenfte: 'Aktuell sind keine Unterkünfte erfasst.',
  no_gastro: 'Aktuell sind keine Gastro-Einträge in der Datenbank erfasst.',
  no_magazin: 'Aktuell sind keine Magazinbeiträge veröffentlicht.',
  willkommen_featured: 'Zufallsfund des Tages →',
  willkommen_discover: 'Entdecken →',
  unknown: 'Unbekannt',
};

// ── Read ALL real collection data ──
const regionen = readCollection('regionen', locale).filter(r => isPublished(r.entry));
const unterkuenfte = readCollection('unterkuenfte', locale).filter(u => isPublished(u.entry));
const alleGastro = readCollection('gastro', locale).filter(g => isPublished(g.entry));
const alleOrte = readCollection('orte', locale).filter(o => isPublished(o.entry));
const alleSights = readCollection('sehenswuerdigkeiten', locale).filter(s => isPublished(s.entry));
const alleMagazin = readCollection('magazin', locale).filter(a => isPublished(a.entry));

// ── Sort accommodations: gold first, then silver, then basic ──
const sortedUnterkuenfte = [...unterkuenfte].sort((a, b) => {
  const order = { gold: 0, silver: 1, basic: 2 };
  return (order[a.entry.tier||'basic']||2) - (order[b.entry.tier||'basic']||2);
});
const top3Unterkuenfte = sortedUnterkuenfte.slice(0, 3);

// ── Pick 3 random gastro ──
const shuffledGastro = [...alleGastro].sort(() => Math.random() - 0.5).slice(0, 3);

// ── Top sights: up to 4 (featured first, then shuffled) ──
const featuredSights = alleSights.filter(s => s.entry.featured);
const otherSights = alleSights.filter(s => !s.entry.featured);
const sortedSights = [...featuredSights, ...otherSights.sort(() => Math.random() - 0.5)].slice(0, 4);

// ── Magazine sorted by date (newest first) ──
const sortedMagazin = [...alleMagazin].sort((a, b) => {
  if (!a.entry.datum) return 1; if (!b.entry.datum) return -1;
  return new Date(b.entry.datum) - new Date(a.entry.datum);
});
const top3Magazin = sortedMagazin.slice(0, 3);

// ── Build embedded JSON for client-side randomization ──
const allForRandom = {
  unterkuenfte: sortedUnterkuenfte.slice(0, 6).map(u => ({ ...u.entry, slug: u.slug, _type: 'unterkunft' })),
  gastro: alleGastro.slice(0, 6).map(g => ({ ...g.entry, slug: g.slug, _type: 'gastro' })),
  orte: alleOrte.map(o => ({ ...o.entry, slug: o.slug, _type: 'ort' })),
  sights: alleSights.slice(0, 6).map(s => ({ ...s.entry, slug: s.slug, _type: 'sight' })),
  magazin: sortedMagazin.slice(0, 6).map(a => ({ ...a.entry, slug: a.slug, _type: 'magazin' })),
};
const allItemsFlat = Object.values(allForRandom).flat();

// ── Seeded shuffle for daily SSR picks ──
const today = new Date().toDateString();
let seed = today.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
function seededShuffle(arr) {
  const a = [...arr];
  let s = seed;
  for (let i = a.length - 1; i > 0; i--) {
    s = (s * 16807) % 2147483647;
    const j = s % (i + 1);
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
const dailyPicks = seededShuffle(allItemsFlat).slice(0, 4);

// ── Helper: format datum for display ──
function formatDate(d) {
  if (!d) return '';
  const lang = locale === 'en' ? 'en-US' : 'de-DE';
  try { return new Date(d).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' }); }
  catch { return d; }
}
---
<BaseLayout title={locale === 'en' ? 'tiroltourismus.com – The Official Tourism Portal' : 'tiroltourismus.com – Das offizielle Tourismusportal'} description={locale === 'en' ? 'The official tourism portal for Tyrol. Mountains, valleys, enjoyment – discover the diversity of the Alps.' : 'Das offizielle Tourismusportal für Tirol. Berge, Täler, Genuss – entdecken Sie die Vielfalt der Alpen.'} locale={locale}>
  <main>
    <!-- ═══ HERO ═══ -->
    <section class="hero" aria-label="Hero">
      <div class="hero-bg"><img src={page.hero.bgImage} alt="" width="1024" height="1024" loading="eager" fetchpriority="high"></div>
      <div class="hero-glow"></div>
      <div class="hero-content">
        <div id="weatherWidget" class="hero-weather"></div>
        <div class="hero-badge" set:html={page.hero.badge}></div>
        <h1>{page.hero.title.map(line => <span class="line">{line}</span>)}</h1>
        <p set:html={page.hero.subtitle}></p>
        <div class="hero-actions">
          <a href={locale === 'en' ? '/en/#regionen' : page.hero.ctaPrimary.href} class={page.hero.ctaPrimary.class}>{page.hero.ctaPrimary.text}</a>
          <a href={locale === 'en' ? '/en/#unterkuenfte' : page.hero.ctaSecondary.href} class={page.hero.ctaSecondary.class}>{page.hero.ctaSecondary.text}</a>
        </div>
      </div>
    </section>

    <!-- ═══ STATS ═══ -->
    <section class="stats" aria-label={locale === 'en' ? 'Statistics' : 'Statistiken'}>
      <div class="container">
        <div class="stats-grid">
          {page.stats.map((s, i) => (
            <div class={`stat-card reveal r${i+1}`}>
              <span class="stat-icon">{s.icon}</span>
              <div class="stat-num" data-count={s.count}>0</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ WILLKOMMEN / WELCOME ═══ -->
    <section class="willkommen section" id="willkommen">
      <div class="container">
        <div class="willkommen-grid">
          <div class="willkommen-text">
            <div class="section-label" style="text-align:left">{t.willkommen.label}</div>
            <h2 class="willkommen-title">{t.willkommen.title} <span>{t.willkommen.titleAccent}</span></h2>
            <p class="willkommen-p">{t.willkommen.p1}</p>
            <p class="willkommen-p">{t.willkommen.p2}</p>
            <div class="willkommen-features">
              {t.willkommen.features.map(f => (
                <div class="willkommen-feature"><span class="wf-icon">{f.icon}</span><span>{f.text}</span></div>
              ))}
            </div>
          </div>
          <div class="willkommen-highlight">
            <div class="willkommen-highlight-box">
              <span class="wh-icon">{t.willkommen.highlight.icon}</span>
              <h3>{t.willkommen.highlight.title}</h3>
              <p set:html={t.willkommen.highlight.text}></p>
              <a href={locale === 'en' ? '/en/magazin/' : '/magazin/'} class="btn btn-glass btn-sm">{t.willkommen.highlight.cta}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ HEUTE ENTDECKEN / DISCOVER TODAY ═══ -->
    <section class="daily section" id="heute" aria-label={t.heute.title}>
      <div class="container">
        <SectionHeader label={t.heute.label} title={t.heute.title} sub={t.heute.sub} />
        <div class="daily-grid" id="dailyPicks">
          {dailyPicks.map((item, i) => {
            const name = item.name || item.titel || t.unknown;
            const emoji = item.emoji || (item._type === 'unterkunft' ? '🏨' : item._type === 'gastro' ? '🍽️' : item._type === 'ort' ? '🏘️' : item._type === 'sight' ? '🏛️' : '📰');
            const typeLabel = t.dailyPickTypes[item._type] || 'Entdeckung';
            const linkBase = t.dailyPickLinks[item._type] || '/';
            return (
              <a href={`${linkBase}${item.slug}/`} class={`daily-card${i === 0 ? ' daily-featured' : ''}`}>
                <div class="daily-emoji-wrap">
                  <span class="daily-emoji">{emoji}</span>
                  {i === 0 && <span class="daily-star">✨</span>}
                  <button data-fav-btn data-fav-collection={item._type === 'unterkunft' ? 'unterkuenfte' : item._type === 'gastro' ? 'gastro' : item._type === 'ort' ? 'orte' : item._type === 'sight' ? 'sehenswuerdigkeiten' : item._type === 'magazin' ? 'magazin' : item._type} data-fav-slug={item.slug} data-fav-name={name} data-fav-emoji={emoji} data-fav-ort="" data-fav-color="" class="fav-btn daily-fav-btn" aria-label="Zur Merkliste hinzufügen"><svg viewBox="0 0 24 24" width="14" height="14" class="fav-heart-icon"><path class="fav-heart-path" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                </div>
                <div class="daily-body">
                  <span class="daily-type">{typeLabel}</span>
                  <span class="daily-name">{name}</span>
                  <span class="daily-cta">{i === 0 ? t.willkommen_featured : t.willkommen_discover}</span>
                </div>
              </a>
            );
          })}
        </div>
        <div class="section-footer">
          <a href={locale === 'en' ? '/en/orte/' : '/orte/'} class="btn-outline">{t.discover_all}</a>
        </div>
      </div>
    </section>

    <!-- ═══ REGIONEN ═══ -->
    <section class="section" id="regionen" aria-label="Regionen">
      <div class="container">
        <SectionHeader label={t.regionen.label} title={t.regionen.title} sub={t.regionen.sub} />
        <p class="regionen-lead">{t.regionen.lead}</p>
        <div class="section-grid">
          {regionen.map(r => (
            <RegionCard titel={r.entry.titel} slug={r.slug} beschreibung={r.entry.kurzbeschreibung} emoji={r.entry.emoji} bewertung={r.entry.bewertung} farbe={r.entry.farbe} featured={r.entry.featured} />
          ))}
        </div>
        <div class="section-footer">
          <a href={locale === 'en' ? '/en/regionen/' : '/regionen/'} class="btn-outline">{t.all_regions}</a>
        </div>
      </div>
    </section>

    <!-- ═══ SEHENSWÜRDIGKEITEN ═══ -->
    <section class="section" id="sehenswuerdigkeiten" aria-label={locale === 'en' ? 'Sights' : 'Sehenswürdigkeiten'}>
      <div class="container">
        <SectionHeader label={t.sehenswuerdigkeiten.label} title={t.sehenswuerdigkeiten.title} sub={t.sehenswuerdigkeiten.sub} />
        {sortedSights.length > 0 ? (
          <>
            <div class="sight-grid">
              {sortedSights.map(s => (
                <SightCard name={s.entry.name} slug={s.slug} kurzbeschreibung={s.entry.kurzbeschreibung} kategorie={s.entry.kategorie} emoji={s.entry.emoji} farbe={s.entry.farbe} ort={s.entry.ort} preis={s.entry.preis} />
              ))}
            </div>
            <div class="section-footer">
              <a href={locale === 'en' ? '/en/sehenswuerdigkeiten/' : '/sehenswuerdigkeiten/'} class="btn-outline">{t.all_sights}</a>
            </div>
          </>
        ) : (
          <p style="text-align:center;color:var(--text2);padding:40px 0">{t.no_sights}</p>
        )}
      </div>
    </section>

    <!-- ═══ UNTERKÜNFTE ═══ -->
    <section class="section" id="unterkuenfte" aria-label={locale === 'en' ? 'Accommodations' : 'Unterkünfte'}>
      <div class="container">
        <SectionHeader label={t.unterkuenfte.label} title={t.unterkuenfte.title} sub={t.unterkuenfte.sub} />
        <p class="section-lead">{t.unterkuenfte.lead}</p>
        <div class="section-grid" id="unterkunftGrid">
          {top3Unterkuenfte.length > 0 ? top3Unterkuenfte.map(u => (
            <AccommodationCard name={u.entry.name} slug={u.slug} typ={u.entry.typ} ort={u.entry.ort} sterne={u.entry.sterne} preis_ab={u.entry.preis_ab} tier={u.entry.tier || 'basic'} />
          )) : <p style="text-align:center;color:var(--text2);grid-column:1/-1;padding:40px 0">{t.no_unterkuenfte}</p>}
        </div>
        <div class="section-footer">
          <a href={locale === 'en' ? '/en/unterkuenfte/' : '/unterkuenfte/'} class="btn-outline">{t.all_unterkuenfte}</a>
        </div>
      </div>
    </section>

    <!-- ═══ GASTRO ═══ -->
    <section class="section" id="gastro" aria-label={locale === 'en' ? 'Gastronomy' : 'Gastronomie'}>
      <div class="container">
        <SectionHeader label={t.gastro.label} title={t.gastro.title} sub={t.gastro.sub} />
        {alleGastro.length > 0 ? (
          <>
            <div class="section-grid" id="gastroGrid">
              {shuffledGastro.map(g => (
                <GastroCard name={g.entry.name} slug={g.slug} beschreibung={g.entry.kurzbeschreibung} kategorie={g.entry.kategorie} preis={g.entry.preis} emoji={g.entry.emoji} farbe={g.entry.farbe} ort={g.entry.ort} />
              ))}
            </div>
            <div class="section-footer">
              <a href={locale === 'en' ? '/en/gastro/' : '/gastro/'} class="btn-outline">{t.all_gastro}</a>
            </div>
          </>
        ) : <p style="text-align:center;color:var(--text2);padding:40px 0">{t.no_gastro}</p>}
      </div>
    </section>

    <!-- ═══ MAGAZIN ═══ -->
    <section class="section" id="magazin" aria-label={locale === 'en' ? 'Magazine' : 'Magazin'}>
      <div class="container">
        <SectionHeader label={t.magazin.label} title={t.magazin.title} sub={t.magazin.sub} />
        {top3Magazin.length > 0 ? (
          <>
            <div class="section-grid" id="magazinGrid">
              {top3Magazin.map(a => (
                <ArticleCard titel={a.entry.titel} slug={a.slug} teaser={a.entry.teaser} datum={formatDate(a.entry.datum)} kategorie={a.entry.kategorie} />
              ))}
            </div>
            <div class="section-footer">
              <a href={locale === 'en' ? '/en/magazin/' : '/magazin/'} class="btn-outline">{t.all_magazin}</a>
            </div>
          </>
