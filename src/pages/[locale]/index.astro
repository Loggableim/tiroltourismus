---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import RegionCard from '../../components/RegionCard.astro';
import AccommodationCard from '../../components/AccommodationCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import GastroCard from '../../components/GastroCard.astro';
import SightCard from '../../components/SightCard.astro';
import TirolLogo from '../../components/TirolLogo.astro';
import { readCollection, isPublished } from '../../lib/content.js';
import { LANGUAGES_READY } from '../../lib/languages.js';

import dePage from '../../data/homepage.json';
import enPage from '../../data/en/homepage.json';
import frPage from '../../data/fr/homepage.json';
import itPage from '../../data/it/homepage.json';
import esPage from '../../data/es/homepage.json';
import zhPage from '../../data/zh/homepage.json';
import nlPage from '../../data/nl/homepage.json';
import csPage from '../../data/cs/homepage.json';

const PAGE_MAP = {
  de: dePage,
  en: enPage,
  fr: frPage,
  it: itPage,
  es: esPage,
  zh: zhPage,
  nl: nlPage,
  cs: csPage,
};

const SECTION_LABELS = {
  de: { regionen: '#regionen', unterkuenfte: '#unterkuenfte', sehenswuerdigkeiten: '#sehenswuerdigkeiten', gastro: '#gastro', magazin: '#magazin' },
  en: { regionen: '#regions', unterkuenfte: '#accommodations', sehenswuerdigkeiten: '#sights', gastro: '#food-drink', magazin: '#magazine' },
  fr: { regionen: '#régions', unterkuenfte: '#hébergements', sehenswuerdigkeiten: '#sites', gastro: '#gastronomie', magazin: '#magazine' },
  it: { regionen: '#regioni', unterkuenfte: '#alloggi', sehenswuerdigkeiten: '#attrazioni', gastro: '#gastronomia', magazin: '#magazine' },
  es: { regionen: '#regiones', unterkuenfte: '#alojamientos', sehenswuerdigkeiten: '#atracciones', gastro: '#gastronomía', magazin: '#revista' },
  zh: { regionen: '#地区', unterkuenfte: '#住宿', sehenswuerdigkeiten: '#景点', gastro: '#美食', magazin: '#杂志' },
  nl: { regionen: '#regio\'s', unterkuenfte: '#accommodaties', sehenswuerdigkeiten: '#bezienswaardigheden', gastro: '#eten-drinken', magazin: '#tijdschrift' },
  cs: { regionen: '#regiony', unterkuenfte: '#ubytovani', sehenswuerdigkeiten: '#pametihodnosti', gastro: '#gastronomie', magazin: '#magazin' },
};

export async function getStaticPaths() {
  return LANGUAGES_READY.filter((locale) => locale !== 'de').map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale || 'de';
const sl = SECTION_LABELS[locale] || SECTION_LABELS.de;
const page = PAGE_MAP[locale] || dePage;
const localePrefix = locale === 'de' ? '' : `/${locale}`;

const regions = readCollection('regionen', locale).filter((r) => isPublished(r.entry)).slice(0, 6);
const stays = readCollection('unterkuenfte', locale).filter((u) => isPublished(u.entry)).slice(0, 3);
const gastro = readCollection('gastro', locale).filter((g) => isPublished(g.entry)).slice(0, 3);
const sights = readCollection('sehenswuerdigkeiten', locale).filter((s) => isPublished(s.entry)).slice(0, 4);
const magazin = readCollection('magazin', locale).filter((a) => isPublished(a.entry)).slice(0, 3);
---

<BaseLayout
  title={locale === 'de' ? 'Startseite' : locale === 'en' ? 'Home' : locale === 'fr' ? 'Accueil' : locale === 'it' ? 'Home' : locale === 'es' ? 'Inicio' : locale === 'zh' ? '首页' : locale === 'nl' ? 'Startpagina' : locale === 'cs' ? 'Domovská stránka' : 'Startseite'}
  description={page.hero?.subtitle}
  locale={locale}
  preloadImage={page.hero?.bgImage}
>
  <main>
    <section class="hero" aria-label="Hero">
      <div class="hero-bg"><img src={page.hero.bgImage} alt="" width="1024" height="1024" loading="eager" fetchpriority="high"></div>
      <div class="hero-glow"></div>
      <div class="hero-content">
        <div class="hero-badge" set:html={page.hero.badge}></div>
        <div class="hero-headline">
          <h1>{page.hero.title.map(line => <span class="line">{line}</span>)}</h1>
        </div>
        <p set:html={page.hero.subtitle}></p>
        <div class="hero-actions">
          <a href={page.hero.ctaPrimary.href} class={page.hero.ctaPrimary.class}>{page.hero.ctaPrimary.text}</a>
          <a href={page.hero.ctaSecondary.href} class={page.hero.ctaSecondary.class}>{page.hero.ctaSecondary.text}</a>
        </div>
      </div>
    </section>

    <section class="stats" aria-label="Statistiken">
      <div class="container">
        <div class="stats-grid">
          {page.stats.map((s, i) => (
            <div class={`stat-card reveal r${i + 1}`}>
              <span class="stat-icon">{s.icon}</span>
              <div class="stat-num" data-count={s.count}>0</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="regionen">
      <div class="container">
        <SectionHeader label={sl.regionen} title={page.regionen.title} sub={page.regionen.desc} />
        <div class="section-grid">
          {regions.map((r) => (
            <RegionCard
              titel={r.entry.titel}
              slug={r.slug}
              beschreibung={r.entry.kurzbeschreibung}
              emoji={r.entry.emoji}
              bewertung={r.entry.bewertung}
              farbe={r.entry.farbe}
              featured={r.entry.featured}
              locale={locale}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="unterkuenfte">
      <div class="container">
        <SectionHeader label={sl.unterkuenfte} title={page.unterkuenfte.title} sub={page.unterkuenfte.desc} />
        <div class="section-grid">
          {stays.map((u) => (
            <AccommodationCard
              name={u.entry.name || u.entry.titel}
              slug={u.slug}
              ort={u.entry.ort}
              sterne={u.entry.sterne}
              tier={u.entry.tier}
              preis_ab={u.entry.preis}
              locale={locale}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="sehenswuerdigkeiten">
      <div class="container">
        <SectionHeader label={sl.sehenswuerdigkeiten} title={locale === 'de' ? 'Sehenswürdigkeiten' : locale === 'fr' ? 'Sites' : locale === 'it' ? 'Attrazioni' : locale === 'es' ? 'Atracciones' : locale === 'zh' ? '景点' : locale === 'nl' ? 'Bezienswaardigheden' : locale === 'cs' ? 'Pamětihodnosti' : 'Sights'} sub={locale === 'de' ? 'Die schönsten Ausflugsziele in Tirol.' : locale === 'en' ? 'Discover the most beautiful excursion destinations in Tyrol.' : locale === 'fr' ? 'Découvrez les plus beaux sites touristiques du Tyrol.' : locale === 'it' ? 'Scopri le più belle attrazioni del Tirolo.' : locale === 'es' ? 'Descubre los lugares de interés más bellos del Tirol.' : locale === 'zh' ? '发现蒂罗尔最美丽的景点。' : locale === 'nl' ? 'Ontdek de mooiste uitstapbestemmingen in Tirol.' : locale === 'cs' ? 'Objevte nejkrásnější výletní cíle v Tyrolsku.' : page.whyTirol?.desc || page.regionen.desc} />
        <div class="sight-grid">
          {sights.map((s) => (
            <SightCard
              name={s.entry.name}
              slug={s.slug}
              kurzbeschreibung={s.entry.kurzbeschreibung}
              kategorie={s.entry.kategorie}
              emoji={s.entry.emoji}
              farbe={s.entry.farbe}
              ort={s.entry.ort}
              preis={s.entry.preis}
              linkPrefix={`${localePrefix}/sehenswuerdigkeiten/`}
              locale={locale}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="gastro">
      <div class="container">
        <SectionHeader label={sl.gastro} title={locale === 'de' ? 'Gastronomie' : locale === 'en' ? 'Food & Drink' : locale === 'fr' ? 'Gastronomie' : locale === 'it' ? 'Gastronomia' : locale === 'es' ? 'Gastronomía' : locale === 'zh' ? '美食' : locale === 'nl' ? 'Eten & Drinken' : locale === 'cs' ? 'Gastronomie' : 'Food & Drink'} sub={locale === 'de' ? 'Tiroler Genuss und alpine Küche.' : locale === 'en' ? 'Tyrolean cuisine and alpine dining experiences.' : locale === 'fr' ? 'Cuisine tyrolienne et gastronomie alpine.' : locale === 'it' ? 'Cucina tirolese e gastronomia alpina.' : locale === 'es' ? 'Cocina tirolesa y gastronomía alpina.' : locale === 'zh' ? '蒂罗尔美食与阿尔卑斯餐饮体验。' : locale === 'nl' ? 'Tirolse gastronomie en alpine eetervaringen.' : locale === 'cs' ? 'Tyrolský gastronomický zážitek a alpská kuchyně.' : page.whyTirol?.desc || page.regionen.desc} />
        <div class="section-grid">
          {gastro.map((g) => (
            <GastroCard
              name={g.entry.name}
              slug={g.slug}
              beschreibung={g.entry.kurzbeschreibung}
              kategorie={g.entry.kategorie}
              emoji={g.entry.emoji}
              ort={g.entry.ort}
              preis={g.entry.preis}
              linkPrefix={`${localePrefix}/gastro/`}
              locale={locale}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="magazin">
      <div class="container">
        <SectionHeader label={sl.magazin} title={locale === 'de' ? 'Magazin' : locale === 'en' ? 'Magazine' : locale === 'fr' ? 'Magazine' : locale === 'it' ? 'Magazine' : locale === 'es' ? 'Revista' : locale === 'zh' ? '杂志' : locale === 'nl' ? 'Tijdschrift' : locale === 'cs' ? 'Časopis' : 'Magazine'} sub={locale === 'de' ? 'Neue Geschichten, Reiseideen und Tirol-Highlights.' : locale === 'en' ? 'New stories, travel ideas and Tyrolean highlights.' : locale === 'fr' ? 'Nouvelles histoires, idées de voyage et points forts du Tyrol.' : locale === 'it' ? 'Nuove storie, idee di viaggio e highlights tirolesi.' : locale === 'es' ? 'Nuevas historias, ideas de viaje y destacados del Tirol.' : locale === 'zh' ? '新故事、旅行灵感和蒂罗尔亮点。' : locale === 'nl' ? 'Nieuwe verhalen, reisideeën en Tirolse hoogtepunten.' : locale === 'cs' ? 'Nové příběhy, inspiro na cesty a tyrolské hvězdy.' : page.regionen.desc} />
        <div class="section-grid">
          {magazin.map((a) => (
            <ArticleCard
              slug={a.slug}
              titel={a.entry.titel}
              teaser={a.entry.kurzbeschreibung}
              datum={a.entry.datum}
              kategorie={a.entry.kategorie}
              hero_bild={a.entry.hero_bild}
              locale={locale}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
