---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import RegionCard from '../../components/RegionCard.astro';
import AccommodationCard from '../../components/AccommodationCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import GastroCard from '../../components/GastroCard.astro';
import SightCard from '../../components/SightCard.astro';
import { readCollection, isPublished } from '../../lib/content.js';
import { LANGUAGES_READY } from '../../lib/languages.js';

import dePage from '../../data/homepage.json';
import enPage from '../../data/en/homepage.json';
import frPage from '../../data/fr/homepage.json';
import itPage from '../../data/it/homepage.json';

const PAGE_MAP = {
  de: dePage,
  en: enPage,
  fr: frPage,
  it: itPage,
  es: dePage,
  zh: dePage,
};

export async function getStaticPaths() {
  return LANGUAGES_READY.filter((locale) => locale !== 'de').map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale || 'de';
const page = PAGE_MAP[locale] || dePage;

const regions = readCollection('regionen').filter((r) => isPublished(r.entry)).slice(0, 6);
const stays = readCollection('unterkuenfte').filter((u) => isPublished(u.entry)).slice(0, 3);
const gastro = readCollection('gastro').filter((g) => isPublished(g.entry)).slice(0, 3);
const sights = readCollection('sehenswuerdigkeiten').filter((s) => isPublished(s.entry)).slice(0, 4);
const magazin = readCollection('magazin').filter((a) => isPublished(a.entry)).slice(0, 3);
---

<BaseLayout
  title={locale === 'de' ? 'Startseite' : locale === 'en' ? 'Home' : locale === 'fr' ? 'Accueil' : locale === 'it' ? 'Home' : locale === 'es' ? 'Inicio' : '首页'}
  description={page.hero?.subtitle}
  locale={locale}
>
  <main>
    <section class="hero" aria-label="Hero">
      <div class="hero-bg"><img src={page.hero.bgImage} alt="" width="1024" height="1024" loading="eager" fetchpriority="high"></div>
      <div class="hero-glow"></div>
      <div class="hero-content">
        <div class="hero-badge" set:html={page.hero.badge}></div>
        <h1>{page.hero.title.map(line => <span class="line">{line}</span>)}</h1>
        <p set:html={page.hero.subtitle}></p>
        <div class="hero-actions">
          <a href={page.hero.ctaPrimary.href} class={page.hero.ctaPrimary.class}>{page.hero.ctaPrimary.text}</a>
          <a href={page.hero.ctaSecondary.href} class={page.hero.ctaSecondary.class}>{page.hero.ctaSecondary.text}</a>
        </div>
      </div>
    </section>

    <section class="stats" aria-label="Statistiken">
      <div class="container">
        <div class="stats-grid">
          {page.stats.map((s, i) => (
            <div class={`stat-card reveal r${i + 1}`}>
              <span class="stat-icon">{s.icon}</span>
              <div class="stat-num" data-count={s.count}>0</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="regionen">
      <div class="container">
        <SectionHeader label="#regionen" title={page.regionen.title} sub={page.regionen.desc} />
        <div class="section-grid">
          {regions.map((r) => (
            <RegionCard
              titel={r.entry.titel}
              slug={r.slug}
              beschreibung={r.entry.kurzbeschreibung}
              emoji={r.entry.emoji}
              bewertung={r.entry.bewertung}
              farbe={r.entry.farbe}
              featured={r.entry.featured}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="unterkuenfte">
      <div class="container">
        <SectionHeader label="#unterkuenfte" title={page.unterkuenfte.title} sub={page.unterkuenfte.desc} />
        <div class="section-grid">
          {stays.map((u) => (
            <AccommodationCard
              titel={u.entry.titel}
              slug={u.slug}
              beschreibung={u.entry.kurzbeschreibung}
              ort={u.entry.ort}
              stern={u.entry.sterne}
              image={u.entry.bilder?.[0] || u.entry.bild || '/brand/hero-logos/konzept1_gipfellinie_20260517_083224.webp'}
              tier={u.entry.tier}
              preis={u.entry.preis}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="sehenswuerdigkeiten">
      <div class="container">
        <SectionHeader label="#sehenswuerdigkeiten" title={locale === 'de' ? 'Sehenswürdigkeiten' : locale === 'fr' ? 'Sites' : locale === 'it' ? 'Attrazioni' : locale === 'es' ? 'Atracciones' : locale === 'zh' ? '景点' : 'Sights'} sub={locale === 'de' ? 'Die schönsten Ausflugsziele in Tirol.' : page.whyTirol?.desc || page.regionen.desc} />
        <div class="sight-grid">
          {sights.map((s) => (
            <SightCard
              name={s.entry.name}
              slug={s.slug}
              kurzbeschreibung={s.entry.kurzbeschreibung}
              kategorie={s.entry.kategorie}
              emoji={s.entry.emoji}
              farbe={s.entry.farbe}
              ort={s.entry.ort}
              preis={s.entry.preis}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="gastro">
      <div class="container">
        <SectionHeader label="#gastro" title={locale === 'de' ? 'Gastronomie' : page.regionen.title} sub={locale === 'de' ? 'Tiroler Genuss und alpine Küche.' : page.whyTirol?.desc || page.regionen.desc} />
        <div class="section-grid">
          {gastro.map((g) => (
            <GastroCard
              name={g.entry.name}
              slug={g.slug}
              kurzbeschreibung={g.entry.kurzbeschreibung}
              kategorie={g.entry.kategorie}
              emoji={g.entry.emoji}
              ort={g.entry.ort}
              preis={g.entry.preis}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="magazin">
      <div class="container">
        <SectionHeader label="#magazin" title={locale === 'de' ? 'Magazin' : page.magazin?.[0]?.title || 'Magazine'} sub={locale === 'de' ? 'Neue Geschichten, Reiseideen und Tirol-Highlights.' : page.regionen.desc} />
        <div class="section-grid">
          {magazin.map((a) => (
            <ArticleCard
              slug={a.slug}
              titel={a.entry.titel}
              kurzbeschreibung={a.entry.kurzbeschreibung}
              datum={a.entry.datum}
              kategorie={a.entry.kategorie}
              bild={a.entry.bild || a.entry.bilder?.[0]}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
