---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactForm from '../../components/ContactForm.tsx';
import { LANGUAGES_READY } from '../../lib/languages.js';

export async function getStaticPaths() {
  return LANGUAGES_READY.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout title="Kontakt" description="Kontaktiere das Team von tiroltourismus.com" locale={locale}>
  <main>
    <div class="container"><Breadcrumbs items="{[{ label: 'Kontakt' }]}" /></div>
    <section class="page-header"><h1>Kontakt</h1></section>
    <ContactForm client:load />
  </main>
</BaseLayout>
