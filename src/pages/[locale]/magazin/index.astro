---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import FilterBar from '../../../components/FilterBar.astro';
import { readCollection, isPublished } from '../../../lib/content.js';
import { LANGUAGES_READY, DEFAULT_LOCALE, localePrefix } from '../../../lib/languages.js';

export async function getStaticPaths() {
  return LANGUAGES_READY.filter((locale) => locale !== 'de').map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = (map) => map[locale] || map[DEFAULT_LOCALE] || '';
const pref = localePrefix(locale);

const labels = {
  title: { de: 'Tirol Magazin', en: 'Tyrol Magazine', fr: 'Magazine du Tyrol', it: 'Magazine del Tirolo', es: 'Revista de Tirol', zh: '蒂罗尔杂志', nl: 'Tirol Magazine', cs: 'Magazín Tyrolska' },
  desc: { de: 'Das Tirol Magazin: Inspiration für Deinen nächsten Urlaub in den Alpen.', en: 'The Tyrol Magazine: Inspiration for your next holiday in the Alps.', fr: 'Le Magazine du Tyrol: Inspiration pour vos prochaines vacances dans les Alpes.', it: 'Il Magazine del Tirolo: Ispirazione per la tua prossima vacanza nelle Alpi.', es: 'La Revista de Tirol: Inspiración para tus próximas vacaciones en los Alpes.', zh: '蒂罗尔杂志：为您下一次阿尔卑斯假期提供灵感。', nl: 'Het Tirol Magazine: Inspiratie voor je volgende vakantie in de Alpen.', cs: 'Magazín Tyrolska: Inspirace pro vaši příští dovolenou v Alpách.' },
  heroSub: { de: 'Geschichten, Tipps und Reportagen aus Tirol.', en: 'Stories, tips and reports from Tyrol.', fr: 'Histoires, conseils et reportages du Tyrol.', it: 'Storie, consigli e reportage dal Tirolo.', es: 'Historias, consejos y reportajes de Tirol.', zh: '来自蒂罗尔的故事、建议和报道。', nl: 'Verhalen, tips en reportages uit Tirol.', cs: 'Příběhy, tipy a reportáže z Tyrolska.' },
  sectionTitle: { de: 'Stories aus den Bergen', en: 'Stories from the Mountains', fr: 'Histoires des Montagnes', it: 'Storie dalle Montagne', es: 'Historias de las Montañas', zh: '山间故事', nl: 'Verhalen uit de Bergen', cs: 'Příběhy z hor' },
  sectionSub: { de: 'Neueste Geschichten, Tipps & Inspirationen – bunt wie Tirol.', en: 'Latest stories, tips & inspiration – as colorful as Tyrol.', fr: 'Dernières histoires, conseils & inspiration – aussi colorées que le Tyrol.', it: 'Ultime storie, consigli & ispirazione – colorate come il Tirolo.', es: 'Últimas historias, consejos e inspiración – tan coloridas como Tirol.', zh: '最新故事、建议和灵感——像蒂罗尔一样多彩。', nl: 'Laatste verhalen, tips & inspiratie – zo kleurrijk als Tirol.', cs: 'Nejnovější příběhy, tipy & inspirace – barevné jako Tyrolsko.' },
  filterAria: { de: 'Magazin nach Kategorie filtern', en: 'Filter magazine by category', fr: 'Filtrer le magazine par catégorie', it: 'Filtra magazine per categoria', es: 'Filtrar revista por categoría', zh: '按类别筛选杂志', nl: 'Filter magazine op categorie', cs: 'Filtrovat magazín podle kategorie' },
  emptyTitle: { de: 'Bald verfügbar', en: 'Coming Soon', fr: 'Bientôt disponible', it: 'Presto disponibile', es: 'Próximamente', zh: '即将上线', nl: 'Binnenkort beschikbaar', cs: 'Brzy k dispozici' },
  emptyText: { de: 'Magazin-Artikel werden aktuell eingepflegt.', en: 'Magazine articles are being added.', fr: 'Les articles de magazine sont en cours d\'ajout.', it: 'Gli articoli del magazine sono in fase di inserimento.', es: 'Los artículos de revista se están añadiendo.', zh: '杂志文章正在添加中。', nl: 'Magazine-artikelen worden momenteel toegevoegd.', cs: 'Články magazínu se právě přidávají.' },
  countLabel: { de: 'Artikel', en: 'articles', fr: 'articles', it: 'articoli', es: 'artículos', zh: '文章', nl: 'artikelen', cs: 'články' },
};

const catLabel = {
  allgemein: { de: 'Allgemein', en: 'General', fr: 'Général', it: 'Generale', es: 'General', zh: '综合', nl: 'Algemeen', cs: 'Obecné' },
  tipps: { de: 'Tipps', en: 'Tips', fr: 'Conseils', it: 'Consigli', es: 'Consejos', zh: '建议', nl: 'Tips', cs: 'Tipy' },
  reiseberichte: { de: 'Reiseberichte', en: 'Travel Reports', fr: 'Récits de Voyage', it: 'Resoconti di Viaggio', es: 'Relatos de Viaje', zh: '旅行报告', nl: 'Reisverslagen', cs: 'Cestovní zprávy' },
  interview: { de: 'Interview', en: 'Interview', fr: 'Interview', it: 'Intervista', es: 'Entrevista', zh: '采访', nl: 'Interview', cs: 'Rozhovor' },
  hintergrund: { de: 'Hintergrund', en: 'Background', fr: 'Contexte', it: 'Sfondo', es: 'Trasfondo', zh: '背景', nl: 'Achtergrond', cs: 'Pozadí' },
  kulinarik: { de: 'Kulinarik', en: 'Culinary', fr: 'Gastronomie', it: 'Enogastronomia', es: 'Gastronomía', zh: '美食', nl: 'Culinaire', cs: 'Gastronomie' },
  natur: { de: 'Natur', en: 'Nature', fr: 'Nature', it: 'Natura', es: 'Naturaleza', zh: '自然', nl: 'Natuur', cs: 'Příroda' },
  kultur: { de: 'Kultur', en: 'Culture', fr: 'Culture', it: 'Cultura', es: 'Cultura', zh: '文化', nl: 'Cultuur', cs: 'Kultura' },
  sport: { de: 'Sport', en: 'Sports', fr: 'Sport', it: 'Sport', es: 'Deportes', zh: '运动', nl: 'Sport', cs: 'Sport' },
  wandern: { de: 'Wandern', en: 'Hiking', fr: 'Randonnée', it: 'Escursionismo', es: 'Senderismo', zh: '徒步', nl: 'Wandelen', cs: 'Turistika' },
  ski: { de: 'Ski', en: 'Ski', fr: 'Ski', it: 'Sci', es: 'Esquí', zh: '滑雪', nl: 'Skiën', cs: 'Lyžování' },
  bike: { de: 'Bike', en: 'Bike', fr: 'Vélo', it: 'Bici', es: 'Bici', zh: '骑行', nl: 'Fietsen', cs: 'Kolo' },
  wellness: { de: 'Wellness', en: 'Wellness', fr: 'Bien-être', it: 'Benessere', es: 'Bienestar', zh: '养生', nl: 'Wellness', cs: 'Wellness' },
  familie: { de: 'Familie', en: 'Family', fr: 'Famille', it: 'Famiglia', es: 'Familia', zh: '家庭', nl: 'Gezin', cs: 'Rodina' },
  abenteuer: { de: 'Abenteuer', en: 'Adventure', fr: 'Aventure', it: 'Avventura', es: 'Aventura', zh: '冒险', nl: 'Avontuur', cs: 'Dobrodružství' },
  events: { de: 'Events', en: 'Events', fr: 'Événements', it: 'Eventi', es: 'Eventos', zh: '活动', nl: 'Evenementen', cs: 'Akce' },
  regionen: { de: 'Regionen', en: 'Regions', fr: 'Régions', it: 'Regioni', es: 'Regiones', zh: '地区', nl: "Regio's", cs: 'Regiony' },
};

const getCatLabel = (key) => {
  const map = catLabel[key];
  return map ? (map[locale] || map[DEFAULT_LOCALE] || key) : key;
};
const articles = readCollection('magazin', locale);
const published = articles.filter(a => isPublished(a.entry)).sort((a, b) => (b.entry.datum || '').localeCompare(a.entry.datum || ''));
const featured = published.slice(0, 1);
const secondary = published.slice(1, 3);
const rest = published.slice(3);

function formatDate(d) {
  if (!d) return '';
  try { return new Date(d + 'T00:00:00').toLocaleDateString(locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-US' : locale === 'fr' ? 'fr-FR' : locale === 'it' ? 'it-IT' : locale === 'es' ? 'es-ES' : locale === 'nl' ? 'nl-NL' : locale === 'cs' ? 'cs-CZ' : 'de-DE', { year: 'numeric', month: 'long', day: 'numeric' }); }
  catch { return d; }
}

const siteURL = 'https://www.tirol-tourismus.at';
const magazinItemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: t(labels.title), description: t(labels.desc),
  url: `${siteURL}${pref}/magazin/`,
  numberOfItems: published.length,
  itemListElement: published.slice(0, 30).map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: a.entry.titel, url: `${siteURL}${pref}/magazin/${a.slug}/` })),
};
---

<BaseLayout title={t(labels.title)} description={t(labels.desc)} locale={locale} jsonld={magazinItemList}>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: t(labels.title) }]} />
    </div>

    <Hero title={t(labels.title)} subtitle={t(labels.heroSub)} emoji="📰" size="md">
      <div slot="actions" class="hero-actions">
        <a href="#magazin-grid" class="btn btn-pink">{t(labels.title)} →</a>
        <span class="hero-urgency">📖 {published.length} {t(labels.countLabel)}</span>
      </div>
    </Hero>

    {published.length > 0 ? (
      <>
        {featured.length > 0 && (
          <section class="section featured-section">
            <div class="container">
              {featured.map((a) => (
                <a href={`${pref}/magazin/${a.slug}/`} class="featured-card">
                  <div class="featured-img">
                    {a.entry.hero_bild ? (
                      <img src={a.entry.hero_bild} alt={a.entry.titel} loading="eager" />
                    ) : (
                      <div class="featured-emoji">📰</div>
                    )}
                    <div class="featured-overlay">
                      <span class="featured-tag">{(getCatLabel(a.entry.kategorie) || a.entry.kategorie || '').toUpperCase()}</span>
                      <h2 class="featured-title">{a.entry.titel}</h2>
                      <p class="featured-teaser">{a.entry.teaser}</p>
                      <span class="featured-link">Weiterlesen →</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="section" id="magazin-grid">
          <div class="container">
            <div class="pop-header">
              <span class="pop-header-label">✦ {t(labels.title)}</span>
              <h2 class="pop-header-title">{t(labels.sectionTitle)}</h2>
              <p class="pop-header-sub">{t(labels.sectionSub)}</p>
            </div>

            <FilterBar keyName="cat" ariaLabel={t(labels.filterAria)} options={[
              { value: 'tipps', label: getCatLabel('tipps') },
              { value: 'reiseberichte', label: getCatLabel('reiseberichte') },
              { value: 'hintergrund', label: getCatLabel('hintergrund') },
              { value: 'allgemein', label: getCatLabel('allgemein') },
            ]} />

            <div class="tile-grid">
              {[secondary, rest].flat().map((a, i) => {
                let tileClass = 'tile';
                if (i < 2) tileClass += ' tile-w2';
                else if (i % 8 === 0) tileClass += ' tile-wh2';
                else if (i % 5 === 0) tileClass += ' tile-w2';
                let colorIdx = i % 8;
                tileClass += ` tile-color-${colorIdx}`;
                return (
                  <a href={`${pref}/magazin/${a.slug}/`} class={tileClass} data-filter-card data-filter-cat={a.entry.kategorie}>
                    {a.entry.hero_bild && (
                      <>
                        <img src={a.entry.hero_bild} alt={a.entry.titel} class="tile-img" loading="lazy" />
                        <div class="tile-overlay"></div>
                      </>
                    )}
                    <div class="tile-content">
                      <span class="tile-tag">{(getCatLabel(a.entry.kategorie) || a.entry.kategorie || '').toUpperCase()}</span>
                      <h3 class="tile-title">{a.entry.titel}</h3>
                      {a.entry.datum && <span class="tile-date">{formatDate(a.entry.datum)}</span>}
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      </>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:80px 0">
          <div style="font-size:64px;margin-bottom:16px">📰</div>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase">{t(labels.emptyTitle)}</h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">{t(labels.emptyText)}</p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  .featured-section{padding-top:0!important}
  .featured-card{display:block;border-radius:0;overflow:hidden;position:relative;transition:transform .2s ease;border:4px solid var(--pop-yellow,#FFD700);box-shadow:12px 12px 0 rgba(0,0,0,.3)}
  .featured-card:hover{transform:translate(-4px,-4px);box-shadow:16px 16px 0 rgba(0,0,0,.35)}
  .featured-img{position:relative;width:100%;aspect-ratio:21/9;min-height:380px;overflow:hidden}
  .featured-img img{width:100%;height:100%;object-fit:cover;display:block}
  .featured-overlay{position:absolute;bottom:0;left:0;right:0;padding:50px 36px 30px;background:linear-gradient(transparent 0%,rgba(0,0,0,.85) 50%);color:#fff}
  .featured-tag{display:inline-block;padding:6px 18px;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:2px;background:var(--tirol-pink);color:#fff;margin-bottom:10px;border:2px solid #fff;box-shadow:4px 4px 0 rgba(0,0,0,.3)}
  .featured-title{font-family:var(--font-display);font-size:42px;line-height:1;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;color:#fff;text-shadow:4px 4px 0 var(--pop-yellow,#FFD700),8px 8px 0 rgba(0,0,0,.3)}
  .featured-teaser{font-size:16px;color:rgba(255,255,255,.8);line-height:1.6;max-width:600px;margin-bottom:12px;font-weight:500}
  .featured-link{font-size:13px;font-weight:900;text-transform:uppercase;letter-spacing:2px;color:var(--pop-yellow,#FFD700);display:inline-flex;align-items:center;gap:6px;padding:8px 20px;border:2px solid var(--pop-yellow,#FFD700);background:rgba(0,0,0,.4);transition:all .2s}
  .featured-link:hover{gap:12px;background:var(--tirol-pink);border-color:#fff;color:#fff}
  .tile-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;grid-auto-flow:dense}
  .tile{display:block;position:relative;overflow:hidden;border:3px solid #000;transition:all .15s ease;cursor:pointer;min-height:220px}
  .tile:hover{transform:translate(-3px,-3px);box-shadow:6px 6px 0 rgba(0,0,0,.35)}
  .tile-w2{grid-column:span 2}
  .tile-h2{grid-row:span 2;min-height:452px}
  .tile-wh2{grid-column:span 2;grid-row:span 2;min-height:452px}
  .tile-color-0{background:var(--tirol-pink);border-color:#C0006E}
  .tile-color-1{background:#0055FF;border-color:#00E5FF}
  .tile-color-2{background:#FF6B00;border-color:#FFD700}
  .tile-color-3{background:#BF00FF;border-color:#FF00AA}
  .tile-color-4{background:#39FF14;border-color:#FFD700}
  .tile-color-5{background:#FF0040;border-color:#FF6B00}
  .tile-color-6{background:#00E5FF;border-color:#0055FF}
  .tile-color-7{background:#000;border-color:#FFD700}
  .tile-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .3s ease;mix-blend-mode:overlay;opacity:.85}
  .tile:hover .tile-img{transform:scale(1.08)}
  .tile-overlay{position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,20,147,.15),rgba(0,229,255,.15));mix-blend-mode:overlay;pointer-events:none}
  .tile::before{content:'';position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.08) 1px,transparent 1px);background-size:6px 6px;pointer-events:none;z-index:1}
  .tile-content{position:absolute;bottom:0;left:0;right:0;padding:30px 20px 18px;background:linear-gradient(transparent 0%,rgba(0,0,0,.75) 50%);z-index:2}
  .tile-tag{display:inline-block;padding:3px 10px;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:1.5px;background:#000;color:#fff;margin-bottom:6px;border:1px solid rgba(255,255,255,.3)}
  .tile-title{font-family:var(--font-display);font-size:18px;line-height:1.1;text-transform:uppercase;letter-spacing:.5px;color:#fff;margin-bottom:4px;text-shadow:2px 2px 0 rgba(0,0,0,.5)}
  .tile-w2 .tile-title,.tile-wh2 .tile-title{font-size:26px}
  .tile-date{font-size:10px;color:rgba(255,255,255,.6);text-transform:uppercase;letter-spacing:1px;font-weight:700}
  .pop-header{margin-bottom:24px;position:relative}
  .pop-header-label{display:inline-block;font-size:11px;font-weight:900;letter-spacing:3px;text-transform:uppercase;padding:6px 16px;background:#000;color:#FFD700;border:2px solid #FFD700;margin-bottom:8px}
  .pop-header-title{font-family:var(--font-display);font-size:36px;text-transform:uppercase;letter-spacing:2px;line-height:1;color:var(--tirol-pink);text-shadow:4px 4px 0 #FFD700;margin-bottom:6px}
  .pop-header-sub{font-size:15px;color:var(--text2);font-weight:500}
  @media(max-width:1024px){.tile-grid{grid-template-columns:repeat(3,1fr)}.featured-title{font-size:34px}}
  @media(max-width:768px){.tile-grid{grid-template-columns:repeat(2,1fr);gap:8px}.tile-w2{grid-column:span 2}.tile-wh2{grid-column:span 2;grid-row:span 1;min-height:220px}.tile{min-height:180px}.featured-img{aspect-ratio:16/9;min-height:260px}.featured-title{font-size:26px}.featured-title{text-shadow:2px 2px 0 #FFD700,4px 4px 0 rgba(0,0,0,.3)}.featured-overlay{padding:30px 20px 20px}.pop-header-title{font-size:28px}}
  @media(max-width:480px){.tile-grid{grid-template-columns:1fr}.tile-w2{grid-column:span 1}.tile-wh2{grid-column:span 1}.tile{min-height:160px}.featured-img{aspect-ratio:4/3;min-height:200px}.featured-title{font-size:22px}.featured-teaser{display:none}.pop-header-title{font-size:22px}}
</style>
