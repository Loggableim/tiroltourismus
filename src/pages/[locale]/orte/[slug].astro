export async function getStaticPaths() {
  const locales = LANGUAGES_READY.filter((l) => l !== 'de');
  const paths = [];
  for (const locale of locales) {
    const all = readCollection('orte', locale).filter(o => isPublished(o.entry));
    for (const o of all) {
      paths.push({ params: { locale, slug: o.slug } });
    }
  }
  return paths;
}

const { locale, slug } = Astro.params;
const entry = readEntry('orte', slug, locale);
if (!entry) return Astro.redirect(`${localePrefix(locale)}/orte/`);

// Qualitätslogik: dünne Ortsseiten nicht indexieren
const shouldIdx = shouldIndex(entry, 'orte');

const l = LABELS[locale] || LABELS.de;
const pref = localePrefix(locale);

const { name, kurzbeschreibung, emoji, farbe, hoehe, einwohner, tags } = entry;

// Verknüpfte Unterkünfte, Gastro und Sehenswürdigkeiten in diesem Ort
const unterkuenfteImOrt = readCollection('unterkuenfte', locale)
  .filter(u => isPublished(u.entry) && u.entry.ort && u.entry.ort.toLowerCase() === name.toLowerCase())
  .slice(0, 6);
const gastroImOrt = readCollection('gastro', locale)
  .filter(g => isPublished(g.entry) && g.entry.ort && g.entry.ort.toLowerCase() === name.toLowerCase())
  .slice(0, 6);
const sehenswuerdigkeitenImOrt = readCollection('sehenswuerdigkeiten', locale)
  .filter(s => isPublished(s.entry) && s.entry.ort && s.entry.ort.toLowerCase() === name.toLowerCase())
  .slice(0, 6);

const nearbyEntries = entry.koordinaten ? findNearby(entry, 'orte', locale, 8) : [];
const CATEGORY_EMOJI = { sehenswuerdigkeiten: '🏛️', gastro: '🍽️', unterkuenfte: '🏨', camping: '🏕️', erlebnisse: '🎯', orte: '🏘️', events: '🎪', regionen: '🏔️' };
const mapMarkers = [];
if (entry.koordinaten) {
  mapMarkers.push({ lat: entry.koordinaten.lat, lng: entry.koordinaten.lng, label: name, emoji: emoji || '🏘️' });
}
nearbyEntries.forEach(n => {
  if (!n.entry.koordinaten) return;
  mapMarkers.push({
    lat: n.entry.koordinaten.lat,
    lng: n.entry.koordinaten.lng,
    label: n.entry.name || n.entry.titel,
    emoji: CATEGORY_EMOJI[n.collection] || '📍',
    href: `${pref}/${n.collection}/${n.slug}/`,
    category: n.collection,
  });
});
const mapSection = mapMarkers.length > 0 ? {
  type: 'map', label: l.standort, title: l.aufDerKarte,
  markers: mapMarkers, scrollWheelZoom: true,
  filterable: true,
} : null;

// Verwandte Orte via ersten Tag
const relatedByTag = tags && tags.length > 0
  ? findByTag(tags[0], locale)
      .filter(r => r.collection === 'orte' && r.slug !== slug)
      .slice(0, 3)
      .map(r => ({
        ...r,
        entry: { ...r.entry, _emoji: r.entry.emoji || '🏘️' }
      }))
  : [];

// JSON-LD: TouristDestination
const siteURL = 'https://www.tirol-tourismus.at';
const destinationLD = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: name,
  description: (kurzbeschreibung || '').substring(0, 300),
  url: `${siteURL}${pref}/orte/${slug}/`,
  ...(entry.koordinaten ? {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: entry.koordinaten.lat,
      longitude: entry.koordinaten.lng,
    },
  } : {}),
  ...(entry.region ? {
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: entry.region,
    },
  } : {}),
};
---

<DetailPage
  title={name}
  description={generateMetaDescription(entry, 'orte', locale)}
  breadcrumbs={[{ label: l.orte, href: `${pref}/orte/` }, { label: name }]}
  locale={locale}
  jsonld={destinationLD}
  noindex={!shouldIdx}
  sections={[
    {
      type: 'hero',
      title: name,
      subtitle: kurzbeschreibung,
      emoji: emoji || '🏘️',
      gradient: farbe,
      size: 'sm',
      bgImage: undefined,
    },
    {
      type: 'facts-bar',
      accentColor: farbe,
      items: [
        hoehe ? { value: hoehe, label: l.hoehe } : null,
        einwohner ? { value: einwohner, label: l.einwohner } : null,
      ].filter(Boolean),
    },
    tags && tags.length > 0 ? { type: 'tags', tags } : null,
    mapSection,
    unterkuenfteImOrt.length > 0 ? {
      type: 'related-grid',
      label: l.uebernachten,
      title: `${l.unterkuenfteIn} ${name}`,
      description: `${unterkuenfteImOrt.length} ${unterkuenfteImOrt.length !== 1 ? l.unterkuenfte : l.unterkunft} gefunden`,
      entries: unterkuenfteImOrt,
      slugPrefix: `${pref}/unterkuenfte/`,
      nameField: 'name',
      subtitleField: 'ort',
      priceField: 'preis_ab',
      emptyText: l.keineUnterkuenfte,
      ctaHref: `${pref}/unterkuenfte/?ort=${encodeURIComponent(name)}`,
      ctaText: l.alleUnterkuenfte,
      accentBg: true,
    } : null,
    gastroImOrt.length > 0 ? {
      type: 'related-grid',
      label: l.gastronomie,
      title: `${l.gastroIn} ${name}`,
      description: `${gastroImOrt.length} ${gastroImOrt.length !== 1 ? l.lokale : l.lokal} gefunden`,
      entries: gastroImOrt,
      slugPrefix: `${pref}/gastro/`,
      nameField: 'name',
      subtitleField: 'ort',
      emojiField: 'emoji',
      emptyText: l.keineGastro,
      ctaHref: `${pref}/gastro/?ort=${encodeURIComponent(name)}`,
      ctaText: l.alleGastro,
    } : null,
    sehenswuerdigkeitenImOrt.length > 0 ? {
      type: 'related-grid',
      label: l.sehenswuerdigkeiten,
      title: `${l.sehenswuerdigkeitenIn} ${name}`,
      description: `${sehenswuerdigkeitenImOrt.length} ${sehenswuerdigkeitenImOrt.length !== 1 ? l.sehenswuerdigkeiten : l.sehenswuerdigkeiten} gefunden`,
      entries: sehenswuerdigkeitenImOrt,
      slugPrefix: `${pref}/sehenswuerdigkeiten/`,
      nameField: 'name',
      subtitleField: 'kurzbeschreibung',
      emojiField: 'emoji',
      defaultEmoji: '🏛️',
      emptyText: l.keineSehenswuerdigkeiten,
      ctaHref: `${pref}/sehenswuerdigkeiten/?ort=${encodeURIComponent(name)}`,
      ctaText: l.alleSehenswuerdigkeiten,
    } : null,
    relatedByTag.length > 0 ? {
      type: 'related-grid',
      label: l.weitereOrte,
      entries: relatedByTag,
      slugPrefix: `${pref}/orte/`,
      nameField: 'name',
      subtitleField: 'kurzbeschreibung',
      emojiField: '_emoji',
      defaultEmoji: '🏘️',
    } : null,
  ].filter(Boolean)}
/>
