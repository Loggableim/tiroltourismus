export async function getStaticPaths() {
  return LANGUAGES_READY.filter((locale) => locale !== 'de').map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = LABELS[locale] || LABELS.de;
const pref = localePrefix(locale);

const orte = readCollection('orte', locale)
  .filter((o) => isPublished(o.entry));

const regionen = readCollection('regionen', locale)
  .filter((r) => isPublished(r.entry))
  .sort(
    (a, b) =>
      (b.entry.bewertung || 0) - (a.entry.bewertung || 0) ||
      (a.entry.titel || '').localeCompare(b.entry.titel || '', locale === 'de' ? 'de' : locale)
  );

const regionFilterOptions = regionen
  .map((r) => ({ slug: r.slug, label: r.entry.titel }))
  .sort((a, b) => (a.label || '').localeCompare(b.label || '', locale === 'de' ? 'de' : locale));

const orteMitKarte = orte.filter((o) => o.entry.koordinaten?.lat && o.entry.koordinaten?.lng);
const orteMarkers = orteMitKarte.map((o) => ({
  lat: o.entry.koordinaten.lat,
  lng: o.entry.koordinaten.lng,
  label: o.entry.name,
  href: `${pref}/orte/${o.slug}/`,
  emoji: o.entry.emoji || '🏘️',
}));

// JSON-LD: ItemList
const siteURL = 'https://www.tirol-tourismus.at';
const orteItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.title,
  description: t.desc,
  url: `${siteURL}${pref}/orte/`,
  numberOfItems: orte.length,
  itemListElement: orte.slice(0, 30).map((o, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: o.entry.name,
    url: `${siteURL}${pref}/orte/${o.slug}/`,
  })),
};
---

<BaseLayout
  title={t.title}
  description={t.desc}
  locale={locale}
  jsonld={orteItemList}
>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: t.orteLabel }]} />
    </div>

    <Hero
      title={t.title}
      subtitle={t.heroSub}
      emoji="🏘️"
      size="md"
    >
      <div slot="actions" class="hero-actions">
        <a href={`${pref}/orte/#orte-grid`} class="btn btn-pink">{t.ctaText}</a>
        <span class="hero-urgency">📍 {orte.length} {t.orteLabel}</span>
      </div>
    </Hero>

    <SectionMap
      markers={orteMarkers}
      label={`${orteMarkers.length} ${t.mapLabel}`}
      title={t.mapTitle}
      height="380px"
      scrollWheelZoom={true}
      filterable={true}
    />

    {orte.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHeader
            label={t.sectionLabel}
            title={t.sectionTitle}
            sub={t.sectionSub}
          />

          {regionen.length > 1 && (
            <FilterBar
              keyName="cat"
              ariaLabel={t.ariaFilter}
              allLabel={t.allLabel}
              options={regionFilterOptions.map((r) => ({ value: r.slug, label: r.label }))}
            />
          )}

          <div class="orte-grid" id="orte-grid">
            {orte.map((o) => (
              <a
                href={`${pref}/orte/${o.slug}/`}
                class="ort-card"
                data-collection="orte"
                data-slug={o.slug}
                data-filter-card
                data-filter-cat={o.entry.region || ''}
              >
                <div class="ort-card-img" style={`--accent:${o.entry.farbe || 'var(--pink)'};background:linear-gradient(180deg, ${o.entry.farbe || 'var(--pink)'}18, rgba(255,255,255,.03))`}>
                  <span class="ort-emoji">{o.entry.emoji || '🏘️'}</span>
                  <FavHeart collection="orte" slug={o.slug} />
                </div>
                <div class="ort-card-body">
                  <h3>{o.entry.name}</h3>
                  {o.entry.kurzbeschreibung && <p>{o.entry.kurzbeschreibung}</p>}
                  <span class="ort-link">{t.entdecken}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">🏘️</div>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase">
            {t.emptyTitle}
          </h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">
            {t.emptyText}
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  .orte-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 0 0 80px;
  }
  @media (max-width: 968px) {
    .orte-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .orte-grid { grid-template-columns: 1fr; }
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  .hero-urgency {
    font-size: 13px;
    font-weight: 600;
    color: var(--text2);
    letter-spacing: 0.5px;
  }
</style>
