---
import DetailPage from '../../../sections/DetailPage.astro';
import { readEntry, readCollection, isPublished } from '../../../lib/content.js';

export async function getStaticPaths() {
  const locales = ['de', 'en'];
  const paths = [];
  for (const locale of locales) {
    const all = readCollection('regionen', locale).filter(r => isPublished(r.entry));
    for (const r of all) {
      paths.push({ params: { locale, slug: r.slug } });
    }
  }
  return paths;
}

const { locale, slug } = Astro.params;
const entry = readEntry('regionen', slug, locale);
if (!entry) return Astro.redirect(`/${locale === 'de' ? '' : 'en/'}regionen/`);

const { titel, emoji, farbe, kurzbeschreibung, bewertung, beschreibung, hoehe, flaeche, einwohner, tags } = entry;

const unterkuenfte = readCollection('unterkuenfte', locale).filter(u => isPublished(u.entry) && u.entry.region === slug);
const orte = readCollection('orte', locale).filter(o => isPublished(o.entry) && o.entry.region === slug);
const gastro = readCollection('gastro', locale).filter(g => isPublished(g.entry) && g.entry.region === slug);

const localePrefix = locale === 'en' ? '/en' : '';

const t = locale === 'en' ? {
  breadcrumb: 'Regions',
  bewertung: 'Rating',
  hoehe: 'Altitude',
  flaeche: 'Area',
  einwohner: 'Population',
  entdecken: `${titel} Highlights`,
  highlights: 'Highlights',
  uebernachten: 'Stay',
  unterkuenfte_title: `Accommodations in ${titel}`,
  orte_title: `Places in ${titel}`,
  gastro_title: `Restaurants in ${titel}`,
  unterkuenfte_empty: 'No accommodations listed in this region yet.',
  orte_empty: 'No places listed in this region yet.',
  gastro_empty: 'No restaurants listed in this region yet.',
  unterkuenfte_cta: 'Show all accommodations',
  orte_cta: 'Show all places',
  gastro_cta: 'Show all restaurants',
} : {
  breadcrumb: 'Regionen',
  bewertung: 'Bewertung',
  hoehe: 'Höhe',
  flaeche: 'Fläche',
  einwohner: 'Einwohner',
  entdecken: `${titel} entdecken`,
  highlights: 'Highlights',
  uebernachten: 'Übernachten',
  unterkuenfte_title: `Unterkünfte im ${titel}`,
  orte_title: `Orte im ${titel}`,
  gastro_title: `Gastro im ${titel}`,
  unterkuenfte_empty: 'Noch keine Unterkünfte in dieser Region gelistet.',
  orte_empty: 'Noch keine Orte in dieser Region gelistet.',
  gastro_empty: 'Noch keine Gastro in dieser Region gelistet.',
  unterkuenfte_cta: 'Alle Unterkünfte anzeigen',
  orte_cta: 'Alle Orte anzeigen',
  gastro_cta: 'Alle Gastro anzeigen',
};

const unterkuenfteCount = unterkuenfte.length;
const orteCount = orte.length;
const gastroCount = gastro.length;
---

<DetailPage
  title={titel}
  description={kurzbeschreibung}
  locale={locale}
  breadcrumbs={[{ label: t.breadcrumb, href: `${localePrefix}/regionen/` }, { label: titel }]}
  sections={[
    {
      type: 'hero',
      title: titel,
      subtitle: kurzbeschreibung,
      emoji: emoji,
      gradient: farbe,
      size: 'sm',
    },
    {
      type: 'facts-bar',
      accentColor: farbe,
      items: [
        bewertung ? { value: bewertung, suffix: '/5', label: t.bewertung } : null,
        hoehe ? { value: hoehe, label: t.hoehe } : null,
        flaeche ? { value: flaeche, label: t.flaeche } : null,
        einwohner ? { value: einwohner, label: t.einwohner } : null,
      ].filter(Boolean),
    },
    beschreibung ? {
      type: 'description',
      label: t.entdecken,
      title: t.highlights,
      content: beschreibung,
    } : null,
    tags && tags.length > 0 ? { type: 'tags', tags: tags } : null,
    {
      type: 'related-grid',
      label: t.uebernachten,
      title: t.unterkuenfte_title,
      description: unterkuenfteCount > 0 ? `${unterkuenfteCount} ${locale === 'en' ? (unterkuenfteCount === 1 ? 'accommodation found' : 'accommodations found') : (unterkuenfteCount === 1 ? 'Unterkunft gefunden' : 'Unterkünfte gefunden')}` : undefined,
      entries: unterkuenfte.slice(0, 6),
      slugPrefix: `${localePrefix}/unterkuenfte/`,
      nameField: 'name',
      subtitleField: 'ort',
      priceField: 'preis_ab',
      emptyText: t.unterkuenfte_empty,
      ctaHref: `${localePrefix}/unterkuenfte/?region=${slug}`,
      ctaText: t.unterkuenfte_cta,
      accentBg: true,
    },
    {
      type: 'related-grid',
      label: locale === 'en' ? 'Places' : 'Orte',
      title: t.orte_title,
      description: orteCount > 0 ? `${orteCount} ${locale === 'en' ? (orteCount === 1 ? 'place found' : 'places found') : (orteCount === 1 ? 'Ort gefunden' : 'Orte gefunden')}` : undefined,
      entries: orte.slice(0, 6),
      slugPrefix: `${localePrefix}/orte/`,
      nameField: 'name',
      subtitleField: 'kurzbeschreibung',
      emojiField: 'emoji',
      emptyText: t.orte_empty,
      ctaHref: `${localePrefix}/orte/?region=${slug}`,
      ctaText: t.orte_cta,
    },
    {
      type: 'related-grid',
      label: locale === 'en' ? 'Gastronomy' : 'Gastronomie',
      title: t.gastro_title,
      description: gastroCount > 0 ? `${gastroCount} ${locale === 'en' ? (gastroCount === 1 ? 'restaurant found' : 'restaurants found') : (gastroCount === 1 ? 'Lokal gefunden' : 'Lokale gefunden')}` : undefined,
      entries: gastro.slice(0, 6),
      slugPrefix: `${localePrefix}/gastro/`,
      nameField: 'name',
      subtitleField: 'ort',
      emojiField: 'emoji',
      emptyText: t.gastro_empty,
      ctaHref: `${localePrefix}/gastro/?region=${slug}`,
      ctaText: t.gastro_cta,
      accentBg: true,
    },
  ].filter(Boolean)}
/>
