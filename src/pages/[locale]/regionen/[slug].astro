export async function getStaticPaths() {
  const locales = LANGUAGES_READY.filter((l) => l !== 'de');
  const paths = [];
  for (const locale of locales) {
    const all = readCollection('regionen', locale).filter((r) => isPublished(r.entry));
    for (const r of all) {
      paths.push({ params: { locale, slug: r.slug } });
    }
  }
  return paths;
}

const { locale, slug } = Astro.params;
const t = LABELS[locale] || LABELS.de;
const pref = localePrefix(locale);

const entry = readEntry('regionen', slug, locale);
if (!entry) return Astro.redirect(`${pref}/regionen/`);

const { titel, emoji, farbe, kurzbeschreibung, bewertung, beschreibung, hoehe, flaeche, einwohner, tags } = entry;

const unterkuenfte = readCollection('unterkuenfte', locale).filter((u) => isPublished(u.entry) && u.entry.region === slug);
const orte = readCollection('orte', locale).filter((o) => isPublished(o.entry) && o.entry.region === slug);
const gastro = readCollection('gastro', locale).filter((g) => isPublished(g.entry) && g.entry.region === slug);
const sehenswuerdigkeiten = readCollection('sehenswuerdigkeiten', locale).filter((s) => isPublished(s.entry) && s.entry.region === slug);

// Verwandte Regionen via ersten Tag
const relatedByTag = tags && tags.length > 0
  ? findByTag(tags[0], locale)
      .filter((r) => r.collection === 'regionen' && r.slug !== slug)
      .slice(0, 3)
      .map((r) => ({
        ...r,
        entry: { ...r.entry, _emoji: r.entry.emoji || '🏔️' },
      }))
  : [];

// JSON-LD: TouristDestination
const siteURL = 'https://tiroltourismus.com';
const regionDesc = (kurzbeschreibung || '').substring(0, 500);
const regionLD = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: titel,
  description: regionDesc,
  url: `${siteURL}${pref}/regionen/${slug}/`,
  ...(entry.koordinaten ? {
    geo: { '@type': 'GeoCoordinates', latitude: parseFloat(entry.koordinaten.lat), longitude: parseFloat(entry.koordinaten.lng) }
  } : {}),
  containedInPlace: {
    '@type': 'AdministrativeArea',
    name: 'Tirol',
    address: { '@type': 'PostalAddress', addressRegion: 'Tirol', addressCountry: 'AT' },
  },
};
---

<DetailPage
  title={titel}
  description={generateMetaDescription(entry, 'regionen', locale)}
  jsonld={regionLD}
  breadcrumbs={[{ label: t.regionen, href: `${pref}/regionen/` }, { label: titel }]}
  sections={[
    {
      type: 'hero',
      title: titel,
      subtitle: kurzbeschreibung,
      emoji: emoji,
      gradient: farbe,
      size: 'sm',
      bgImage: entry.hero_bild,
    },
    {
      type: 'facts-bar',
      accentColor: farbe,
      items: [
        bewertung ? { value: bewertung, suffix: '/5', label: t.bewertung } : null,
        hoehe ? { value: hoehe, label: t.hoehe } : null,
        flaeche ? { value: flaeche, label: t.flaeche } : null,
        einwohner ? { value: einwohner, label: t.einwohner } : null,
      ].filter(Boolean),
    },
    beschreibung
      ? {
          type: 'description',
          label: `${titel} ${t.entdecken}`,
          title: t.highlights,
          content: autoLinkContent(beschreibung, entry, locale),
        }
      : null,
    tags && tags.length > 0 ? { type: 'tags', tags: tags } : null,
    {
      type: 'related-grid',
      label: t.uebernachten,
      title: `${t.unterkuenfte_im} ${titel}`,
      description:
        unterkuenfte.length > 0
          ? `${unterkuenfte.length} ${unterkuenfte.length !== 1 ? t.unterkuenfte : t.unterkunft} gefunden`
          : undefined,
      entries: unterkuenfte.slice(0, 6),
      slugPrefix: `${pref}/unterkuenfte/`,
      nameField: 'name',
      subtitleField: 'ort',
      priceField: 'preis_ab',
      emptyText: t.keine_unterkuenfte,
      ctaHref: `${pref}/unterkuenfte/?region=${slug}`,
      ctaText: t.alle_unterkuenfte,
      accentBg: true,
    },
    {
      type: 'related-grid',
      label: t.orte,
      title: `${t.orte_im} ${titel}`,
      description:
        orte.length > 0
          ? `${orte.length} ${orte.length !== 1 ? t.orte : t.ort} gefunden`
          : undefined,
      entries: orte.slice(0, 6),
      slugPrefix: `${pref}/orte/`,
      nameField: 'name',
      subtitleField: 'kurzbeschreibung',
      emojiField: 'emoji',
      emptyText: t.keine_orte,
      ctaHref: `${pref}/orte/?region=${slug}`,
      ctaText: t.alle_orte,
    },
    {
      type: 'related-grid',
      label: t.gastronomie,
      title: `${t.gastro_im} ${titel}`,
      description:
        gastro.length > 0
          ? `${gastro.length} ${gastro.length !== 1 ? t.lokale : t.lokal} gefunden`
          : undefined,
      entries: gastro.slice(0, 6),
      slugPrefix: `${pref}/gastro/`,
      nameField: 'name',
      subtitleField: 'ort',
      emojiField: 'emoji',
      emptyText: t.keine_gastro,
      ctaHref: `${pref}/gastro/?region=${slug}`,
      ctaText: t.alle_gastro,
      accentBg: true,
    },
    sehenswuerdigkeiten.length > 0
      ? {
          type: 'related-grid',
          label: t.sehenswuerdigkeiten,
          title: `${t.sehenswuerdigkeiten_im} ${titel}`,
          description:
            sehenswuerdigkeiten.length > 0
              ? `${sehenswuerdigkeiten.length} ${sehenswuerdigkeiten.length !== 1 ? t.sehenswuerdigkeiten : t.sehenswuerdigkeiten} gefunden`
              : undefined,
          entries: sehenswuerdigkeiten.slice(0, 6),
          slugPrefix: `${pref}/sehenswuerdigkeiten/`,
          nameField: 'name',
          subtitleField: 'ort',
          emojiField: 'emoji',
          defaultEmoji: '🏛️',
          emptyText: t.keine_sehenswuerdigkeiten,
          ctaHref: `${pref}/sehenswuerdigkeiten/?region=${slug}`,
          ctaText: t.alle_sehenswuerdigkeiten,
          accentBg: true,
        }
      : null,
    relatedByTag.length > 0
      ? {
          type: 'related-grid',
          label: t.weitere_regionen,
          entries: relatedByTag,
          slugPrefix: `${pref}/regionen/`,
          nameField: 'titel',
          subtitleField: 'kurzbeschreibung',
          emojiField: '_emoji',
          defaultEmoji: '🏔️',
        }
      : null,
  ].filter(Boolean)}
/>
