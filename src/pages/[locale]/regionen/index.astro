export async function getStaticPaths() {
  return LANGUAGES_READY.filter((locale) => locale !== 'de').map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = LABELS[locale] || LABELS.de;
const pref = localePrefix(locale);

const regionen = readCollection('regionen', locale)
  .filter((r) => isPublished(r.entry))
  .sort(
    (a, b) =>
      (b.entry.bewertung || 0) - (a.entry.bewertung || 0) ||
      (a.entry.titel || '').localeCompare(b.entry.titel || '', locale === 'de' ? 'de' : locale)
  );

const bezirkeData = readSingleton('bezirke', locale);
const bezirke = bezirkeData ? Object.values(bezirkeData) : [];
const regionsData = readSingleton('regions', locale);

// JSON-LD: ItemList
const siteURL = 'https://www.tirol-tourismus.at';
const regionItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.title,
  description: t.desc,
  url: `${siteURL}${pref}/regionen/`,
  numberOfItems: regionen.length,
  itemListElement: regionen.slice(0, 30).map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r.entry.titel,
    url: `${siteURL}${pref}/regionen/${r.slug}/`,
  })),
};

function stars(bewertung) {
  return Array.from({ length: 5 }, (_, i) => i < (bewertung || 0));
}
---

<BaseLayout
  title={t.title}
  description={t.desc}
  locale={locale}
  jsonld={regionItemList}
>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: t.regionen, href: `${pref}/regionen/` }, { label: t.regionen }]} />
    </div>

    <Hero
      title={t.title}
      subtitle={t.heroSub}
      emoji="🏔️"
      size="md"
    >
      <div slot="actions" class="hero-actions">
        <a href={`${pref}/regionen/#region-grid`} class="btn btn-pink">{t.ctaText}</a>
        <span class="hero-urgency">🏔️ {regionen.length} {t.regionen}</span>
      </div>
    </Hero>

    {regionen.length > 0 ? (
      <>
        <section class="section">
          <div class="container">
            <SectionHeader
              label={t.sectionLabel}
              title={t.sectionTitle}
              sub={t.sectionSub}
            />

            {regionen.length > 1 && (
              <FilterBar
                keyName="cat"
                ariaLabel={t.ariaFilter}
                allLabel={t.allLabel}
                options={[
                  { value: 'featured', label: t.filterFeatured },
                  { value: 'other', label: t.filterOther },
                ]}
              />
            )}

            <div class="region-grid" id="region-grid">
              {regionen.map((r) => {
                const filled = stars(r.entry.bewertung);
                const farbe = r.entry.farbe || 'var(--pink)';
                return (
                  <a
                    href={`${pref}/regionen/${r.slug}/`}
                    class="region-card"
                    data-collection="regionen"
                    data-slug={r.slug}
                    data-filter-card
                    data-filter-cat={r.entry.featured ? 'featured' : 'other'}
                  >
                    <div
                      class="region-card-img"
                      style={`position:relative;background:linear-gradient(135deg,${farbe}15,${farbe}25)`}
                    >
                      {r.slug ? (
                        <img
                          src={`/wappen/regionen/${r.slug}.svg`}
                          alt={`${r.entry.titel} Wappen`}
                          class="region-badge-img"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <>
                          <div class="region-blob" style={`background:${farbe}`}></div>
                          <span class="region-emoji">{r.entry.emoji || '🏔️'}</span>
                        </>
                      )}
                      <FavHeart collection="regionen" slug={r.slug} />
                    </div>
                    <div class="region-card-body">
                      <h3>{r.entry.titel}</h3>
                      {r.entry.kurzbeschreibung && <p>{r.entry.kurzbeschreibung}</p>}
                      {r.entry.featured && <span class="featured-badge">{t.featuredBadge}</span>}
                      <div class="region-stars">
                        {filled.map((f) => (
                          <span class={`star${f ? '' : ' empty'}`}>★</span>
                        ))}
                      </div>
                      <span class="region-link">{t.entdecken}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </section>

        <section class="facts-section">
          <div class="container">
            <div class="facts-grid">
              <div class="fact-item">
                <div class="fact-number">{regionen.length}</div>
                <div class="fact-label">{t.factsRegionen}</div>
              </div>
              <div class="fact-item">
                <div class="fact-number">∞</div>
                <div class="fact-label">{t.factsErlebnisse}</div>
              </div>
              <div class="fact-item">
                <div class="fact-number">100+</div>
                <div class="fact-label">{t.factsUnterkuenfte}</div>
              </div>
            </div>
          </div>
        </section>
      </>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">🏔️</div>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase">
            {t.emptyTitle}
          </h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">
            {t.emptyText}
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  .region-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 0 0 80px;
  }
  @media (max-width: 968px) {
    .region-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .region-grid { grid-template-columns: 1fr; }
  }

  .facts-section {
    background: var(--bg2);
    padding: 60px 0;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    text-align: center;
  }
  .fact-number {
    font-family: var(--font-display);
    font-size: clamp(48px, 6vw, 80px);
    line-height: 1;
    color: var(--pink);
    letter-spacing: 2px;
  }
  .fact-label {
    font-size: 14px;
    color: var(--text2);
    margin-top: 6px;
    font-weight: 500;
  }
  @media (max-width: 600px) {
    .facts-grid { grid-template-columns: 1fr; gap: 30px; }
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  .hero-urgency {
    font-size: 13px;
    font-weight: 600;
    color: var(--text2);
    letter-spacing: 0.5px;
  }
</style>
