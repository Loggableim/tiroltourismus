---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import RegionCard from '../../../components/RegionCard.astro';
import { readCollection, isPublished } from '../../../lib/content.js';
import { LANGUAGES_READY } from '../../../lib/languages.js';

export async function getStaticPaths() {
  return LANGUAGES_READY.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const regionen = readCollection('regionen', locale).filter(r => isPublished(r.entry)).sort((a,b) => (b.entry.bewertung||0)-(a.entry.bewertung||0));

const t = locale === 'de' ? {
  title: 'Regionen',
  desc: 'Sechs Gesichter, ein Land. Jede Region in Tirol hat ihren eigenen Sound – von Gletscherflüstern bis Stadtbeat. Finde deine.',
  hero_sub: 'Sechs Gesichter, ein Land.',
  section_label: 'Tirol entdecken',
  section_title: 'Wo willst du hin?',
  section_sub: 'Ob hochalpine Gipfel, glitzernde Gletscher oder urbane Bergluft – Tirols Regionen sind so vielfältig wie das Leben selbst.',
  actions: 'Regionen entdecken →',
  count_prefix: '🏔️',
  count_suffix: 'Regionen',
  fact_regions: 'Regionen',
  fact_experiences: 'Erlebnisse',
  fact_unterkuenfte: 'Unterkünfte',
  soon_title: 'Bald verfügbar',
  soon_text: 'Regionen werden aktuell eingepflegt. Schau bald wieder vorbei!',
  breadcrumb: 'Regionen',
} : {
  title: 'Regions',
  desc: 'Six faces, one land. Every region in Tyrol has its own sound — from glacier whispers to city beats. Find yours.',
  hero_sub: 'Six faces, one land.',
  section_label: 'Discover Tyrol',
  section_title: 'Where do you want to go?',
  section_sub: 'Whether high-alpine peaks, glittering glaciers, or urban mountain air — Tyrol\'s regions are as diverse as life itself.',
  actions: 'Discover Regions →',
  count_prefix: '🏔️',
  count_suffix: 'Regions',
  fact_regions: 'Regions',
  fact_experiences: 'Experiences',
  fact_unterkuenfte: 'Accommodations',
  soon_title: 'Coming Soon',
  soon_text: 'Regions are currently being added. Check back soon!',
  breadcrumb: 'Regions',
};
---

<BaseLayout
  title={t.title}
  description={t.desc}
  locale={locale}
>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: t.breadcrumb }]} />
    </div>

    <Hero
      title={t.title}
      subtitle={t.hero_sub}
      emoji="🏔️"
      size="md"
    >
      <div slot="actions" class="hero-actions">
        <a href="#region-grid" class="btn btn-pink">{t.actions}</a>
        <span class="hero-urgency">{t.count_prefix} {regionen.length} {t.count_suffix}</span>
      </div>
    </Hero>

    {regionen.length > 0 ? (
      <>
        <section class="section">
          <div class="container">
            <SectionHeader
              label={t.section_label}
              title={t.section_title}
              sub={t.section_sub}
            />

            <div class="region-grid" id="region-grid">
              {regionen.map((r) => (
                <RegionCard
                  titel={r.entry.titel}
                  slug={r.slug}
                  beschreibung={r.entry.kurzbeschreibung}
                  emoji={r.entry.emoji}
                  bewertung={r.entry.bewertung}
                  farbe={r.entry.farbe}
                  featured={r.entry.featured}
                />
              ))}
            </div>
          </div>
        </section>

        <section class="facts-section">
          <div class="container">
            <div class="facts-grid">
              <div class="fact-item">
                <div class="fact-number">{regionen.length}</div>
                <div class="fact-label">{t.fact_regions}</div>
              </div>
              <div class="fact-item">
                <div class="fact-number">∞</div>
                <div class="fact-label">{t.fact_experiences}</div>
              </div>
              <div class="fact-item">
                <div class="fact-number">100+</div>
                <div class="fact-label">{t.fact_unterkuenfte}</div>
              </div>
            </div>
          </div>
        </section>
      </>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">🏔️</div>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase">
            {t.soon_title}
          </h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">
            {t.soon_text}
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  .region-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 0 0 80px;
  }
  @media (max-width: 968px) {
    .region-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .region-grid { grid-template-columns: 1fr; }
  }

  .facts-section {
    background: var(--bg2);
    padding: 60px 0;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    text-align: center;
  }
  .fact-number {
    font-family: var(--font-display);
    font-size: clamp(48px, 6vw, 80px);
    line-height: 1;
    color: var(--pink);
    letter-spacing: 2px;
  }
  .fact-label {
    font-size: 14px;
    color: var(--text2);
    margin-top: 6px;
    font-weight: 500;
  }
  @media (max-width: 600px) {
    .facts-grid { grid-template-columns: 1fr; gap: 30px; }
  }
</style>
