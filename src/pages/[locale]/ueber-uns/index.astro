---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { LANGUAGES_READY } from '../../lib/languages.js';

export async function getStaticPaths() {
  return LANGUAGES_READY.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout title="Über uns" description="Über tiroltourismus.com – Mission & Vision" locale={locale}>
  <main>
    <div class="container"><Breadcrumbs items="{[{ label: 'Über uns' }]}" /></div>
    <main>
    <!-- ============================================================
         BREADCRUMBS
         ============================================================ -->
    <Breadcrumbs items={[{ label: 'Über uns' }]} />

    <!-- ============================================================
         HERO
         ============================================================ -->
    <section class="ueber-hero">
      <div class="ueber-hero-bg"></div>
      <div class="container">
        <div class="ueber-hero-inner">
          <div class="ueber-hero-badge">✨ Über uns</div>
          <h1 class="ueber-hero-title">Tirol <span>ANDERS</span></h1>
          <p class="ueber-hero-sub">
            Bunt. Dunkel. Laut. Leise. Echt.<br />
            Das Tourismusportal, das zeigt, was Tirol wirklich ausmacht.
          </p>
          <div class="ueber-hero-emoji">🏔️✨</div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         ABOUT GRID — 2-Column: Text + Emoji Box
         ============================================================ -->
    <section class="about-section">
      <div class="container">
        <div class="about-grid">
          <div class="about-text">
            <h2>Mission &amp; <span>Vision</span></h2>
            <p>
              tiroltourismus.com ist kein gewöhnliches Tourismusportal. Es ist ein
              Statement: <strong>Tirol kann auch anders</strong>. Bunter. Dunkler.
              Echter.
            </p>
            <p>
            Gegründet 2026 in Innsbruck, vereinen wir die Vielfalt Tirols
              bei Tag und bei Nacht zu einem Erlebnisportal, das
              zeigt, was Tirol wirklich ausmacht: nicht nur die Postkarten-Motive,
              sondern die rohen, ehrlichen Momente dazwischen.
            </p>
            <div class="about-highlight">
              „Wir zeigen Tirol, wie es wirklich ist: wild, leise, laut, bunt und
              manchmal komplett anders, als du denkst."
            </div>
            <p>
              Unsere Mission: jede einzelne Region, Unterkunft, jedes Erlebnis und
              Event in Tirol zu listen – kuratiert von Menschen, betrieben von
              <strong>KI</strong>, für alle zugänglich. Mit einem klaren
              Free-Mium-Modell: Basis kostenlos, Prominenz für Betriebe gegen
              Gebühr.
            </p>
            <a href="/regionen/" class="btn btn-pink about-cta"
              >Regionen entdecken →</a
            >
          </div>
          <div class="about-emoji-box">
            <div class="about-emoji-content">
              <span class="about-emoji-large">🏔️</span>
              <div class="about-emoji-row">
                <span>🎨</span><span>🌙</span><span>🤖</span><span>⛷️</span>
              </div>
              <div class="about-emoji-row">
                <span>🍻</span><span>🏡</span><span>🎿</span><span>🧘</span>
              </div>
              <p class="about-emoji-label">Tirol entdecken</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         WERTE — 3 Value Cards
         ============================================================ -->
    <section class="values-section">
      <div class="container">
        <div class="section-label">
          <span class="label-line"></span>
          <span class="label-text">Unsere Werte</span>
          <span class="label-line"></span>
        </div>
        <h3 class="values-heading">Was uns <span>antreibt</span></h3>

        <div class="values-grid">
          <div class="value-card reveal r1">
            <div class="value-card-bg"></div>
            <div class="value-icon">🎨</div>
            <h4>Lebensfreude</h4>
            <p>
              Bunt, laut, unangepasst. Wir zeigen Tirol so farbenfroh wie es ist
              – kein Einheitsbrei, sondern echtes Leben. Die
              Essenz unseres Portals: Lebensfreude auf 2.000 Metern.
            </p>
            <div class="value-tags">
              <span>Kreativität</span>
              <span>Lebensfreude</span>
              <span>Farbe</span>
            </div>
          </div>

          <div class="value-card reveal r2">
            <div class="value-card-bg"></div>
            <div class="value-icon">🌙</div>
            <h4>Nachtseite</h4>
            <p>
              Dunkel, tief, anders. Die Nachtseite Tirols – für alle, die mehr
              suchen als den sonnigen Postkartenblick. Ruhe, Melancholie,
              Magie. Die Berge unter dem Sternenhimmel.
            </p>
            <div class="value-tags">
              <span>Tiefgang</span>
              <span>Ruhe</span>
              <span>Magie</span>
            </div>
          </div>

          <div class="value-card reveal r3">
            <div class="value-card-bg"></div>
            <div class="value-icon">🤖</div>
            <h4>KI-Betrieben</h4>
            <p>
              Unsere Agenten sammeln, kuratieren und aktualisieren Inhalte in
              Echtzeit. Menschen entscheiden, KI liefert. So bleibt das Portal
              immer frisch – und die Betreiber:innen entlastet.
            </p>
            <div class="value-tags">
              <span>Innovation</span>
              <span>Effizienz</span>
              <span>Zukunft</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         QUOTE
         ============================================================ -->
    <section class="quote-section">
      <div class="container">
        <div class="about-quote">
          <div class="quote-icon">💬</div>
          <blockquote>
            Die Berge sind nicht nur aus Stein und Schnee – sie sind aus
            Geschichten gemacht. Jeder Gipfel hat eine, die darauf wartet,
            erzählt zu werden.
          </blockquote>
          <cite>
            — <strong>Team tiroltourismus.com</strong>, Innsbruck
          </cite>
          <div class="quote-decoration">
            <span></span><span></span><span></span>
          </div>
        </div>
      </div>
    </section>
  </main>


<style is:global>
  /* ==============================================================
     HERO
     ============================================================== */
  .ueber-hero {
    position: relative;
    padding: 80px 0 64px;
    overflow: hidden;
    text-align: center;
  }
  .ueber-hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, var(--pink-glow), transparent 70%);
    opacity: 0.3;
    pointer-events: none;
  }
  .ueber-hero .container {
    position: relative;
    z-index: 2;
  }
  .ueber-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .ueber-hero-badge {
    display: inline-block;
    padding: 6px 18px;
    border-radius: 100px;
    background: var(--pink);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .ueber-hero-title {
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text);
    margin: 0;
  }
  .ueber-hero-title span {
    color: var(--pink);
  }
  .ueber-hero-sub {
    font-size: 16px;
    color: var(--text2);
    line-height: 1.6;
    max-width: 500px;
    margin: 0;
  }
  .ueber-hero-emoji {
    font-size: 48px;
    margin-top: 8px;
    filter: drop-shadow(0 4px 12px rgba(255, 20, 147, 0.25));
    animation: float 3s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  /* ==============================================================
     ABOUT SECTION — 2-Column
     ============================================================== */
  .about-section {
    padding: 64px 0 80px;
  }
  .about-section .container {
    max-width: 1024px;
    margin: 0 auto;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .about-text h2 {
    font-family: var(--font-display);
    font-size: 42px;
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 20px;
  }
  .about-text h2 span {
    color: var(--pink);
  }
  .about-text p {
    font-size: 14px;
    line-height: 1.8;
    color: var(--text2);
    margin-bottom: 16px;
  }
  .about-text p strong {
    color: var(--text);
  }
  .about-text .about-highlight {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    border-left: 3px solid var(--pink);
    padding-left: 20px;
    margin: 24px 0;
    line-height: 1.7;
  }
  .about-cta {
    display: inline-block;
    margin-top: 8px;
  }

  /* Emoji Box */
  .about-emoji-box {
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .about-emoji-box::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--pink-glow), transparent);
    opacity: 0.25;
    pointer-events: none;
  }
  .about-emoji-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 32px;
  }
  .about-emoji-large {
    font-size: 72px;
    line-height: 1;
  }
  .about-emoji-row {
    display: flex;
    gap: 12px;
    font-size: 32px;
  }
  .about-emoji-label {
    font-family: var(--font-display);
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--pink);
    margin: 8px 0 0;
  }

  /* ==============================================================
     VALUES SECTION
     ============================================================== */
  .values-section {
    padding: 64px 0 80px;
    background: var(--bg2);
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
    margin-bottom: 12px;
  }
  .label-line {
    width: 40px;
    height: 1px;
    background: var(--pink);
    opacity: 0.3;
  }
  .label-text {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text3);
  }
  .values-heading {
    font-family: var(--font-display);
    font-size: 36px;
    line-height: 1.1;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-align: center;
    color: var(--text);
    margin-bottom: 40px;
  }
  .values-heading span {
    color: var(--pink);
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 960px;
    margin: 0 auto;
  }
  .value-card {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    padding: 40px 28px 32px;
    text-align: center;
    transition: all 0.4s var(--ease);
    overflow: hidden;
  }
  .value-card:hover {
    transform: translateY(-6px);
    border-color: var(--pink);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.08);
  }
  .value-card-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--pink), var(--purple));
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .value-card:hover .value-card-bg {
    opacity: 1;
  }
  .value-icon {
    font-size: 48px;
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
  }
  .value-card h4 {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 10px;
    position: relative;
    z-index: 1;
  }
  .value-card p {
    font-size: 13px;
    color: var(--text2);
    line-height: 1.7;
    position: relative;
    z-index: 1;
    margin-bottom: 16px;
  }
  .value-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    position: relative;
    z-index: 1;
  }
  .value-tags span {
    padding: 3px 10px;
    border-radius: 100px;
    background: var(--pink);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* ==============================================================
     QUOTE SECTION
     ============================================================== */
  .quote-section {
    padding: 72px 0 88px;
  }
  .quote-section .container {
    max-width: 720px;
    margin: 0 auto;
  }
  .about-quote {
    position: relative;
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 56px 44px 48px;
    text-align: center;
    overflow: hidden;
  }
  .about-quote::before {
    content: '"';
    position: absolute;
    top: 8px;
    left: 20px;
    font-family: var(--font-display);
    font-size: 96px;
    line-height: 1;
    color: var(--pink);
    opacity: 0.1;
    pointer-events: none;
  }
  .quote-icon {
    font-size: 40px;
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
  }
  .about-quote blockquote {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.7;
    color: var(--text);
    margin-bottom: 20px;
    font-style: italic;
    position: relative;
    z-index: 1;
  }
  .about-quote cite {
    font-size: 13px;
    color: var(--text2);
    font-style: normal;
    position: relative;
    z-index: 1;
  }
  .about-quote cite strong {
    color: var(--pink);
  }
  .quote-decoration {
    display: flex;
    gap: 6px;
    justify-content: center;
    margin-top: 20px;
    position: relative;
    z-index: 1;
  }
  .quote-decoration span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pink);
    opacity: 0.2;
  }
  .quote-decoration span:nth-child(2) {
    opacity: 0.4;
  }
  .quote-decoration span:nth-child(3) {
    opacity: 0.6;
  }

  /* ==============================================================
     RESPONSIVE
     ============================================================== */
  @media (max-width: 768px) {
    .ueber-hero-title {
      font-size: 38px;
    }
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .about-text h2 {
      font-size: 32px;
    }
    .values-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .about-quote {
      padding: 40px 24px 36px;
    }
    .about-quote blockquote {
      font-size: 17px;
    }
  }

  @media (max-width: 480px) {
    .ueber-hero {
      padding: 48px 0 40px;
    }
    .ueber-hero-title {
      font-size: 28px;
    }
    .about-emoji-large {
      font-size: 52px;
    }
    .about-emoji-row {
      font-size: 24px;
    }
  }
</style>
  </main>
</BaseLayout>
