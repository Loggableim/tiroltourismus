---
// bezirke/[slug].astro — Detailseite für einen Bezirk
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { readSingleton, readCollection, isPublished } from '../../lib/content.js';
import { generateMetaDescription } from '../../lib/seo.js';
import OrtCard from '../../components/OrtCard.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// Regionen → Bezirk Mapping
const BEZIRK_REGIONS: Record<string, string[]> = {
  innsbruck: ['innsbruck'],
  'innsbruck-land': ['innsbruck-land'],
  imst: ['imst', 'oetztal'],
  landeck: ['landeck', 'arlberg', 'kaunertal'],
  reutte: ['ausserfern'],
  kufstein: ['kufstein'],
  kitzbuehel: ['kitzbuehel'],
  schwaz: ['schwaz', 'achensee', 'zillertal'],
  lienz: ['osttirol', 'lienz'],
};

const WAPPEN_DATA = JSON.parse(readFileSync(resolve(process.cwd(), 'wappen/wappen_page_data.json'), 'utf-8'));
const WAPPEN_BEZIRKE = Object.fromEntries(
  WAPPEN_DATA.bezirke.map((b: any) => [b.key, { ...b, publicImg: `/wappen/${b.img.replace(/^img\//, '')}` }])
);

export async function getStaticPaths() {
  const b = readSingleton('bezirke') || {};
  return Object.values(b).filter(Boolean).map((entry: any) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;
const bezirke = readSingleton('bezirke');
const bezirk = bezirke?.[slug] || null;
if (!bezirk) return Astro.redirect('/bezirke/');

const bezirkWappen = WAPPEN_BEZIRKE[slug] || null;
const relevantRegions = BEZIRK_REGIONS[slug] || [];
const allOrte = readCollection('orte').filter((o) => isPublished(o.entry));
const orteImBezirk = allOrte.filter((o) => relevantRegions.includes(o.entry.region));
const alleRegionen = readCollection('regionen');
const regionenImBezirk = alleRegionen.filter((r) => relevantRegions.includes(r.slug));

// Cross-Collection-Links: Gastro, Erlebnisse, Unterkünfte, Sehenswürdigkeiten
const alleGastro = readCollection('gastro').filter((g) => isPublished(g.entry));
const gastroImBezirk = alleGastro.filter((g) => relevantRegions.includes(g.entry.region)).slice(0, 6);

const alleErlebnisse = readCollection('erlebnisse').filter((e) => isPublished(e.entry));
const erlebnisseImBezirk = alleErlebnisse.filter((e) => relevantRegions.includes(e.entry.region)).slice(0, 6);

const alleUnterkuenfte = readCollection('unterkuenfte').filter((u) => isPublished(u.entry));
const unterkuenfteImBezirk = alleUnterkuenfte.filter((u) => relevantRegions.includes(u.entry.region)).slice(0, 6);

const alleSehenswuerdigkeiten = readCollection('sehenswuerdigkeiten').filter((s) => isPublished(s.entry));
const sehenswuerdigkeitenImBezirk = alleSehenswuerdigkeiten.filter((s) => relevantRegions.includes(s.entry.region)).slice(0, 6);
---
<BaseLayout
  title={bezirk.name}
  description={generateMetaDescription({ name: bezirk.name, beschreibung: bezirk.beschreibung }, 'bezirke')}
>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Bezirke', href: '/bezirke/' }, { label: bezirk.name }]} />
    </div>

    <section class="bezirk-hero">
      <div class="container bezirk-hero-grid">
        <div class="bezirk-hero-copy">
          <div style="font-size:64px;margin-bottom:8px">🗺️</div>
          <h1 class="bezirk-page-title">{bezirk.name}</h1>
          <p class="bezirk-page-desc">{bezirk.beschreibung}</p>
          {orteImBezirk.length > 0 && (
            <p style="color:var(--text3);font-size:13px;margin-top:12px">{orteImBezirk.length} Gemeinden</p>
          )}
          {bezirkWappen && (
            <a href="/wappen/" class="bezirk-wappen-link">Wappen-Atlas öffnen →</a>
          )}
        </div>
        {bezirkWappen && (
          <div class="bezirk-hero-wappen">
            <img src={bezirkWappen.publicImg} alt={`${bezirk.name} Wappen`} loading="lazy" decoding="async" width="240" height="240">
          </div>
        )}
      </div>
    </section>

    {regionenImBezirk.length > 0 && (
      <section class="section" style="padding:0 0 40px">
        <div class="container">
          <h2 class="section-title" style="font-family:var(--font-display);font-size:28px;letter-spacing:1px;margin-bottom:16px">
            Regionen in {bezirk.name}
          </h2>
          <div class="bezirk-regionen">
            {regionenImBezirk.map((r) => (
              <a href={`/regionen/${r.slug}/`} class="bezirk-region-tag">
                {r.entry.emoji} {r.entry.titel}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section" style="padding:0 0 80px">
      <div class="container">
        <h2 class="section-title" style="font-family:var(--font-display);font-size:28px;letter-spacing:1px;margin-bottom:16px">
          Orte & Gemeinden
        </h2>
        {orteImBezirk.length > 0 ? (
          <div class="bezirk-orte-grid">
            {orteImBezirk.map((o) => (
              <OrtCard
                name={o.entry.name}
                slug={o.slug}
                beschreibung={o.entry.kurzbeschreibung}
                emoji={o.entry.emoji}
                farbe={o.entry.farbe}
              />
            ))}
          </div>
        ) : (
          <div style="text-align:center;padding:40px;color:var(--text2);border:1px dashed var(--glass-border);border-radius:var(--radius)">
            <p>Noch keine Orte für diesen Bezirk erfasst.</p>
          </div>
        )}
      </div>
    </section>

    {sehenswuerdigkeitenImBezirk.length > 0 && (
      <section class="section" style="padding:0 0 80px">
        <div class="container">
          <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:16px">
            <h2 class="section-title" style="font-family:var(--font-display);font-size:28px;letter-spacing:1px;margin:0">
              🏛️ Sehenswürdigkeiten
            </h2>
            <a href="/sehenswuerdigkeiten/" style="font-size:13px;font-weight:600;color:var(--pink);text-decoration:none">Alle anzeigen →</a>
          </div>
          <div class="bezirk-orte-grid">
            {sehenswuerdigkeitenImBezirk.map((s) => (
              <a href={`/sehenswuerdigkeiten/${s.slug}/`} class="bezirk-mini-card">
                <div class="bezirk-mini-emoji">{s.entry.emoji || '🏛️'}</div>
                <div class="bezirk-mini-body">
                  <h3>{s.entry.name}</h3>
                  {s.entry.ort && <div class="bezirk-mini-meta">{s.entry.ort}</div>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {erlebnisseImBezirk.length > 0 && (
      <section class="section" style="padding:0 0 80px">
        <div class="container">
          <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:16px">
            <h2 class="section-title" style="font-family:var(--font-display);font-size:28px;letter-spacing:1px;margin:0">
              🎯 Erlebnisse
            </h2>
            <a href="/erlebnisse/" style="font-size:13px;font-weight:600;color:var(--pink);text-decoration:none">Alle anzeigen →</a>
          </div>
          <div class="bezirk-orte-grid">
            {erlebnisseImBezirk.map((e) => (
              <a href={`/erlebnisse/${e.slug}/`} class="bezirk-mini-card">
                <div class="bezirk-mini-emoji">{e.entry.emoji || '🎯'}</div>
                <div class="bezirk-mini-body">
                  <h3>{e.entry.name}</h3>
                  {e.entry.ort && <div class="bezirk-mini-meta">{e.entry.ort}{e.entry.kategorie ? ` · ${e.entry.kategorie}` : ''}</div>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {gastroImBezirk.length > 0 && (
      <section class="section" style="padding:0 0 80px">
        <div class="container">
          <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:16px">
            <h2 class="section-title" style="font-family:var(--font-display);font-size:28px;letter-spacing:1px;margin:0">
              🍽️ Gastronomie
            </h2>
            <a href="/gastro/" style="font-size:13px;font-weight:600;color:var(--pink);text-decoration:none">Alle anzeigen →</a>
          </div>
          <div class="bezirk-orte-grid">
            {gastroImBezirk.map((g) => (
              <a href={`/gastro/${g.slug}/`} class="bezirk-mini-card">
                <div class="bezirk-mini-emoji">{g.entry.emoji || '🍽️'}</div>
                <div class="bezirk-mini-body">
                  <h3>{g.entry.name}</h3>
                  {(g.entry.ort || g.entry.kategorie) && <div class="bezirk-mini-meta">{[g.entry.ort, g.entry.kategorie].filter(Boolean).join(' · ')}</div>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {unterkuenfteImBezirk.length > 0 && (
      <section class="section" style="padding:0 0 80px">
        <div class="container">
          <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:16px">
            <h2 class="section-title" style="font-family:var(--font-display);font-size:28px;letter-spacing:1px;margin:0">
              🏨 Unterkünfte
            </h2>
            <a href="/unterkuenfte/" style="font-size:13px;font-weight:600;color:var(--pink);text-decoration:none">Alle anzeigen →</a>
          </div>
          <div class="bezirk-orte-grid">
            {unterkuenfteImBezirk.map((u) => (
              <a href={`/unterkuenfte/${u.slug}/`} class="bezirk-mini-card">
                <div class="bezirk-mini-emoji">🏨</div>
                <div class="bezirk-mini-body">
                  <h3>{u.entry.name}</h3>
                  {u.entry.ort && <div class="bezirk-mini-meta">{u.entry.ort}{u.entry.sterne ? ` · ${'★'.repeat(u.entry.sterne)}` : ''}</div>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  .bezirk-page-title {
    font-family: var(--font-display);
    font-size: clamp(42px,6vw,72px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .bezirk-page-desc {
    color: var(--text2);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
    font-size: 15px;
  }
  .bezirk-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) 280px;
    gap: 24px;
    align-items: center;
    padding: 56px 0 40px;
    text-align: left;
  }
  .bezirk-hero-copy {
    text-align: left;
  }
  .bezirk-hero-copy .bezirk-page-desc,
  .bezirk-hero-copy h1 {
    margin-left: 0;
    margin-right: 0;
  }
  .bezirk-hero-wappen {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 18px;
    box-shadow: var(--glass-shadow);
  }
  .bezirk-hero-wappen img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    background: #fff;
    border-radius: 18px;
    padding: 12px;
  }
  .bezirk-wappen-link {
    display: inline-flex;
    align-items: center;
    margin-top: 18px;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--pink);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .bezirk-regionen {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .bezirk-region-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
    transition: all 0.2s;
  }
  .bezirk-region-tag:hover {
    border-color: var(--pink);
    color: var(--pink);
  }
  .bezirk-orte-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .bezirk-mini-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    background: var(--bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: all 0.25s var(--ease);
  }
  .bezirk-mini-card:hover {
    border-color: var(--pink);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255,20,147,0.08);
  }
  .bezirk-mini-emoji {
    font-size: 32px;
    line-height: 1;
    flex-shrink: 0;
  }
  .bezirk-mini-body {
    flex: 1;
    min-width: 0;
  }
  .bezirk-mini-body h3 {
    font-family: var(--font-display);
    font-size: 16px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 2px;
    line-height: 1.2;
    color: var(--text);
  }
  .bezirk-mini-meta {
    font-size: 12px;
    color: var(--text2);
    line-height: 1.4;
  }
  @media(max-width:968px){
    .bezirk-orte-grid{grid-template-columns:repeat(2,1fr)}
    .bezirk-hero-grid{grid-template-columns:1fr}
  }
  @media(max-width:600px){
    .bezirk-orte-grid{grid-template-columns:1fr}
  }
</style>
