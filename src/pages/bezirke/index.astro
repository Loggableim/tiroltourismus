---
// bezirke/index.astro — Übersicht aller Bezirke Tirols
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { readSingleton } from '../../lib/content.js';

const bezirke = readSingleton('bezirke');
const items = bezirke ? Object.values(bezirke) : [];
---
<BaseLayout
  title="Bezirke Tirols"
  description="Alle neun Bezirke Tirols im Überblick – von Innsbruck bis Osttirol, vom Außerfern bis zum Zillertal."
>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Bezirke' }]} />
    </div>

    <section class="bezirke-hero">
      <div class="container" style="text-align:center;padding:60px 0 40px">
        <div style="font-size:64px;margin-bottom:8px">🗺️</div>
        <h1 class="bezirke-title">Bezirke Tirols</h1>
        <p class="bezirke-sub">Neun Bezirke – neun Persönlichkeiten. Von der Landeshauptstadt bis zu den entlegensten Tälern.</p>
      </div>
    </section>

    <section class="section" style="padding:0 0 80px">
      <div class="container">
        <div class="bezirke-grid">
          {items.filter(Boolean).map(b => (
            <a href={`/bezirke/${b.slug}/`} class="bezirk-card">
              <div class="bezirk-card-header">
                <h2 class="bezirk-card-name">{b.name}</h2>
              </div>
              <p class="bezirk-card-desc">{b.beschreibung}</p>
              <div class="bezirk-card-footer">
                <span class="bezirk-card-count">∞ Gemeinden</span>
                <span class="bezirk-card-arrow">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .bezirke-title {
    font-family: var(--font-display);
    font-size: clamp(42px,6vw,72px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .bezirke-sub {
    color: var(--text2);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
    font-size: 15px;
  }
  .bezirke-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .bezirk-card {
    background: var(--bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    padding: 28px;
    text-decoration: none;
    color: var(--text);
    transition: all 0.3s var(--ease);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bezirk-card:hover {
    border-color: var(--pink);
    box-shadow: 0 8px 32px rgba(255,20,147,0.1);
    transform: translateY(-2px);
  }
  .bezirk-card-name {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 1px;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .bezirk-card-desc {
    color: var(--text2);
    font-size: 13px;
    line-height: 1.6;
    flex: 1;
  }
  .bezirk-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
    border-top: 1px solid var(--glass-border);
  }
  .bezirk-card-count {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .5px;
    color: var(--text3);
  }
  .bezirk-card-arrow {
    color: var(--pink);
    font-size: 18px;
  }
  @media(max-width:968px){.bezirke-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.bezirke-grid{grid-template-columns:1fr}}
</style>
