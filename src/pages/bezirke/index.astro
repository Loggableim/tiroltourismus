---
// bezirke/index.astro — Übersicht aller Bezirke Tirols
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { readSingleton } from '../../lib/content.js';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const bezirke = readSingleton('bezirke');
const items = bezirke ? Object.values(bezirke) : [];
const wappenData = JSON.parse(readFileSync(resolve(process.cwd(), 'wappen/wappen_page_data.json'), 'utf-8'));
const wappenBezirke = wappenData.bezirke.map((b) => ({
  ...b,
  publicImg: `/wappen/${b.img.replace(/^img\//, '')}`,
}));

// JSON-LD: ItemList
const siteURL = 'https://www.tirol-tourismus.at';
const bezirkItemList = items.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Bezirke Tirols',
  description: 'Alle neun Bezirke Tirols im Überblick – von Innsbruck bis Osttirol, vom Außerfern bis zum Zillertal.',
  url: `${siteURL}/bezirke/`,
  numberOfItems: items.length,
  itemListElement: items.filter(Boolean).map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    url: `${siteURL}/bezirke/${b.slug}/`,
  })),
} : undefined;
---
<BaseLayout
  title="Bezirke Tirols"
  description="Alle neun Bezirke Tirols im Überblick – von Innsbruck bis Osttirol, vom Außerfern bis zum Zillertal."
  jsonld={bezirkItemList}
>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Bezirke' }]} />
    </div>

    <section class="bezirke-hero">
      <div class="container" style="text-align:center;padding:60px 0 40px">
        <div style="font-size:64px;margin-bottom:8px">🗺️</div>
        <h1 class="bezirke-title">Bezirke Tirols</h1>
        <p class="bezirke-sub">Neun Bezirke – neun Persönlichkeiten. Von der Landeshauptstadt bis zu den entlegensten Tälern.</p>
      </div>
    </section>

    <section class="wappen-feature-wrap">
      <div class="container">
        <a href="/wappen/" class="wappen-feature-card">
          <div class="wappen-feature-copy">
            <div class="wappen-feature-kicker">Neu im Atlas</div>
            <h2>Tiroler Wappen-Übersicht</h2>
            <p>Alle Bezirks- und Ortswappen in einer modernen, ultraminimalen Darstellung – direkt aus der Bezirke-Übersicht erreichbar.</p>
          </div>
          <div class="wappen-feature-preview">
            {wappenBezirke.slice(0, 4).map((b) => (
              <img src={b.publicImg} alt={b.name} loading="lazy" decoding="async">
            ))}
          </div>
        </a>
      </div>
    </section>

    <section class="section" style="padding:0 0 80px">
      <div class="container">
        <div class="bezirke-grid">
          {items.filter(Boolean).map(b => (
            <a href={`/bezirke/${b.slug}/`} class="bezirk-card">
              <div class="bezirk-card-header">
                <h2 class="bezirk-card-name">{b.name}</h2>
              </div>
              <p class="bezirk-card-desc">{b.beschreibung}</p>
              <div class="bezirk-card-footer">
                <span class="bezirk-card-count">∞ Gemeinden</span>
                <span class="bezirk-card-arrow">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .bezirke-title {
    font-family: var(--font-display);
    font-size: clamp(42px,6vw,72px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .bezirke-sub {
    color: var(--text2);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
    font-size: 15px;
  }
  .wappen-feature-wrap {
    padding: 0 0 18px;
  }
  .wappen-feature-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: 16px;
    align-items: center;
    padding: 20px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(255,20,147,.08), rgba(255,215,0,.06));
    border: 1px solid rgba(255,20,147,.18);
    text-decoration: none;
    color: var(--text);
    box-shadow: 0 14px 36px rgba(0,0,0,.05);
    transition: all .25s var(--ease);
  }
  .wappen-feature-card:hover {
    border-color: var(--tirol-pink);
    transform: translateY(-1px);
  }
  .wappen-feature-kicker {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--tirol-pink);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .wappen-feature-copy h2 {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 44px);
    letter-spacing: 1px;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 8px;
  }
  .wappen-feature-copy p {
    color: var(--text2);
    line-height: 1.7;
    max-width: 62ch;
  }
  .wappen-feature-preview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .wappen-feature-preview img {
    width: 100%;
    aspect-ratio: 1 / 1.1;
    object-fit: contain;
    background: #fff;
    border-radius: 16px;
    border: 1px solid var(--glass-border);
    padding: 8px;
  }
  .bezirke-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .bezirk-card {
    background: var(--bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    padding: 28px;
    text-decoration: none;
    color: var(--text);
    transition: all 0.3s var(--ease);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bezirk-card:hover {
    border-color: var(--tirol-pink);
    box-shadow: 0 8px 32px rgba(255,20,147,0.1);
    transform: translateY(-2px);
  }
  .bezirk-card-name {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 1px;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .bezirk-card-desc {
    color: var(--text2);
    font-size: 13px;
    line-height: 1.6;
    flex: 1;
  }
  .bezirk-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
    border-top: 1px solid var(--glass-border);
  }
  .bezirk-card-count {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .5px;
    color: var(--text3);
  }
  .bezirk-card-arrow {
    color: var(--tirol-pink);
    font-size: 18px;
  }
  @media(max-width:968px){
    .wappen-feature-card{grid-template-columns:1fr}
    .wappen-feature-preview{grid-template-columns:repeat(4,1fr)}
    .bezirke-grid{grid-template-columns:repeat(2,1fr)}
  }
  @media(max-width:600px){
    .bezirke-grid{grid-template-columns:1fr}
    .wappen-feature-preview{grid-template-columns:repeat(2,1fr)}
  }
</style>
