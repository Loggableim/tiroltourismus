---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SectionMap from '../../sections/SectionMap.astro';
import CampingCard from '../../components/CampingCard.astro';
import { readCollection, isPublished } from '../../lib/content.js';

const camping = readCollection('camping').filter(c => isPublished(c.entry));
const campingMitCoords = camping.filter(c => c.entry.koordinaten?.lat && c.entry.koordinaten?.lng);
// Group by region for display
const byRegion = {};
for (const c of camping) {
  const region = c.entry.region || 'sonstige';
  if (!byRegion[region]) byRegion[region] = [];
  byRegion[region].push(c);
}
const regionNames = {
  ausserfern: 'Außerfern',
  achensee: 'Achensee',
  arlberg: 'Arlberg',
  imst: 'Imst',
  innsbruck: 'Innsbruck',
  'innsbruck-land': 'Innsbruck-Land',
  kitzbuehel: 'Kitzbühel',
  kufstein: 'Kufstein',
  landeck: 'Landeck',
  oetztal: 'Ötztal',
  osttirol: 'Osttirol',
  schwaz: 'Schwaz',
  stubaital: 'Stubaital',
  zillertal: 'Zillertal',
  sonstige: 'Weitere Regionen',
};
const sortedRegions = Object.keys(byRegion).sort((a, b) => {
  if (a === 'sonstige') return 1;
  if (b === 'sonstige') return -1;
  return (regionNames[a] || a).localeCompare(regionNames[b] || b);
});
---

<BaseLayout
  title="Campingplätze in Tirol"
  description="Entdecke die schönsten Campingplätze in Tirol. Von Alpencamping bis Zeltplatz – Dein Platz in der Natur."
>
  <main>
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Startseite</a><span class="sep">›</span><span>Campingplätze</span>
      </div>
    </div>

    <section class="page-header">
      <div class="container">
        <h1 class="reveal">Campingplätze in Tirol</h1>
        <p class="reveal r2">
          Von Alpencamping mit Bergpanorama bis zu familienfreundlichen
          Plätzen am See – hier findest Du Deinen Stellplatz in der Natur.
        </p>
      </div>
    </section>

    {campingMitCoords.length > 0 && (
      <SectionMap
        markers={campingMitCoords.map(c => ({
          lat: c.entry.koordinaten.lat,
          lng: c.entry.koordinaten.lng,
          label: c.entry.name,
          emoji: '🏕️',
          href: '/camping/' + c.slug + '/',
          category: 'camping',
        }))}
        label={campingMitCoords.length + ' Campingplätze'}
        title="Auf einen Blick"
        height="380px"
        scrollWheelZoom={true}
        filterable={true}
      />
    )}

    {camping.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHeader
            label="Übernachten in der Natur"
            title="Campingplätze in Tirol"
            sub="🏕️ {camping.length} Campingplätze – von einfachen Zeltplätzen bis zu Komfort-Campingresorts."
          />

          {sortedRegions.map(region => {
            const items = byRegion[region];
            return (
              <div class="region-group">
                <h2 class="region-title">{regionNames[region] || region} <span class="region-count">({items.length})</span></h2>
                <div class="cp-grid">
                  {items.map(c => (
                    <CampingCard
                      name={c.entry.name}
                      slug={c.slug}
                      ort={c.entry.ort}
                      region={c.entry.region}
                      preis_ab={c.entry.preis_ab}
                      ausstattung={c.entry.ausstattung}
                      tier={c.entry.tier || 'basic'}
                    />
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">🏕️</div>
          <h2
            style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase"
          >
            Bald verfügbar
          </h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">
            Campingplätze werden aktuell eingepflegt. Schau bald wieder vorbei!
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  .page-header {
    position: relative;
    padding: 60px 0 40px;
    text-align: center;
    background: var(--bg2);
    border-bottom: 1px solid var(--glass-border);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-header p {
    font-size: 15px;
    color: var(--text2);
    max-width: 480px;
    margin: 0 auto;
  }

  .cp-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 968px) {
    .cp-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 550px) {
    .cp-grid { grid-template-columns: 1fr; }
  }

  .region-group {
    margin-bottom: 48px;
  }
  .region-title {
    font-family: var(--font-display);
    font-size: 28px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--glass-border);
    color: var(--text);
  }
  .region-count {
    font-size: 16px;
    color: var(--text3);
    font-weight: 400;
  }
</style>
