---
// demofrontneu.astro — Demo front page (noindex, no sitemap).
// Language chooser (8 tiles) + real category counts. Fits in 100dvh, no scroll.
import TirolLogo from '../components/TirolLogo.astro';
import { readCollection, isPublished } from '../lib/content.js';
import { switchLangPath } from '../lib/languages.js';

// ── 8 languages: name native + "Discover Tirol" line ──
const LANG_TILES = [
  { code: 'de', htmlLang: 'de', name: 'Deutsch',    tagline: 'Tirol entdecken',   accent: 'var(--tirol-red)' },
  { code: 'en', htmlLang: 'en', name: 'English',    tagline: 'Discover Tirol',    accent: 'var(--ikea-blue)' },
  { code: 'fr', htmlLang: 'fr', name: 'Français',   tagline: 'Découvrir le Tyrol', accent: 'var(--pop-purple)' },
  { code: 'cs', htmlLang: 'cs', name: 'Čeština',    tagline: 'Objevte Tyrolsko',  accent: 'var(--pop-green)' },
  { code: 'nl', htmlLang: 'nl', name: 'Nederlands', tagline: 'Ontdek Tirol',      accent: 'var(--pop-orange)' },
  { code: 'it', htmlLang: 'it', name: 'Italiano',   tagline: 'Scopri il Tirolo',  accent: 'var(--tirol-pink-dark)' },
  { code: 'es', htmlLang: 'es', name: 'Español',    tagline: 'Descubre el Tirol', accent: 'var(--gold)' },
  { code: 'zh', htmlLang: 'zh', name: '中文',        tagline: '探索蒂罗尔',         accent: 'var(--tirol-pink)' },
];
// Real front page per language (subdomain/prefix logic reused from lib/languages.js)
const tiles = LANG_TILES.map((t) => ({ ...t, href: switchLangPath('/', 'de', t.code) }));

// ── REAL counts counted at build time from src/data/<folder> ──
const countEntries = (name) => readCollection(name, 'de').filter((e) => isPublished(e.entry)).length;
const nf = new Intl.NumberFormat('en-US');
const CATEGORIES = [
  { slug: 'orte',               label: 'Places',             count: countEntries('orte') },
  { slug: 'unterkuenfte',       label: 'Accommodations',     count: countEntries('unterkuenfte') },
  { slug: 'sehenswuerdigkeiten', label: 'Sights',            count: countEntries('sehenswuerdigkeiten') },
  { slug: 'erlebnisse',         label: 'Activities & Nature', count: countEntries('erlebnisse') },
  { slug: 'gastro',             label: 'Food & Drink',       count: countEntries('gastro') },
  { slug: 'camping',            label: 'Camping',            count: countEntries('camping') },
].map((c) => ({ ...c, href: switchLangPath(`/${c.slug}/`, 'de', 'de') }));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sprachauswahl — Tirol Tourismus</title>
  <meta name="description" content="Wähle deine Sprache / Choose your language — Tirol Tourismus Demo.">
  <meta name="robots" content="noindex">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/tirol.css">
</head>
<body>
<div class="wrap">
  <a class="banner" id="continueBanner" href="/" hidden>
    Continue in <span id="continueLang"></span> →
  </a>

  <header class="head">
    <a class="brand" href="https://tiroltourismus.com/" aria-label="Tirol Tourismus">
      <TirolLogo width={168} idSuffix="df" locale="de" />
    </a>
    <h1 class="claim" lang="en">Choose your language</h1>
  </header>

  <main class="langs" aria-label="Language selection">
    {tiles.map((t) => (
      <a
        class="tile"
        href={t.href}
        lang={t.htmlLang}
        data-lang={t.code}
        style={`--accent:${t.accent}`}
      >
        <span class="rec-badge" lang="en">Recommended</span>
        <span class="name">{t.name}</span>
        <span class="sub">{t.tagline}</span>
      </a>
    ))}
  </main>

  <nav class="cats" aria-label="Categories">
    {CATEGORIES.map((c) => (
      <a class="chip" href={c.href}>
        {c.label} <b>{nf.format(c.count)}</b>
      </a>
    ))}
  </nav>
</div>

<script is:inline>
(function () {
  'use strict';
  var NAMES = { de: 'Deutsch', en: 'English', fr: 'Français', cs: 'Čeština', nl: 'Nederlands', it: 'Italiano', es: 'Español', zh: '中文' };
  var STORE = 'tirol-demo-lang';
  var tiles = {};
  document.querySelectorAll('.tile[data-lang]').forEach(function (a) {
    tiles[a.getAttribute('data-lang')] = a;
  });

  function normalize(tag) {
    tag = String(tag || '').toLowerCase();
    if (!tag) return null;
    var base = tag.split('-')[0];
    return tiles[base] ? base : null;
  }

  // 1) Recommend the browser language (no auto redirect)
  var langs = [];
  try { langs = navigator.languages || [navigator.language]; } catch (e) {}
  var match = null;
  for (var i = 0; i < langs.length && !match; i++) match = normalize(langs[i]);
  if (match) {
    tiles[match].classList.add('recommended');
    tiles[match].setAttribute('aria-current', 'true');
  }

  // 2) Return visit → "Continue in <language> →"
  var saved = null;
  try { saved = localStorage.getItem(STORE); } catch (e) {}
  if (saved && tiles[saved]) {
    var banner = document.getElementById('continueBanner');
    var label = document.getElementById('continueLang');
    if (banner && label) {
      label.textContent = NAMES[saved] || saved;
      banner.setAttribute('href', tiles[saved].getAttribute('href'));
      banner.hidden = false;
    }
  }

  // 3) Save the chosen language on click
  Object.keys(tiles).forEach(function (code) {
    tiles[code].addEventListener('click', function () {
      try { localStorage.setItem(STORE, code); } catch (e) {}
    });
  });
})();
</script>

<style is:global>
  html, body { height: 100%; overflow: hidden; }
  body { background: var(--bg); }

  .wrap {
    position: relative;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 1.2vh, 14px);
    padding: clamp(8px, 1.6vh, 20px) clamp(10px, 3vw, 40px);
    overflow: hidden;
    background:
      radial-gradient(60% 45% at 15% 0%, rgba(255, 20, 147, .08), transparent 70%),
      radial-gradient(55% 45% at 90% 100%, rgba(212, 168, 0, .10), transparent 70%),
      var(--bg);
  }

  .banner {
    align-self: center;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: clamp(5px, 1vh, 9px) clamp(12px, 2vw, 20px);
    border-radius: 100px;
    background: var(--tirol-pink-dark);
    color: #fff;
    font-size: clamp(11px, 1.5vh, 13px);
    font-weight: 700;
    letter-spacing: .3px;
    text-decoration: none;
    box-shadow: 0 8px 24px var(--tirol-pink-glow);
  }
  .banner[hidden] { display: none; }
  .banner:hover { filter: brightness(1.08); }

  .head {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1.5vw, 18px);
    flex-wrap: wrap;
  }
  .brand { display: inline-flex; line-height: 0; }
  .claim {
    font-family: var(--font-body);
    font-size: clamp(10px, 1.5vh, 13px);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text2);
  }

  .langs {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: clamp(6px, 1.1vh, 14px);
  }

  .tile {
    position: relative;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2px, .6vh, 6px);
    text-align: center;
    padding: clamp(6px, 1.4vh, 18px) clamp(8px, 1.4vw, 16px);
    border: 1px solid var(--glass-border);
    border-top: 4px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg2);
    color: var(--text);
    text-decoration: none;
    transition: transform .25s var(--ease), box-shadow .25s var(--ease), border-color .25s var(--ease);
  }
  .tile:hover {
    transform: translateY(-3px);
    border-color: var(--tirol-pink);
    box-shadow: 0 12px 32px rgba(0, 0, 0, .12);
  }
  .tile .name {
    font-family: var(--font-display);
    font-size: clamp(20px, 3.6vh, 34px);
    line-height: 1;
    letter-spacing: 1px;
  }
  .tile[lang="zh"] .name { letter-spacing: 4px; }
  .tile .sub {
    font-size: clamp(9px, 1.5vh, 13px);
    line-height: 1.25;
    color: var(--text2);
  }

  .tile.recommended {
    border-color: var(--tirol-pink);
    box-shadow: 0 0 0 2px var(--tirol-pink), 0 12px 34px var(--tirol-pink-glow);
  }
  .rec-badge {
    position: absolute;
    top: clamp(4px, .8vh, 8px);
    right: clamp(4px, .8vh, 8px);
    display: none;
    align-items: center;
    padding: 1px 7px;
    border-radius: 100px;
    background: var(--gold);
    color: #1A1A1A;
    font-size: clamp(8px, 1.1vh, 10px);
    font-weight: 700;
    letter-spacing: .5px;
    text-transform: uppercase;
  }
  .tile.recommended .rec-badge { display: inline-flex; }

  .cats {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(4px, .9vh, 10px);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: clamp(4px, .9vh, 9px) clamp(8px, 1.4vw, 15px);
    border-radius: 100px;
    background: var(--surface);
    border: 1px solid var(--glass-border);
    color: var(--text);
    font-size: clamp(10px, 1.5vh, 13px);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: border-color .2s, color .2s, background .2s;
  }
  .chip b {
    font-family: var(--font-display);
    font-size: 1.2em;
    line-height: 1;
    color: var(--tirol-pink);
  }
  .chip:hover {
    border-color: var(--tirol-pink);
    color: var(--tirol-pink);
    background: rgba(255, 20, 147, .06);
  }

  a:focus-visible {
    outline: 3px solid var(--tirol-pink);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .langs {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(4, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile, .chip { transition: none; }
  }
</style>
</body>
</html>
