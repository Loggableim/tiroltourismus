---
// events/eintragen/index.astro — Event-Submission-Formular für User
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import EventSubmissionForm from '../../../components/EventSubmissionForm.tsx';
---

<BaseLayout
  title="Event eintragen – Tirol Tourismus"
  description="Trage dein Event kostenlos auf tiroltourismus.com ein. Nach Prüfung wird es im Event-Kalender veröffentlicht."
>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Events', href: '/events/' }, { label: 'Event eintragen' }]} />
    </div>

    <section class="ev-page-header">
      <div class="container">
        <div class="ev-page-emoji">🎪</div>
        <h1>Event eintragen</h1>
        <p class="ev-page-sub">
          Du veranstaltest ein Konzert, einen Markt, eine Wanderung oder ein Fest in Tirol?<br />
          Trag es kostenlos ein – nach Freigabe durch unser Team ist es live.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container" style="max-width:720px">
        <SectionHeader
          label="Event-Details"
          title="Dein Event"
          sub="Alle Angaben können nach Einreichung nicht mehr bearbeitet werden. Bei Fragen: hallo@tiroltourismus.com"
        />
        <EventSubmissionForm client:load />
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .ev-page-header{position:relative;padding:60px 0 0;text-align:center}
  .ev-page-emoji{font-size:64px;margin-bottom:8px}
  .ev-page-header h1{font-family:var(--font-display);font-size:clamp(36px,5vw,64px);line-height:1;letter-spacing:2px;text-transform:uppercase;margin-bottom:12px}
  .ev-page-sub{font-size:15px;color:var(--text2);max-width:520px;margin:0 auto;line-height:1.6}
</style>
