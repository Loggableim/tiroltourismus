---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import EventCard from '../../components/EventCard.astro';
import SectionMap from '../../sections/SectionMap.astro';
import { readCollection, isPublished } from '../../lib/content.js';

const events = readCollection('events').filter(e => isPublished(e.entry));
const sorted = events.sort((a, b) => (a.entry.datum_von || '').localeCompare(b.entry.datum_von || ''));
const mitCoords = events.filter(e => e.entry.koordinaten?.lat && e.entry.koordinaten?.lng);
---

<BaseLayout title="Events in Tirol" description="Events in Tirol: Konzerte, Sport, Kultur, Feste und kulinarische Highlights – der offizielle Event-Kalender für Tirol.">
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Events' }]} />
    </div>

    <section class="page-header">
      <div class="container">
        <div style="font-size:48px;margin-bottom:8px">🎪</div>
        <h1>Events in Tirol</h1>
        <p>Konzerte, Sport-Events, Kultur-Festivals, Märkte und kulinarische Highlights – der offizielle Event-Kalender für Tirol.</p>
        <div style="margin-top:20px">
          <a href="/events/eintragen/" class="btn btn-pink">+ Eigenes Event eintragen</a>
        </div>
      </div>
    </section>

    {mitCoords.length > 0 && (
      <SectionMap
        markers={mitCoords.map(e => ({
          lat: e.entry.koordinaten.lat,
          lng: e.entry.koordinaten.lng,
          label: e.entry.name || e.entry.titel,
          emoji: e.entry.emoji || '🎪',
          href: '/events/' + e.slug + '/',
          category: 'events',
        }))}
        label={mitCoords.length + ' Events'}
        title="Auf einen Blick"
        height="380px"
        scrollWheelZoom={true}
        filterable={true}
      />
    )}

    {sorted.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHeader
            label="Event-Kalender"
            title="Anstehende Events"
            sub="Alle Termine auf einen Blick – von Bergfesten bis zu Gourmet-Erlebnissen."
          />
          <div class="events-list">
            {sorted.map((e, i) => (
              <EventCard
                titel={e.entry.titel || e.entry.name}
                slug={e.slug}
                kategorie={e.entry.kategorie}
                kurzbeschreibung={e.entry.kurzbeschreibung}
                ort={e.entry.ort}
                datum_von={e.entry.datum_von}
                uhrzeit={e.entry.uhrzeit}
                preis={e.entry.preis}
                emoji={e.entry.emoji}
              />
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">🎪</div>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;text-transform:uppercase">Bald verfügbar</h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto 20px">Events werden aktuell eingepflegt. Schau bald wieder vorbei!</p>
          <a href="/events/eintragen/" class="btn btn-pink">→ Jetzt Event eintragen</a>
        </div>
      </section>
    )}

    <!-- CTA Section -->
    <section class="section" style="background:var(--bg2);border-top:1px solid var(--glass-border)">
      <div class="container" style="text-align:center;padding:40px 0">
        <div style="font-size:48px;margin-bottom:12px">📢</div>
        <h2 style="font-family:var(--font-display);font-size:28px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px">Event veröffentlichen</h2>
        <p style="color:var(--text2);max-width:480px;margin:0 auto 24px;line-height:1.6">
          Du veranstaltest ein Event in Tirol? Trag es kostenlos ein und erreiche tausende Besucher auf dem offiziellen Tourismusportal.
        </p>
        <a href="/events/eintragen/" class="btn btn-pink" style="font-size:16px;padding:14px 36px">
          🎪 Kostenlos eintragen
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .page-header{position:relative;padding:60px 0 40px;text-align:center;background:var(--bg2);border-bottom:1px solid var(--glass-border)}
  .page-header h1{font-family:var(--font-display);font-size:clamp(36px,6vw,72px);line-height:1;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}
  .page-header p{font-size:15px;color:var(--text2);max-width:520px;margin:0 auto}
  .events-list{display:flex;flex-direction:column;gap:16px}
  .btn-pink{display:inline-flex;align-items:center;gap:6px;padding:12px 28px;background:var(--pink);color:#fff !important;border-radius:100px;font-weight:700;font-size:14px;letter-spacing:.5px;text-transform:uppercase;text-decoration:none;transition:all .3s;border:none;cursor:pointer}
  .btn-pink:hover{background:var(--pink-dark,#e01080);transform:translateY(-2px);box-shadow:0 6px 24px rgba(255,20,147,.3)}
</style>
