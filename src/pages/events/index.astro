---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readCollection, isPublished } from '../../lib/content.js';

const events = readCollection('events').filter(e => isPublished(e.entry));
const sorted = events.sort((a, b) => (a.entry.datum_von || '').localeCompare(b.entry.datum_von || ''));

const monate = ['Jänner','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
function formatDate(d) {
  if (!d) return null;
  const [y, m, day] = d.split('-');
  return { day: parseInt(day), month: monate[parseInt(m)-1], year: y };
}
---

<BaseLayout title="Events in Tirol" description="Events in Tirol: Konzerte, Sport-Events, Kultur-Festivals und kulinarische Highlights – der offizielle Event-Kalender für Tirol.">
  <main>
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Startseite</a><span class="sep">›</span><span>Events</span>
      </div>
    </div>

    <section class="page-header">
      <div class="container">
        <div style="font-size:48px;margin-bottom:8px">🎪</div>
        <h1>Events in Tirol</h1>
        <p>Konzerte, Sport-Events, Kultur-Festivals und kulinarische Highlights – der offizielle Event-Kalender für Tirol.</p>
      </div>
    </section>

    {sorted.length > 0 ? (
      <section class="section">
        <div class="container">
          <div class="section-header"><h2 class="section-title">Anstehende Events</h2></div>
          <div class="events-list">
            {sorted.map((e, i) => {
              const ev = e.entry;
              const dateInfo = ev.datum_von ? formatDate(ev.datum_von) : null;
              return (
                <a href={`/events/${e.slug}/`} class="event-card-link">
                  <div class={`event-card reveal r${(i % 3) + 1}`}>
                    {dateInfo && (
                      <div class="event-date-box">
                        <span class="day">{dateInfo.day}</span>
                        <span class="month">{dateInfo.month}</span>
                        <span class="year">{dateInfo.year}</span>
                      </div>
                    )}
                    <div class="event-info">
                      {ev.kategorie && <span class="event-cat">{ev.kategorie}</span>}
                      <h3>{ev.titel}</h3>
                      {ev.kurzbeschreibung && <p class="event-desc">{ev.kurzbeschreibung}</p>}
                      {ev.ort && <div class="event-location">{ev.ort}</div>}
                      <div class="event-meta">
                        {ev.uhrzeit && <span class="event-time">{ev.uhrzeit}</span>}
                        {ev.preis && <span class="event-price">{ev.preis}</span>}
                        {ev.webseite && <a href={ev.webseite} target="_blank" class="event-link">Details →</a>}
                      </div>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">🎪</div>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px">Bald verfügbar</h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto">Events werden aktuell eingepflegt. Schau bald wieder vorbei!</p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  .page-header{position:relative;padding:60px 0 40px;text-align:center;background:var(--bg2);border-bottom:1px solid var(--glass-border)}
  .page-header h1{font-family:var(--font-display);font-size:clamp(42px,6vw,80px);line-height:1;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}
  .page-header p{font-size:15px;color:var(--text2);max-width:480px;margin:0 auto}

  .event-card-link{display:block;text-decoration:none;color:inherit}
  .event-card-link:hover .event-card{transform:translateY(-4px);border-color:var(--pink);box-shadow:0 12px 40px rgba(0,0,0,.08)}

  .events-list{display:flex;flex-direction:column;gap:16px}

  .event-card{display:flex;background:var(--bg2);border:1px solid var(--glass-border);border-radius:var(--radius-lg);overflow:hidden;transition:all .4s var(--ease);min-height:140px}
  /* hover on .event-card-link instead of .event-card directly */

  .event-date-box{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:110px;padding:20px 16px;background:var(--pink);color:#fff;text-align:center;flex-shrink:0}
  .event-date-box .day{font-family:var(--font-display);font-size:38px;line-height:1;letter-spacing:1px}
  .event-date-box .month{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-top:2px;opacity:.85}
  .event-date-box .year{font-size:9px;font-weight:600;opacity:.6;margin-top:2px}

  .event-info{padding:20px 24px;flex:1;display:flex;flex-direction:column}
  .event-cat{display:inline-block;padding:3px 12px;border-radius:100px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;width:fit-content;background:rgba(255,20,147,.12);color:var(--pink)}
  .event-info h3{font-family:var(--font-display);font-size:24px;letter-spacing:.5px;line-height:1.2;margin-bottom:4px;color:var(--text)}
  .event-desc{font-size:13px;color:var(--text2);line-height:1.5;margin-bottom:8px}
  .event-location{font-size:12px;color:var(--text2);margin-bottom:8px}
  .event-location::before{content:'📍 '}
  .event-meta{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
  .event-time{font-size:12px;color:var(--text3);display:flex;align-items:center;gap:4px}
  .event-time::before{content:'🕐 '}
  .event-price{font-size:12px;font-weight:700;color:var(--pink)}
  .event-link{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--pink);transition:all .3s;display:inline-flex;align-items:center;gap:4px}

  @media(max-width:600px){
    .event-card{flex-direction:column}
    .event-date-box{flex-direction:row;gap:8px;min-width:auto;padding:12px 16px}
    .event-date-box .day{font-size:24px}
    .event-date-box .month{font-size:12px}
    .event-date-box .year{font-size:8px}
  }
</style>
