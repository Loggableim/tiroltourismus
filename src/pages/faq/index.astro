---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SegmentedNav from '../../components/SegmentedNav.astro';
import { readSingleton } from '../../lib/content.js';

const faqItems = readSingleton('faq') || [];

// Group by category
const categoryOrder = ['allgemein', 'anreise', 'unterkunft', 'wandern', 'ski', 'familie', 'gastro', 'regionen', 'wetter', 'events'];
const categoryLabels = {
  allgemein: 'Allgemein',
  anreise: 'Anreise',
  unterkunft: 'Unterkunft',
  wandern: 'Wandern',
  ski: 'Ski & Winter',
  familie: 'Familie & Kinder',
  gastro: 'Kulinarik',
  regionen: 'Regionen',
  wetter: 'Wetter & Reisezeit',
  events: 'Events & Veranstaltungen',
};
const categoryEmoji = {
  allgemein: '📌',
  anreise: '🚗',
  unterkunft: '🏨',
  wandern: '🥾',
  ski: '⛷️',
  familie: '👨‍👩‍👧‍👦',
  gastro: '🍽️',
  regionen: '🗺️',
  wetter: '🌤️',
  events: '🎉',
};

// Build grouped map preserving order
const grouped = new Map();
for (const cat of categoryOrder) {
  const items = faqItems.filter(i => i.kategorie === cat);
  if (items.length > 0) {
    grouped.set(cat, items);
  }
}
// Also add any categories not in our predefined order
for (const item of faqItems) {
  if (item.kategorie && !grouped.has(item.kategorie)) {
    const items = faqItems.filter(i => i.kategorie === item.kategorie);
    grouped.set(item.kategorie, items);
  }
}

// Build JSON-LD FAQPage schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.frage,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.antwort,
    },
  })),
};

function catId(kategorie) {
  return 'cat-' + kategorie.toLowerCase().replace(/\s+/g, '-').replace(/[&]/g, 'und');
}
---

<BaseLayout
  title="FAQ – Häufige Fragen zu Tirol"
  description="Antworten auf die häufigsten Fragen zu Tirol – von Anreise und Unterkunft über Wandern, Ski und Kulinarik bis zu Events und Familienurlaub."
  jsonld={faqSchema}
>
  <main>
    <!-- BREADCRUMBS -->
    <Breadcrumbs items={[{ label: 'FAQ' }]} />

    <!-- HERO -->
    <section class="faq-hero">
      <div class="faq-hero-bg"></div>
      <div class="container">
        <div class="faq-hero-inner">
          <div class="faq-hero-emoji">❓</div>
          <h1 class="faq-hero-title">FAQ</h1>
          <p class="faq-hero-sub">
            Häufige Fragen rund um Deinen nächsten Urlaub in Tirol – von der Anreise bis zu den schönsten Wanderwegen und Skipisten.
          </p>
        </div>
      </div>
    </section>

    <!-- CATEGORY NAV -->
    {[...grouped.keys()].length > 0 && (
      <section>
        <div class="container">
          <SegmentedNav
            ariaLabel="FAQ Kategorien"
            items={[...grouped.keys()].map((cat) => ({
              href: `#${catId(cat)}`,
              icon: categoryEmoji[cat] || '📌',
              label: categoryLabels[cat] || cat,
              count: grouped.get(cat).length,
            }))}
          />
        </div>
      </section>
    )}

    <!-- FAQ SECTIONS BY CATEGORY -->
    <section class="faq-section">
      <div class="container" style="max-width: 800px">
        <SectionHeader
          label="#wissen"
          title="Fragen & Antworten"
          sub="Alles, was Du für Deine Reiseplanung nach Tirol wissen musst – übersichtlich nach Themen geordnet."
        />

        {[...grouped.keys()].length > 0 ? (
          [...grouped.keys()].map((cat, catIndex) => (
            <div class="faq-category" id={catId(cat)}>
              <h2 class="faq-category-title">
                <span class="faq-category-emoji">{categoryEmoji[cat] || '📌'}</span>
                {categoryLabels[cat] || cat}
              </h2>

              <div class="faq-list">
                {grouped.get(cat).map((item, i) => (
                  <details class="faq-item" id={`faq-${catIndex}-${i}`}>
                    <summary class="faq-question">
                      <span class="faq-num">{(i + 1).toString().padStart(2, '0')}</span>
                      <span class="faq-q-text">{item.frage}</span>
                      <span class="faq-toggle" aria-hidden="true">+</span>
                    </summary>
                    <div class="faq-answer">
                      <p>{item.antwort}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))
        ) : (
          <p class="faq-empty">Derzeit sind keine FAQ-Einträge verfügbar.</p>
        )}
      </div>
    </section>

    <!-- WEITERFÜHRENDE LINKS -->
    <section class="faq-links-section">
      <div class="container" style="max-width: 800px">
        <div class="faq-links">
          <h3 class="faq-links-title">Weitere Informationen</h3>
          <div class="faq-links-grid">
            <a href="/magazin/" class="faq-link-card">
              <span class="faq-link-emoji">📰</span>
              <span class="faq-link-text">Magazin</span>
              <span class="faq-link-desc">Geschichten, Tipps und Reportagen aus Tirol</span>
            </a>
            <a href="/magazin/tags/" class="faq-link-card">
              <span class="faq-link-emoji">🏷️</span>
              <span class="faq-link-text">Themen entdecken</span>
              <span class="faq-link-desc">Alle Themen und Kategorien auf einen Blick</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* ==============================================================
     FAQ HERO
     ============================================================== */
  .faq-hero {
    position: relative;
    padding: 80px 0 48px;
    overflow: hidden;
    text-align: center;
  }
  .faq-hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, var(--pink-glow), transparent 70%);
    opacity: 0.3;
    pointer-events: none;
  }
  .faq-hero .container { position: relative; z-index: 2; }
  .faq-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .faq-hero-emoji {
    font-size: 64px;
    line-height: 1;
    filter: drop-shadow(0 4px 12px rgba(255, 20, 147, 0.25));
    animation: faq-float 3s ease-in-out infinite;
  }
  @keyframes faq-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .faq-hero-title {
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text);
    margin: 0;
  }
  .faq-hero-sub {
    font-size: 16px;
    color: var(--text2);
    line-height: 1.6;
    max-width: 580px;
    margin: 0;
  }
  /* ==============================================================
     FAQ SECTION
     ============================================================== */
  .faq-section {
    padding: 16px 0 64px;
  }
  .faq-category {
    margin-bottom: 48px;
    scroll-margin-top: 120px;
  }
  .faq-category-title {
    font-family: var(--font-display);
    font-size: 28px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--glass-border);
  }
  .faq-category-emoji { font-size: 24px; line-height: 1; }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .faq-empty {
    text-align: center;
    padding: 64px 0;
    color: var(--text3);
    font-size: 15px;
  }

  /* ==============================================================
     FAQ ITEM – <details>/<summary> Accordion
     ============================================================== */
  .faq-item {
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .faq-item[open] {
    border-color: var(--pink);
    box-shadow: 0 4px 24px var(--pink-glow);
  }
  .faq-question {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background 0.3s;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question:hover { background: var(--surface-hover); }
  .faq-num {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: 1px;
    color: var(--text3);
    width: 36px;
    flex-shrink: 0;
  }
  .faq-q-text {
    flex: 1;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.5;
  }
  .faq-toggle {
    font-size: 22px;
    font-weight: 300;
    color: var(--pink);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--glass);
    flex-shrink: 0;
    transition: transform 0.3s var(--ease);
  }
  .faq-item[open] .faq-toggle { transform: rotate(45deg); }
  .faq-answer {
    padding: 0 24px 24px 74px;
  }
  .faq-answer p {
    font-size: 14px;
    color: var(--text2);
    line-height: 1.8;
    margin: 0;
  }

  /* ==============================================================
     WEITERE LINKS
     ============================================================== */
  .faq-links-section {
    padding: 0 0 80px;
  }
  .faq-links {
    text-align: center;
  }
  .faq-links-title {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 24px;
  }
  .faq-links-grid {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .faq-link-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 28px 32px;
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: all 0.3s var(--ease);
    min-width: 200px;
  }
  .faq-link-card:hover {
    border-color: var(--pink);
    box-shadow: 0 4px 24px var(--pink-glow);
    transform: translateY(-4px);
  }
  .faq-link-emoji { font-size: 36px; line-height: 1; }
  .faq-link-text {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
  }
  .faq-link-desc {
    font-size: 13px;
    color: var(--text2);
    line-height: 1.4;
  }

  /* ==============================================================
     RESPONSIVE
     ============================================================== */
  @media (max-width: 768px) {
    .faq-hero { padding: 48px 0 32px; }
    .faq-hero-title { font-size: 36px; }
    .faq-hero-emoji { font-size: 48px; }
    .faq-section { padding: 16px 0 48px; }
    .faq-category-title { font-size: 22px; }
    .faq-question { padding: 16px 18px; gap: 10px; }
    .faq-num { width: 28px; font-size: 16px; }
    .faq-q-text { font-size: 14px; }
    .faq-answer { padding: 0 18px 18px 56px; }
    .faq-answer p { font-size: 13px; }
    .faq-links-section { padding: 0 0 64px; }
  }
  @media (max-width: 480px) {
    .faq-num { display: none; }
    .faq-answer { padding: 0 18px 18px 18px; }
  }
</style>

<script is:inline>
(function() {
  // Accordion: close others when opening a new question
  const details = document.querySelectorAll('.faq-item');
  details.forEach((item) => {
    item.addEventListener('toggle', function() {
      if (this.open) {
        details.forEach((other) => {
          if (other !== this && other.open) {
            other.removeAttribute('open');
          }
        });
        setTimeout(() => {
          this.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 100);
      }
    });
  });

})();
</script>
