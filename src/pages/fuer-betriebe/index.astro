---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
---

<BaseLayout
  title="Für Betriebe"
  description="tiroltourismus.com für Betriebe: Jetzt eintragen und sichtbar werden. Basis kostenlos, Premium gegen Gebühr. Werden Sie Teil des größten Tirol-Portals."
>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Für Betriebe' }]} />
    </div>

    <Hero
      title="Für Betriebe"
      subtitle="Werden Sie Teil des größten Tirol-Portals. Basis kostenlos – Prominenz gegen Gebühr."
      emoji="🏢"
      size="md"
    >
      <div slot="actions" class="hero-actions">
        <a href="/fuer-betriebe/registrierung/" class="btn btn-pink">Jetzt eintragen →</a>
        <span class="hero-urgency">🚀 Kostenlos starten</span>
      </div>
    </Hero>

    <!-- How it works -->
    <section class="section">
      <div class="container" style="max-width:800px">
        <SectionHeader
          label="So einfach geht's"
          title="So funktioniert's"
          sub="In drei Schritten zu mehr Sichtbarkeit und Buchungen."
        />

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:48px">
          <div class="card" style="padding:32px 24px;text-align:center">
            <div style="font-size:36px;margin-bottom:12px">📝</div>
            <h3 style="font-family:var(--font-display);font-size:20px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px">Eintragen</h3>
            <p style="font-size:13px;color:var(--text2)">Kostenloser Basiseintrag mit allen wichtigen Infos zu Ihrem Betrieb. Adresse, Kontakt, Beschreibung – in wenigen Minuten erledigt.</p>
          </div>
          <div class="card" style="padding:32px 24px;text-align:center">
            <div style="font-size:36px;margin-bottom:12px">📈</div>
            <h3 style="font-family:var(--font-display);font-size:20px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px">Sichtbar werden</h3>
            <p style="font-size:13px;color:var(--text2)">Mit Silver oder Gold erscheinen Sie prominent – vor Gratis-Einträgen, mit eigenem Badge und auf der Startseite.</p>
          </div>
          <div class="card" style="padding:32px 24px;text-align:center">
            <div style="font-size:36px;margin-bottom:12px">📊</div>
            <h3 style="font-family:var(--font-display);font-size:20px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px">Profitieren</h3>
            <p style="font-size:13px;color:var(--text2)">Mehr Buchungen, mehr Sichtbarkeit, mehr Gäste aus aller Welt. Starten Sie noch heute!</p>
          </div>
        </div>

        <!-- Pricing -->
        <SectionHeader
          label="Für jedes Budget"
          title="Unsere Packages"
          sub="Basic ist und bleibt kostenlos. Für mehr Sichtbarkeit upgraden Sie flexibel."
        />

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:48px" id="pricing">
          <!-- Basic -->
          <div class="card" style="padding:32px 24px;text-align:center;border:2px solid var(--glass-border)">
            <h3 style="font-family:var(--font-display);font-size:28px;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px">Basic</h3>
            <div style="font-size:36px;font-weight:800;color:var(--green);margin-bottom:16px">Kostenlos</div>
            <ul style="list-style:none;padding:0;margin-bottom:24px;font-size:13px;color:var(--text2);line-height:2.2">
              <li>✅ Basiseintrag</li>
              <li>✅ Adresse & Kontakt</li>
              <li>✅ Beschreibung</li>
              <li>✅ Öffnungszeiten</li>
              <li>❌ Featured-Badge</li>
              <li>❌ Höhere Platzierung</li>
              <li>❌ Bilder-Galerie</li>
            </ul>
            <span style="font-size:12px;color:var(--text3)">Jederzeit aufwertbar</span>
          </div>

          <!-- Silver -->
          <div class="card" style="padding:32px 24px;text-align:center;border:2px solid var(--pink);position:relative">
            <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--pink);color:#fff;padding:4px 20px;border-radius:100px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px">Beliebt</div>
            <h3 style="font-family:var(--font-display);font-size:28px;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px">Silver</h3>
            <div style="font-size:36px;font-weight:800;color:var(--pink);margin-bottom:16px">Ab 19€<span style="font-size:14px;font-weight:400;color:var(--text2)">/Monat</span></div>
            <ul style="list-style:none;padding:0;margin-bottom:24px;font-size:13px;color:var(--text2);line-height:2.2">
              <li>✅ Alles aus Basic</li>
              <li>✅ Silver-Badge</li>
              <li>✅ Bilder-Galerie (bis 10)</li>
              <li>✅ Vor Basic gelistet</li>
              <li>✅ Social-Media-Links</li>
              <li>❌ Top-Platzierung</li>
              <li>❌ Featured auf Startseite</li>
            </ul>
            <a href="/preise/" class="btn btn-pink" style="width:100%">Jetzt starten →</a>
          </div>

          <!-- Gold -->
          <div class="card" style="padding:32px 24px;text-align:center;border:2px solid var(--yellow)">
            <h3 style="font-family:var(--font-display);font-size:28px;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px">Gold</h3>
            <div style="font-size:36px;font-weight:800;color:var(--yellow);margin-bottom:16px">Ab 49€<span style="font-size:14px;font-weight:400;color:var(--text2)">/Monat</span></div>
            <ul style="list-style:none;padding:0;margin-bottom:24px;font-size:13px;color:var(--text2);line-height:2.2">
              <li>✅ Alles aus Silver</li>
              <li>✅ ⭐ Gold-Badge</li>
              <li>✅ Top-Platzierung</li>
              <li>✅ Featured auf Startseite</li>
              <li>✅ Bilder-Galerie (unbegrenzt)</li>
              <li>✅ Eigener Agent für Updates</li>
              <li>✅ Exklusiver Partner-Status</li>
            </ul>
            <a href="/preise/" class="btn btn-pink" style="width:100%">Jetzt starten →</a>
          </div>
        </div>

        <!-- Hinweis -->
        <div style="text-align:center">
          <p style="font-size:14px;color:var(--text2);margin-bottom:16px">✅ Sichere Zahlungsabwicklung über LemonSqueezy. Monatlich kündbar – jederzeit.</p>
          <a href="/kontakt/" class="btn btn-outline">Kontakt aufnehmen</a>
        </div>
      </div>
    </section>

    <!-- Business model explanation -->
    <section class="section" style="background:var(--bg2);border-top:1px solid var(--glass-border);border-bottom:1px solid var(--glass-border)">
      <div class="container" style="max-width:800px">
        <SectionHeader
          label="Unser Modell"
          title="Free-Mium für Tirol"
          sub="Kostenlos für alle – Premium für mehr. So bleibt das Portal offen und finanziert sich fair."
        />

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-bottom:48px">
          <div style="background:var(--bg1);border:1px solid var(--glass-border);border-radius:var(--radius);padding:32px">
            <div style="font-size:28px;margin-bottom:12px">🆓</div>
            <h3 style="font-family:var(--font-display);font-size:18px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;color:var(--green)">Free – für alle</h3>
            <p style="font-size:13px;color:var(--text2);line-height:1.8">
              Jeder Betrieb in Tirol kann sich <strong>kostenlos</strong> eintragen. Der Basiseintrag enthält alle wichtigen Informationen: Adresse, Kontakt, Beschreibung und Öffnungszeiten. So stellen wir sicher, dass unser Portal das <strong>vollständigste Tirol-Verzeichnis</strong> bleibt – für Gäste und Einheimische gleichermaßen.
            </p>
          </div>
          <div style="background:var(--bg1);border:1px solid var(--glass-border);border-radius:var(--radius);padding:32px">
            <div style="font-size:28px;margin-bottom:12px">⭐</div>
            <h3 style="font-family:var(--font-display);font-size:18px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;color:var(--pink)">Premium – für mehr</h3>
            <p style="font-size:13px;color:var(--text2);line-height:1.8">
              Betriebe, die <strong>mehr Sichtbarkeit</strong> wünschen, können auf Silver oder Gold upgraden. Gegen eine faire monatliche Gebühr erhalten Sie einen <strong>hervorgehobenen Eintrag</strong>, Badges, bessere Platzierungen und exklusive Features. So finanzieren wir den Betrieb des Portals und halten es gleichzeitig für alle offen.
            </p>
          </div>
        </div>

        <div style="background:var(--bg1);border:1px solid var(--glass-border);border-radius:var(--radius);padding:32px;text-align:center">
          <div style="font-size:32px;margin-bottom:12px">🤖</div>
          <h3 style="font-family:var(--font-display);font-size:18px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px">KI-gestützte Kuratierung</h3>
          <p style="font-size:13px;color:var(--text2);line-height:1.8;max-width:600px;margin:0 auto">
            Unsere KI-Agenten sammeln und aktualisieren Inhalte in Echtzeit – von Öffnungszeiten über Events bis zu Bewertungen. Premium-Betriebe profitieren von einem <strong>persönlichen KI-Agenten</strong>, der ihren Eintrag stets aktuell hält und Optimierungsvorschläge liefert. Menschen entscheiden, KI liefert.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         FAQ — Häufige Fragen & Einwände
         ═══════════════════════════════════════════════════════ -->
    <section class="section faq-section">
      <div class="container" style="max-width:720px">
        <SectionHeader
          label="Häufige Fragen"
          title="Was Betriebe fragen"
          sub="Ehrliche Antworten auf die häufigsten Bedenken – kein Kleingedrucktes."
        />

        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
              <span>🤔</span>
              Ist der Basiseintrag wirklich kostenlos?
              <span class="faq-arrow">▼</span>
            </button>
            <div class="faq-answer">
              <p><strong>Ja, für immer.</strong> Der Basiseintrag ist und bleibt kostenlos – ohne Haken, ohne versteckte Kosten, ohne Kartenzahlung. Sie brauchen nur Ihren Betrieb anzumelden, und schon sind Sie im größten Tirol-Portal sichtbar. Premium-Upgrades sind optional und werden erst gebucht, wenn Sie mehr Sichtbarkeit wünschen.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
              <span>📊</span>
              Lohnt sich das wirklich? Haben Sie überhaupt Besucher?
              <span class="faq-arrow">▼</span>
            </button>
            <div class="faq-answer">
              <p>Absolut. Unser Portal wächst täglich – mit <strong>Regionen, Unterkünften, Events und Magazin-Content</strong>, der bei Google gefunden wird. Jeder Eintrag profitiert von unserer <strong>KI-gestützten Suchmaschinenoptimierung</strong> und wird auf tiroltourismus.com sowie über Social-Media-Kanäle ausgespielt. Ein Eintrag kostet Sie nichts – das Risiko ist null, der potenzielle Gewinn enorm.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
              <span>🌐</span>
              Ich bin schon auf Google & Booking.com – wozu noch ein Portal?
              <span class="faq-arrow">▼</span>
            </button>
            <div class="faq-answer">
              <p>Gute Frage. Die Antwort: <strong>Sichtbarkeit in der Nische.</strong> Google listet alles – wir listen nur Tirol. Wer auf tiroltourismus.com sucht, hat bereits eine <strong>konkrete Reiseabsicht für Tirol</strong>. Das ist keine Streuwerbung, sondern direktes, qualifiziertes Publikum. Außerdem: Auf den großen Plattformen zahlen Sie pro Buchung satte Provisionen – bei uns nicht. Und mit Premium sind Sie <strong>vor allen Gratis-Einträgen platziert</strong>, ohne ständig Gebote abgeben zu müssen.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
              <span>🔄</span>
              Kann ich Premium jederzeit kündigen?
              <span class="faq-arrow">▼</span>
            </button>
            <div class="faq-answer">
              <p><strong>Ja, monatlich kündbar.</strong> Keine Mindestlaufzeit, keine versteckten Kündigungsfristen. Sie können Silver oder Gold jederzeit zum Monatsende beenden und fallen automatisch zurück in den kostenlosen Basiseintrag. Wir wollen, dass Sie nur dann zahlen, wenn Sie den Mehrwert auch tatsächlich spüren.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
              <span>⏰</span>
              Ich habe keine Zeit für noch eine Plattform. Wer pflegt meinen Eintrag?
              <span class="faq-arrow">▼</span>
            </button>
            <div class="faq-answer">
              <p>Verständlich – und genau dafür sind unsere <strong>KI-Agenten</strong> da. Sie übernehmen die Pflege Ihres Eintrags automatisch: Öffnungszeiten, Events, Bewertungen – alles wird in Echtzeit aktualisiert. Als Premium-Betrieb erhalten Sie sogar einen <strong>persönlichen KI-Assistenten</strong>, der Optimierungsvorschläge liefert. Sie müssen sich um nichts kümmern, außer einmal anzumelden. Menschen entscheiden, <strong>KI liefert</strong>.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
              <span>🏔️</span>
              Wer steckt hinter tiroltourismus.com?
              <span class="faq-arrow">▼</span>
            </button>
            <div class="faq-answer">
              <p>Ein kleines, leidenschaftliches Team mit Sitz in <strong>Innsbruck, Tirol</strong>. Wir haben dieses Portal gestartet, weil wir fanden, dass Tirol ein Portal verdient, das so bunt, ehrlich und anders ist wie das Land selbst. Unsere Mission: das <strong>vollständigste Tirol-Verzeichnis</strong> aufzubauen – kuratiert von Menschen, betrieben von KI, für alle zugänglich. Transparenz und Fairness sind unsere Grundwerte.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section">
      <div class="container" style="text-align:center;padding:48px 0">
        <div style="font-size:48px;margin-bottom:16px">🚀</div>
        <h2 style="font-family:var(--font-display);font-size:clamp(28px,4vw,48px);line-height:1;letter-spacing:1px;text-transform:uppercase;margin-bottom:16px">
          Bereit, durchzustarten?
        </h2>
        <p style="font-size:14px;color:var(--text2);max-width:480px;margin:0 auto 24px;line-height:1.6">
          Registrieren Sie Ihren Betrieb kostenlos oder upgrade direkt auf Silver oder Gold. Wir helfen Ihnen bei jedem Schritt.
        </p>
        <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
          <a href="/fuer-betriebe/registrierung/" class="btn btn-pink">Jetzt eintragen</a>
          <a href="/kontakt/" class="btn btn-outline">Beratung anfragen</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .section{padding:64px 0}
  .container{max-width:1200px;margin:0 auto;padding:0 24px}
  .card{background:var(--bg2);border:1px solid var(--glass-border);border-radius:var(--radius);overflow:hidden;transition:all .4s var(--ease)}
  .card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,.08)}

  /* ═══ FAQ ACCORDION ═══ */
  .faq-section {
    background: var(--bg);
    border-bottom: 1px solid var(--glass-border);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .faq-item {
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .faq-item:hover {
    border-color: var(--pink);
    box-shadow: 0 4px 16px rgba(255, 20, 147, 0.06);
  }
  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    text-align: left;
    letter-spacing: 0.3px;
    transition: background 0.3s;
    line-height: 1.4;
  }
  .faq-question span:first-child {
    font-size: 20px;
    flex-shrink: 0;
  }
  .faq-arrow {
    margin-left: auto;
    flex-shrink: 0;
    font-size: 10px;
    color: var(--text3);
    transition: transform 0.3s var(--ease);
  }
  .faq-question.open .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s var(--ease), padding 0.4s var(--ease);
    padding: 0 24px;
  }
  .faq-answer.open {
    max-height: 300px;
    padding: 0 24px 20px;
  }
  .faq-answer p {
    font-size: 13px;
    color: var(--text2);
    line-height: 1.8;
    margin: 0;
  }
  .faq-answer strong {
    color: var(--text);
  }
  .faq-item:first-child .faq-question span:first-child {
    font-size: 20px;
  }

  @media(max-width:768px){
    .section{padding:48px 0}
    [style*="grid-template-columns:repeat(3,1fr)"]{grid-template-columns:1fr!important}
    [style*="grid-template-columns:1fr 1fr"]{grid-template-columns:1fr!important}
    .faq-question {
      padding: 14px 18px;
      font-size: 13px;
    }
    .faq-answer.open {
      padding: 0 18px 16px;
    }
  }
</style>
