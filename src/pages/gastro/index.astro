---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import GastroCard from '../../components/GastroCard.astro';
import SectionMap from '../../sections/SectionMap.astro';
import FilterBar from '../../components/FilterBar.astro';
import { readCollection, isPublished } from '../../lib/content.js';

const gastro = readCollection('gastro').filter((g) => isPublished(g.entry));
const gastroMitCoords = gastro.filter((g) => g.entry.koordinaten?.lat && g.entry.koordinaten?.lng);

const kategorieLabel = {
  almwirtschaft: '🥨 Almwirtschaft',
  bar: '🍸 Bar',
  cafe: '☕ Café',
  eiscafe: '🍦 Eiscafé',
  eissalon: '🍦 Eissalon',
  imbiss: '🌭 Imbiss',
  international: '🌍 International',
  pizzeria: '🍕 Pizzeria',
  pub: '🍺 Pub',
  regional: '🫕 Regional',
  restaurant: '🍽️ Restaurant',
  tirolerisch: '🥘 Tirolerisch',
};

const kategorien = [...new Set(gastro.map((g) => g.entry.kategorie).filter(Boolean))].sort((a, b) => (kategorieLabel[a] || a).localeCompare(kategorieLabel[b] || b, 'de'));
---

<BaseLayout
  title="Gastro in Tirol"
  description="Entdecke die kulinarische Vielfalt Tirols – von urigen Hütten bis zu Sternerestaurants."
>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Gastro' }]} />
    </div>

    <Hero
      title="Gastro"
      subtitle="Entdecke die kulinarische Vielfalt Tirols."
      emoji="🍽️"
      size="md"
    >
      <div slot="actions" class="hero-actions">
        <a href="#gastro-grid" class="btn btn-pink">Gastro entdecken →</a>
        <span class="hero-urgency">⭐ {gastro.length} Genussorte</span>
      </div>
    </Hero>

    {gastroMitCoords.length > 0 && (
      <SectionMap
        markers={gastroMitCoords.map((g) => ({
          lat: g.entry.koordinaten.lat,
          lng: g.entry.koordinaten.lng,
          label: g.entry.name,
          emoji: g.entry.emoji || '🍽️',
          href: '/gastro/' + g.slug + '/',
          category: 'gastro',
        }))}
        label={gastroMitCoords.length + ' Genussorte'}
        title="Auf einen Blick"
        height="380px"
        scrollWheelZoom={true}
        filterable={true}
      />
    )}

    {gastro.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHeader
            label="Tirol genießen"
            title="Gastro in Tirol"
            sub="Von urigen Hütten über traditionelle Gasthäuser bis zu moderner Haubenküche – Tirol verwöhnt deinen Gaumen."
          />

          {kategorien.length > 1 && (
            <FilterBar
              keyName="cat"
              ariaLabel="Gastro nach Kategorie filtern"
              options={kategorien.map((k) => ({ value: k, label: kategorieLabel[k] || k }))}
            />
          )}

          <div class="gastro-grid" id="gastro-grid">
            {gastro.map((g) => (
              <GastroCard
                name={g.entry.name}
                slug={g.slug}
                beschreibung={g.entry.kurzbeschreibung}
                kategorie={g.entry.kategorie}
                preis={g.entry.preis}
                emoji={g.entry.emoji}
                farbe={g.entry.farbe}
                ort={g.entry.ort}
              />
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">🍽️</div>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase">
            Bald verfügbar
          </h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">
            Gastro-Einträge werden aktuell eingepflegt. Schau bald wieder vorbei!
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

</style>
