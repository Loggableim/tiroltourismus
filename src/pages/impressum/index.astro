---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
---

<BaseLayout
  title="Impressum"
  description="Impressum – Offenlegung, Kontakt und rechtliche Hinweise zu tiroltourismus.com."
>
  <main>
    <!-- ============================================================
         BREADCRUMBS
         ============================================================ -->
    <div class="container">
      <Breadcrumbs items={[{ label: 'Impressum' }]} />
    </div>

    <!-- ============================================================
         HEADER
         ============================================================ -->
    <section class="impressum-header">
      <div class="container">
        <SectionHeader
          title="Impressum"
          sub="Angaben gemäß § 5 ECG & Offenlegung gem. § 25 Mediengesetz"
        />
      </div>
    </section>

    <!-- ============================================================
         LEGAL CONTENT
         ============================================================ -->
    <section class="impressum-content">
      <div class="container">
        <div class="impressum-inner">
          <!-- Medieninhaber -->
          <div class="legal-section">
            <h2 class="legal-heading">Medieninhaber &amp; Betreiber</h2>
            <div class="legal-body">
              <p>
                <strong>tiroltourismus.com</strong><br />
                c/o AlpenPop Media GmbH<br />
                Maria-Theresien-Straße 18<br />
                6020 Innsbruck<br />
                Österreich
              </p>
              <p>
                <strong>Firmenbuch:</strong> FN 612345 a<br />
                <strong>Firmenbuchgericht:</strong> Landesgericht Innsbruck<br />
                <strong>UID-Nummer:</strong> ATU 7654321<br />
                <strong>DVR:</strong> 0987654
              </p>
              <p>
                <strong>Geschäftsführer:</strong> Max Mustermann<br />
                <strong>Fachgruppe:</strong> Werbung &amp; Marktkommunikation<br />
                <strong>Behördliche Aufsicht:</strong> Magistrat Innsbruck<br />
                <strong>Anwendbare Rechtsvorschriften:</strong> Gewerbeordnung 1994 (abrufbar unter
                <a href="https://www.ris.bka.gv.at" target="_blank" rel="noopener noreferrer">ris.bka.gv.at</a>)
              </p>
            </div>
          </div>

          <!-- Kontakt -->
          <div class="legal-section">
            <h2 class="legal-heading">Kontakt</h2>
            <div class="legal-body">
              <p>
                <strong>E-Mail:</strong> <a href="mailto:office@tiroltourismus.com">office@tiroltourismus.com</a><br />
                <strong>Telefon:</strong> <a href="tel:+43512345678">+43 512 345678</a><br />
                <strong>Web:</strong> <a href="https://www.tiroltourismus.com" target="_blank" rel="noopener noreferrer">www.tiroltourismus.com</a>
              </p>
            </div>
          </div>

          <!-- Haftungsausschluss -->
