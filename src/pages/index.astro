<!-- ═══ ENTDECKEN-TABS LOGIC ═══ -->
<script is:inline>
(function() {
  'use strict';
  function setupCatTabs() {
    const tabs = document.querySelectorAll('.cat-tab');
    const panels = document.querySelectorAll('.cat-panel');
    if (!tabs.length || !panels.length) return;

    function activate(cat) {
      tabs.forEach(t => {
        const match = t.dataset.cat === cat;
        t.setAttribute('aria-selected', match ? 'true' : 'false');
        t.classList.toggle('is-active', match);
      });
      panels.forEach(p => {
        const match = p.dataset.panel === cat;
        p.hidden = !match;
        p.classList.toggle('is-active', match);
      });
      // Persist last selection in sessionStorage
      try { sessionStorage.setItem('cat-tab', cat); } catch(e) {}
    }

    tabs.forEach(t => {
      t.addEventListener('click', () => activate(t.dataset.cat));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const arr = Array.from(tabs);
        const idx = arr.indexOf(t);
        const next = e.key === 'ArrowRight' ? arr[(idx + 1) % arr.length] : arr[(idx - 1 + arr.length) % arr.length];
        next.focus();
        activate(next.dataset.cat);
      });
    });

    // Restore last selected tab, default to "sights"
    let saved = 'sights';
    try { saved = sessionStorage.getItem('cat-tab') || 'sights'; } catch(e) {}
    if (![...tabs].some(t => t.dataset.cat === saved)) saved = 'sights';
    activate(saved);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCatTabs);
  } else {
    setupCatTabs();
  }
})();
</script>

<!-- ═══ STATS COUNTER ANIMATION ═══ -->
<script is:inline>
(function() {
  'use strict';
  function animateCount(el, target, duration) {
    const start = performance.now();
    const isLarge = target > 999;
    function step(now) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(eased * target);
      el.textContent = isLarge && target >= 1000
        ? current.toLocaleString('de-DE')
        : current;
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  function startCounters() {
    const els = document.querySelectorAll('.stat-num[data-count]');
    els.forEach(el => {
      const target = parseInt(el.dataset.count, 10);
      if (isNaN(target) || target <= 0) {
        el.textContent = target || '0';
        return;
      }
      const delay = parseInt(el.closest('.stat-card')?.className?.match(/r(\d)/)?.[1] || '1') * 120;
      setTimeout(() => animateCount(el, target, 1200), delay);
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startCounters);
  } else {
    startCounters();
  }
})();
</script>
