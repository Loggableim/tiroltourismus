---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import RegionCard from '../components/RegionCard.astro';
import AccommodationCard from '../components/AccommodationCard.astro';
import CampingCard from '../components/CampingCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import GastroCard from '../components/GastroCard.astro';
import SightCard from '../components/SightCard.astro';
import SectionMap from '../sections/SectionMap.astro';
import { readCollection, isPublished } from '../lib/content.js';
import page from '../data/homepage.json';

// ── Read ALL real collection data ──
const regionen = readCollection('regionen').filter(r => isPublished(r.entry));
const unterkuenfte = readCollection('unterkuenfte').filter(u => isPublished(u.entry));
const alleGastro = readCollection('gastro').filter(g => isPublished(g.entry));
const alleOrte = readCollection('orte').filter(o => isPublished(o.entry));
const alleSights = readCollection('sehenswuerdigkeiten').filter(s => isPublished(s.entry));
const alleMagazin = readCollection('magazin').filter(a => isPublished(a.entry));
const camping = readCollection('camping').filter(c => isPublished(c.entry));
const top3Camping = [...camping].sort((a, b) => {
  const order = { gold: 0, silver: 1, basic: 2 };
  return (order[a.entry.tier||'basic']||2) - (order[b.entry.tier||'basic']||2);
}).slice(0, 3);

// ── Tirol-Übersichts-Karte: Marker aus allen Collections ──
const mapMarkers = [
  ...unterkuenfte.filter(e => e.entry.koordinaten?.lat && e.entry.koordinaten?.lng).map(e => ({
    lat: e.entry.koordinaten.lat, lng: e.entry.koordinaten.lng,
    label: e.entry.name || e.entry.titel || 'Unterkunft',
    href: `/unterkuenfte/${e.slug}/`,
    emoji: e.entry.emoji || '🏨', category: 'unterkuenfte',
  })),
  ...alleGastro.filter(e => e.entry.koordinaten?.lat && e.entry.koordinaten?.lng).map(e => ({
    lat: e.entry.koordinaten.lat, lng: e.entry.koordinaten.lng,
    label: e.entry.name || e.entry.titel || 'Gastro',
    href: `/gastro/${e.slug}/`,
    emoji: e.entry.emoji || '🍽️', category: 'gastro',
  })),
  ...alleOrte.filter(e => e.entry.koordinaten?.lat && e.entry.koordinaten?.lng).map(e => ({
    lat: e.entry.koordinaten.lat, lng: e.entry.koordinaten.lng,
    label: e.entry.name || e.entry.titel || 'Ort',
    href: `/orte/${e.slug}/`,
    emoji: e.entry.emoji || '🏘️', category: 'orte',
  })),
  ...alleSights.filter(e => e.entry.koordinaten?.lat && e.entry.koordinaten?.lng).map(e => ({
    lat: e.entry.koordinaten.lat, lng: e.entry.koordinaten.lng,
    label: e.entry.name || e.entry.titel || 'Sehenswürdigkeit',
    href: `/sehenswuerdigkeiten/${e.slug}/`,
    emoji: e.entry.emoji || '🏛️', category: 'sehenswuerdigkeiten',
  })),
  ...camping.filter(e => e.entry.koordinaten?.lat && e.entry.koordinaten?.lng).map(e => ({
    lat: e.entry.koordinaten.lat, lng: e.entry.koordinaten.lng,
    label: e.entry.name || e.entry.titel || 'Camping',
    href: `/camping/${e.slug}/`,
    emoji: e.entry.emoji || '🏕️', category: 'camping',
  })),
  ...alleMagazin.filter(e => e.entry.koordinaten?.lat && e.entry.koordinaten?.lng).map(e => ({
    lat: e.entry.koordinaten.lat, lng: e.entry.koordinaten.lng,
    label: e.entry.titel || e.entry.name || 'Magazin',
    href: `/magazin/${e.slug}/`,
    emoji: e.entry.emoji || '📰', category: 'magazin',
  })),
].slice(0, 250);

// ── Sort accommodations: gold first, then silver, then basic ──
const sortedUnterkuenfte = [...unterkuenfte].sort((a, b) => {
  const order = { gold: 0, silver: 1, basic: 2 };
  return (order[a.entry.tier||'basic']||2) - (order[b.entry.tier||'basic']||2);
});
const top3Unterkuenfte = sortedUnterkuenfte.slice(0, 3);

// ── Pick 3 random gastro ──
const shuffledGastro = [...alleGastro].sort(() => Math.random() - 0.5).slice(0, 3);

// ── Top sights: up to 4 (featured first, then shuffled) ──
const featuredSights = alleSights.filter(s => s.entry.featured);
const otherSights = alleSights.filter(s => !s.entry.featured);
const sortedSights = [...featuredSights, ...otherSights.sort(() => Math.random() - 0.5)].slice(0, 4);

// ── Magazine sorted by date (newest first) ──
const sortedMagazin = [...alleMagazin].sort((a, b) => {
  if (!a.entry.datum) return 1; if (!b.entry.datum) return -1;
  return new Date(b.entry.datum) - new Date(a.entry.datum);
});
const top3Magazin = sortedMagazin.slice(0, 3);

// ── Build embedded JSON for client-side randomization ──
const allForRandom = {
  unterkuenfte: sortedUnterkuenfte.slice(0, 6).map(u => ({ ...u.entry, slug: u.slug, _type: 'unterkunft' })),
  gastro: alleGastro.slice(0, 6).map(g => ({ ...g.entry, slug: g.slug, _type: 'gastro' })),
  orte: alleOrte.map(o => ({ ...o.entry, slug: o.slug, _type: 'ort' })),
  sights: alleSights.slice(0, 6).map(s => ({ ...s.entry, slug: s.slug, _type: 'sight' })),
  magazin: sortedMagazin.slice(0, 6).map(a => ({ ...a.entry, slug: a.slug, _type: 'magazin' })),
};
const allItemsFlat = Object.values(allForRandom).flat();

// ── Seeded shuffle for daily SSR picks ──
const today = new Date().toDateString();
let seed = today.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
function seededShuffle(arr) {
  const a = [...arr];
  let s = seed;
  for (let i = a.length - 1; i > 0; i--) {
    s = (s * 16807) % 2147483647;
    const j = s % (i + 1);
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
const dailyPicks = seededShuffle(allItemsFlat).slice(0, 4);
const dailyPickTypes = { unterkunft: 'Unterkunft', gastro: 'Gastro', ort: 'Ort', sight: 'Sehenswürdigkeit', magazin: 'Magazin' };
const dailyPickLinks = { unterkunft: '/unterkuenfte/', gastro: '/gastro/', ort: '/orte/', sight: '/sehenswuerdigkeiten/', magazin: '/magazin/' };

// ── Helper: format datum for display ──
function formatDate(d) {
  if (!d) return '';
  try { return new Date(d).toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' }); }
  catch { return d; }
}
---
<BaseLayout title="tiroltourismus.com – Das offizielle Tourismusportal" description="Das offizielle Tourismusportal für Tirol. Berge, Täler, Genuss – entdecken Sie die Vielfalt der Alpen.">
  <main>
    <!-- ═══ HERO ═══ -->
    <section class="hero" aria-label="Hero">
      <div class="hero-bg">
        <div class="hero-gradient"></div>
        <svg class="hero-alps" viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
          <defs>
            <linearGradient id="alps-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgba(255,20,147,0.06)"/>
              <stop offset="40%" stop-color="rgba(50,30,80,0.12)"/>
              <stop offset="100%" stop-color="rgba(5,7,12,0)"/>
            </linearGradient>
          </defs>
          <path d="M0,400 L0,240 Q90,180 144,200 Q216,220 288,160 Q324,120 360,140 L432,80 Q468,40 504,60 L576,20 Q612,0 648,10 L720,40 Q756,50 792,30 L864,70 L936,100 Q972,110 1008,90 L1080,130 L1152,160 Q1188,170 1224,150 L1296,200 Q1332,220 1368,200 L1440,240 L1440,400 Z" fill="url(#alps-grad)" opacity="0.5"/>
          <path d="M0,400 L0,280 Q120,230 240,250 Q360,260 480,200 Q540,180 600,190 L720,120 Q756,90 792,100 L864,140 Q900,150 936,130 L1008,180 Q1044,200 1080,185 L1152,220 Q1188,240 1224,220 L1296,260 Q1332,280 1368,260 L1440,300 L1440,400 Z" fill="rgba(255,20,147,0.03)" opacity="0.4"/>
          <path d="M0,400 L0,320 Q144,280 288,300 Q432,310 576,260 Q648,240 720,250 L864,180 Q900,165 936,175 L1008,210 Q1044,230 1080,215 L1152,260 Q1188,280 1224,260 L1296,300 Q1332,320 1368,300 L1440,340 L1440,400 Z" fill="rgba(255,255,255,0.015)" opacity="0.3"/>
        </svg>
        <div class="hero-mesh"></div>
      </div>
      <div class="hero-glow"></div>
      <div class="hero-content">
        <!-- weather widget is rendered in footer via BaseLayout -->
        <div class="hero-badge" set:html={page.hero.badge}></div>
        <div class="hero-headline">
          <div class="hero-logo">
            <svg viewBox="12 6 325 38" width="120"><defs>
              <linearGradient id="hl1"><stop offset="0%" stop-color="#A00D24"/><stop offset="100%" stop-color="#C8102E"/></linearGradient>
              <linearGradient id="hl2"><stop offset="0%" stop-color="#C0006E"/><stop offset="100%" stop-color="#FF1493"/></linearGradient>
              <linearGradient id="hl3"><stop offset="0%" stop-color="#D4A800"/><stop offset="100%" stop-color="#FFD700"/></linearGradient>
              <linearGradient id="hl4"><stop offset="0%" stop-color="#C0006E"/><stop offset="100%" stop-color="#FF1493"/></linearGradient>
              <linearGradient id="hl5"><stop offset="0%" stop-color="#003A8A"/><stop offset="100%" stop-color="#0066FF"/></linearGradient>
            </defs>
            <text x="14" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#hl1)">T</text>
            <polygon points="14,36 14,10 36,36" fill="url(#hl1)" opacity="0.08"/>
            <text x="46" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#hl2)">I</text>
            <polygon points="46,36 46,14 60,36" fill="url(#hl2)" opacity="0.08"/>
            <text x="72" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#hl3)">R</text>
            <polygon points="72,36 72,8 96,36" fill="url(#hl3)" opacity="0.08"/>
            <text x="104" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#hl4)">O</text>
            <polygon points="104,36 104,10 130,36" fill="url(#hl4)" opacity="0.08"/>
            <text x="138" y="38" font-family="'Bebas Neue','Impact','Arial Narrow',sans-serif" font-size="36" font-weight="bold" fill="url(#hl5)">L</text>
            <polygon points="138,36 138,12 158,36" fill="url(#hl5)" opacity="0.08"/>
            <circle cx="178" cy="30" r="2.5" fill="rgba(255,255,255,0.12)" opacity="0.3"/>
            <text x="192" y="38" font-family="'Montserrat',sans-serif" font-size="28" font-weight="300" letter-spacing="0.8" fill="rgba(255,255,255,0.9)">tourismus</text>
          </svg>
          </div>
          <h1>{page.hero.title.map(line => <span class="line">{line}</span>)}</h1>
        </div>
        <p set:html={page.hero.subtitle}></p>
        <div class="hero-actions">
          <a href={page.hero.ctaPrimary.href} class={page.hero.ctaPrimary.class}>{page.hero.ctaPrimary.text}</a>
          <a href={page.hero.ctaSecondary.href} class={page.hero.ctaSecondary.class}>{page.hero.ctaSecondary.text}</a>
        </div>
      </div>
    </section>

    <!-- ═══ TIROL-KARTE ═══ -->
    <SectionMap
      markers={mapMarkers}
      label={`${mapMarkers.length} Orte entdecken`}
      title="Tirol entdecken"
      height="450px"
      scrollWheelZoom={true}
      filterable={true}
    />

    <!-- ═══ STATS ═══ -->
    <section class="stats" aria-label="Statistiken">
      <div class="container">
        <div class="stats-grid">
          {page.stats.map((s, i) => (
            <div class={`stat-card reveal r${i+1}`}>
              <span class="stat-icon">{s.icon}</span>
              <div class="stat-num" data-count={s.count}>0</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ WILLKOMMEN IN TIROL ═══ -->
    <section class="willkommen section" id="willkommen">
      <div class="container">
        <div class="willkommen-grid">
          <div class="willkommen-text">
            <div class="section-label" style="text-align:left">#willkommen</div>
            <h2 class="willkommen-title">Willkommen in <span>Tirol</span></h2>
            <p class="willkommen-p">Tirol ist weit mehr als nur eine Region – es ist ein Gefühl von Freiheit, Abenteuer und tiefer Verbundenheit mit der Natur. Sanfte Almwiesen und schroffe Felsgipfel wechseln sich ab wie die Jahreszeiten, uralte Tradition trifft auf moderne Gastfreundschaft, und in jedem Tal wartet eine neue Überraschung.</p>
            <p class="willkommen-p">Ob Sie durch die historischen Gassen Innsbrucks schlendern, auf dem Gipfel eines Dreitausenders den Panoramablick genießen oder in einer urigen Hütte Tiroler Schmankerl kosten – dieser Flecken Erde hat eine Seele, die man spüren kann. Lassen Sie sich von unserer Vielfalt überraschen.</p>
            <div class="willkommen-features">
              <div class="willkommen-feature"><span class="wf-icon">🏔️</span><span>788 Dreitausender</span></div>
              <div class="willkommen-feature"><span class="wf-icon">🥾</span><span>24.500 Wanderkilometer</span></div>
              <div class="willkommen-feature"><span class="wf-icon">🚡</span><span>580 Liftanlagen</span></div>
              <div class="willkommen-feature"><span class="wf-icon">🍽️</span><span>Tiroler Genussküche</span></div>
            </div>
          </div>
          <div class="willkommen-highlight">
            <div class="willkommen-highlight-box">
              <span class="wh-icon">💡</span>
              <h3>Wussten Sie?</h3>
              <p>In Tirol gibt es über <strong>60 verschiedene Jausenstationen und Almhütten</strong>, die nur zu Fuß oder mit der Seilbahn erreichbar sind. Jede davon serviert hausgemachten Kaiserschmarrn, Kaspressknödel und andere Tiroler Spezialitäten – mit einmaliger Bergkulisse garantiert.</p>
              <a href="/magazin/" class="btn btn-glass btn-sm">Mehr entdecken →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ HEUTE ENTDECKEN ═══ -->
    <section class="daily section" id="heute" aria-label="Heute entdecken">
      <div class="container">
        <SectionHeader label="#heute" title="Heute entdecken" sub="Zufallsfunde aus allen Kategorien – jeden Tag neu. Klick Dich durch Tirols bunteste Seiten." />
        <div class="daily-grid" id="dailyPicks">
          {dailyPicks.map((item, i) => {
            const name = item.name || item.titel || 'Unbekannt';
            const emoji = item.emoji || (item._type === 'unterkunft' ? '🏨' : item._type === 'gastro' ? '🍽️' : item._type === 'ort' ? '🏘️' : item._type === 'sight' ? '🏛️' : '📰');
            const typeLabel = dailyPickTypes[item._type] || 'Entdeckung';
            const linkBase = dailyPickLinks[item._type] || '/';
            return (
              <a href={`${linkBase}${item.slug}/`} class={`daily-card${i === 0 ? ' daily-featured' : ''}`}>
                <div class="daily-emoji-wrap">
                  <span class="daily-emoji">{emoji}</span>
                  {i === 0 && <span class="daily-star">✨</span>}
                </div>
                <div class="daily-body">
                  <span class="daily-type">{typeLabel}</span>
                  <span class="daily-name">{name}</span>
                  <span class="daily-cta">{i === 0 ? 'Zufallsfund des Tages →' : 'Entdecken →'}</span>
                </div>
              </a>
            );
          })}
        </div>
        <div class="section-footer">
          <a href="/orte/" class="btn-outline">Alle Orte &amp; Sehenswürdigkeiten entdecken →</a>
        </div>
      </div>
    </section>

    <!-- ═══ REGIONEN ═══ -->
    <section class="section" id="regionen" aria-label="Regionen">
      <div class="container">
        <SectionHeader label="#regionen" title="Unsere Regionen" sub="Ein Land, unendlich viele Gesichter. Jede Region Tirols hat ihren eigenen Charakter – von der urbanen Alpenstadt Innsbruck bis zu den unberührten Gletscherwelten des Kaunertals." />
        <p class="regionen-lead">Egal ob actionreiche Tage im Zillertal, kulinarische Genussmomente im Stubaital oder luxuriöse Auszeiten in Kitzbühel – hier finden Sie Ihre perfekte Region. Jede Destination in unserem Portal wurde kuratiert, bewertet und mit persönlichen Beschreibungen versehen.</p>
        <div class="section-grid">
          {regionen.map(r => (
            <RegionCard titel={r.entry.titel} slug={r.slug} beschreibung={r.entry.kurzbeschreibung} emoji={r.entry.emoji} bewertung={r.entry.bewertung} farbe={r.entry.farbe} featured={r.entry.featured} />
          ))}
        </div>
        <div class="section-footer">
          <a href="/regionen/" class="btn-outline">Alle Regionen entdecken →</a>
        </div>
      </div>
    </section>

    <!-- ═══ SEHENSWÜRDIGKEITEN ═══ -->
    <section class="section" id="sehenswuerdigkeiten" aria-label="Sehenswürdigkeiten">
      <div class="container">
        <SectionHeader label="#sehenswuerdigkeiten" title="Sehenswürdigkeiten" sub="Von historischen Kirchen über spektakuläre Berggipfel bis zu kulturellen Highlights – Tirols schönste Ausflugsziele." />
        {sortedSights.length > 0 ? (
          <>
            <div class="sight-grid">
              {sortedSights.map(s => (
                <SightCard name={s.entry.name} slug={s.slug} kurzbeschreibung={s.entry.kurzbeschreibung} kategorie={s.entry.kategorie} emoji={s.entry.emoji} farbe={s.entry.farbe} ort={s.entry.ort} preis={s.entry.preis} />
              ))}
            </div>
            <div class="section-footer">
              <a href="/sehenswuerdigkeiten/" class="btn-outline">Alle {alleSights.length} Sehenswürdigkeiten anzeigen →</a>
            </div>
          </>
        ) : (
          <p style="text-align:center;color:var(--text2);padding:40px 0">Aktuell sind keine Sehenswürdigkeiten in der Datenbank erfasst. Neue Einträge folgen in Kürze.</p>
        )}
      </div>
    </section>

    <!-- ═══ UNTERKÜNFTE ═══ -->
    <section class="section" id="unterkuenfte" aria-label="Unterkünfte">
      <div class="container">
        <SectionHeader label="#unterkuenfte" title="Top Unterkünfte" sub="Handverlesene Hotels, Ferienwohnungen und Bauernhöfe – für jeden Geschmack und jedes Budget." />
        <p class="section-lead">Unsere Redaktion testet und bewertet jede Unterkunft persönlich. Gold-gekennzeichnete Häuser bieten das besondere Extra mit Stil und erstklassigem Service. Silber steht für exzellentes Preis-Leistungs-Verhältnis, Basic für charmant und erschwinglich.</p>
        <div class="section-grid" id="unterkunftGrid">
          {top3Unterkuenfte.length > 0 ? top3Unterkuenfte.map(u => (
            <AccommodationCard name={u.entry.name} slug={u.slug} typ={u.entry.typ} ort={u.entry.ort} sterne={u.entry.sterne} preis_ab={u.entry.preis_ab} tier={u.entry.tier || 'basic'} />
          )) : <p style="text-align:center;color:var(--text2);grid-column:1/-1;padding:40px 0">Aktuell sind keine Unterkünfte erfasst.</p>}
        </div>
        <div class="section-footer">
          <a href="/unterkuenfte/" class="btn-outline">Alle {unterkuenfte.length} Unterkünfte anzeigen →</a>
        </div>
      </div>
    </section>

    <!-- ═══ CAMPING ═══ -->
    <section class="section" id="camping" aria-label="Campingplätze">
      <div class="container">
        <SectionHeader label="#camping" title="Campingplätze" sub="🏕️ Von Alpencamping bis Zeltplatz – übernachten inmitten der Tiroler Bergwelt." />
        <div class="section-grid" id="campingGrid">
          {top3Camping.length > 0 ? top3Camping.map(c => (
            <CampingCard name={c.entry.name} slug={c.slug} ort={c.entry.ort} ausstattung={c.entry.ausstattung} tier={c.entry.tier || 'basic'} />
          )) : <p style="text-align:center;color:var(--text2);grid-column:1/-1;padding:40px 0">Aktuell sind keine Campingplätze erfasst.</p>}
        </div>
        <div class="section-footer">
          <a href="/camping/" class="btn-outline">Alle {camping.length} Campingplätze anzeigen →</a>
        </div>
      </div>
    </section>

    <!-- ═══ GASTRO ═══ -->
    <section class="section" id="gastro" aria-label="Gastronomie">
      <div class="container">
        <SectionHeader label="#gastro" title="Essen & Trinken" sub="Von der urigen Almhütte bis zur gehobenen Küche – Tirols Gastronomie ist so vielfältig wie seine Landschaft." />
        {alleGastro.length > 0 ? (
          <>
            <div class="section-grid" id="gastroGrid">
              {shuffledGastro.map(g => (
                <GastroCard name={g.entry.name} slug={g.slug} beschreibung={g.entry.kurzbeschreibung} kategorie={g.entry.kategorie} preis={g.entry.preis} emoji={g.entry.emoji} farbe={g.entry.farbe} ort={g.entry.ort} />
              ))}
            </div>
            <div class="section-footer">
              <a href="/gastro/" class="btn-outline">Alle {alleGastro.length} Gastro-Adressen entdecken →</a>
            </div>
          </>
        ) : <p style="text-align:center;color:var(--text2);padding:40px 0">Aktuell sind keine Gastro-Einträge in der Datenbank erfasst.</p>}
      </div>
    </section>

    <!-- ═══ MAGAZIN ═══ -->
    <section class="section" id="magazin" aria-label="Magazin">
      <div class="container">
        <SectionHeader label="#magazin" title="Stories aus den Bergen" sub="Neueste Geschichten, Tipps & Inspirationen rund um Ihren nächsten Tirol-Urlaub." />
        {top3Magazin.length > 0 ? (
          <>
            <div class="section-grid" id="magazinGrid">
              {top3Magazin.map(a => (
                <ArticleCard titel={a.entry.titel} slug={a.slug} teaser={a.entry.teaser} datum={formatDate(a.entry.datum)} kategorie={a.entry.kategorie} hero_bild={a.entry.hero_bild} />
              ))}
            </div>
            <div class="section-footer">
              <a href="/magazin/" class="btn-outline">Alle Magazin-Beiträge lesen →</a>
            </div>
          </>
        ) : <p style="text-align:center;color:var(--text2);padding:40px 0">Aktuell sind keine Magazinbeiträge veröffentlicht.</p>}
      </div>
    </section>

    <!-- ═══ PARTNER ═══ -->
    <section class="partner section" aria-label="Partner">
      <div class="container">
