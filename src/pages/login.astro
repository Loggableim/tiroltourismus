---
// Login-Seite — E-Mail-Login, ruft POST /api/auth/login auf
import BaseLayout from '../layouts/BaseLayout.astro';
import { readSingleton } from '../lib/content.js';

const settings = readSingleton('einstellungen');
const siteDesc = 'Melde dich an oder erstelle ein Konto für deine Merkliste und Premium-Inhalte.';
---
<BaseLayout title="Anmelden — Tirol Tourismus" description={siteDesc}>
  <main class="login-page">
    <div class="login-card">
      <div class="login-header">
        <div class="login-icon">🔑</div>
        <h1>Anmelden</h1>
        <p class="login-sub">Mit E-Mail anmelden — deine Merkliste und Premium-Inhalte warten auf dich.</p>
      </div>

      <form id="loginForm" class="login-form">
        <div class="form-group">
          <label for="email">E-Mail-Adresse</label>
          <input type="email" id="email" name="email" required
            placeholder="deine@email.de"
            autocomplete="email" />
        </div>

        <button type="submit" class="btn btn-pink login-btn" id="loginBtn">
          <span id="btnText">Weiter →</span>
          <span id="btnSpinner" style="display:none">⏳</span>
        </button>
      </form>

      <div id="loginError" class="login-error" style="display:none"></div>
      <div id="loginSuccess" class="login-success" style="display:none">
        ✅ Erfolgreich angemeldet! <a href="/">Zur Startseite</a>
      </div>

      <div class="login-footer">
        <p>Deine Daten werden nur für die Merkliste und Premium-Zugriff verwendet.</p>
        <p><a href="/datenschutz/">Datenschutzerklärung</a></p>
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .login-page {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 20px 60px;
    background: var(--bg);
  }
  .login-card {
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 48px 40px;
    max-width: 440px;
    width: 100%;
    box-shadow: 0 8px 40px rgba(0,0,0,.06);
  }
  .login-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .login-icon {
    font-size: 48px;
    margin-bottom: 12px;
  }
  .login-header h1 {
    font-family: var(--font-display);
    font-size: 28px;
    margin: 0 0 8px;
    text-transform: uppercase;
    color: var(--text);
  }
  .login-sub {
    color: var(--text2);
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-group label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: .3px;
  }
  .form-group input {
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    outline: none;
    transition: border-color .3s, box-shadow .3s;
  }
  .form-group input:focus {
    border-color: var(--pink);
    box-shadow: 0 0 0 3px rgba(255,20,147,.15);
  }
  .login-btn {
    width: 100%;
    padding: 14px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 12px;
    cursor: pointer;
    border: none;
    margin-top: 8px;
  }
  .login-btn:disabled {
    opacity: .5;
    cursor: not-allowed;
  }
  .login-error {
    margin-top: 16px;
    padding: 12px 16px;
    background: rgba(220,38,38,.1);
    border: 1px solid rgba(220,38,38,.2);
    border-radius: 12px;
    color: #DC2626;
    font-size: 14px;
    text-align: center;
  }
  .login-success {
    margin-top: 16px;
    padding: 12px 16px;
    background: rgba(34,197,94,.1);
    border: 1px solid rgba(34,197,94,.2);
    border-radius: 12px;
    color: #16A34A;
    font-size: 14px;
    text-align: center;
  }
  .login-success a {
    color: var(--pink);
    font-weight: 600;
    text-decoration: underline;
  }
  .login-footer {
    margin-top: 24px;
    text-align: center;
    font-size: 12px;
    color: var(--text3);
  }
  .login-footer a {
    color: var(--pink);
    text-decoration: underline;
  }
</style>

<script is:inline>
(function() {
  const form = document.getElementById('loginForm');
  const emailInput = document.getElementById('email');
  const btn = document.getElementById('loginBtn');
  const btnText = document.getElementById('btnText');
  const btnSpinner = document.getElementById('btnSpinner');
  const errorDiv = document.getElementById('loginError');
  const successDiv = document.getElementById('loginSuccess');

  if (!form) return;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.style.display = 'none';
    successDiv.style.display = 'none';

    const email = emailInput.value.trim();
    if (!email || !email.includes('@')) {
      errorDiv.textContent = 'Bitte gib eine gültige E-Mail-Adresse ein.';
      errorDiv.style.display = 'block';
      return;
    }

    // Button disable + Spinner
    btn.disabled = true;
    btnText.style.display = 'none';
    btnSpinner.style.display = 'inline';

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });

      const data = await res.json();

      if (data.success) {
        successDiv.style.display = 'block';
        form.style.display = 'none';
        // Nach 1.5s zur Startseite
        setTimeout(() => { window.location.href = '/'; }, 1500);
      } else {
        errorDiv.textContent = data.error || 'Anmeldung fehlgeschlagen.';
        errorDiv.style.display = 'block';
      }
    } catch (err) {
      errorDiv.textContent = 'Verbindungsfehler. Bitte versuch es später nochmal.';
      errorDiv.style.display = 'block';
    } finally {
      btn.disabled = false;
      btnText.style.display = 'inline';
      btnSpinner.style.display = 'none';
    }
  });
})();
</script>
