---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';

const faqItems = [
  // ─── Anreise (3) ───
  {
    q: 'Wie komme ich am besten nach Tirol?',
    a: 'Tirol ist hervorragend an das internationale Verkehrsnetz angebunden. Mit dem Auto erreichst du Tirol über die Inntalautobahn A12 (aus Deutschland via Kufstein) oder die Brennerautobahn A13 aus Italien. Die Anreise mit der Bahn ist bequem über die Hauptbahnhöfe Innsbruck, Kufstein oder Landeck möglich – der Railjet verbindet Tirol stündlich mit Wien, München und Zürich. Die nächsten internationalen Flughäfen sind Innsbruck (INN), München (MUC) und Salzburg (SZG), jeweils mit guten Bahn- und Busverbindungen ins Inntal.',
  },
  {
    q: 'Gibt es ein günstiges Öffi-Ticket für Touristen in Tirol?',
    a: 'Ja, mit der Tiroler Oberland Card oder dem Klimaticket Tirol kannst du Busse und Nahverkehrszüge in ganz Tirol nutzen. Für Urlauber besonders praktisch ist die Gästekarte, die viele Gemeinden ausstellen – sie berechtigt zur kostenlosen Nutzung von Regionalbussen und oft auch zu Ermäßigungen auf Bergbahnen. Die Eintrittskarte für die Kernzone Innsbruck kostest du ab 2,80 € pro Fahrt, das Tagesticket liegt bei etwa 6,80 €.',
  },
  {
    q: 'Welche Mautpflicht gibt es auf Tirols Straßen?',
    a: 'Auf österreichischen Autobahnen und Schnellstraßen besteht Vignettenpflicht. Eine digitale Klebevignette für 10 Tage kostet 9,90 €, für 2 Monate 29,90 € und für ein Jahr 96,80 € (Stand 2025). Die Brennerautobahn A13 zwischen Innsbruck und Italien ist mautpflichtig – hier kommt zusätzlich zur Vignette eine Streckenmaut hinzu. Für Sonderfahrten durch die Gemeinden am Achensee oder das Zillertal kann eine ortsübliche Maut anfallen, die bar oder mit Karte zahlbar ist.',
  },

  // ─── Unterkunft (3) ───
  {
    q: 'Welche Unterkunftsarten gibt es in Tirol?',
    a: 'Tirol bietet eine riesige Auswahl an Unterkünften für jeden Geschmack und jedes Budget. Von luxuriösen 5-Sterne-Hotels mit Wellnessbereich über gemütliche Bauernhöfe, familiengeführte Pensionen, urige Berghütten bis hin zu modernen Ferienwohnungen und Campingplätzen. Besonders beliebt sind die „Kinderhotels“ mit professioneller Betreuung und die „Wellnesshotels“ mit Sauna- und Thermalbereichen. Viele Unterkünfte sind Mitglied bei „Tiroler Gastfreundschaft“ und garantieren hohe Qualität.',
  },
  {
    q: 'Wie finde ich eine günstige Unterkunft in Tirol?',
    a: 'Für preisbewusste Reisende lohnt sich die Suche außerhalb der Hauptsaison (Juli/August und Februar/März). Ferienwohnungen und Privatzimmer sind meist günstiger als Hotels. Jugendherbergen und Gasthöfe bieten einfache, saubere Zimmer ab 35 € pro Nacht. Ein Geheimtipp sind die „Almhütten zur Miete“ – ursprüngliche Selbstversorgerhütten abseits der Touristenströme. Die Buchung über die offizielle Website tiroltourismus.com garantiert oft die besten Konditionen inklusive Gästekarte.',
  },
  {
    q: 'Kann ich in Tirol auch Campen oder mit dem Wohnmobil reisen?',
    a: 'Ja, Tirol verfügt über rund 60 Campingplätze, viele davon ganzjährig geöffnet. Von einfachen Bauernhof-Stellplätzen bis zu 5-Sterne-Campingresorts mit Wellnessbereich ist alles dabei. Wildcampen ist in Österreich grundsätzlich verboten – Wohnmobile dürfen nur auf ausgewiesenen Stellplätzen übernachten. Besonders beliebt sind Campingplätze am Achensee, im Ötztal und im Zillertal. Viele Plätze bieten „Camping-Cards“ mit Rabatten für längere Aufenthalte.',
  },

  // ─── Wandern (4) ───
  {
    q: 'Was sind die schönsten Wanderwege in Tirol?',
    a: 'Tirol ist ein wahres Wanderparadies mit über 26.000 km markierten Wanderwegen. Zu den Highlights zählen der Adlerweg – ein 300 km langer Weitwanderweg quer durch Tirol – und der Traumpfad München–Venedig, der durch Osttirol führt. Tageswanderer lieben den Zirbenweg am Patscherkofel bei Innsbruck oder den Lechweg am gleichnamigen Fluss. Der E5 – eine der schönsten Höhenwege der Alpen – startet im Ötztal. Für jeden Schwierigkeitsgrad ist etwas dabei, von einfachen Talwanderungen bis zu anspruchsvollen Klettersteigen.',
  },
  {
    q: 'Brauche ich eine spezielle Ausrüstung zum Wandern in Tirol?',
    a: 'Für einfache Talwanderungen reichen feste Schuhe, wetterfeste Kleidung und ausreichend Wasser. Bei anspruchsvolleren Touren sind gutes Schuhwerk mit Profilsohle, eine Regenjacke, Sonnenschutz und ein Erste-Hilfe-Set Pflicht. Für Klettersteige benötigst du ein Klettersteigset mit Karabiner und Helm – diese können bei vielen Talstationen ausgeliehen werden. Wetterwechsel in den Bergen sind schnell und unvorhersehbar, daher solltest du immer eine wärmende Schicht im Rucksack haben.',
  },
  {
    q: 'Welche geführten Wanderungen werden in Tirol angeboten?',
    a: 'In fast jeder Region Tirols werden geführte Wanderungen angeboten – oft sogar kostenlos mit der Gästekarte. Die „Tiroler Bergführer“-Vereinigung bietet von Alpintouren bis zu thematischen Kräuterwanderungen alles an. Viele Tourismusverbände stellen wöchentliche Programme mit „Wanderungen für Genießer“ oder „Sonnenaufgangstouren“ zusammen. Auch Themenwanderungen wie die „Almabtrieb-Routen“ im Herbst oder Weinwanderungen in Südtirols Nachbarschaft erfreuen sich großer Beliebtheit.',
  },
  {
    q: 'Sind Wanderungen mit Kindern in Tirol geeignet?',
    a: 'Ja, Tirol hat viele familienfreundliche Wanderwege. Der „Murmelwanderweg“ im Zillertal, der „Alpakawanderweg“ in der Region Kufstein und der „Sagenwanderweg“ bei Rattenberg sind speziell für Kinder konzipiert. Viele Bergbahnen nehmen Kinderwagen mit, und es gibt zahlreiche Spielplätze an den Bergstationen. Auch geführte „Naturerlebnis-Wanderungen“ mit Rangern sind ein Highlight. Die „Tiroler Familiencard“ bietet Ermäßigungen auf Bahnen und Eintritte.',
  },

  // ─── Ski (4) ───
  {
    q: 'Welche Skigebiete in Tirol sind die besten?',
    a: 'Tirol zählt zu den Top-Skidestinationen weltweit. Zu den bekanntesten Skigebieten gehören Sölden (Gletscherski bis in den Mai), der Arlberg (größtes zusammenhängendes Skigebiet Österreichs mit 305 Pistenkilometern), das Zillertal (mit Mayrhofen, Hintertuxer Gletscher) und St. Anton am Arlberg. Auch Kitzbühel, Ischgl, das Skigebiet Ski Juwel Alpbachtal und die Kitzsteinhorn-Region bieten exzellente Bedingungen. Jedes Skigebiet hat seinen eigenen Charakter – von familienfreundlich bis extrem anspruchsvoll.',
  },
  {
    q: 'Was kostet ein Skipass in Tirol durchschnittlich?',
    a: 'Die Preise für Skipässe variieren je nach Saison und Größe des Skigebiets. Ein Tagesskipass für ein mittelgroßes Skigebiet kostet in der Hochsaison etwa 58–75 € für Erwachsene. Große Verbünde wie der „Ski amadé“ oder der „Arlberg“ liegen bei 70–90 € pro Tag. Kinder unter 15 Jahren erhalten meist 50 % Ermäßigung. Frühbucher-Rabatte und Mehrtageskarten bringen deutliche Ersparnisse: Ein 6-Tages-Ticket ist oft nur gut viermal so teuer wie das Tagesticket.',
  },
  {
    q: 'Wann ist die beste Skisaison in Tirol?',
    a: 'Die Hauptskisaison in Tirol läuft von Dezember bis April. Die beste Schneesicherheit besteht von Januar bis Mitte März, wenn auch die meisten Sonnenstunden locken. Gletscherskigebiete wie der Hintertuxer Gletscher, Sölden und Stubai sind sogar von Oktober bis Mai geöffnet. Hochsaisonzeiten sind Weihnachten/Neujahr, die Februar-Ferien (Semesterferien in Deutschland/Österreich) und Ostern – dann ist mit höheren Preisen und mehr Betrieb zu rechnen. Skifahren im November oder Mai ist nur auf Gletschern möglich.',
  },
  {
    q: 'Gibt es auch Langlaufloipen in Tirol?',
    a: 'Ja! Abseits der Abfahrtspisten bietet Tirol über 1.500 km präparierte Langlaufloipen. Das Loipennetz im Seefelder Plateau ist eines der größten und schönsten in den Alpen. Auch das Ötztal, die Region um Innsbruck und das Hochpustertal in Osttirol sind beliebte Langlaufziele. Von klassischer Spur bis Skating ist alles möglich. Viele Loipen werden kostenlos gepflegt – eine Loipengebühr fällt nur in besonders hochwertig präparierten Zentren an. Skating-Spuren sind meist separat markiert.',
  },

  // ─── Familie (3) ───
  {
    q: 'Welche Aktivitäten für Kinder gibt es in Tirol?',
    a: 'Neben den familienfreundlichen Wanderwegen bietet Tirol eine Fülle an Kinderattraktionen. Der „Alpenzoo Innsbruck“ beherbergt 2.000 Alpentiere, das „Schwazer Bergwerk“ entführt in die Untertagewelt und die „Swarovski Kristallwelten“ in Wattens begeistern mit funkelnden Kunstwerken. Freizeitparks wie der „Area 47“ am Achensee bieten Klettergärten, Wasserrutschen und Canyoning. Im Winter locken zahlreiche Kinderskigebiete mit Förderbändern, Zauberteppichen und Skikindergärten.',
  },
  {
    q: 'Gibt es spezielle Familienangebote in Tirol?',
    a: 'Ja, Tirol ist extrem familienfreundlich. Viele Hotels bieten „Kinderbetreuung & Halbpension“ an – oft mit ermäßigten Preisen oder sogar kostenlosen Aufenthalten für Kinder bis 6 Jahre. Die „Tiroler Familiencard“ gewährt bis zu 50 % Rabatt auf Bergbahnen, Museen und Freizeiteinrichtungen. Zwischen vielen Skigebieten gilt „Kinder bis 15 Jahre fahren kostenlos“ bei Buchung einer Mehrtageskarte für die Eltern. Die Gästekarte vieler Gemeinden bietet kostenlose Aktivitäten wie Streichelzoos oder Märchenwanderungen.',
  },

  // ─── Kulinarik (3) ───
  {
    q: 'Was sind typische Tiroler Gerichte, die ich probieren sollte?',
    a: 'Die Tiroler Küche ist herzhaft und bodenständig. Unbedingt probieren solltest du Tiroler Gröstl (Bratkartoffeln mit Speck und Spiegelei), Kaspressknödel (Käseknödel), Schlipfkrapfen (gefüllte Teigtaschen) und natürlich die Tiroler Speck: luftgetrocknet und würzig gewürzt. Auch süße Spezialitäten wie Kaiserschmarrn, Apfelstrudel und Zillertaler Krapfen (Küchl) sind über die Grenzen hinaus bekannt. Dazu passt ein Glas Südtiroler Wein oder ein frisches „Zillertaler Bier“ vom Fass.',
  },
  {
    q: 'Wo finde ich traditionelle Wirtshäuser in Tirol?',
    a: 'Traditionelle „Tiroler Wirtshäuser“ findest du in fast jedem Dorf – erkennbar an der holzvertäfelten Stube, der offenen Kaminfeuerstelle und den handgeschriebenen Speisekarten. Besonders authentisch sind Gasthöfe mit der Auszeichnung „Tiroler Wirtshauskultur“. Empfehlenswerte Adressen sind der „Gasthof Acksteiner“ in Lans, die „Alte Schmiede“ in Söll und der „Hirschen“ in St. Johann. Viele bieten einen „Wirtshaus-Shuttle“ an, der Gäste ab der Talstation abholt. Reservierungen sind besonders an Wochenenden empfehlenswert.',
  },
  {
    q: 'Welche regionalen Lebensmittel sind typisch für Tirol?',
    a: 'Tirol hat eine reiche kulinarische Tradition mit vielen geschützten Produkten. Der „Tiroler Speck g.g.A.“ ist EU-weit geschützt, ebenso der „Tiroler Graukäse“ und der „Tiroler Almkäse“. Auch die Tiroler Bergbauernmilch, Tiroler Wild aus heimischen Revieren und das aromatische „Tiroler Almfrischkäse“ gehören zu den regionalen Spezialitäten. Auf den Märkten in Innsbruck, Kufstein und Lienz kannst du direkt bei Bauern einkaufen. Die „Genusscard“ Tirol bietet Vergünstigungen bei vielen Direktvermarktern und Restaurants.',
  },

  // ─── Regionen (1) ───
  {
    q: 'Welche Regionen in Tirol sind besonders sehenswert?',
    a: 'Tirol gliedert sich in viele einzigartige Regionen, jede mit eigenem Charakter. Das Ötztal lockt mit dem höchsten Gletscherskigebiet und der Ötzi-Ausstellung, das Zillertal mit traditioneller Musik und dem Hintertuxer Gletscher. Die Region um Kitzbühel ist für ihre mondäne Atmosphäre und das Hahnenkamm-Rennen bekannt. Der Arlberg ist das Herz des Tiefschneefahrens, das Stubaital überzeugt mit dem nahen Stubaier Gletscher und der Grawa-Wasserfall-Runde. Osttirol mit der Hohen Tauern bietet ursprüngliche Bergnatur. Innsbruck selbst vereint Stadtflair mit Alpenabenteuer – alle Regionen sind mit den öffentlichen Verkehrsmitteln gut erreichbar.',
  },

  // ─── Wetter (2) ───
  {
    q: 'Wie ist das Wetter in Tirol im Jahresverlauf?',
    a: 'Tirol hat ein typisches Alpenklima mit warmen, sonnigen Sommern (durchschnittlich 20–28 °C von Juni bis August) und kalten, schneereichen Wintern (–5 bis +5 °C von Dezember bis Februar). Frühling (März–Mai) ist wechselhaft, der Herbst (September–November) oft mild und golden mit vielen Schönwetterperioden. Die beste Reisezeit für Wanderungen ist Mai bis Oktober, für Skifahrer Dezember bis April. In den Höhenlagen ist es deutlich kühler: Auf 2.500 m Höhe sind selbst im August nur 10–15 °C zu erwarten.',
  },
  {
    q: 'Ist das Wetter in den Bergen schnell wechselhaft?',
    a: 'Ja, in den Alpen kann das Wetter sehr schnell umschlagen. Ein strahlend blauer Himmel kann sich innerhalb von Minuten in einen Gewittersturm mit Hagel verwandeln – insbesondere zwischen Juni und August. Deshalb die Goldene Regel: Vor jeder Bergtour den aktuellen Wetterbericht der ZAMG (GeoSphere Austria) checken, auf Wetterwarnungen achten und die Tour früh starten. Elektronische Lawinenwarndienste sind im Winter Pflicht. In den Tourismusbüros liegen kostenlose Wetter- und Lawinen-Merkblätter auf.',
  },

  // ─── Events (3) ───
  {
    q: 'Welche traditionellen Veranstaltungen gibt es in Tirol?',
    a: 'Tirol ist reich an Traditionen und Brauchtumsveranstaltungen. Höhepunkte sind der „Tiroler Advent“ mit den Christkindlmärkten, das „Almabtrieb-Fest“ im September (geschmückte Kühe ziehen von der Alm ins Tal), der „Tiroler Krippenweg“ in Rattenberg und die „Gauderfeste“ im Zillertal. Im Sommer locken die „Tiroler Volksmusik-Wochen“, Handwerksmärkte und traditionelle Schützenfeste. Regionale Highlights sind der „Schleicherlaufen“ in Telfs und das „Schemenlaufen“ in Imst – UNESCO-Weltkulturerbe.',
  },
  {
    q: 'Welche Sport-Events sollte man in Tirol nicht verpassen?',
    a: 'Tirol ist Austragungsort zahlreicher internationaler Sportevents. Das legendäre „Hahnenkamm-Rennen“ in Kitzbühel zieht jedes Jahr im Januar 50.000 Zuschauer an. Der „Innsbruck-Triathlon“ im August, das „Ötztaler Radmarathon“-Rennen und der „Ischgl Ironbike“ sind Highlights für Sportbegeisterte. Im Winter locken die Weltcup-Rennen in Sölden und am Arlberg sowie die „Four Hills Tournament“-Station in Bischofshofen (nahe der Tiroler Grenze). Viele Events sind kostenlos am Streckenrand verfolgbar.',
  },
  {
    q: 'Gibt es kulturelle Events und Musikfestivals in Tirol?',
    a: 'Ja, Tirol hat ein reiches Kulturangebot. Die „Innsbrucker Festwochen der Alten Musik“ sind international renommiert. Das „Kufstein Open Air“ – ein Musikfestival mit Kopfhörer-Technologie auf der Festung Kufstein – ist einzigartig. Der „Achensee“ lockt mit Segelregatten, das „Ötztal“ mit dem „Ötztal Mountain Man“ Triathlon. Über das Jahr verteilt gibt es unzählige Dorf- und Bergfeste mit Live-Musik, Schuhplattlern und regionaler Kulinarik. Der Eintritt ist oft kostenlos oder sehr günstig.',
  },
];

// JSON-LD FAQPage schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout
  title="FAQ – Häufige Fragen zu Tirol"
  description="Alle wichtigen Fragen und Antworten rund um Deinen Tirol-Urlaub: Anreise, Unterkunft, Wandern, Ski, Familie, Kulinarik, Wetter, Events und Regionen."
  jsonld={faqSchema}
>
  <main>
    <!-- BREADCRUMBS -->
    <Breadcrumbs items={[{ label: 'Magazin', href: '/magazin/' }, { label: 'FAQ' }]} />

    <!-- HERO -->
    <section class="faq-hero">
      <div class="faq-hero-bg"></div>
      <div class="container">
        <div class="faq-hero-inner">
          <div class="faq-hero-emoji">❓</div>
          <h1 class="faq-hero-title">FAQ</h1>
          <p class="faq-hero-sub">
            Häufige Fragen rund um Deinen nächsten Urlaub in Tirol – von der Anreise bis zu den schönsten Wanderwegen und Skipisten.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="faq-section">
      <div class="container" style="max-width: 800px">
        <SectionHeader
          label="#wissen"
          title="Fragen & Antworten"
          sub="Alles, was Du für Deine Reiseplanung nach Tirol wissen musst – übersichtlich zusammengefasst."
        />

        <div class="faq-list" id="faqList">
          {faqItems.map((item, i) => (
            <details class="faq-item" id={`faq-${i}`}>
              <summary class="faq-question">
                <span class="faq-num">{(i + 1).toString().padStart(2, '0')}</span>
                <span class="faq-q-text">{item.q}</span>
                <span class="faq-toggle" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* ==============================================================
     FAQ HERO
     ============================================================== */
  .faq-hero {
    position: relative;
    padding: 80px 0 64px;
    overflow: hidden;
    text-align: center;
  }
  .faq-hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, var(--pink-glow), transparent 70%);
    opacity: 0.3;
    pointer-events: none;
  }
  .faq-hero .container {
    position: relative;
    z-index: 2;
  }
  .faq-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .faq-hero-emoji {
    font-size: 64px;
    line-height: 1;
    filter: drop-shadow(0 4px 12px rgba(255, 20, 147, 0.25));
    animation: faq-float 3s ease-in-out infinite;
  }
  @keyframes faq-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .faq-hero-title {
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text);
    margin: 0;
  }
  .faq-hero-sub {
    font-size: 16px;
    color: var(--text2);
    line-height: 1.6;
    max-width: 580px;
    margin: 0;
  }

  /* ==============================================================
     FAQ SECTION
     ============================================================== */
  .faq-section {
    padding: 32px 0 88px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ==============================================================
     FAQ ITEM – <details>/<summary> Accordion
     ============================================================== */
  .faq-item {
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .faq-item[open] {
    border-color: var(--pink);
    box-shadow: 0 4px 24px var(--pink-glow);
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background 0.3s;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-question:hover {
    background: var(--surface-hover);
  }

  .faq-num {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: 1px;
    color: var(--text3);
    width: 36px;
    flex-shrink: 0;
  }
  .faq-q-text {
    flex: 1;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.5;
  }
  .faq-toggle {
    font-size: 22px;
    font-weight: 300;
    color: var(--pink);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--glass);
    flex-shrink: 0;
    transition: transform 0.3s var(--ease);
  }
  .faq-item[open] .faq-toggle {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 24px 24px 74px;
  }
  .faq-answer p {
    font-size: 14px;
    color: var(--text2);
    line-height: 1.8;
    margin: 0;
  }

  /* ==============================================================
     RESPONSIVE
     ============================================================== */
  @media (max-width: 768px) {
    .faq-hero {
      padding: 48px 0 40px;
    }
    .faq-hero-title {
      font-size: 36px;
    }
    .faq-hero-emoji {
      font-size: 48px;
    }
    .faq-section {
      padding: 24px 0 64px;
    }
    .faq-question {
      padding: 16px 18px;
      gap: 10px;
    }
    .faq-num {
      width: 28px;
      font-size: 16px;
    }
    .faq-q-text {
      font-size: 14px;
    }
    .faq-answer {
      padding: 0 18px 18px 56px;
    }
    .faq-answer p {
      font-size: 13px;
    }
  }

  @media (max-width: 480px) {
    .faq-num {
      display: none;
    }
    .faq-answer {
      padding: 0 18px 18px 18px;
    }
  }
</style>

<script is:inline>
(function() {
  // Smooth open/close animation via CSS – no extra JS needed for toggling.
  // But we add a small enhancement: close others when opening a new question.
  const details = document.querySelectorAll('.faq-item');
  details.forEach((item) => {
    item.addEventListener('toggle', function() {
      if (this.open) {
        details.forEach((other) => {
          if (other !== this && other.open) {
            other.removeAttribute('open');
          }
        });
        // Scroll the opened item into view with a small offset
        setTimeout(() => {
          this.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 100);
      }
    });
  });
})();
</script>
