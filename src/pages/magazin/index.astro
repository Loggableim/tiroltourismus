---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { readCollection, isPublished } from '../../lib/content.js';

const articles = readCollection('magazin');
const published = articles
  .filter(a => isPublished(a.entry))
  .sort((a, b) => (b.entry.datum || '').localeCompare(a.entry.datum || ''));

const featured = published.slice(0, 1);
const secondary = published.slice(1, 3);
const rest = published.slice(3);

const catEmoji = { allgemein: '📰', tipps: '💡', reiseberichte: '✈️', interview: '🎙️', hintergrund: '🔍' };
const catLabel = { allgemein: 'Allgemein', tipps: 'Tipps', reiseberichte: 'Reiseberichte', interview: 'Interview', hintergrund: 'Hintergrund' };

function formatDate(d) {
  if (!d) return '';
  try { return new Date(d + 'T00:00:00').toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' }); }
  catch { return d; }
}

// JSON-LD: ItemList
const siteURL = 'https://www.tirol-tourismus.at';
const magazinItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Tirol Magazin',
  description: 'Das Tirol Magazin: Inspiration für Deinen nächsten Urlaub in den Alpen.',
  url: `${siteURL}/magazin/`,
  numberOfItems: published.length,
  itemListElement: published.slice(0, 30).map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.entry.titel,
    url: `${siteURL}/magazin/${a.slug}/`,
  })),
};
---

<BaseLayout title="Tirol Magazin" description="Das Tirol Magazin: Inspiration für Deinen nächsten Urlaub in den Alpen." jsonld={magazinItemList}>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Magazin' }]} />
    </div>

    <Hero
      title="Magazin"
      subtitle="Geschichten, Tipps und Reportagen aus Tirol."
      emoji="📰"
      size="md"
    >
      <div slot="actions" class="hero-actions">
        <a href="#magazin-grid" class="btn btn-pink">Artikel entdecken →</a>
        <span class="hero-urgency">📖 {published.length} Artikel</span>
      </div>
    </Hero>

    {published.length > 0 ? (
      <>
        <!-- ═══ FEATURED ARTICLE ═══ -->
        {featured.length > 0 && (
          <section class="section featured-section">
            <div class="container">
              {featured.map((a) => (
                <a href={`/magazin/${a.slug}/`} class="featured-card">
                  <div class="featured-img">
                    {a.entry.hero_bild ? (
                      <img src={a.entry.hero_bild} alt={a.entry.titel} loading="eager" />
                    ) : (
                      <div class="featured-emoji">{catEmoji[a.entry.kategorie] || '📰'}</div>
                    )}
                    <div class="featured-overlay">
                      <span class="featured-tag">{(catLabel[a.entry.kategorie] || a.entry.kategorie || '').toUpperCase()}</span>
                      <h2 class="featured-title">{a.entry.titel}</h2>
                      <p class="featured-teaser">{a.entry.teaser}</p>
                      <span class="featured-link">Weiterlesen →</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- ═══ POP-ART KACHEL-GRID ═══ -->
        <section class="section" id="magazin-grid">
          <div class="container">
            <div class="pop-header">
              <span class="pop-header-label">✦ Magazin</span>
              <h2 class="pop-header-title">Stories aus den Bergen</h2>
              <p class="pop-header-sub">Neueste Geschichten, Tipps & Inspirationen — bunt wie Tirol.</p>
            </div>

            <FilterBar
              keyName="cat"
              ariaLabel="Magazin nach Kategorie filtern"
              options={[
                { value: 'tipps', label: 'Tipps' },
                { value: 'reiseberichte', label: 'Reiseberichte' },
                { value: 'hintergrund', label: 'Hintergrund' },
                { value: 'allgemein', label: 'Allgemein' },
              ]}
            />

            <div class="tile-grid">
              {[secondary, rest].flat().map((a, i) => {
                // Determine tile size: first 2 get double-width, every 8th gets big
                let tileClass = 'tile';
                if (i < 2) tileClass += ' tile-w2';
                else if (i % 8 === 0) tileClass += ' tile-wh2';
                else if (i % 5 === 0) tileClass += ' tile-w2';
                // Color index cycles through palette
                let colorIdx = i % 8;
                tileClass += ` tile-color-${colorIdx}`;
                
                // First 3 articles show as text-only color tiles for pop effect
                const isColorTile = i < 3 && !a.entry.hero_bild;
                
                return (
                  <a href={`/magazin/${a.slug}/`} class={tileClass} data-filter-card data-filter-cat={a.entry.kategorie}>
                    {a.entry.hero_bild && (
                      <>
                        <img src={a.entry.hero_bild} alt={a.entry.titel} class="tile-img" loading="lazy" />
                        <div class="tile-overlay"></div>
                      </>
                    )}
                    <div class="tile-content">
                      <span class="tile-tag">{(catLabel[a.entry.kategorie] || a.entry.kategorie || '').toUpperCase()}</span>
                      <h3 class="tile-title">{a.entry.titel}</h3>
                      {a.entry.datum && <span class="tile-date">{formatDate(a.entry.datum)}</span>}
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      </>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:80px 0">
          <div style="font-size:64px;margin-bottom:16px">📰</div>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase">
            Bald verfügbar
          </h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">
            Magazin-Artikel werden aktuell eingepflegt.
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  /* ══════════════════════════════════════════════
     TIROL MAGAZIN — ANDY WARHOL × WINDOWS 8
     Bunte Kacheln, Pop-Art-Feeling, dynamisches Grid
     ══════════════════════════════════════════════ */

  /* ─── Pop-Art Farbpalette ─── */
  .magazin-page {
    --mag-pink: #FF1493;
    --mag-yellow: #FFD700;
    --mag-cyan: #00E5FF;
    --mag-orange: #FF6B00;
    --mag-green: #39FF14;
    --mag-purple: #BF00FF;
    --mag-blue: #0055FF;
    --mag-red: #FF0040;
    --mag-hot-magenta: #FF00AA;
  }

  /* ─── FEATURED: Riesiges Hero-Kachel ─── */
  .featured-section { padding-top: 0 !important; }
  .featured-card {
    display: block;
    border-radius: 0;
    overflow: hidden;
    position: relative;
    transition: transform .2s ease;
    border: 4px solid var(--mag-yellow);
    box-shadow: 12px 12px 0 rgba(0,0,0,.3);
  }
  .featured-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 16px 16px 0 rgba(0,0,0,.35);
  }
  .featured-img {
    position: relative;
    width: 100%;
    aspect-ratio: 21/9;
    min-height: 380px;
    overflow: hidden;
  }
  .featured-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .featured-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 50px 36px 30px;
    background: linear-gradient(transparent 0%, rgba(0,0,0,.85) 50%);
    color: #fff;
  }
  .featured-tag {
    display: inline-block;
    padding: 6px 18px;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: var(--mag-pink);
    color: #fff;
    margin-bottom: 10px;
    border: 2px solid #fff;
    box-shadow: 4px 4px 0 rgba(0,0,0,.3);
  }
  .featured-title {
    font-family: var(--font-display);
    font-size: 42px;
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 8px;
    color: #fff;
    text-shadow: 4px 4px 0 var(--mag-yellow), 8px 8px 0 rgba(0,0,0,.3);
  }
  .featured-teaser {
    font-size: 16px;
    color: rgba(255,255,255,.8);
    line-height: 1.6;
    max-width: 600px;
    margin-bottom: 12px;
    font-weight: 500;
  }
  .featured-link {
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--mag-yellow);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 20px;
    border: 2px solid var(--mag-yellow);
    background: rgba(0,0,0,.4);
    transition: all .2s;
  }
  .featured-link:hover { gap: 12px; background: var(--mag-pink); border-color: #fff; color: #fff; }

  /* ─── KACHEL-GRID (Windows 8 Metro Style) ─── */
  .tile-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    grid-auto-flow: dense;
  }

  /* Standard-Kachel 1×1 */
  .tile {
    display: block;
    position: relative;
    overflow: hidden;
    border: 3px solid #000;
    transition: all .15s ease;
    cursor: pointer;
    min-height: 220px;
  }
  .tile:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 rgba(0,0,0,.35);
  }

  /* Kachel-Größen */
  .tile-w2 { grid-column: span 2; }
  .tile-h2 { grid-row: span 2; min-height: 452px; }
  .tile-wh2 { grid-column: span 2; grid-row: span 2; min-height: 452px; }

  /* Kachel-Farben (abwechselnd, basierend auf Kategorie) */
  .tile-color-0 { background: var(--mag-pink); border-color: var(--mag-hot-magenta); }
  .tile-color-1 { background: var(--mag-blue); border-color: var(--mag-cyan); }
  .tile-color-2 { background: var(--mag-orange); border-color: var(--mag-yellow); }
  .tile-color-3 { background: var(--mag-purple); border-color: var(--mag-hot-magenta); }
  .tile-color-4 { background: var(--mag-green); border-color: var(--mag-yellow); }
  .tile-color-5 { background: var(--mag-red); border-color: var(--mag-orange); }
  .tile-color-6 { background: var(--mag-cyan); border-color: var(--mag-blue); }
  .tile-color-7 { background: #000; border-color: var(--mag-yellow); }

  /* Kachel-Bild */
  .tile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
    mix-blend-mode: overlay;
    opacity: 0.85;
  }
  .tile:hover .tile-img {
    transform: scale(1.08);
  }

  /* Duotone-Overlay (Warhol-Effekt) */
  .tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,20,147,.15), rgba(0,229,255,.15));
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  .tile-color-1 .tile-overlay { background: linear-gradient(135deg, rgba(0,85,255,.2), rgba(0,229,255,.15)); }
  .tile-color-2 .tile-overlay { background: linear-gradient(135deg, rgba(255,107,0,.2), rgba(255,215,0,.15)); }
  .tile-color-3 .tile-overlay { background: linear-gradient(135deg, rgba(191,0,255,.2), rgba(255,0,170,.15)); }
  .tile-color-4 .tile-overlay { background: linear-gradient(135deg, rgba(57,255,20,.15), rgba(255,215,0,.15)); }
  .tile-color-5 .tile-overlay { background: linear-gradient(135deg, rgba(255,0,64,.2), rgba(255,107,0,.15)); }
  .tile-color-6 .tile-overlay { background: linear-gradient(135deg, rgba(0,229,255,.15), rgba(0,85,255,.2)); }

  /* Halftone-Muster (Ben-Day Dots) */
  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,.08) 1px, transparent 1px);
    background-size: 6px 6px;
    pointer-events: none;
    z-index: 1;
  }

  /* Kachel-Content */
  .tile-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px 20px 18px;
    background: linear-gradient(transparent 0%, rgba(0,0,0,.75) 50%);
    z-index: 2;
  }
  .tile-tag {
    display: inline-block;
    padding: 3px 10px;
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    background: #000;
    color: #fff;
    margin-bottom: 6px;
    border: 1px solid rgba(255,255,255,.3);
  }
  .tile-title {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: .5px;
    color: #fff;
    margin-bottom: 4px;
    text-shadow: 2px 2px 0 rgba(0,0,0,.5);
  }
  .tile-w2 .tile-title, .tile-wh2 .tile-title { font-size: 26px; }
  .tile-h2 .tile-title { font-size: 22px; }
  .tile-date {
    font-size: 10px;
    color: rgba(255,255,255,.6);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
  }

  /* Kachel ohne Bild (reine Farb-Kachel) */
  .tile-noimg {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
  }
  .tile-noimg .tile-emoji {
    font-size: 48px;
    margin-bottom: 12px;
  }
  .tile-noimg .tile-tag { background: rgba(0,0,0,.5); border: 1px solid #fff; }
  .tile-noimg .tile-title { font-size: 24px; text-shadow: 3px 3px 0 #000; }

  /* ─── SEKTIONS-ÜBERSCHRIFT (Pop-Art) ─── */
  .pop-header {
    margin-bottom: 24px;
    position: relative;
  }
  .pop-header-label {
    display: inline-block;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 6px 16px;
    background: #000;
    color: var(--mag-yellow);
    border: 2px solid var(--mag-yellow);
    margin-bottom: 8px;
  }
  .pop-header-title {
    font-family: var(--font-display);
    font-size: 36px;
    text-transform: uppercase;
    letter-spacing: 2px;
    line-height: 1;
    color: var(--mag-pink);
    text-shadow: 4px 4px 0 var(--mag-yellow);
    margin-bottom: 6px;
  }
  .pop-header-sub {
    font-size: 15px;
    color: var(--text2);
    font-weight: 500;
  }

  /* ─── RESPONSIVE ─── */
  @media(max-width:1024px) {
    .tile-grid { grid-template-columns: repeat(3, 1fr); }
    .featured-title { font-size: 34px; }
  }
  @media(max-width:768px) {
    .tile-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .tile-w2 { grid-column: span 2; }
    .tile-wh2 { grid-column: span 2; grid-row: span 1; min-height: 220px; }
    .tile-h2 { grid-row: span 1; }
    .tile { min-height: 180px; }
    .featured-img { aspect-ratio: 16/9; min-height: 260px; }
    .featured-title { font-size: 26px; }
    .featured-title { text-shadow: 2px 2px 0 var(--mag-yellow), 4px 4px 0 rgba(0,0,0,.3); }
    .featured-overlay { padding: 30px 20px 20px; }
    .pop-header-title { font-size: 28px; }
  }
  @media(max-width:480px) {
    .tile-grid { grid-template-columns: 1fr; }
    .tile-w2 { grid-column: span 1; }
    .tile-wh2 { grid-column: span 1; }
    .tile { min-height: 160px; }
    .featured-img { aspect-ratio: 4/3; min-height: 200px; }
    .featured-title { font-size: 22px; }
    .featured-teaser { display: none; }
    .pop-header-title { font-size: 22px; }
  }
</style>
