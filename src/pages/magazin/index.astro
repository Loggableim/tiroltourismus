---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readCollection, isPublished } from '../../lib/content.js';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = readCollection('magazin');
const published = articles
  .filter(a => isPublished(a.entry))
  .sort((a, b) => (b.entry.datum || '').localeCompare(a.entry.datum || ''));
const featured = published[0] || null;
const catEmoji = { allgemein: '📰', tipps: '💡', reiseberichte: '✈️', interview: '🎙️', hintergrund: '🔍' };
---

<BaseLayout title="Tirol Magazin" description="Das Tirol Magazin: Inspiration für Deinen nächsten Urlaub in den Alpen.">
  <main>
    <section class="mag-hero">
      <div class="container">
        <span class="hero-emoji">📰</span>
        <h1>Magazin</h1>
        <p>Geschichten, Tipps und Insider-Wissen für dein nächstes Abenteuer in Tirol.</p>
      </div>
    </section>

    {published.length > 0 ? (
      <section class="section">
        <div class="container">
          {featured && (
            <a href={`/magazin/${featured.slug}/`} class="feature-card reveal">
              <div class="feature-visual">
                <span class="feature-badge">Featured</span>
                {catEmoji[featured.entry.kategorie] || '📰'}
              </div>
              <div class="feature-body">
                <div class="article-cat">
                  <span class="tag tag-pink">{featured.entry.kategorie}</span>
                </div>
                <div class="article-date" style="font-size:12px;color:var(--text3);margin-bottom:8px">
                  {featured.entry.datum}
                </div>
                <h2>{featured.entry.titel}</h2>
                <p>{featured.entry.teaser}</p>
                <span class="read-more">Weiterlesen →</span>
              </div>
            </a>
          )}

          <div class="article-grid">
            {published.slice(featured ? 1 : 0).map((a) => (
              <ArticleCard
                titel={a.entry.titel}
                slug={a.slug}
                teaser={a.entry.teaser}
                datum={a.entry.datum}
                kategorie={a.entry.kategorie}
                emoji={catEmoji[a.entry.kategorie] || '📰'}
              />
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">📰</div>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px">Bald verfügbar</h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto">
            Magazin-Artikel werden aktuell eingepflegt.
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  .mag-hero {
    position: relative;
    padding: 80px 0;
    text-align: center;
    background: var(--bg2);
    border-bottom: 1px solid var(--glass-border);
    overflow: hidden;
  }
  .mag-hero::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: var(--pink-glow);
    filter: blur(80px);
    pointer-events: none;
  }
  .mag-hero::after {
    content: '';
    position: absolute;
    bottom: -30%;
    right: -10%;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: var(--blue-glow);
    filter: blur(80px);
    pointer-events: none;
  }
  .mag-hero .hero-emoji {
    font-size: 64px;
    display: block;
    margin-bottom: 8px;
    position: relative;
    z-index: 1;
  }
  .mag-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 96px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }
  .mag-hero p {
    font-size: 16px;
    color: var(--text2);
    max-width: 500px;
    margin: 12px auto 0;
    position: relative;
    z-index: 1;
  }

  .feature-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.4s var(--ease);
    margin-bottom: 48px;
  }
  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--pink);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.08);
  }
  .feature-visual {
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 80px;
    background: linear-gradient(135deg, var(--surface), var(--surface-hover));
    position: relative;
  }
  .feature-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--pink);
    color: #fff;
  }
  .feature-body {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .feature-body h2 {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
    color: var(--text);
  }
  .feature-body p {
    font-size: 14px;
    color: var(--text2);
    line-height: 1.7;
    margin-bottom: 20px;
  }
  .feature-body .read-more {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--pink);
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .feature-body .read-more:hover {
    color: var(--pink-dark);
    gap: 8px;
  }
  @media (max-width: 768px) {
    .feature-card { grid-template-columns: 1fr; }
    .feature-visual { min-height: 200px; font-size: 56px; }
    .feature-body { padding: 24px; }
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 968px) {
    .article-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .article-grid { grid-template-columns: 1fr; }
  }

  .article-cat {
    margin-bottom: 6px;
  }
  .tag {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--surface);
    border: 1px solid var(--glass-border);
  }
  .tag-pink {
    border-color: rgba(255, 20, 147, 0.15);
    color: var(--pink);
  }
</style>
