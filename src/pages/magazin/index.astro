---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { readCollection, isPublished } from '../../lib/content.js';

const articles = readCollection('magazin');
const published = articles
  .filter(a => isPublished(a.entry))
  .sort((a, b) => (b.entry.datum || '').localeCompare(a.entry.datum || ''));

const catEmoji = { allgemein: '📰', tipps: '💡', reiseberichte: '✈️', interview: '🎙️', hintergrund: '🔍' };
const catLabel = { allgemein: 'Allgemein', tipps: 'Tipps', reiseberichte: 'Reiseberichte', interview: 'Interview', hintergrund: 'Hintergrund' };

function formatDate(d) {
  if (!d) return '';
  try { return new Date(d + 'T00:00:00').toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' }); }
  catch { return d; }
}

// JSON-LD: ItemList
const siteURL = 'https://www.tirol-tourismus.at';
const magazinItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Tirol Magazin',
  description: 'Das Tirol Magazin: Inspiration für Deinen nächsten Urlaub in den Alpen.',
  url: `${siteURL}/magazin/`,
  numberOfItems: published.length,
  itemListElement: published.slice(0, 30).map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.entry.titel,
    url: `${siteURL}/magazin/${a.slug}/`,
  })),
};
---

<BaseLayout title="Tirol Magazin" description="Das Tirol Magazin: Inspiration für Deinen nächsten Urlaub in den Alpen." jsonld={magazinItemList}>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Magazin' }]} />
    </div>

    <Hero
      title="Magazin"
      subtitle="Geschichten, Tipps und Reportagen aus Tirol."
      emoji="📰"
      size="md"
    >
      <div slot="actions" class="hero-actions">
        <a href="#magazin-grid" class="btn btn-pink">Artikel entdecken →</a>
        <span class="hero-urgency">📖 {published.length} Artikel</span>
      </div>
    </Hero>

    {published.length > 0 ? (
      <section class="section" id="magazin-grid">
        <div class="container">
          <SectionHeader
            label="#magazin"
            title="Stories aus den Bergen"
            sub="Neueste Geschichten, Tipps & Inspirationen rund um Deinen nächsten Tirol-Urlaub."
          />

          <FilterBar
            keyName="cat"
            ariaLabel="Magazin nach Kategorie filtern"
            options={[
              { value: 'tipps', label: 'Tipps' },
              { value: 'reiseberichte', label: 'Reiseberichte' },
              { value: 'hintergrund', label: 'Hintergrund' },
              { value: 'allgemein', label: 'Allgemein' },
            ]}
          />

          <div class="magazin-grid">
            {published.map((a) => (
              <div class="magazin-item" data-filter-card data-filter-cat={a.entry.kategorie}>
                <ArticleCard
                  titel={a.entry.titel}
                  slug={a.slug}
                  teaser={a.entry.teaser}
                  datum={formatDate(a.entry.datum)}
                  kategorie={(catLabel[a.entry.kategorie] || a.entry.kategorie || '').toUpperCase()}
                  emoji={catEmoji[a.entry.kategorie] || '📰'}
                  hero_bild={a.entry.hero_bild}
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:80px 0">
          <div style="font-size:64px;margin-bottom:16px">📰</div>
          <h2 style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase">
            Bald verfügbar
          </h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">
            Magazin-Artikel werden aktuell eingepflegt.
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

