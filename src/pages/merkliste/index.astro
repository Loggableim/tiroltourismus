---
// merkliste/index.astro — Merkliste (Favorites) Seite
// Lädt eine React-Komponente, die client-seitig aus dem LocalStorage rendert.
import BaseLayout from '../../layouts/BaseLayout.astro';
import MerklistePage from '../../components/MerklistePage.tsx';
---

<BaseLayout
  title="Merkliste"
  description="Deine gespeicherten Favoriten – Unterkünfte, Erlebnisse, Events und mehr."
>
  <main>
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Startseite</a><span class="sep">›</span><span>Merkliste</span>
      </div>
    </div>

    <section class="page-header">
      <div class="container">
        <div style="font-size:48px;margin-bottom:8px">💖</div>
        <h1>Deine Merkliste</h1>
        <p>Alle gespeicherten Favoriten auf einen Blick.</p>
      </div>
    </section>

    <section class="section merkliste-section">
      <div class="container">
        <MerklistePage client:load />
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .merkliste-section {
    min-height: 40vh;
  }
  .page-header {
    position: relative;
    padding: 60px 0 40px;
    text-align: center;
    background: var(--bg2);
    border-bottom: 1px solid var(--glass-border);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-header p {
    font-size: 15px;
    color: var(--text2);
    max-width: 480px;
    margin: 0 auto;
  }
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 0;
    font-size: 12px;
    color: var(--text3);
  }

  /* ── Merkliste Page ── */
  .merkliste-loading {
    text-align: center;
    padding: 60px 0;
    color: var(--text2);
    font-size: 15px;
  }

  .merkliste-empty {
    text-align: center;
    padding: 80px 20px;
  }
  .merkliste-empty-icon {
    font-size: 64px;
    margin-bottom: 12px;
  }
  .merkliste-empty-title {
    font-family: var(--font-display);
    font-size: 32px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 8px;
  }
  .merkliste-empty-text {
    font-size: 14px;
    color: var(--text2);
    max-width: 420px;
    margin: 0 auto 24px;
    line-height: 1.7;
  }
  .btn-pink {
    display: inline-flex;
    padding: 14px 32px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    background: var(--pink);
    color: #fff;
    text-decoration: none;
    transition: all 0.3s var(--ease);
  }
  .btn-pink:hover {
    background: var(--pink-dark);
    transform: translateY(-3px);
    box-shadow: 0 8px 30px var(--pink-glow);
  }

  .merkliste-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--glass-border);
    margin-bottom: 24px;
  }
  .merkliste-count {
    font-size: 14px;
    color: var(--text2);
  }
  .merkliste-count strong {
    color: var(--text);
    font-size: 18px;
  }
  .merkliste-clear {
    padding: 8px 16px;
    border-radius: 100px;
    border: 1px solid var(--glass-border);
    background: var(--surface);
    color: var(--text2);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }
  .merkliste-clear:hover {
    background: rgba(255,20,147,.1);
    border-color: var(--pink);
    color: var(--pink);
  }

  .merkliste-group {
    margin-bottom: 40px;
  }
  .merkliste-group-title {
    font-family: var(--font-display);
    font-size: 28px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .merkliste-group-title a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.3s;
  }
  .merkliste-group-title a:hover {
    color: var(--pink);
  }
  .merkliste-group-count {
    font-size: 13px;
    font-weight: 400;
    color: var(--text3);
    background: var(--surface);
    padding: 2px 10px;
    border-radius: 100px;
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: 0;
  }

  .merkliste-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .merkliste-card {
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.4s var(--ease);
    display: flex;
    position: relative;
  }
  .merkliste-card:hover {
    transform: translateY(-4px);
    border-color: var(--pink);
    box-shadow: 0 12px 36px rgba(0,0,0,.06);
  }

  .merkliste-card-link {
    display: flex;
    gap: 14px;
    padding: 16px;
    text-decoration: none;
    color: inherit;
    flex: 1;
    min-width: 0;
  }
  .merkliste-card-emoji {
    font-size: 36px;
    flex-shrink: 0;
    width: 48px;
    text-align: center;
    line-height: 1;
  }
  .merkliste-card-body {
    min-width: 0;
    flex: 1;
  }
  .merkliste-card-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text3);
    margin-bottom: 2px;
  }
  .merkliste-card-name {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: 0.3px;
    color: var(--text);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .merkliste-card-ort {
    font-size: 12px;
    color: var(--text2);
  }

  .merkliste-card-remove {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    background: rgba(0,0,0,.05);
    color: var(--text3);
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s;
    opacity: 0;
  }
  .merkliste-card:hover .merkliste-card-remove {
    opacity: 1;
  }
  .merkliste-card-remove:hover {
    background: rgba(255,20,147,.15);
    color: var(--pink);
  }

  @media (max-width: 600px) {
    .merkliste-grid {
      grid-template-columns: 1fr;
    }
    .merkliste-card-remove {
      opacity: 1;
    }
  }
</style>
