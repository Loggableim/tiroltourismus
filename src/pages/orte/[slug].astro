---
import DetailPage from '../../sections/DetailPage.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { readEntry, readCollection, isPublished, findNearby, findByTag, shouldIndex } from '../../lib/content.js';
import { generateMetaDescription } from '../../lib/seo.js';

export async function getStaticPaths() {
  const all = readCollection('orte').filter(o => isPublished(o.entry));
  return all.map(o => ({ params: { slug: o.slug } }));
}

const ULTRA_MINIMAL = JSON.parse(
  readFileSync(resolve(process.cwd(), 'wappen/sd15_ultra_minimal.json'), 'utf-8')
) as Array<{ ort: string; img_rel: string; bezirk: string }>;

const normalize = (value: string) =>
  value
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const wappenForOrt = (ortName: string) => {
  const entry = ULTRA_MINIMAL.find((item) => normalize(item.ort) === normalize(ortName));
  return entry ? `/wappen/ultra-minimal/${entry.img_rel.replace(/^img\/sd15_ultra_minimal\//, '')}` : null;
};

const { slug } = Astro.params;
const entry = readEntry('orte', slug);
if (!entry) return Astro.redirect('/orte/');

// Qualitätslogik: dünne Ortsseiten nicht indexieren
const shouldIdx = shouldIndex(entry, 'orte');

const { name, kurzbeschreibung, emoji, farbe, hoehe, einwohner, tags } = entry;
const wappenSrc = wappenForOrt(name);

// Verknüpfte Unterkünfte, Gastro und Sehenswürdigkeiten in diesem Ort
const unterkuenfteImOrt = readCollection('unterkuenfte')
  .filter(u => isPublished(u.entry) && u.entry.ort && u.entry.ort.toLowerCase() === name.toLowerCase())
  .slice(0, 6);
const gastroImOrt = readCollection('gastro')
  .filter(g => isPublished(g.entry) && g.entry.ort && g.entry.ort.toLowerCase() === name.toLowerCase())
  .slice(0, 6);
const sehenswuerdigkeitenImOrt = readCollection('sehenswuerdigkeiten')
  .filter(s => isPublished(s.entry) && s.entry.ort && s.entry.ort.toLowerCase() === name.toLowerCase())
  .slice(0, 6);

const nearbyEntries = entry.koordinaten ? findNearby(entry, 'orte', 'de', 8) : [];
const mapMarkers = [];
if (entry.koordinaten) {
  mapMarkers.push({ lat: entry.koordinaten.lat, lng: entry.koordinaten.lng, label: name, wappenSrc, emoji: emoji || '🏘️' });
}
nearbyEntries.forEach(n => {
  if (!n.entry.koordinaten) return;
  const nearbyWappen = wappenForOrt(n.entry.name || n.entry.titel || '');
  mapMarkers.push({
    lat: n.entry.koordinaten.lat,
    lng: n.entry.koordinaten.lng,
    label: n.entry.name || n.entry.titel,
    wappenSrc: nearbyWappen,
    emoji: n.entry.emoji || '🏘️',
    href: '/' + n.collection + '/' + n.slug + '/',
    category: n.collection,
  });
});
const mapSection = mapMarkers.length > 0 ? {
  type: 'map', label: 'Standort', title: 'Auf der Karte',
  markers: mapMarkers, scrollWheelZoom: true,
  filterable: true,
} : null;

// Verwandte Orte via ersten Tag
const relatedByTag = tags && tags.length > 0
  ? findByTag(tags[0])
      .filter(r => r.collection === 'orte' && r.slug !== slug)
      .slice(0, 3)
      .map(r => ({
        ...r,
        entry: { ...r.entry, _wappenSrc: wappenForOrt(r.entry.name || r.entry.titel || ''), _emoji: r.entry.emoji || '🏘️' }
      }))
  : [];

// JSON-LD: TouristDestination
const siteURL = 'https://www.tirol-tourismus.at';
const destinationLD = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: name,
  description: (kurzbeschreibung || '').substring(0, 300),
  url: `${siteURL}/orte/${slug}/`,
  ...(entry.koordinaten ? {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: entry.koordinaten.lat,
      longitude: entry.koordinaten.lng,
    },
  } : {}),
  ...(entry.region ? {
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: entry.region,
    },
  } : {}),
};
---

<DetailPage
  title={name}
  description={generateMetaDescription(entry, 'orte')}
  breadcrumbs={[{ label: 'Orte', href: '/orte/' }, { label: name }]}
  jsonld={destinationLD}
  noindex={!shouldIdx}
  sections={[
    {
      type: 'hero',
      title: name,
      subtitle: kurzbeschreibung,
      imageSrc: wappenSrc,
      gradient: farbe,
      size: 'sm',
      bgImage: undefined,
    },
    {
      type: 'facts-bar',
      accentColor: farbe,
      items: [
        hoehe ? { value: hoehe, label: 'Höhe' } : null,
        einwohner ? { value: einwohner, label: 'Einwohner' } : null,
      ].filter(Boolean),
    },
    tags && tags.length > 0 ? { type: 'tags', tags } : null,
    mapSection,
    unterkuenfteImOrt.length > 0 ? {
      type: 'related-grid',
      label: 'Übernachten',
      title: `Unterkünfte in ${name}`,
      description: `${unterkuenfteImOrt.length} Unterkunft${unterkuenfteImOrt.length !== 1 ? 'en' : ''} gefunden`,
      entries: unterkuenfteImOrt,
      slugPrefix: '/unterkuenfte/',
      nameField: 'name',
      subtitleField: 'ort',
      priceField: 'preis_ab',
      emptyText: 'Noch keine Unterkünfte in diesem Ort gelistet.',
      ctaHref: `/unterkuenfte/?ort=${encodeURIComponent(name)}`,
      ctaText: 'Alle Unterkünfte anzeigen',
      accentBg: true,
    } : null,
    gastroImOrt.length > 0 ? {
      type: 'related-grid',
      label: 'Gastronomie',
      title: `Gastro in ${name}`,
      description: `${gastroImOrt.length} Lokal${gastroImOrt.length !== 1 ? 'e' : ''} gefunden`,
      entries: gastroImOrt,
      slugPrefix: '/gastro/',
      nameField: 'name',
      subtitleField: 'ort',
      emojiField: 'emoji',
      emptyText: 'Noch keine Gastro in diesem Ort gelistet.',
      ctaHref: `/gastro/?ort=${encodeURIComponent(name)}`,
      ctaText: 'Alle Gastro anzeigen',
    } : null,
    sehenswuerdigkeitenImOrt.length > 0 ? {
      type: 'related-grid',
      label: 'Sehenswürdigkeiten',
      title: `Sehenswürdigkeiten in ${name}`,
      description: `${sehenswuerdigkeitenImOrt.length} Sehenswürdigkeit${sehenswuerdigkeitenImOrt.length !== 1 ? 'en' : ''} gefunden`,
      entries: sehenswuerdigkeitenImOrt,
      slugPrefix: '/sehenswuerdigkeiten/',
      nameField: 'name',
      subtitleField: 'kurzbeschreibung',
      emojiField: 'emoji',
      defaultEmoji: '🏛️',
      emptyText: 'Noch keine Sehenswürdigkeiten in diesem Ort gelistet.',
      ctaHref: `/sehenswuerdigkeiten/?ort=${encodeURIComponent(name)}`,
      ctaText: 'Alle Sehenswürdigkeiten anzeigen',
    } : null,
    relatedByTag.length > 0 ? {
      type: 'related-grid',
      label: 'Weitere Orte',
      entries: relatedByTag,
      slugPrefix: '/orte/',
      nameField: 'name',
      subtitleField: 'kurzbeschreibung',
      imageField: '_wappenSrc',
      defaultEmoji: '🏘️',
    } : null,
  ].filter(Boolean)}
/>
