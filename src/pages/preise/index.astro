---
// Tirol Tourismus — Preise & Mitgliedschaft
// Pricing page with LemonSqueezy checkout integration
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TIERS, LEMONSQUEEZY } from '../../config/pricing.js';

const tiers = [TIERS.basic, TIERS.silver, TIERS.gold];
const features = TIERS.basic.features.map((f, i) => ({
  label: f.text,
  basic: TIERS.basic.features[i].included,
  silver: TIERS.silver.features[i].included,
  gold: TIERS.gold.features[i].included,
}));

// Build the FAQ data
const faqs = [
  { q: 'Kann ich jederzeit kündigen?', a: 'Ja. Deine Mitgliedschaft läuft monatlich und kann jederzeit ohne Frist gekündigt werden. Der Zugang bleibt bis zum Ende des bezahlten Zeitraums aktiv.' },
  { q: 'Was ist der Unterschied zwischen Silber und Gold?', a: 'Gold enthält alles aus Silber plus Top-Listing (Gold-Badge auf Deinen Favoriten), erweiterte Analysen und eine werbefreie Erfahrung.' },
  { q: 'Gibt es eine kostenlose Testphase?', a: 'Basic ist und bleibt kostenlos – damit kannst Du Tirol entdecken. Upgrades auf Silver oder Gold sind jederzeit möglich.' },
  { q: 'Welche Zahlungsmethoden werden akzeptiert?', a: 'Wir akzeptieren Kreditkarte (Visa, Mastercard), Apple Pay, Google Pay, PayPal und Sepa-Lastschrift – alle Zahlungen werden sicher über LemonSqueezy abgewickelt.' },
  { q: 'Ist meine Zahlung sicher?', a: 'Ja. Alle Transaktionen werden über LemonSqueezy abgewickelt, das PCI-DSS-konform ist und branchenübliche Verschlüsselung verwendet.' },
  { q: 'Kann ich von Silver auf Gold upgraden?', a: 'Ja, jederzeit. Du upgradest einfach in Deinem Dashboard – die Differenz wird anteilig berechnet.' },
];
---

<BaseLayout
  title="Preise & Mitgliedschaft – Tirol Tourismus"
  description="Wähle Deine Mitgliedschaft: Basic (kostenlos), Silver (19€) oder Gold (49€). Vergleiche die Funktionen und finde das passende Paket."
>
  <main>
    <!-- ─── HERO ─── -->
    <section class="pricing-hero">
      <div class="container">
        <div class="pricing-hero-badge">Mitgliedschaft</div>
        <h1 class="pricing-hero-title">Wähle Dein Paket</h1>
        <p class="pricing-hero-sub">
          Tirol erleben. Wähle die Mitgliedschaft, die zu Dir passt –
          vom kostenlosen Einstieg bis zum Premium-Zugang mit allen Vorteilen.
        </p>
      </div>
    </section>

    <!-- ─── PRICING CARDS ─── -->
    <section class="section pricing-section">
      <div class="container">
        <div class="pricing-grid">
          {tiers.map((tier) => (
            <div class={`pricing-card${tier.popular ? ' pricing-card-popular' : ''}`}>
              {tier.popular && <div class="pricing-popular-badge">Beliebteste Wahl</div>}
              <div class="pricing-card-header">
                <div class="pricing-emoji">{tier.emoji}</div>
                <h2 class="pricing-tier-name">{tier.label}</h2>
                <p class="pricing-desc">{tier.description}</p>
                <div class="pricing-price-row">
                  {tier.price > 0 ? (
                    <>
                      <span class="pricing-price-val" style={`color:${tier.color}`}>{tier.price}€</span>
                      <span class="pricing-price-period">{tier.period}</span>
                    </>
                  ) : (
                    <span class="pricing-price-free">Kostenlos</span>
                  )}
                </div>
              </div>

              <ul class="pricing-features">
                {tier.features.map((f) => (
                  <li class={`pricing-feat${f.included ? '' : ' pricing-feat-no'}`}>
                    <span class="pricing-feat-icon">{f.included ? '✓' : '—'}</span>
                    <span class="pricing-feat-text">{f.text}</span>
                  </li>
                ))}
              </ul>

              <div class="pricing-card-footer">
                {tier.id === 'basic' ? (
                  <a href="/" class="pricing-btn pricing-btn-outline">Kostenlos starten</a>
                ) : (
                  <a
                    href="#"
                    class={`pricing-btn pricing-btn-primary${tier.popular ? ' pricing-btn-glow' : ''}`}
                    data-lemon-tier={tier.id}
                    onclick={`event.preventDefault(); window.__openCheckout && window.__openCheckout('${tier.id}')`}
                  >
                    {tier.cta}
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── COMPARISON TABLE ─── -->
    <section class="section comparison-section">
      <div class="container">
        <div class="section-header" style="margin-bottom: 48px">
          <div class="section-label" style="font-family:var(--font-display);font-size:20px;letter-spacing:2px;color:var(--pink);margin-bottom:4px">Funktionen</div>
          <h2 class="section-title" style="font-family:var(--font-display);font-size:clamp(36px,5vw,64px);line-height:1;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px">Im Detail</h2>
          <p class="section-sub" style="font-size:14px;color:var(--text2);max-width:520px;margin:0 auto;line-height:1.6">
            Alle Funktionen auf einen Blick. Vergleiche die Mitgliedschaften.
          </p>
        </div>

        <div class="comparison-table-wrap">
          <table class="comparison-table">
            <thead>
              <tr>
                <th class="comp-th comp-th-label">Funktion</th>
                <th class="comp-th" data-tier="basic">
                  <span class="comp-tier-label">🌲 Basic</span>
                  <span class="comp-tier-price">Kostenlos</span>
                </th>
                <th class="comp-th comp-th-highlight" data-tier="silver">
                  <span class="comp-tier-label">🥈 Silber</span>
                  <span class="comp-tier-price">19€/Monat</span>
                </th>
                <th class="comp-th" data-tier="gold">
                  <span class="comp-tier-label">⭐ Gold</span>
                  <span class="comp-tier-price">49€/Monat</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {features.map((feat, i) => (
                <tr class={`comp-row${i % 2 === 0 ? ' comp-row-alt' : ''}`}>
                  <td class="comp-td comp-td-label">{feat.label}</td>
                  <td class="comp-td comp-td-check">{feat.basic ? '✓' : '—'}</td>
                  <td class="comp-td comp-td-highlight">{feat.silver ? '✓' : '—'}</td>
                  <td class="comp-td">{feat.gold ? '✓' : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ─── FAQ ─── -->
    <section class="section faq-section">
      <div class="container">
        <div class="section-header" style="margin-bottom: 48px">
          <div class="section-label" style="font-family:var(--font-display);font-size:20px;letter-spacing:2px;color:var(--pink);margin-bottom:4px">FAQ</div>
          <h2 class="section-title" style="font-family:var(--font-display);font-size:clamp(36px,5vw,64px);line-height:1;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px">Häufige Fragen</h2>
        </div>

        <div class="faq-grid">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary class="faq-question">{faq.q}</summary>
              <p class="faq-answer">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── CTA BANNER ─── -->
    <section class="section cta-banner-section">
      <div class="container">
        <div class="cta-banner">
          <h2 class="cta-banner-title">Noch unentschlossen?</h2>
          <p class="cta-banner-text">
            Starte mit Basic – völlig kostenlos. Du kannst jederzeit auf Silver oder Gold upgraden.
          </p>
          <a href="/" class="pricing-btn pricing-btn-primary">Kostenlos loslegen</a>
        </div>
      </div>
    </section>
  </main>

  <!-- ─── CLIENT-SIDE LEMON.JS INTEGRATION ─── -->
  <script is:inline set:html={`window.__TIROL_PRICING = {
  storeId: ${JSON.stringify(LEMONSQUEEZY.storeId)},
  variants: {
    silver: ${JSON.stringify(LEMONSQUEEZY.variants.silver)},
    gold: ${JSON.stringify(LEMONSQUEEZY.variants.gold)},
  },
};

  // Load Lemon.js dynamically
  (function() {
    var script = document.createElement('script');
    script.src = 'https://lmsqueezy.com/lemon.js';
    script.async = true;
    script.onload = function() {
      initCheckoutButtons();
    };
    document.head.appendChild(script);

    // Open LemonSqueezy checkout overlay
    window.__openCheckout = function(tierId) {
      var config = window.__TIROL_PRICING;
      var variantId = config.variants[tierId];
      if (!variantId || !config.storeId) {
        window.location.href = '/preise/';
        return;
      }
      if (typeof window.createLemonSqueezy !== 'function') {
        // Fallback: redirect to hosted checkout
        window.location.href = 'https://tiroltourismus.lemonsqueezy.com/checkout/buy/' + variantId;
        return;
      }
      window.createLemonSqueezy().then(function(ls) {
        ls.CreateCheckout({
          store: config.storeId,
          variant: variantId,
          redirectUrl: window.location.origin + '/preise/',
        });
      }).catch(function() {
        window.location.href = 'https://tiroltourismus.lemonsqueezy.com/checkout/buy/' + variantId;
      });
    };

    function initCheckoutButtons() {
      // Handle checkout success redirect — check URL params
      var params = new URLSearchParams(window.location.search);
      var checkoutId = params.get('checkout_id');
      if (checkoutId) {
        handleCheckoutSuccess(checkoutId);
      }
    }

    function handleCheckoutSuccess(checkoutId) {
      // Try to verify the checkout via Lemon.js
      if (typeof window.createLemonSqueezy === 'function') {
        window.createLemonSqueezy().then(function(ls) {
          if (ls && ls.GetCheckoutData) {
            ls.GetCheckoutData({ checkoutId: checkoutId }).then(function(data) {
              if (data && data.variant_id) {
                var vid = parseInt(data.variant_id);
                var tier = 'basic';
                if (vid === window.__TIROL_PRICING.variants.silver) tier = 'silver';
                else if (vid === window.__TIROL_PRICING.variants.gold) tier = 'gold';

                if (tier !== 'basic') {
                  localStorage.setItem('tirol_user_tier', tier);
                  localStorage.setItem('tirol_subscription_data', JSON.stringify({
                    checkoutId: checkoutId,
                    variantId: vid,
                    tier: tier,
                    verifiedAt: Date.now(),
                  }));
                  // Show success message
                  showSuccess(tier);
                  // Clean URL
                  window.history.replaceState({}, '', '/preise/');
                }
              }
            }).catch(function() {});
          }
        }).catch(function() {});
      }

      // Also store a basic indication even if JS verification fails
      // The webhook handles real server-side verification
      if (!localStorage.getItem('tirol_checkout_pending_' + checkoutId)) {
        localStorage.setItem('tirol_checkout_pending_' + checkoutId, Date.now().toString());
      }
    }

    function showSuccess(tier) {
      var tierNames = { silver: 'Silber', gold: '⭐ Gold' };
      var banner = document.createElement('div');
      banner.style.cssText = 'position:fixed;top:100px;left:50%;transform:translateX(-50%);z-index:2000;background:linear-gradient(135deg,var(--green),#059669);color:#fff;padding:20px 40px;border-radius:16px;font-size:16px;font-weight:600;box-shadow:0 16px 48px rgba(0,0,0,.3);text-align:center;max-width:500px;animation:fadeSlideDown .5s var(--ease)';
      banner.innerHTML = '🎉 <strong>Willkommen bei ' + (tierNames[tier] || tier) + '!</strong><br><span style="font-size:13px;opacity:.9">Deine Mitgliedschaft ist aktiv. Entdecke alle Inhalte.</span><br><a href="/unterkuenfte/" style="display:inline-block;margin-top:12px;padding:8px 20px;background:rgba(255,255,255,.2);border-radius:100px;color:#fff;font-size:12px;font-weight:700">Zu den Unterkünften →</a>';
      document.body.appendChild(banner);
      setTimeout(function() {
        banner.style.opacity = '0';
        banner.style.transition = 'opacity .6s';
        setTimeout(function() { banner.remove(); }, 600);
      }, 5000);
    }

    // Check for pending checkouts from previous sessions
    (function checkPending() {
      var prefix = 'tirol_checkout_pending_';
      for (var i = 0; i < localStorage.length; i++) {
        var key = localStorage.key(i);
        if (key && key.indexOf(prefix) === 0) {
          var ts = parseInt(localStorage.getItem(key));
          if (ts && (Date.now() - ts) < 86400000) {
            // Less than 24h old — assume Silver as safe default
            var currentTier = localStorage.getItem('tirol_user_tier') || 'basic';
            if (currentTier === 'basic') {
              localStorage.setItem('tirol_user_tier', 'silver');
            }
            localStorage.removeItem(key);
          }
        }
      }
    })();
  })();
`} />
</BaseLayout>

<style is:global>
  /* ─── PRICING HERO ─── */
  .pricing-hero {
    position: relative;
    padding: 140px 0 60px;
    text-align: center;
    background: var(--bg2);
    border-bottom: 1px solid var(--glass-border);
    overflow: hidden;
  }
  .pricing-hero::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -20%;
    width: 140%;
    height: 140%;
    background: radial-gradient(ellipse at 30% 50%, var(--pink-glow) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 50%, var(--gold-glow) 0%, transparent 60%);
    pointer-events: none;
    opacity: 0.5;
  }
  .pricing-hero-badge {
    display: inline-block;
    padding: 6px 20px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    background: var(--pink);
    color: #fff;
    margin-bottom: 16px;
  }
  .pricing-hero-title {
    font-family: var(--font-display);
    font-size: clamp(52px, 8vw, 110px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
    position: relative;
  }
  .pricing-hero-sub {
    font-size: 15px;
    color: var(--text2);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.7;
    position: relative;
  }

  /* ─── PRICING GRID ─── */
  .pricing-section {
    padding: 80px 0;
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
  }

  .pricing-card {
    background: var(--glass);
    backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    transition: all 0.4s var(--ease);
    position: relative;
  }
  .pricing-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--glass-shadow);
  }
  .pricing-card-popular {
    border-color: var(--gold);
    box-shadow: 0 0 0 1px var(--gold), 0 8px 32px var(--gold-glow);
    transform: scale(1.04);
    z-index: 2;
  }
  .pricing-card-popular:hover {
    transform: scale(1.04) translateY(-6px);
  }
  .pricing-popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 16px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    color: #1a1a1a;
    white-space: nowrap;
  }

  .pricing-card-header {
    text-align: center;
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--glass-border);
  }
  .pricing-emoji {
    font-size: 42px;
    margin-bottom: 8px;
    line-height: 1;
  }
  .pricing-tier-name {
    font-family: var(--font-display);
    font-size: 32px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .pricing-desc {
    font-size: 12px;
    color: var(--text2);
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .pricing-price-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
  }
  .pricing-price-val {
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
  }
  .pricing-price-period {
    font-size: 14px;
    color: var(--text3);
  }
  .pricing-price-free {
    font-size: 32px;
    font-weight: 800;
    color: var(--text3);
    line-height: 1;
  }

  .pricing-features {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    flex: 1;
  }
  .pricing-feat {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    font-size: 12px;
    border-bottom: 1px solid var(--glass-border);
  }
  .pricing-feat:last-child {
    border-bottom: none;
  }
  .pricing-feat-icon {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    flex-shrink: 0;
    background: rgba(0, 200, 83, 0.12);
    color: var(--pop-green);
  }
  .pricing-feat-no .pricing-feat-icon {
    background: rgba(0, 0, 0, 0.05);
    color: var(--text3);
  }
  .pricing-feat-text {
    color: var(--text);
    line-height: 1.4;
  }
  .pricing-feat-no .pricing-feat-text {
    color: var(--text3);
  }

  .pricing-card-footer {
    text-align: center;
  }

  .pricing-btn {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 700;
    font-family: var(--font-body);
    letter-spacing: 0.3px;
    transition: all 0.3s var(--ease);
    cursor: pointer;
    border: none;
    width: 100%;
    text-align: center;
  }
  .pricing-btn-outline {
    background: transparent;
    border: 1px solid var(--glass-border);
    color: var(--text);
  }
  .pricing-btn-outline:hover {
    border-color: var(--pink);
    background: var(--pink);
    color: #fff;
  }
  .pricing-btn-primary {
    background: var(--pink);
    color: #fff;
  }
  .pricing-btn-primary:hover {
    background: var(--pink-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--pink-glow);
  }
  .pricing-btn-glow {
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    color: #1a1a1a;
    box-shadow: 0 4px 20px var(--gold-glow);
  }
  .pricing-btn-glow:hover {
    background: linear-gradient(135deg, var(--gold-light), #FFE44D);
    box-shadow: 0 8px 32px var(--gold-glow);
    transform: translateY(-2px);
  }

  /* ─── COMPARISON TABLE ─── */
  .comparison-section {
    padding: 80px 0;
    background: var(--bg2);
  }
  .comparison-table-wrap {
    overflow-x: auto;
    max-width: 900px;
    margin: 0 auto;
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .comp-th {
    padding: 16px 20px;
    text-align: center;
    font-weight: 700;
    border-bottom: 2px solid var(--glass-border);
    white-space: nowrap;
  }
  .comp-th-label {
    text-align: left;
    color: var(--text2);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .comp-th[data-tier="basic"] { color: var(--text3); }
  .comp-th[data-tier="silver"] { color: var(--pop-green); }
  .comp-th[data-tier="gold"] { color: var(--gold); }
  .comp-th-highlight {
    background: var(--gold-soft);
    border-left: 1px solid var(--gold-glow);
    border-right: 1px solid var(--gold-glow);
  }
  .comp-tier-label {
    display: block;
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .comp-tier-price {
    display: block;
    font-size: 11px;
    font-weight: 400;
    opacity: 0.7;
  }
  .comp-row-alt {
    background: var(--surface);
  }
  .comp-td {
    padding: 12px 20px;
    text-align: center;
    border-bottom: 1px solid var(--glass-border);
  }
  .comp-td-label {
    text-align: left;
    color: var(--text);
    font-weight: 500;
  }
  .comp-td-check {
    color: var(--text3);
  }
  .comp-td[data-tier="silver"],
  .comp-td-highlight {
    color: var(--pop-green);
    font-weight: 600;
    border-left: 1px solid var(--gold-soft);
    border-right: 1px solid var(--gold-soft);
    background: rgba(0, 200, 83, 0.03);
  }

  /* ─── FAQ ─── */
  .faq-section {
    padding: 80px 0;
  }
  .faq-grid {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .faq-item {
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: all 0.3s var(--ease);
    background: var(--surface);
  }
  .faq-item:hover {
    border-color: var(--pink);
  }
  .faq-item[open] {
    border-color: var(--pink);
  }
  .faq-question {
    padding: 16px 20px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text);
    list-style: none;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-question::after {
    content: '+';
    font-size: 20px;
    color: var(--pink);
    font-weight: 300;
    transition: transform 0.3s;
  }
  .faq-item[open] .faq-question::after {
    content: '−';
  }
  .faq-answer {
    padding: 0 20px 16px;
    font-size: 13px;
    color: var(--text2);
    line-height: 1.7;
  }

  /* ─── CTA BANNER ─── */
  .cta-banner-section {
    padding: 60px 0 100px;
  }
  .cta-banner {
    text-align: center;
    background: linear-gradient(135deg, var(--pink), var(--tirol-pink-dark));
    border-radius: var(--radius-lg);
    padding: 60px 40px;
    position: relative;
