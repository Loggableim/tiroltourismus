---
import DetailPage from '../../sections/DetailPage.astro';
import PaywallOverlay from '../../components/PaywallOverlay.astro';
import { readEntry, readCollection, isPublished } from '../../lib/content.js';

export async function getStaticPaths() {
  const all = readCollection('unterkuenfte').filter(u => isPublished(u.entry));
  return all.map(u => ({ params: { slug: u.slug } }));
}

const { slug } = Astro.params;
const entry = readEntry('unterkuenfte', slug);
if (!entry) return Astro.redirect('/unterkuenfte/');

const typLabel = { hotel:'Hotel', ferienwohnung:'Ferienwohnung', bauernhof:'Bauernhof', jugendherberge:'Jugendherberge', camping:'Camping' };
const tier = entry.tier || 'basic';
const isBasic = tier === 'basic';
const isSilver = tier === 'silver';
const isGold = tier === 'gold';

const badge = {
  gold: { text:'⭐ Gold', cls:'tag-gold' },
  silver: { text:'Silber', cls:'tag-blue' },
  basic: { text:'Basic', cls:'tag-basic' },
}[tier] || null;

const emoji = entry.typ === 'camping' ? '🏕️' : (entry.emoji || '🏨');

// Free-Mium Tier-Logik:
// Basic: Hero + Kontaktdaten sichtbar, Rest hinter Paywall
// Silver: Alles (Beschreibung, Bilder, Bewertung, Kontakt)
// Gold: Alles + Hervorhebung/Gold-Styling

// Öffentlich sichtbare Sektionen für alle Tiers
const publicSections = [
  {
    type: 'hero',
    title: entry.name,
    subtitle: entry.ort ? `${entry.ort}${entry.plz ? `, ${entry.plz}` : ''}` : undefined,
    emoji: emoji,
    size: 'sm',
    bgImage: entry.hero_bild,
    meta: {
      stars: entry.sterne,
      badge: badge ? { text: badge.text, cls: badge.cls } : undefined,
      price: entry.preis_ab ? { value: `ab ${entry.preis_ab} €`, label: '/ Nacht' } : undefined,
    },
  },
];

// Basis-Kontaktdaten (Basic zeigt nur das)
const basicContactItems = [
  { label: 'Typ', value: typLabel[entry.typ] || entry.typ },
  { label: 'Adresse', value: entry.adresse ? `${entry.adresse}${entry.ort ? `, ${entry.ort}` : ''}` : entry.ort || undefined },
  { label: 'Telefon', value: entry.telefon || undefined, type: 'link', href: entry.telefon ? `tel:${entry.telefon}` : undefined },
  { label: 'E-Mail', value: entry.email || undefined, type: 'link', href: entry.email ? `mailto:${entry.email}` : undefined },
].filter(i => i.value);

// Premium-Sektionen (für Silver/Gold, hinter Paywall bei Basic)
const premiumSections = [];

// Beschreibung
if (entry.beschreibung) {
  premiumSections.push({
    type: 'description',
    label: 'Über diese Unterkunft',
    title: 'Beschreibung',
    content: entry.beschreibung,
  });
}

// Vollständige Details (für Silver/Gold)
if (!isBasic) {
  premiumSections.push({
    type: 'details-grid',
    items: [
      { label: 'Typ', value: typLabel[entry.typ] || entry.typ },
      { label: 'Adresse', value: entry.adresse ? `${entry.adresse}${entry.ort ? `, ${entry.ort}` : ''}` : entry.ort || undefined },
      { label: 'Telefon', value: entry.telefon || undefined, type: 'link', href: entry.telefon ? `tel:${entry.telefon}` : undefined },
      { label: 'E-Mail', value: entry.email || undefined, type: 'link', href: entry.email ? `mailto:${entry.email}` : undefined },
      { label: 'Webseite', value: entry.webseite || undefined, type: 'link', href: entry.webseite },
      { label: 'Ausstattung', tags: entry.ausstattung || [], type: 'tags' },
      { label: 'Tags', tags: entry.tags || [], type: 'tags' },
    ].filter(Boolean),
  });
}

// Preis
if (!isBasic && entry.preis_ab) {
  premiumSections.push({
    type: 'price',
    value: entry.preis_ab,
    label: '/ Nacht',
    extras: entry.preis_extras || [],
  });
}

// CTA
if (!isBasic) {
  premiumSections.push({
    type: 'cta',
    label: 'Interesse?',
    title: 'Jetzt anfragen',
    subtitle: 'Kontaktieren Sie die Unterkunft direkt für Buchungen und Anfragen.',
    buttons: [
      entry.telefon ? { label: `📞 ${entry.telefon}`, href: `tel:${entry.telefon}`, variant: 'pink' } : null,
      entry.email ? { label: '✉️ E-Mail senden', href: `mailto:${entry.email}`, variant: 'glass' } : null,
    ].filter(Boolean),
  });
}

// Zusammensetzen
let allSections;
if (isBasic) {
  // Basic: Hero + Basis-Kontaktdaten
  allSections = [
    ...publicSections,
    {
      type: 'details-grid',
      items: basicContactItems,
    },
  ];
} else {
  // Silver/Gold: Hero + Premium-Inhalte
  allSections = [
    ...publicSections,
    ...premiumSections,
  ];
}
---

<DetailPage
  title={entry.name}
  description={`${entry.name} – ${entry.ort || 'Tirol'}. ${(entry.typ && typLabel[entry.typ]) || 'Unterkunft'}`}
  breadcrumbs={[{ label: 'Unterkünfte', href: '/unterkuenfte/' }, { label: entry.name }]}
  sections={allSections}
/>

<!-- Basic: Premium-Inhalte hinter Paywall-Overlay -->
{isBasic && (
  <section class="section paywall-restricted">
    <div class="container" style="position:relative;max-width:800px">
      <PaywallOverlay name={entry.name} slug={slug} />
      <!-- Verdeckte Premium-Inhalte (Blur + Overlay) -->
      <div class="paywall-hidden-content">
        {entry.beschreibung && (
          <div class="paywall-teaser">
            <div class="paywall-teaser-label">Beschreibung</div>
            <p class="paywall-teaser-preview">
              {entry.beschreibung.replace(/<[^>]*>/g, '').substring(0, 120)}...
            </p>
          </div>
        )}
        <div class="paywall-teaser">
          <div class="paywall-teaser-label">Details & Ausstattung</div>
          <div class="paywall-teaser-tags">
            {(entry.ausstattung || []).slice(0, 3).map(t => <span class="tag">{t}</span>)}
            {(entry.ausstattung || []).length > 3 && <span class="tag tag-more">+{entry.ausstattung.length - 3}</span>}
          </div>
        </div>
        {entry.preis_ab && (
          <div class="paywall-teaser">
            <div class="paywall-teaser-label">Preise & Buchung</div>
            <p class="paywall-teaser-preview">ab {entry.preis_ab} Euro/Nacht - Alle Preise und Buchungsdetails</p>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<!-- --- TIER-SPEZIFISCHE STYLES --- -->

<!-- GOLD: Highlighting -->
{isGold && (
  <style is:global>
    .sec-hero { background: var(--gold-soft) !important; border-bottom-color: rgba(212,168,0,.15) !important; }
    .sec-hero-badge.tag-gold { background: linear-gradient(135deg, var(--yellow), #F59E0B); color: #1a1a1a; font-weight: 800; padding: 6px 18px; }
    .sec-hero-price-val { color: var(--gold) !important; }
  </style>
)}

<!-- BASIC: Gedämpfter Stil -->
{isBasic && (
  <style is:global>
    .sec-hero-badge.tag-basic { background: var(--surface); border: 1px solid var(--glass-border); color: var(--text3); }
    .sec-hero { opacity: 0.85; }
  </style>
)}

<style is:global>
  /* Paywall-Hidden-Content */
  .paywall-hidden-content {
    opacity: 0.3;
    filter: blur(4px);
    pointer-events: none;
    user-select: none;
    padding: 40px 0;
  }
  .paywall-teaser { margin-bottom: 32px; }
  .paywall-teaser-label { font-family: var(--font-display); font-size: 22px; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; color: var(--text); }
  .paywall-teaser-preview { font-size: 14px; color: var(--text2); line-height: 1.6; }
  .paywall-teaser-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .paywall-teaser-tags .tag { padding: 4px 10px; border-radius: 100px; font-size: 10px; font-weight: 600; background: var(--surface); border: 1px solid var(--glass-border); color: var(--text2); }
  .tag-more { color: var(--text3) !important; }
  .paywall-restricted { padding-top: 0 !important; }
  @media (max-width: 768px) { .paywall-hidden-content { padding: 24px 0; } }
</style>
