---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import AccommodationCard from '../../components/AccommodationCard.astro';
import { readCollection, isPublished } from '../../lib/content.js';

const unterkuenfte = readCollection('unterkuenfte').filter(u => isPublished(u.entry));
const sorted = unterkuenfte.sort((a, b) => {
  const order = { gold: 0, silver: 1, basic: 2 };
  return (order[a.entry.tier || 'basic'] || 2) - (order[b.entry.tier || 'basic'] || 2);
});
---

<BaseLayout
  title="Unterkünfte in Tirol"
  description="Finde Dein Zuhause in Tirol. Hotels, Ferienwohnungen & Bauernhöfe – von luxuriös bis urig."
>
  <main>
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Startseite</a><span class="sep">›</span><span>Unterkünfte</span>
      </div>
    </div>

    <section class="page-header">
      <div class="container">
        <h1 class="reveal">Finde Dein Zuhause in Tirol</h1>
        <p class="reveal r2">
          Von luxuriösen Wellness-Hotels über urige Berghütten bis zu
          familiengeführten Bauernhöfen – hier wirst Du fündig.
        </p>
      </div>
    </section>

    {sorted.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHeader
            label="Buchen & Träumen"
            title="Unterkünfte in Tirol"
            sub="Von ★★★★★ Luxusresorts bis zu gemütlichen Bauernhöfen – finde den Ort, der zu Dir passt."
          />

          <div class="tab-switcher reveal r1">
            <button class="tab-btn active" data-tier="alle">Alle</button>
            <button class="tab-btn" data-tier="gold">⭐ Gold</button>
            <button class="tab-btn" data-tier="silver">Silber</button>
          </div>

          <div class="uk-grid">
            {sorted.map((u, i) => (
              <AccommodationCard
                name={u.entry.name}
                slug={u.slug}
                typ={u.entry.typ}
                ort={u.entry.ort}
                sterne={u.entry.sterne}
                preis_ab={u.entry.preis_ab}
                tier={u.entry.tier || 'basic'}
                data-tier={u.entry.tier || 'basic'}
              />
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">🏨</div>
          <h2
            style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase"
          >
            Bald verfügbar
          </h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">
            Unterkünfte werden aktuell eingepflegt. Schau bald wieder vorbei!
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  .page-header {
    position: relative;
    padding: 60px 0 40px;
    text-align: center;
    background: var(--bg2);
    border-bottom: 1px solid var(--glass-border);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-header p {
    font-size: 15px;
    color: var(--text2);
    max-width: 480px;
    margin: 0 auto;
  }

  .uk-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 968px) {
    .uk-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 550px) {
    .uk-grid { grid-template-columns: 1fr; }
  }

  .tab-switcher {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-bottom: 32px;
    background: var(--surface);
    padding: 4px;
    border-radius: 100px;
    max-width: 420px;
    margin-left: auto;
    margin-right: auto;
    border: 1px solid var(--glass-border);
  }
  .tab-btn {
    padding: 10px 24px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--text2);
    transition: all 0.3s;
    cursor: pointer;
    border: none;
    background: transparent;
  }
  .tab-btn.active {
    background: var(--pink);
    color: #fff;
    box-shadow: 0 4px 16px var(--pink-glow);
  }
  .tab-btn:hover:not(.active) {
    color: var(--text);
    background: var(--bg1);
  }
</style>
