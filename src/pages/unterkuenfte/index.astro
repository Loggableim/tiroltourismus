---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SectionMap from '../../sections/SectionMap.astro';
import AccommodationCard from '../../components/AccommodationCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { readCollection, isPublished } from '../../lib/content.js';

const unterkuenfte = readCollection('unterkuenfte').filter(u => isPublished(u.entry));
const unterkunftMitCoords = unterkuenfte.filter(u => u.entry.koordinaten?.lat && u.entry.koordinaten?.lng);
const sorted = unterkuenfte.sort((a, b) => {
  const order = { gold: 0, silver: 1, basic: 2 };
  return (order[a.entry.tier || 'basic'] || 2) - (order[b.entry.tier || 'basic'] || 2);
});

// JSON-LD: ItemList
const siteURL = 'https://www.tirol-tourismus.at';
const accommodationItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Unterkünfte in Tirol',
  description: 'Finde Dein Zuhause in Tirol. Hotels, Ferienwohnungen & Bauernhöfe – von luxuriös bis urig.',
  url: `${siteURL}/unterkuenfte/`,
  numberOfItems: unterkuenfte.length,
  itemListElement: sorted.slice(0, 30).map((u, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: u.entry.name,
    url: `${siteURL}/unterkuenfte/${u.slug}/`,
  })),
};
---

<BaseLayout
  title="Unterkünfte in Tirol"
  description="Finde Dein Zuhause in Tirol. Hotels, Ferienwohnungen & Bauernhöfe – von luxuriös bis urig."
  jsonld={accommodationItemList}
>
  <main>
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Startseite</a><span class="sep">›</span><span>Unterkünfte</span>
      </div>
    </div>

    <section class="page-header">
      <div class="container">
        <h1 class="reveal">Finde Dein Zuhause in Tirol</h1>
        <p class="reveal r2">
          Von luxuriösen Wellness-Hotels über urige Berghütten zu familiengeführten
          Bauernhöfen und 236 Campingplätzen – hier wirst Du fündig.
        </p>
      </div>
    </section>

    {unterkunftMitCoords.length > 0 && (
      <SectionMap
        markers={unterkunftMitCoords.map(u => ({
          lat: u.entry.koordinaten.lat,
          lng: u.entry.koordinaten.lng,
          label: u.entry.name,
          emoji: u.entry.typ === 'camping' ? '🏕️' : (u.entry.emoji || '🏨'),
          href: '/unterkuenfte/' + u.slug + '/',
          category: 'unterkuenfte',
        }))}
        label={unterkunftMitCoords.length + ' Unterkünfte'}
        title="Auf einen Blick"
        height="380px"
        scrollWheelZoom={true}
        filterable={true}
      />
    )}

    {sorted.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHeader
            label="Übernachten & Träumen"
            title="Unterkünfte in Tirol"
            sub="Von ★★★★★ Luxusresorts bis zu gemütlichen Bauernhöfen – finde den Ort, der zu Dir passt."
          />

          <div class="filter-row reveal r1">
            <FilterBar
              keyName="typ"
              ariaLabel="Unterkünfte nach Typ filtern"
              options={[
                { value: 'hotel', label: '🏨 Hotel' },
                { value: 'ferienwohnung', label: '🏠 Ferienwohnung' },
                { value: 'camping', label: '⛺ Camping' },
                { value: 'bauernhof', label: '🐄 Bauernhof' },
                { value: 'jugendherberge', label: '🎒 Jugendherberge' },
              ]}
            />
            <FilterBar
              keyName="tier"
              compact
              ariaLabel="Unterkünfte nach Kategorie filtern"
              options={[
                { value: 'gold', label: '⭐ Gold' },
                { value: 'silver', label: 'Silber' },
                { value: 'basic', label: 'Basic' },
              ]}
            />
          </div>

          <div class="uk-grid">
            {sorted.map((u, i) => (
              <AccommodationCard
                name={u.entry.name}
                slug={u.slug}
                typ={u.entry.typ}
                ort={u.entry.ort}
                sterne={u.entry.sterne}
                preis_ab={u.entry.preis_ab}
                tier={u.entry.tier || 'basic'}
                data-tier={u.entry.tier || 'basic'}
              />
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">🏨</div>
          <h2
            style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase"
          >
            Bald verfügbar
          </h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">
            Unterkünfte werden aktuell eingepflegt. Schau bald wieder vorbei!
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>


<style is:global>
  .page-header {
    position: relative;
    padding: 60px 0 40px;
    text-align: center;
    background: var(--bg2);
    border-bottom: 1px solid var(--glass-border);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-header p {
    font-size: 15px;
    color: var(--text2);
    max-width: 480px;
    margin: 0 auto;
  }

  .uk-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 968px) {
    .uk-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 550px) {
    .uk-grid { grid-template-columns: 1fr; }
  }

</style>
