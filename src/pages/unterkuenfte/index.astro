---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SectionMap from '../../sections/SectionMap.astro';
import AccommodationCard from '../../components/AccommodationCard.astro';
import { readCollection, isPublished } from '../../lib/content.js';

const unterkuenfte = readCollection('unterkuenfte').filter(u => isPublished(u.entry));
const unterkunftMitCoords = unterkuenfte.filter(u => u.entry.koordinaten?.lat && u.entry.koordinaten?.lng);
const sorted = unterkuenfte.sort((a, b) => {
  const order = { gold: 0, silver: 1, basic: 2 };
  return (order[a.entry.tier || 'basic'] || 2) - (order[b.entry.tier || 'basic'] || 2);
});
---

<BaseLayout
  title="Unterkünfte in Tirol"
  description="Finde Dein Zuhause in Tirol. Hotels, Ferienwohnungen & Bauernhöfe – von luxuriös bis urig."
>
  <main>
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Startseite</a><span class="sep">›</span><span>Unterkünfte</span>
      </div>
    </div>

    <section class="page-header">
      <div class="container">
        <h1 class="reveal">Finde Dein Zuhause in Tirol</h1>
        <p class="reveal r2">
          Von luxuriösen Wellness-Hotels über urige Berghütten zu familiengeführten
          Bauernhöfen und 236 Campingplätzen – hier wirst Du fündig.
        </p>
      </div>
    </section>

    {unterkunftMitCoords.length > 0 && (
      <SectionMap
        markers={unterkunftMitCoords.map(u => ({
          lat: u.entry.koordinaten.lat,
          lng: u.entry.koordinaten.lng,
          label: u.entry.name,
          emoji: u.entry.typ === 'camping' ? '🏕️' : (u.entry.emoji || '🏨'),
          href: '/unterkuenfte/' + u.slug + '/',
          category: 'unterkuenfte',
        }))}
        label={unterkunftMitCoords.length + ' Unterkünfte'}
        title="Auf einen Blick"
        height="380px"
        scrollWheelZoom={true}
        filterable={true}
      />
    )}

    {sorted.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHeader
            label="Übernachten & Träumen"
            title="Unterkünfte in Tirol"
            sub="Von ★★★★★ Luxusresorts bis zu gemütlichen Bauernhöfen – finde den Ort, der zu Dir passt."
          />

          <div class="filter-row reveal r1">
            <!-- Type filter row -->
            <div class="tab-switcher tab-switcher-typ" data-filter="typ">
              <button class="tab-btn active" data-typ="alle">Alle Typen</button>
              <button class="tab-btn" data-typ="hotel">🏨 Hotel</button>
              <button class="tab-btn" data-typ="ferienwohnung">🏠 Ferienwohnung</button>
              <button class="tab-btn" data-typ="camping">⛺ Camping</button>
              <button class="tab-btn" data-typ="bauernhof">🐄 Bauernhof</button>
              <button class="tab-btn" data-typ="jugendherberge">🎒 Jugendherberge</button>
            </div>
            <!-- Tier filter row -->
            <div class="tab-switcher tab-switcher-tier" data-filter="tier" style="margin-top:8px">
              <button class="tab-btn active" data-tier="alle">Alle Stufen</button>
              <button class="tab-btn" data-tier="gold">⭐ Gold</button>
              <button class="tab-btn" data-tier="silver">Silber</button>
              <button class="tab-btn" data-tier="basic">Basic</button>
            </div>
          </div>

          <div class="uk-grid">
            {sorted.map((u, i) => (
              <AccommodationCard
                name={u.entry.name}
                slug={u.slug}
                typ={u.entry.typ}
                ort={u.entry.ort}
                sterne={u.entry.sterne}
                preis_ab={u.entry.preis_ab}
                tier={u.entry.tier || 'basic'}
                data-tier={u.entry.tier || 'basic'}
              />
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container" style="text-align:center;padding:60px 0">
          <div style="font-size:64px;margin-bottom:16px">🏨</div>
          <h2
            style="font-family:var(--font-display);font-size:32px;margin-bottom:12px;letter-spacing:1px;text-transform:uppercase"
          >
            Bald verfügbar
          </h2>
          <p style="color:var(--text2);max-width:400px;margin:0 auto;line-height:1.6">
            Unterkünfte werden aktuell eingepflegt. Schau bald wieder vorbei!
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<script is:inline>
(function() {
  var typButtons = document.querySelectorAll('.tab-switcher-typ .tab-btn');
  var tierButtons = document.querySelectorAll('.tab-switcher-tier .tab-btn');
  var cards = document.querySelectorAll('.uk-card');

  function applyFilters() {
    var activeTyp = 'alle';
    var activeTier = 'alle';
    document.querySelectorAll('.tab-switcher-typ .tab-btn.active').forEach(function(b) {
      if (b.getAttribute('data-typ')) activeTyp = b.getAttribute('data-typ');
    });
    document.querySelectorAll('.tab-switcher-tier .tab-btn.active').forEach(function(b) {
      if (b.getAttribute('data-tier')) activeTier = b.getAttribute('data-tier');
    });
    cards.forEach(function(card) {
      var cardTyp = card.getAttribute('data-typ') || 'unknown';
      var cardTier = card.getAttribute('data-tier') || 'basic';
      var showTyp = activeTyp === 'alle' || cardTyp === activeTyp;
      var showTier = activeTier === 'alle' || cardTier === activeTier;
      card.style.display = (showTyp && showTier) ? '' : 'none';
    });
  }

  function setupTabGroup(buttons) {
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var parent = this.parentNode;
        parent.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
        this.classList.add('active');
        applyFilters();
      });
    });
  }

  setupTabGroup(typButtons);
  setupTabGroup(tierButtons);
})();
</script>

<style is:global>
  .page-header {
    position: relative;
    padding: 60px 0 40px;
    text-align: center;
    background: var(--bg2);
    border-bottom: 1px solid var(--glass-border);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-header p {
    font-size: 15px;
    color: var(--text2);
    max-width: 480px;
    margin: 0 auto;
  }

  .uk-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 968px) {
    .uk-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 550px) {
    .uk-grid { grid-template-columns: 1fr; }
  }

  .tab-switcher {
    display: flex;
    justify-content: center;
    gap: 6px;
    background: var(--surface);
    padding: 4px;
    border-radius: 100px;
    max-width: 420px;
    margin-left: auto;
    margin-right: auto;
    border: 1px solid var(--glass-border);
  }
  .filter-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin-bottom: 32px;
  }
  .tab-switcher-typ {
    max-width: 680px;
    flex-wrap: wrap;
  }
  .tab-switcher-tier {
    max-width: 420px;
  }
  .tab-btn {
    padding: 10px 24px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--text2);
    transition: all 0.3s;
    cursor: pointer;
    border: none;
    background: transparent;
  }
  .tab-btn.active {
    background: var(--pink);
    color: #fff;
    box-shadow: 0 4px 16px var(--pink-glow);
  }
  .tab-btn:hover:not(.active) {
    color: var(--text);
    background: var(--bg1);
  }

  @media (max-width: 700px) {
    .tab-switcher {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      flex-wrap: nowrap;
      justify-content: flex-start;
      max-width: none;
      border-radius: 100px;
      scrollbar-width: none;
    }
    .tab-switcher::-webkit-scrollbar { display: none; }
    .tab-btn {
      padding: 8px 14px;
      font-size: 11px;
      white-space: nowrap;
      flex-shrink: 0;
    }
  }
</style>
