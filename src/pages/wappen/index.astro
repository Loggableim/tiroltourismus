---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const data = JSON.parse(
  readFileSync(resolve(process.cwd(), 'wappen/wappen_page_data.json'), 'utf-8')
);

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/ä/g, 'ae')
    .replace(/ö/g, 'oe')
    .replace(/ü/g, 'ue')
    .replace(/ß/g, 'ss')
    .replace(/\./g, '')
    .replace(/\s+/g, '_')
    .replace(/-/g, '_');

const districts = data.bezirke.map((bezirk: any) => ({
  ...bezirk,
  publicImg: `/wappen/${bezirk.img.replace(/^img\//, '')}`,
  orte: bezirk.orte.map((ort: any) => ({
    ...ort,
    slug: slugify(ort.name),
    publicImg: `/wappen/ultra-minimal/${bezirk.key}/${slugify(ort.name)}.png`,
  })),
}));

const totalOrte = districts.reduce((sum: number, d: any) => sum + d.orte.length, 0);
---
<BaseLayout
  title="Wappen Tirol"
  description="Alle Tiroler Bezirks- und Ortswappen in einer schnellen, modernen Übersicht – gruppiert nach Bezirk und mit klickbaren Detailkacheln."
>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Wappen Tirol' }]} />
    </div>

    <section class="wappen-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow">Ultraminimaler Wappen-Atlas</div>
          <h1>Alle Wappen Tirols</h1>
          <p>
            Bezirke oben, darunter die zugehörigen Orte. Die Wappen sind bewusst als
            ultrareduzierte, moderne Embleme gestaltet – nicht als klassische, detailverliebte
            Heraldik-Kopien.
          </p>
          <div class="hero-meta">
            <div><strong>{districts.length}</strong><span>Bezirke</span></div>
            <div><strong>{totalOrte}</strong><span>Ortswappen</span></div>
            <div><strong>1</strong><span>gemeinsame Stilrichtung</span></div>
          </div>
        </div>
        <div class="hero-panel">
          <div class="panel-title">Schnellnavigation</div>
          <div class="district-pills">
            {districts.map((d: any) => (
              <a href={`#${d.key}`}>{d.name}</a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="container">
        <div class="intro-card">
          <div>
            <h2>So funktioniert die Seite</h2>
            <p>
              Jeder Bezirk ist als eigene Karte angelegt. Klick auf einen Bezirk, um die dazugehörigen
              Orte als Wappen-Galerie zu sehen.
            </p>
          </div>
          <a href="#imst" class="intro-link">Direkt zu den Bezirken →</a>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0;padding-bottom:80px">
      <div class="container">
        <div class="district-stack">
          {districts.map((d: any, idx: number) => (
            <details id={d.key} class={`district-block ${idx === 0 ? 'open' : ''}`} open={idx === 0}>
              <summary class="district-summary">
                <div class="summary-copy">
                  <div class="summary-topline">Bezirk</div>
                  <h2>{d.name}</h2>
                  <p>{d.orte.length} Ortswappen in dieser Gruppe</p>
                </div>
                <div class="summary-badge">
                  <img src={d.publicImg} alt={`${d.name} Wappen`} loading="lazy" decoding="async" width="180" height="180">
                </div>
              </summary>

              <div class="district-body">
                <div class="district-lead">
                  <div class="district-info">
                    <span class="district-label">Bezirk Wappen</span>
                    <p>
                      Das Bezirkswappen dient als Einstieg. Darunter findest du alle Orte als
                      einheitliche, ultraminimale Varianten.
                    </p>
                  </div>
                  <a href={`/bezirke/${d.key}/`} class="district-detail-link">Bezirk ansehen →</a>
                </div>

                <div class="wappen-grid">
                  {d.orte.map((ort: any) => (
                    <a href={`/bezirke/${d.key}/`} class="wappen-card" title={ort.name}>
                      <img src={ort.publicImg} alt={ort.name} loading="lazy" decoding="async" width="420" height="540">
                      <div class="wappen-card-label">{ort.name}</div>
                    </a>
                  ))}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .wappen-hero {
    padding: 44px 0 24px;
    border-bottom: 1px solid var(--glass-border);
    background: linear-gradient(180deg, rgba(255, 20, 147, 0.04), transparent 70%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(320px, 0.9fr);
    gap: 24px;
    align-items: stretch;
  }
  .hero-copy, .hero-panel, .intro-card, .district-block {
    background: var(--bg);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    box-shadow: var(--glass-shadow);
  }
  .hero-copy {
    padding: 32px;
  }
  .eyebrow {
    font-family: var(--font-display);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--pink);
    font-size: 14px;
    margin-bottom: 12px;
  }
  .hero-copy h1 {
    font-family: var(--font-display);
    font-size: clamp(44px, 6.2vw, 86px);
    line-height: .94;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .hero-copy p {
    max-width: 58ch;
    color: var(--text2);
    font-size: 15px;
    line-height: 1.75;
  }
  .hero-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }
  .hero-meta div {
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--bg2);
    border: 1px solid var(--glass-border);
  }
  .hero-meta strong {
    display: block;
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }
  .hero-meta span {
    display: block;
    color: var(--text3);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  .hero-panel {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .panel-title, .district-label, .summary-topline {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--text3);
    font-weight: 700;
  }
  .district-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .district-pills a {
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    color: var(--text);
    text-decoration: none;
    font-size: 13px;
    transition: all .2s var(--ease);
  }
  .district-pills a:hover {
    border-color: var(--pink);
    color: var(--pink);
    transform: translateY(-1px);
  }
  .intro-card {
    padding: 20px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
  }
  .intro-card h2 {
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .intro-card p { color: var(--text2); line-height: 1.65; }
  .intro-link, .district-detail-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--pink);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }
  .district-stack { display: flex; flex-direction: column; gap: 18px; }
  .district-block { overflow: hidden; }
  .district-summary {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 20px 22px;
    cursor: pointer;
  }
  .district-summary::-webkit-details-marker { display: none; }
  .district-summary h2 {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 5px 0 8px;
  }
  .district-summary p { color: var(--text2); font-size: 14px; }
  .summary-badge {
    width: 110px;
    height: 110px;
    border-radius: 24px;
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .summary-badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10px;
  }
  .district-body {
    padding: 0 22px 22px;
    border-top: 1px solid var(--glass-border);
  }
  .district-lead {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    padding: 18px 0 18px;
  }
  .district-info p {
    color: var(--text2);
    max-width: 68ch;
    line-height: 1.7;
    margin-top: 4px;
  }
  .wappen-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
  }
  .wappen-card {
    text-decoration: none;
    color: var(--text);
    background: var(--bg2);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    overflow: hidden;
    transition: all .22s var(--ease);
  }
  .wappen-card:hover {
    transform: translateY(-2px);
    border-color: var(--pink);
    box-shadow: 0 10px 24px rgba(255,20,147,.12);
  }
  .wappen-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: contain;
    background: #fff;
    display: block;
    padding: 8px;
  }
  .wappen-card-label {
    padding: 10px 12px 12px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
  }
  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-meta { grid-template-columns: 1fr; }
    .district-lead { flex-direction: column; align-items: start; }
  }
  @media (max-width: 700px) {
    .hero-copy, .hero-panel, .intro-card, .district-summary, .district-body { padding-left: 16px; padding-right: 16px; }
    .intro-card { flex-direction: column; align-items: start; }
    .summary-badge { width: 84px; height: 84px; border-radius: 18px; }
  }
</style>
