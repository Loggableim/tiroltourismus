---
export interface Props {
  emoji?: string;
  image?: string;
  category?: string;
  categoryColor?: string;
  date?: string;
  author?: string;
  title: string;
  teaser?: string;
}

const {
  emoji,
  image,
  category,
  categoryColor,
  date,
  author,
  title,
  teaser,
} = Astro.props;
---

<header class="sec-art-hero">
  {image && <img src={image} alt={title} class="sec-art-bg" loading="eager" decoding="async" fetchpriority="high" width="1200" height="600" />}
  <div class="container">
    {emoji && <div class="sec-art-emoji">{emoji}</div>}
    <div class="sec-art-meta">
      {category && (
        <span
          class="sec-art-cat"
          style={categoryColor ? `background:${categoryColor}` : ''}
        >
          {category}
        </span>
      )}
      {date && <span class="sec-art-date">{date}</span>}
      {author && <span class="sec-art-author">• {author}</span>}
    </div>
    <h1>{title}</h1>
    {teaser && <p class="sec-art-teaser">{teaser}</p>}
  </div>
</header>

<style is:global>
  .sec-art-hero {
    position: relative;
    padding: 60px 0 50px;
    text-align: center;
    background: var(--bg2);
    border-bottom: 1px solid var(--glass-border);
    overflow: hidden;
  }
  .sec-art-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: 0.22;
    pointer-events: none;
    filter: blur(2px);
  }
  .sec-art-hero .container {
    position: relative;
    z-index: 1;
  }
  .sec-art-emoji {
    font-size: 48px;
    line-height: 1;
    margin-bottom: 12px;
  }
  .sec-art-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .sec-art-cat {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--tirol-pink);
    color: #fff;
  }
  .sec-art-date,
  .sec-art-author {
    font-size: 12px;
    color: var(--text3);
  }
  .sec-art-author {
    font-weight: 500;
  }
  .sec-art-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 56px);
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 12px 0;
    color: var(--text);
  }
  .sec-art-teaser {
    font-size: 16px;
    color: var(--text2);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .sec-art-hero {
      padding: 44px 0 36px;
    }
    .sec-art-emoji {
      font-size: 40px;
    }
    .sec-art-hero h1 {
      font-size: clamp(26px, 4.5vw, 42px);
    }
    .sec-art-teaser {
      font-size: 15px;
    }
  }

  @media (max-width: 480px) {
    .sec-art-hero {
      padding: 32px 0 28px;
    }
    .sec-art-emoji {
      font-size: 32px;
    }
    .sec-art-hero h1 {
      font-size: clamp(22px, 5vw, 28px);
    }
    .sec-art-teaser {
      font-size: 14px;
    }
    .sec-art-meta {
      gap: 6px;
    }
  }
</style>
