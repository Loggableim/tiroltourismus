---
export interface Props {
  buttons: Array<{
    label: string;
    href: string;
    variant?: 'pink' | 'glass' | 'outline';
    icon?: string;
  }>;
  label?: string;
  title?: string;
  subtitle?: string;
}

const { buttons, label, title, subtitle } = Astro.props;
---

<section class="sec-cta">
  <div class="container" style="text-align:center">
    {(label || title) && (
      <div class="section-header" style="margin-bottom:24px">
        {label && <div class="section-label">{label}</div>}
        {title && <h2 class="section-title" style="font-size:clamp(28px,4vw,48px)">{title}</h2>}
        {subtitle && <p class="section-desc">{subtitle}</p>}
      </div>
    )}
    <div class="sec-cta-buttons">
      {buttons.map(btn => (
        <a href={btn.href} class={`btn btn-${btn.variant || 'pink'}`}>
          {btn.icon && <span>{btn.icon}</span>}
          {btn.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .sec-cta {
    padding: 60px 0;
    background: rgba(255, 20, 147, 0.04);
    border-top: 1px solid var(--glass-border);
  }

  .sec-cta-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .sec-cta {
      padding: 44px 0;
    }
    .sec-cta-buttons {
      flex-direction: column;
    }
    .sec-cta-buttons .btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .sec-cta {
      padding: 36px 0;
    }
    .sec-cta .section-title {
      font-size: clamp(22px, 6vw, 32px) !important;
    }
  }
</style>
