---
// Komponente: SectionHero – Hero-Bereich für Detailseiten
// Styling-Klasse-Prefix: sec-
// Props
export interface Props {
  title: string;
  subtitle?: string;
  emoji?: string;
  gradient?: string; // Hex-Farbe für Akzent
  size?: 'sm' | 'md'; // Standard 'sm'
  bgImage?: string; // URL zum Hero-Hintergrundbild (z.B. /images/unterkuenfte/hotel-xyz/hero.webp)
  meta?: {
    stars?: number;
    badge?: { text: string; cls: string };
    price?: { value: string | number; label?: string };
  };
}

const { title, subtitle, emoji, gradient, size = 'sm', bgImage, meta } = Astro.props;
---

<section class={`sec-hero sec-hero-${size}${bgImage ? ' sec-hero-has-img' : ''}`} style={bgImage ? `background-image:url(${bgImage})` : ''}>
  {bgImage && <div class="sec-hero-img-overlay"></div>}
  {gradient && !bgImage && (
    <div class="sec-hero-bg" style={`background:${gradient}15`}>
      <div class="sec-hero-blob" style={`background:${gradient}`}></div>
    </div>
  )}
  <div class="container">
    {emoji && <div class="sec-hero-emoji">{emoji}</div>}
    <h1>{title}</h1>
    {subtitle && <p class="sec-hero-sub">{subtitle}</p>}
    {meta && (
      <div class="sec-hero-meta">
        {meta.stars && (
          <div class="sec-hero-stars">
            {'★'.repeat(meta.stars)}{'☆'.repeat(5 - meta.stars)}
          </div>
        )}
        {meta.badge && (
          <span class={`sec-hero-badge ${meta.badge.cls}`}>
            {meta.badge.text}
          </span>
        )}
        {meta.price && (
          <div class="sec-hero-price">
            <span class="sec-hero-price-val">{meta.price.value}</span>
            {meta.price.label && (
              <span class="sec-hero-price-label">{meta.price.label}</span>
            )}
          </div>
        )}
      </div>
    )}
    <slot name="actions" />
  </div>
</section>

<style is:global>
  /* === SectionHero === */
  .sec-hero {
    position: relative;
    text-align: center;
    overflow: hidden;
  }

  /* Size: sm */
  .sec-hero-sm {
    padding: 60px 0 40px;
    background: var(--bg2);
    border-bottom: 1px solid var(--glass-border);
  }

  /* Size: sm with background image */
  .sec-hero-sm.sec-hero-has-img {
    padding: 80px 0 60px;
    background-size: cover;
    background-position: center center;
    position: relative;
  }

  /* Size: md */
  .sec-hero-md {
    padding: 80px 0 60px;
    min-height: 40vh;
    display: flex;
    align-items: center;
  }

  /* Size: md with background image */
  .sec-hero-md.sec-hero-has-img {
    min-height: 50vh;
    background-size: cover;
    background-position: center center;
    position: relative;
  }

  /* Background image overlay */
  .sec-hero-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.6) 100%);
    z-index: 0;
    pointer-events: none;
  }

  /* Text readability over background images */
  .sec-hero-has-img .sec-hero-emoji,
  .sec-hero-has-img h1,
  .sec-hero-has-img .sec-hero-sub,
  .sec-hero-has-img .sec-hero-meta {
    color: #fff !important;
  }

  /* Hintergrund-Elemente */
  .sec-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .sec-hero-blob {
    width: 400px;
    height: 400px;
    border-radius: 50%;
    position: absolute;
    top: -100px;
    right: -100px;
    opacity: 0.12;
    filter: blur(60px);
  }

  /* Emoji */
  .sec-hero-emoji {
    font-size: 56px;
    display: block;
    margin-bottom: 8px;
    position: relative;
    z-index: 1;
  }

  /* Titel */
  .sec-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
    position: relative;
    z-index: 1;
  }

  .sec-hero-md h1 {
    font-size: clamp(48px, 7vw, 80px);
  }

  /* Subtitle */
  .sec-hero-sub {
    font-size: 15px;
    color: var(--text2);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  /* Meta-Bereich */
  .sec-hero-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 16px;
    position: relative;
    z-index: 1;
  }

  .sec-hero-stars {
    font-size: 20px;
    color: var(--yellow);
    letter-spacing: 4px;
  }

  .sec-hero-badge {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sec-hero-price {
    text-align: center;
  }

  .sec-hero-price-val {
    font-family: var(--font-display);
    font-size: 28px;
    letter-spacing: 1px;
    color: var(--pink);
    display: block;
  }

  .sec-hero-price-label {
    font-size: 12px;
    color: var(--text3);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .sec-hero-sm {
      padding: 40px 0 28px;
    }
    .sec-hero-meta {
      gap: 12px;
    }
    .sec-hero-emoji {
      font-size: 44px;
    }
    .sec-hero h1 {
      font-size: clamp(30px, 5vw, 48px);
    }
    .sec-hero-md h1 {
      font-size: clamp(36px, 7vw, 60px);
    }
    .sec-hero-sub {
      font-size: 14px;
    }
  }

  @media (max-width: 480px) {
    .sec-hero-sm {
      padding: 32px 0 24px;
    }
    .sec-hero-sm.sec-hero-has-img {
      padding: 48px 0 36px;
    }
    .sec-hero-md {
      padding: 48px 0 36px;
    }
    .sec-hero-emoji {
      font-size: 36px;
    }
    .sec-hero h1 {
      font-size: clamp(24px, 5vw, 32px);
      letter-spacing: 1px;
    }
    .sec-hero-md h1 {
      font-size: clamp(28px, 7vw, 40px);
    }
    .sec-hero-sub {
      font-size: 13px;
    }
    .sec-hero-price-val {
      font-size: 22px;
    }
  }
</style>
