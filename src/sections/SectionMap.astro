---
// SectionMap.astro — Kartenabschnitt für Detailseiten (Orte, Unterkünfte, etc.)
// Rendert eine Leaflet-Karte mit einem einzelnen Marker oder mehreren Markern.

import LeafletMap from '../components/LeafletMap.jsx';

export interface Props {
  label?: string;
  title?: string;
  sub?: string;
  markers: { lat: string | number; lng: string | number; label?: string; href?: string; emoji?: string; color?: string }[];
  center?: { lat: string | number; lng: string | number };
  zoom?: number;
  height?: string;
  scrollWheelZoom?: boolean;
}

const { label, title, sub, markers = [], center, zoom, height, scrollWheelZoom } = Astro.props;
const hasMultiple = markers.length > 1;
---

<section class="section section-map">
  <div class="container">
    {(label || title) && (
      <div class="section-header">
        {label && <div class="section-label">{label}</div>}
        {title && <h2 class="section-title">{title}</h2>}
        {sub && <p class="section-desc">{sub}</p>}
      </div>
    )}

    <LeafletMap
      client:only="react"
      markers={markers}
      center={center}
      zoom={zoom || (hasMultiple ? 8 : 13)}
      height={height || (hasMultiple ? '480px' : '400px')}
      scrollWheelZoom={scrollWheelZoom ?? !hasMultiple}
    />
  </div>
</section>

<style is:global>
  .section-map {
    padding: 60px 0;
    background: var(--bg2);
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }
  @media(max-width:600px){.section-map{padding:40px 0}.section-map [class*='leaflet-container']{height:300px!important}}
</style>
