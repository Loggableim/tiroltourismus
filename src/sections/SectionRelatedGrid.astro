---
export interface Props {
  label?: string;
  title?: string;
  description?: string;
  entries: Array<any>;
  slugPrefix: string;
  nameField: string;
  subtitleField?: string;
  priceField?: string;
  emojiField?: string;
  defaultEmoji?: string;
  emptyText?: string;
  ctaHref?: string;
  ctaText?: string;
  accentBg?: boolean;
}

const {
  label,
  title,
  description,
  entries,
  slugPrefix,
  nameField,
  subtitleField,
  priceField,
  emojiField,
  defaultEmoji,
  emptyText,
  ctaHref,
  ctaText,
  accentBg,
} = Astro.props;
---

<section class="sec-rel section" class:list={{ 'sec-rel-alt': accentBg }}>
  <div class="container">
    {(label || title) && (
      <div class="section-header">
        {label && <div class="section-label">{label}</div>}
        {title && (
          <h2 class="section-title" style="font-size:clamp(32px,4vw,56px)">
            {title}
          </h2>
        )}
        {description && <p class="section-desc">{description}</p>}
      </div>
    )}
    {entries && entries.length > 0 ? (
      <>
        <div class="sec-rel-grid">
          {entries.map((e) => {
            const emoji = emojiField
              ? e.entry
                ? e.entry[emojiField]
                : e[emojiField]
              : defaultEmoji;
            const name = e.entry ? e.entry[nameField] : e[nameField];
            const subtitle = subtitleField
              ? e.entry
                ? e.entry[subtitleField]
                : e[subtitleField]
              : '';
            const price = priceField
              ? e.entry
                ? e.entry[priceField]
                : e[priceField]
              : '';
            const slug = e.slug || e[slugPrefix];
            return (
              <a href={`${slugPrefix}${slug}/`} class="sec-rel-card">
                <div class="sec-rel-card-emoji">{emoji || '📌'}</div>
                <div class="sec-rel-card-body">
                  <h3>{name}</h3>
                  {subtitle && <p>{subtitle}</p>}
                  {price && <span class="sec-rel-price">ab {price} €</span>}
                </div>
              </a>
            );
          })}
        </div>
        {ctaHref && ctaText && (
          <div class="sec-rel-cta">
            <a href={ctaHref} class="btn btn-outline">
              {ctaText} →
            </a>
          </div>
        )}
      </>
    ) : (
      <p class="sec-rel-empty">{emptyText || 'Keine Einträge gefunden.'}</p>
    )}
  </div>
</section>

<style is:global>
  .sec-rel {
    padding-bottom: 60px;
  }
  .sec-rel-alt {
    background: var(--bg2);
  }
  .sec-rel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }
  .sec-rel-card {
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: all 0.4s var(--ease);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .sec-rel-card:hover {
    transform: translateY(-4px);
    border-color: var(--pink);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
  }
  .sec-rel-card-emoji {
    font-size: 36px;
    padding: 20px 20px 0;
    text-align: center;
  }
  .sec-rel-card-body {
    padding: 16px 20px 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .sec-rel-card-body h3 {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 6px;
    line-height: 1.2;
    color: var(--text);
  }
  .sec-rel-card-body p {
    font-size: 12px;
    color: var(--text3);
    line-height: 1.5;
    margin-bottom: 8px;
    flex: 1;
  }
  .sec-rel-price {
    font-size: 14px;
    font-weight: 700;
    color: var(--pink);
    margin-top: auto;
  }
  .sec-rel-empty {
    text-align: center;
    font-size: 14px;
    color: var(--text3);
    padding: 20px 0 10px;
  }
  .sec-rel-cta {
    text-align: center;
  }
  @media (max-width: 968px) {
    .sec-rel-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .sec-rel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
