---
export interface Props {
  label?: string;
  title?: string;
  tipps: string[];
}
const { label, title, tipps } = Astro.props;
---

{tipps && tipps.length > 0 && (
  <section class="sec-tipps section" style="padding-top:0">
    <div class="container" style="max-width:800px">
      {label && title && (
        <div class="section-header" style="margin-bottom:24px">
          <div class="section-label">{label}</div>
          <h2 class="section-title" style="font-size:clamp(28px,4vw,44px)">{title}</h2>
        </div>
      )}
      <div class="sec-tipps-list">
        {tipps.map((t, i) => (
          <div class="sec-tipp-item">
            <span class="sec-tipp-num">{String(i+1).padStart(2, '0')}</span>
            <span class="sec-tipp-text">{t}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style is:global>
  .sec-tipps-list { display: flex; flex-direction: column; gap: 12px; }
  .sec-tipp-item { display: flex; align-items: flex-start; gap: 16px; padding: 16px 20px; background: var(--surface); border: 1px solid var(--glass-border); border-radius: var(--radius); transition: all 0.3s; }
  .sec-tipp-item:hover { border-color: rgba(255,20,147,.15); transform: translateX(4px); }
  .sec-tipp-num { font-family: var(--font-display); font-size: 24px; line-height: 1; color: var(--pink); min-width: 32px; opacity: .6; }
  .sec-tipp-text { font-size: 14px; color: var(--text2); line-height: 1.7; }
  @media(max-width:600px){ .sec-tipp-item { padding: 12px 16px; } .sec-tipp-num { font-size: 18px; min-width: 24px; } }
</style>
